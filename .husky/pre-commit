#!/usr/bin/env bash

# 0. Check for hardcoded numRuns in staged property tests (fast grep check)
if git diff --cached --name-only | grep -q "test/property/.*\.test\.js$"; then
    if git diff --cached -U0 -- test/property/ | grep '^+' | grep -v '^+++' | grep 'numRuns: *[0-9]' > /dev/null 2>&1; then
        echo "❌ Hardcoded numRuns found in staged property test changes."
        echo "   Use: import { NUM_RUNS } from '../helpers/property-config.js'"
        exit 1
    fi
fi

# 1. Lint staged JS files (fast — only changed files)
npx lint-staged

# 2. Python syntax check on staged .py files in templates/do/lib/python/
STAGED_PY=$(git diff --cached --name-only --diff-filter=ACM | grep '\.py$' || true)
if [ -n "$STAGED_PY" ]; then
    for pyfile in $STAGED_PY; do
        if ! python3 -c "import ast; ast.parse(open('$pyfile').read())" 2>/dev/null; then
            echo "❌ Python syntax error in: $pyfile"
            exit 1
        fi
    done
fi

# 3. Codegen parity check (ensures schema-manifest + generated files are fresh)
#    Only run full codegen if schema/source files that affect generation are staged.
#    Otherwise just verify no unstaged drift exists in generated dirs.
CODEGEN_TRIGGERS="config/parameter-schema-v2.json|scripts/codegen-|servers/lib/catalogs/"
if git diff --cached --name-only | grep -qE "$CODEGEN_TRIGGERS"; then
    npm run codegen --silent
    if ! git diff --exit-code --quiet -I "// Generated:" -I "\"generatedAt\"" -- docs/data/ src/lib/generated/ 2>/dev/null; then
        echo "❌ Generated files are stale. Run: npm run codegen"
        echo "   Then stage the updated files and commit again."
        exit 1
    fi
fi

# 4. Command generator sync check
node scripts/sync-command-generator.js --check

# 5. Remove __pycache__ directories from staging area
git diff --cached --name-only | grep -E '__pycache__' | while read f; do
    git rm -r --cached "$f" 2>/dev/null || true
done

git ls-files --cached | grep '__pycache__' | xargs git rm --cached -r 2>/dev/null || true