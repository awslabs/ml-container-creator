# Python bytecode (belt-and-suspenders — also cleaned by npm run clean:pycache)
**/__pycache__/
**/*.pyc
**/*.pyo

# CDK build output (large, regenerated from source)
infra/ci-harness/cdk.out/

# Test files (not needed in published package)
infra/ci-harness/test/

# Development artifacts
.DS_Store
.idea/
.kiro/
.vscode/
.hypothesis/
.pytest_cache/
.nyc_output/
coverage/
test-output-*
test-results.json
drafts/

# MkDocs
site/
docs/deep-dive-deck.pptx

# CI/scripts (development-only)
scripts/
.github/
.eslintrc.cjs

# Server test files and dev artifacts
servers/*/test.js
servers/*/licenses.csv
servers/*/sbom.json
servers/*/node_modules/
servers/lib/licenses.csv
servers/lib/sbom.json
servers/lib/node_modules/

# Infra node_modules (users run npm install themselves)
infra/ci-harness/node_modules/
