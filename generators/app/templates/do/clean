set -e
set -u
set -o pipefail

# Source configuration
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${SCRIPT_DIR}/config"

# Parse arguments
CLEANUP_TARGET=""
FORCE_CLEAN=false

for arg in "$@"; do
    case "$arg" in
        --force) FORCE_CLEAN=true ;;
        -*) ;; # ignore other flags
        *) CLEANUP_TARGET="$arg" ;;
    esac
done

