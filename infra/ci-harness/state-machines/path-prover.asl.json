{
  "Comment": "Path Prover Orchestrator — proves untested configuration paths end-to-end. Loops: Brain → stages → PickNext → Brain|End. Budget-controlled.",
  "StartAt": "Brain",
  "States": {
    "Brain": {
      "Type": "Task",
      "Resource": "${BrainFunctionArn}",
      "Parameters": {
        "action": "getNextConfig",
        "iteration.$": "$.iteration",
        "budgetSpent.$": "$.budgetSpent",
        "maxProvesPerRun.$": "$.maxProvesPerRun",
        "maxCostPerRun.$": "$.maxCostPerRun",
        "previousResults.$": "$.previousResults"
      },
      "ResultPath": "$.brainResult",
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException"],
          "IntervalSeconds": 5,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "ClassifyFailure"
        }
      ],
      "Next": "CheckBrainDone"
    },

    "CheckBrainDone": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.brainResult.done",
          "BooleanEquals": true,
          "Next": "End"
        }
      ],
      "Default": "PrepareStageInput"
    },

    "PrepareStageInput": {
      "Type": "Pass",
      "Parameters": {
        "iteration.$": "$.iteration",
        "budgetSpent.$": "$.budgetSpent",
        "maxProvesPerRun.$": "$.maxProvesPerRun",
        "maxCostPerRun.$": "$.maxCostPerRun",
        "previousResults.$": "$.previousResults",
        "brainResult.$": "$.brainResult",
        "currentConfig.$": "$.brainResult.next",
        "tuneRequested.$": "$.brainResult.tuneRequested"
      },
      "Next": "GenerateBuildPush"
    },

    "GenerateBuildPush": {
      "Type": "Task",
      "Resource": "arn:aws:states:::codebuild:startBuild",
      "Parameters": {
        "ProjectName": "${CodeBuildProjectName}",
        "EnvironmentVariablesOverride": [
          {
            "Name": "CONFIG_JSON",
            "Value.$": "States.JsonToString($.currentConfig)",
            "Type": "PLAINTEXT"
          },
          {
            "Name": "CI_STAGE",
            "Value": "path-prove-generate-build-push",
            "Type": "PLAINTEXT"
          },
          {
            "Name": "PATH_PROVER_MODE",
            "Value": "true",
            "Type": "PLAINTEXT"
          }
        ]
      },
      "ResultPath": "$.generateBuildPushResult",
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed"],
          "IntervalSeconds": 30,
          "MaxAttempts": 1,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "ClassifyFailure"
        }
      ],
      "Next": "DeployTest"
    },

    "DeployTest": {
      "Type": "Task",
      "Resource": "arn:aws:states:::codebuild:startBuild",
      "Parameters": {
        "ProjectName": "${CodeBuildProjectName}",
        "EnvironmentVariablesOverride": [
          {
            "Name": "CONFIG_JSON",
            "Value.$": "States.JsonToString($.currentConfig)",
            "Type": "PLAINTEXT"
          },
          {
            "Name": "CI_STAGE",
            "Value": "path-prove-deploy-test",
            "Type": "PLAINTEXT"
          },
          {
            "Name": "PATH_PROVER_MODE",
            "Value": "true",
            "Type": "PLAINTEXT"
          }
        ]
      },
      "ResultPath": "$.deployTestResult",
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed"],
          "IntervalSeconds": 30,
          "MaxAttempts": 1,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "ClassifyFailure"
        }
      ],
      "Next": "CheckTune"
    },

    "CheckTune": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.tuneRequested",
          "BooleanEquals": true,
          "Next": "TuneAdapterTest"
        }
      ],
      "Default": "Benchmark"
    },

    "TuneAdapterTest": {
      "Type": "Task",
      "Resource": "arn:aws:states:::codebuild:startBuild",
      "Parameters": {
        "ProjectName": "${CodeBuildProjectName}",
        "EnvironmentVariablesOverride": [
          {
            "Name": "CONFIG_JSON",
            "Value.$": "States.JsonToString($.currentConfig)",
            "Type": "PLAINTEXT"
          },
          {
            "Name": "CI_STAGE",
            "Value": "path-prove-tune-adapter-test",
            "Type": "PLAINTEXT"
          },
          {
            "Name": "PATH_PROVER_MODE",
            "Value": "true",
            "Type": "PLAINTEXT"
          }
        ]
      },
      "ResultPath": "$.tuneAdapterTestResult",
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed"],
          "IntervalSeconds": 30,
          "MaxAttempts": 1,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "ClassifyFailure"
        }
      ],
      "Next": "Benchmark"
    },

    "Benchmark": {
      "Type": "Task",
      "Resource": "arn:aws:states:::codebuild:startBuild",
      "Parameters": {
        "ProjectName": "${CodeBuildProjectName}",
        "EnvironmentVariablesOverride": [
          {
            "Name": "CONFIG_JSON",
            "Value.$": "States.JsonToString($.currentConfig)",
            "Type": "PLAINTEXT"
          },
          {
            "Name": "CI_STAGE",
            "Value": "path-prove-benchmark",
            "Type": "PLAINTEXT"
          },
          {
            "Name": "PATH_PROVER_MODE",
            "Value": "true",
            "Type": "PLAINTEXT"
          }
        ]
      },
      "ResultPath": "$.benchmarkResult",
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed"],
          "IntervalSeconds": 30,
          "MaxAttempts": 1,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "ClassifyFailure"
        }
      ],
      "Next": "WriteResults"
    },

    "WriteResults": {
      "Type": "Task",
      "Resource": "${WriteResultsFunctionArn}",
      "Parameters": {
        "action": "writeResults",
        "config.$": "$.currentConfig",
        "benchmarkResult.$": "$.benchmarkResult",
        "runType": "path_prove"
      },
      "ResultPath": "$.writeResult",
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException"],
          "IntervalSeconds": 5,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "ClassifyFailure"
        }
      ],
      "Next": "Clean"
    },

    "Clean": {
      "Type": "Task",
      "Resource": "arn:aws:states:::codebuild:startBuild",
      "Parameters": {
        "ProjectName": "${CodeBuildProjectName}",
        "EnvironmentVariablesOverride": [
          {
            "Name": "CONFIG_JSON",
            "Value.$": "States.JsonToString($.currentConfig)",
            "Type": "PLAINTEXT"
          },
          {
            "Name": "CI_STAGE",
            "Value": "path-prove-clean",
            "Type": "PLAINTEXT"
          },
          {
            "Name": "PATH_PROVER_MODE",
            "Value": "true",
            "Type": "PLAINTEXT"
          }
        ]
      },
      "ResultPath": "$.cleanResult",
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed"],
          "IntervalSeconds": 10,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.cleanError",
          "Next": "PickNext"
        }
      ],
      "Next": "PickNext"
    },

    "PickNext": {
      "Type": "Task",
      "Resource": "${BrainFunctionArn}",
      "Parameters": {
        "action": "pickNext",
        "iteration.$": "$.iteration",
        "budgetSpent.$": "$.budgetSpent",
        "maxProvesPerRun.$": "$.maxProvesPerRun",
        "maxCostPerRun.$": "$.maxCostPerRun",
        "currentConfig.$": "$.currentConfig",
        "previousResults.$": "$.previousResults",
        "lastResult": "success"
      },
      "ResultPath": "$.pickNextResult",
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException"],
          "IntervalSeconds": 5,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "End"
        }
      ],
      "Next": "CheckDone"
    },

    "CheckDone": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.pickNextResult.done",
          "BooleanEquals": true,
          "Next": "End"
        }
      ],
      "Default": "UpdateIterationState"
    },

    "UpdateIterationState": {
      "Type": "Pass",
      "Parameters": {
        "iteration.$": "$.pickNextResult.iteration",
        "budgetSpent.$": "$.pickNextResult.budgetSpent",
        "maxProvesPerRun.$": "$.maxProvesPerRun",
        "maxCostPerRun.$": "$.maxCostPerRun",
        "previousResults.$": "$.pickNextResult.previousResults",
        "brainResult.$": "$.pickNextResult"
      },
      "Next": "CheckBrainDone"
    },

    "ClassifyFailure": {
      "Type": "Task",
      "Resource": "${ClassifyFailureFunctionArn}",
      "Parameters": {
        "action": "classifyFailure",
        "error.$": "$.error",
        "config.$": "$.currentConfig",
        "iteration.$": "$.iteration"
      },
      "ResultPath": "$.classification",
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException"],
          "IntervalSeconds": 5,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "Next": "WriteFailureRecord"
    },

    "WriteFailureRecord": {
      "Type": "Task",
      "Resource": "${WriteResultsFunctionArn}",
      "Parameters": {
        "action": "writeFailure",
        "config.$": "$.currentConfig",
        "error.$": "$.error",
        "classification.$": "$.classification",
        "runType": "path_prove"
      },
      "ResultPath": "$.failureWriteResult",
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException"],
          "IntervalSeconds": 5,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "Next": "CleanAfterFailure"
    },

    "CleanAfterFailure": {
      "Type": "Task",
      "Resource": "arn:aws:states:::codebuild:startBuild",
      "Parameters": {
        "ProjectName": "${CodeBuildProjectName}",
        "EnvironmentVariablesOverride": [
          {
            "Name": "CONFIG_JSON",
            "Value.$": "States.JsonToString($.currentConfig)",
            "Type": "PLAINTEXT"
          },
          {
            "Name": "CI_STAGE",
            "Value": "path-prove-clean",
            "Type": "PLAINTEXT"
          },
          {
            "Name": "PATH_PROVER_MODE",
            "Value": "true",
            "Type": "PLAINTEXT"
          }
        ]
      },
      "ResultPath": "$.failureCleanResult",
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed"],
          "IntervalSeconds": 10,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.failureCleanError",
          "Next": "PickNextAfterFailure"
        }
      ],
      "Next": "PickNextAfterFailure"
    },

    "PickNextAfterFailure": {
      "Type": "Task",
      "Resource": "${BrainFunctionArn}",
      "Parameters": {
        "action": "pickNext",
        "iteration.$": "$.iteration",
        "budgetSpent.$": "$.budgetSpent",
        "maxProvesPerRun.$": "$.maxProvesPerRun",
        "maxCostPerRun.$": "$.maxCostPerRun",
        "currentConfig.$": "$.currentConfig",
        "previousResults.$": "$.previousResults",
        "lastResult": "failure",
        "classification.$": "$.classification"
      },
      "ResultPath": "$.pickNextResult",
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException"],
          "IntervalSeconds": 5,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "End"
        }
      ],
      "Next": "CheckDone"
    },

    "End": {
      "Type": "Succeed"
    }
  }
}
