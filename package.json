{
  "name": "@aws/ml-container-creator",
  "version": "1.9.1",
  "description": "Build and deploy custom ML containers on AWS SageMaker with minimal configuration.",
  "main": "src/index.js",
  "bin": {
    "ml-container-creator": "./bin/cli.js",
    "mcc": "./bin/cli.js"
  },
  "keywords": [
    "sagemaker",
    "docker",
    "ml",
    "containers"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/awslabs/ml-container-creator.git"
  },
  "files": [
    "bin/",
    "src/",
    "templates/",
    "servers/lib/catalogs/",
    "servers/base-image-picker/index.js",
    "servers/base-image-picker/manifest.json",
    "servers/base-image-picker/package.json",
    "servers/model-picker/index.js",
    "servers/model-picker/manifest.json",
    "servers/model-picker/package.json",
    "servers/region-picker/index.js",
    "servers/region-picker/manifest.json",
    "servers/region-picker/package.json",
    "servers/hyperpod-cluster-picker/index.js",
    "servers/hyperpod-cluster-picker/manifest.json",
    "servers/hyperpod-cluster-picker/package.json",
    "servers/instance-sizer/lib/",
    "servers/instance-sizer/index.js",
    "servers/instance-sizer/manifest.json",
    "servers/instance-sizer/package.json",
    "servers/endpoint-picker/index.js",
    "servers/endpoint-picker/manifest.json",
    "servers/endpoint-picker/package.json",
    "servers/e2e-status/index.js",
    "servers/e2e-status/manifest.json",
    "servers/e2e-status/package.json",
    "servers/workload-picker/catalogs/",
    "servers/workload-picker/index.js",
    "servers/workload-picker/manifest.json",
    "servers/workload-picker/package.json",
    "servers/agent-knowledge/index.js",
    "servers/agent-knowledge/package.json",
    "servers/reasoning/index.js",
    "servers/reasoning/manifest.json",
    "servers/reasoning/package.json",
    "servers/lib/bedrock-client.js",
    "servers/lib/create-picker-server.js",
    "servers/lib/load-catalog.js",
    "servers/lib/custom-validators.js",
    "servers/lib/dynamic-resolver.js",
    "servers/lib/image-filter.js",
    "servers/lib/model-id-resolver.js",
    "servers/lib/override-loader.js",
    "servers/lib/schemas/",
    "servers/lib/package.json",
    "servers/README.md",
    "config/defaults.json",
    "config/bootstrap-e2e-stack.json",
    "config/parameter-schema-v2.json",
    "config/agent.json",
    "config/tune-catalog.json",
    "config/presets/",
    "infra/ci-harness/bin/",
    "infra/ci-harness/lambda/",
    "infra/ci-harness/lib/",
    "infra/ci-harness/state-machines/",
    "infra/ci-harness/buildspec.yml",
    "infra/ci-harness/cdk.json",
    "infra/ci-harness/package.json",
    "infra/ci-harness/package-lock.json",
    "infra/ci-harness/tsconfig.json",
    "infra/ci-harness/state-machines/",
    "infra/bootstrap-modules/**/*.ts",
    "infra/bootstrap-modules/**/*.cjs",
    "infra/bootstrap-modules/**/buckets.json",
    "infra/bootstrap-modules/module-manifest.json",
    "infra/bootstrap-modules/cdk.json",
    "infra/bootstrap-modules/package.json",
    "infra/bootstrap-modules/package-lock.json",
    "infra/bootstrap-modules/tsconfig.json",
    "!infra/bootstrap-modules/**/*.d.ts",
    "!infra/bootstrap-modules/test/",
    "!infra/bootstrap-modules/node_modules/",
    "!infra/bootstrap-modules/dist/",
    "!infra/bootstrap-modules/cdk.out/",
    "!infra/bootstrap-modules/.hyperpod-helm-cache/",
    "README.md",
    "LICENSE",
    "LICENSE-THIRD-PARTY",
    "NOTICE",
    "requirements.txt",
    "pyproject.toml",
    "examples/train-plugins/",
    "!examples/**/__pycache__/",
    "docs/**/*.md",
    "!docs/dev/*-pr-summary.md",
    "!docs/dev/*-pr-description.md",
    "!docs/dev/v*-release-notes.md"
  ],
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.11.1",
    "npm": ">=11.6.2"
  },
  "scripts": {
    "test": "mocha 'test/**/*.test.js' --ignore 'test/property/**' --recursive --timeout 30000 --parallel",
    "test:property": "NODE_OPTIONS='--max-old-space-size=8192' mocha 'test/property/**/*.test.js' --recursive --timeout 60000 --parallel --jobs 4",
    "test:all": "npm run test && npm run test:node && npm run test:property",
    "test:node": "node scripts/run-node-tests.js",
    "test:node:network": "node scripts/run-node-tests.js --include-network",
    "test:fast": "mocha 'test/**/*.test.js' --recursive --timeout 15000 --parallel",
    "test:unit": "mocha 'test/unit/**/*.test.js' --recursive --timeout 15000",
    "test:integration": "mocha 'test/integration/**/*.test.js' --recursive --timeout 30000",
    "test:servers": "node scripts/run-server-tests.js",
    "test:servers:unit": "node scripts/run-server-tests.js",
    "test:servers:network": "node scripts/run-server-tests.js --include-network",
    "test:watch": "mocha 'test/**/*.test.js' --recursive --timeout 30000 --watch",
    "test:coverage": "nyc npm test",
    "test:ci": "npm run lint && npm run test:all",
    "test:perf": "node scripts/analyze-test-performance.js",
    "lint": "eslint src/ servers/ bin/ --ext .js,.cjs,.mjs",
    "lint:fix": "eslint src/ servers/ bin/ --ext .js,.cjs,.mjs --fix",
    "codegen": "node scripts/codegen-cli.js && node scripts/codegen-validator.js && node scripts/codegen-widget.js && node scripts/codegen-parameter-matrix.js && node scripts/codegen-target-guard.js && node scripts/codegen-deploy-flags.js && node scripts/codegen-train-schema.js && node scripts/codegen-export-map.js && eslint src/lib/generated/ --fix",
    "sync:models": "node scripts/sync-model-families.js",
    "sync:serving": "node scripts/sync-serving-versions.js",
    "sync:all": "npm run sync:models && npm run sync:serving",
    "sync:pricing": "python3 templates/do/lib/python/pricing.py snapshot",
    "validate:doc-commands": "node scripts/validate-docs-commands.js",
    "validate:catalogs": "node scripts/validate-catalogs.js",
    "validate:serve-manifests": "node scripts/validate-serve-manifests.js",
    "validate:tune-manifests": "node scripts/validate-tune-manifests.js",
    "sbom": "sbom --format spdx --output sbom.json",
    "prepublishOnly": "npm run lint && npm run test:all",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/client-secrets-manager": "^3.700.0",
    "@aws-sdk/credential-providers": "^3.700.0",
    "@aws-sdk/util-dynamodb": "^3.700.0",
    "@aws/ml-container-creator": "^1.4.0",
    "@inquirer/prompts": "^8.4.2",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "ajv": "^8.12.0",
    "chalk": "^5.6.2",
    "cli-table3": "^0.6.5",
    "commander": "13.1.0",
    "ejs": "^3.1.10",
    "minimatch": "^10.2.4",
    "ora": "^9.4.1",
    "tinyglobby": "^0.2.16"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/client-sagemaker": "^3.700.0",
    "@aws-sdk/client-service-quotas": "^3.700.0",
    "@microsoft/eslint-formatter-sarif": "^3.1.0",
    "eslint": "^8.57.1",
    "eslint-plugin-property-test-rules": "file:eslint-rules",
    "fast-check": "^4.5.2",
    "husky": "^9.1.7",
    "license-report": "^6.8.0",
    "lint-staged": "^17.0.7",
    "mocha": "^12.0.0",
    "npm-force-resolutions": "^0.0.10",
    "nyc": "^18.0.0",
    "sbom": "^0.0.0"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix --quiet --max-warnings 0"
    ]
  },
  "nyc": {
    "extension": [
      ".js",
      ".mjs"
    ],
    "//": "BL238: no .cjs/.ts hooks. Under nyc a child ts-node run (test/unit/bootstrap-*-cdk.test.js) otherwise resolves '../bucket-declarations' to the sibling .cjs runtime file instead of the .ts source. infra/** is not part of root coverage."
  }
}
