{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "array",
    "minItems": 1,
    "items": {
        "type": "object",
        "required": [
            "code",
            "labels"
        ],
        "properties": {
            "code": {
                "type": "string",
                "pattern": "^[a-z]{2,4}-[a-z]+-\\d+$"
            },
            "labels": {
                "type": "array",
                "minItems": 1,
                "items": {
                    "type": "string"
                }
            }
        },
        "additionalProperties": false
    }
}
