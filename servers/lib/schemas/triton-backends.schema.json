{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "triton-backends.schema.json",
    "type": "object",
    "minProperties": 1,
    "additionalProperties": {
        "type": "object",
        "required": [
            "requiresGpu",
            "modelFormats",
            "modelArtifactName",
            "requiresModelName",
            "supportsSampleModel"
        ],
        "properties": {
            "requiresGpu": {
                "type": "boolean"
            },
            "modelFormats": {
                "oneOf": [
                    {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    {
                        "type": "null"
                    }
                ]
            },
            "modelArtifactName": {
                "oneOf": [
                    {
                        "type": "string"
                    },
                    {
                        "type": "null"
                    }
                ]
            },
            "requiresModelName": {
                "type": "boolean"
            },
            "supportsSampleModel": {
                "type": "boolean"
            }
        },
        "additionalProperties": false
    }
}
