<%# download_model_from_s3 is ALWAYS defined for wrapper-path engines (vllm/
    sglang/tensorrt-llm). It must NOT be gated on the generate-time `modelSource`:
    a project generated with the default huggingface source can be staged to S3
    at DEPLOY time via do/stage, which sets MODEL_SOURCE=s3 + MODEL_ARTIFACT_URI
    in the pod env. resolve_model()'s s3 branch (always emitted) calls this
    function, so gating the definition produced a `download_model_from_s3:
    command not found` crash whenever a huggingface-generated project was later
    staged to S3. The function is inert unless MODEL_SOURCE=s3 at runtime. %>
# ---------------------------------------------------------------------------
# download_model_from_s3 — Download model artifacts from S3 to a local path
# ---------------------------------------------------------------------------
download_model_from_s3() {
    local s3_uri="$1"
    local dest_path="$2"
    local start_time
    start_time=$(date +%s)

    if [ -z "$s3_uri" ] || [ -z "$dest_path" ]; then
        echo "Error: download_model_from_s3 requires S3 URI and destination path" >&2
        return 1
    fi

    echo "Downloading model from ${s3_uri} to ${dest_path}..." >&2
    mkdir -p "${dest_path}"

    # NOTE: `aws s3 cp/sync` write their PROGRESS METER TO STDOUT. This function is
    # called from resolve_model(), whose stdout is captured by $(...) to yield the
    # resolved model path. If any aws progress leaks to stdout it is concatenated
    # into that path and then exported into the engine's model env var (e.g.
    # SGLANG_MODEL_PATH), producing a multi-kilobyte, multi-line env value. A large
    # enough value exceeds the kernel's per-string arg limit (MAX_ARG_STRLEN, 128
    # KiB) and makes EVERY subsequent execve fail with E2BIG ("Argument list too
    # long") — env, grep, python, and the server binary itself — bricking startup.
    # The bug is model-size probabilistic (a long sync dumps a long progress blob),
    # which is why it surfaced on a 96-shard model and not smaller ones. Two guards:
    #   1) --no-progress --only-show-errors silences the meter at the source.
    #   2) resolve_model() redirects this function's stdout to stderr at the call
    #      site, so the ONLY thing left on stdout is the deliberate path echo.
    if [[ "$s3_uri" == *.tar.gz ]] || [[ "$s3_uri" == *.tgz ]]; then
        if ! aws s3 cp --no-progress --only-show-errors "$s3_uri" /tmp/model_archive.tar.gz; then
            echo "Error: Failed to download tarball from ${s3_uri}" >&2
            return 1
        fi
        if ! tar -xzf /tmp/model_archive.tar.gz -C "$dest_path"; then
            echo "Error: Failed to extract tarball from ${s3_uri}" >&2
            rm -f /tmp/model_archive.tar.gz
            return 1
        fi
        rm -f /tmp/model_archive.tar.gz
    elif [[ "$s3_uri" == */ ]] || ! aws s3 ls "$s3_uri" 2>/dev/null | grep -q "^[0-9]"; then
        # Bucket consolidation R3.5: a staged base prefix also holds every project's
        # canonical LoRA adapters under .mlcc-adapters/ — never download them into
        # a realtime container (adapters load as their own inference components).
        # The glob must equal s3_layout.SERVE_SYNC_EXCLUDE (conformance test).
        if ! aws s3 sync --no-progress --only-show-errors --exclude ".mlcc-adapters/*" "$s3_uri" "$dest_path"; then
            echo "Error: Failed to sync from ${s3_uri}" >&2
            return 1
        fi
    else
        if ! aws s3 cp --no-progress --only-show-errors "$s3_uri" "$dest_path/"; then
            echo "Error: Failed to copy ${s3_uri}" >&2
            return 1
        fi
    fi

    local duration
    duration=$(( $(date +%s) - start_time ))
    echo "Download complete: ${s3_uri} → ${dest_path} (${duration}s)" >&2
}

# ---------------------------------------------------------------------------
# Model Loading Adapter — resolve model based on MODEL_SOURCE env var
# ---------------------------------------------------------------------------
MODEL_SOURCE="${MODEL_SOURCE:-huggingface}"
MODEL_ARTIFACT_URI="${MODEL_ARTIFACT_URI:-}"
LOCAL_MODEL_PATH="/opt/ml/model"

<% if (modelServer === 'vllm') { %>
_MODEL_VAR="VLLM_MODEL"
<% } else if (modelServer === 'sglang') { %>
_MODEL_VAR="SGLANG_MODEL_PATH"
<% } else if (modelServer === 'tensorrt-llm') { %>
_MODEL_VAR="TRTLLM_MODEL"
<% } %>

resolve_model() {
    case "$MODEL_SOURCE" in
        huggingface)
            echo "${!_MODEL_VAR}"
            return
            ;;
        s3|registry)
            # Non-empty check WITHOUT expanding the directory listing. The old
            # `[ "$(ls -A "$dir")" ]` captured every filename into one shell word —
            # fine for a handful of files, but a model with its .cache/huggingface
            # tree can hold thousands, making that an unnecessarily huge string.
            # `find ... -print -quit` stops at the first entry: O(1), no big word.
            if [ -d "$LOCAL_MODEL_PATH" ] && [ -n "$(find "$LOCAL_MODEL_PATH" -mindepth 1 -print -quit 2>/dev/null)" ]; then
                echo "Using pre-mounted model artifacts at $LOCAL_MODEL_PATH" >&2
                echo "$LOCAL_MODEL_PATH"
                return
            fi

            if [ "$MODEL_SOURCE" = "registry" ] && [ -z "$MODEL_ARTIFACT_URI" ]; then
                local model_uri="${!_MODEL_VAR}"
                local registry_prefix="registry://"
                if [[ "$model_uri" == "${registry_prefix}"* ]]; then
                    local registry_path="${model_uri#${registry_prefix}}"
                    local group_name="${registry_path%%/*}"
                    local version="${registry_path#*/}"
                    local region="${AWS_REGION:-${AWS_DEFAULT_REGION:-us-east-1}}"

                    local account_id
                    account_id=$(aws sts get-caller-identity --query Account --output text 2>/dev/null) || {
                        echo "Error: Failed to get AWS account ID for model package ARN" >&2
                        exit 1
                    }

                    local package_arn="arn:aws:sagemaker:${region}:${account_id}:model-package/${group_name}/${version}"
                    echo "Resolving ${model_uri} via SageMaker DescribeModelPackage..." >&2
                    echo "   ARN: ${package_arn}" >&2

                    local describe_output
                    describe_output=$(aws sagemaker describe-model-package \
                        --model-package-name "$package_arn" \
                        --region "$region" \
                        --output json 2>/dev/null) || {
                        echo "Error: Failed to describe model package: ${package_arn}" >&2
                        exit 1
                    }

                    MODEL_ARTIFACT_URI=$(echo "$describe_output" | python3 -c "
import sys, json, re
try:
    pkg = json.load(sys.stdin)
    uri = ''
    containers = pkg.get('InferenceSpecification', {}).get('Containers', [])
    if containers:
        c = containers[0]
        uri = c.get('ModelDataUrl', '')
        if not uri:
            uri = c.get('ModelDataSource', {}).get('S3DataSource', {}).get('S3Uri', '')
    if not uri:
        desc = pkg.get('ModelPackageDescription', '')
        m = re.search(r's3://[^\s]+', desc)
        if m:
            uri = m.group(0)
    print(uri)
except:
    print('')
" 2>/dev/null)

                    if [ -n "$MODEL_ARTIFACT_URI" ] && [ "$MODEL_ARTIFACT_URI" != "None" ]; then
                        echo "Resolved artifact URI: ${MODEL_ARTIFACT_URI}" >&2
                    else
                        echo "Error: No model artifact URI found in model package: ${package_arn}" >&2
                        exit 1
                    fi
                fi
            fi

            if [ -z "$MODEL_ARTIFACT_URI" ]; then
                echo "Error: ${MODEL_SOURCE} model requires artifact URI or pre-mounted artifacts at $LOCAL_MODEL_PATH" >&2
                exit 1
            fi
            # Redirect the downloader's STDOUT to stderr (1>&2) so NOTHING it (or
            # its aws children) prints can pollute resolve_model's captured stdout.
            # resolve_model runs inside $(...) and its stdout IS the resolved path;
            # the only line that may reach stdout is the deliberate echo below.
            # Belt-and-suspenders with --no-progress in download_model_from_s3.
            if ! download_model_from_s3 "$MODEL_ARTIFACT_URI" "$LOCAL_MODEL_PATH" 1>&2; then
                echo "Error: Failed to download model from ${MODEL_ARTIFACT_URI}" >&2
                exit 1
            fi
            echo "$LOCAL_MODEL_PATH"
            ;;
        *)
            echo "${!_MODEL_VAR}"
            return
            ;;
    esac
}

_RESOLVED_MODEL=$(resolve_model) || exit 1
export "${_MODEL_VAR}=${_RESOLVED_MODEL}"
echo "Resolved ${_MODEL_VAR}=${_RESOLVED_MODEL} (source: ${MODEL_SOURCE})"
unset _MODEL_VAR _RESOLVED_MODEL

