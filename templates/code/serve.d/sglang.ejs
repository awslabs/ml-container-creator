# ---------------------------------------------------------------------------
# SGLang Server Configuration
# ---------------------------------------------------------------------------
# Env prefix: SGLANG_
# Entrypoint: python3 -m sglang.launch_server
# Port: 8080 (SageMaker requirement)
# ---------------------------------------------------------------------------

PREFIX="SGLANG_"
ARG_PREFIX="--"

# ---------------------------------------------------------------------------
# Positive whitelist via --help introspection (same approach as vLLM).
#
# Only forward SGLANG_* env vars whose --<flag> the running sglang.launch_server
# actually accepts. This is version-proof: it adapts to whatever SGLang version
# is in the image and silently drops env-only or unknown vars instead of
# crashing the server with an unrecognized-arg error. Note SGLang's flag names
# differ from vLLM (e.g. --tp-size, --context-length, --mem-fraction-static).
# ---------------------------------------------------------------------------
VALID_ARGS_CACHE="/tmp/.sglang-valid-args"
if [ ! -s "${VALID_ARGS_CACHE}" ]; then
    python3 -m sglang.launch_server --help 2>/dev/null \
        | grep -oE '\-\-[a-z0-9][a-z0-9-]+' \
        | sort -u > "${VALID_ARGS_CACHE}" 2>/dev/null || true
fi

# Fallback blocklist — used only if --help introspection produced nothing.
EXCLUDE_VARS=()

_have_whitelist=false
if [ -s "${VALID_ARGS_CACHE}" ]; then
    _have_whitelist=true
else
    echo "⚠️  Could not introspect sglang --help; falling back to exclude-list filtering" >&2
fi

# Declare and populate array of matching environment variables
mapfile -t env_vars < <(env | grep "^${PREFIX}")

# Convert SGLANG_ env vars to CLI arguments
for var in "${env_vars[@]}"; do
    IFS='=' read -r key value <<< "$var"

    # Remove prefix, convert to lowercase, replace underscores with dashes
    arg_name=$(echo "${key#"${PREFIX}"}" | tr '[:upper:]' '[:lower:]' | tr '_' '-')

    # Speculative decoding flags are assembled explicitly below so optional
    # values and the S3 draft-model validation follow one code path.
    case "${key}" in
        SGLANG_SPECULATIVE_ALGORITHM|SGLANG_SPECULATIVE_DRAFT_MODEL_PATH|SGLANG_SPECULATIVE_NUM_STEPS|SGLANG_SPECULATIVE_EAGLE_TOPK)
            continue
            ;;
    esac

    # Primary path: only forward args sglang actually accepts (from --help).
    if [ "$_have_whitelist" = true ]; then
        if ! grep -qx -- "${ARG_PREFIX}${arg_name}" "${VALID_ARGS_CACHE}"; then
            continue
        fi
    elif [ ${#EXCLUDE_VARS[@]} -gt 0 ]; then
        skip=false
        for exclude in "${EXCLUDE_VARS[@]}"; do
            if [ "$key" = "$exclude" ]; then skip=true; break; fi
        done
        if [ "$skip" = true ]; then continue; fi
    fi

    # Boolean handling: true = flag only, false = skip entirely
    if [ "$value" = "false" ]; then continue; fi

    SERVER_ARGS+=("${ARG_PREFIX}${arg_name}")
    if [ -n "$value" ] && [ "$value" != "true" ]; then
        SERVER_ARGS+=("$value")
    fi
done

# ---------------------------------------------------------------------------
# Speculative decoding (BL085) — SGLang discrete flags.
# The HyperPod CRD supplies engine-specific SGLANG_SPECULATIVE_* values. The
# algorithm is already in SGLang's required uppercase enum form.
# ---------------------------------------------------------------------------
_speculative_draft_model="${SGLANG_SPECULATIVE_DRAFT_MODEL_PATH:-${HP_SPECULATIVE_MODEL:-}}"
if [ -n "${_speculative_draft_model}" ] && [[ "${_speculative_draft_model}" == s3://* ]]; then
    echo "❌ HP_SPECULATIVE_MODEL must be a HuggingFace model ID or local path, not an s3:// URI. Stage it first with do/stage." >&2
    exit 1
fi
if [ -n "${SGLANG_SPECULATIVE_ALGORITHM:-}" ]; then
    SERVER_ARGS+=(--speculative-algorithm "${SGLANG_SPECULATIVE_ALGORITHM}")
    if [ -n "${SGLANG_SPECULATIVE_DRAFT_MODEL_PATH:-}" ]; then
        SERVER_ARGS+=(--speculative-draft-model-path "${SGLANG_SPECULATIVE_DRAFT_MODEL_PATH}")
    fi
    if [ -n "${SGLANG_SPECULATIVE_NUM_STEPS:-}" ]; then
        SERVER_ARGS+=(--speculative-num-steps "${SGLANG_SPECULATIVE_NUM_STEPS}")
    fi
    if [ -n "${SGLANG_SPECULATIVE_EAGLE_TOPK:-}" ]; then
        SERVER_ARGS+=(--speculative-eagle-topk "${SGLANG_SPECULATIVE_EAGLE_TOPK}")
    fi
fi

echo "-------------------------------------------------------------------"
echo "SGLang engine args: [${SERVER_ARGS[@]}]"
echo "-------------------------------------------------------------------"

exec python3 -m sglang.launch_server "${SERVER_ARGS[@]}"
