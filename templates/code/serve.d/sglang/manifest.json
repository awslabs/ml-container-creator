{
  "engine": "sglang",
  "env_var_prefix": "SGLANG_",
  "speculative_decoding": true,
  "supported_algorithms": ["eagle3", "eagle2", "eagle", "draft-model", "mtp"],
  "algorithm_map": {
    "eagle3": "EAGLE3",
    "eagle2": "EAGLE",
    "eagle": "EAGLE",
    "draft-model": "STANDALONE",
    "mtp": "MTP"
  },
  "hot_reload": true,
  "metrics_endpoint": {
    "path": "/metrics",
    "port": 8080,
    "format": "prometheus"
  },
  "metric_signals": {
    "kv_cache_util": { "type": "gauge", "name": "sglang:token_usage" },
    "queue_depth_running": { "type": "gauge", "name": "sglang:num_running_reqs" },
    "queue_depth_waiting": { "type": "gauge", "name": "sglang:num_queue_reqs" },
    "prefix_cache_hit_rate": { "type": "gauge", "name": "sglang:cache_hit_rate" }
  },
  "dimension_map": {
    "quantization": "QUANTIZATION",
    "tensor_parallel_degree": "TP_SIZE",
    "max_model_len": "CONTEXT_LENGTH",
    "kv_cache_dtype": "KV_CACHE_DTYPE"
  },
  "capability_map": {
    "model": { "suffix": "MODEL_PATH", "value_type": "valued" },
    "tensor_parallel_degree": { "suffix": "TP_SIZE", "value_type": "valued" },
    "quantization": { "suffix": "QUANTIZATION", "value_type": "valued" },
    "lora_enable": { "suffix": "ENABLE_LORA", "value_type": "boolean", "requires_any_of": [["lora_max_rank", "lora_target_modules"]] },
    "lora_max_rank": { "suffix": "MAX_LORA_RANK", "value_type": "valued", "default": 16 },
    "lora_target_modules": { "suffix": "LORA_TARGET_MODULES", "value_type": "valued", "default": "all" }
  },
  "min_version": "0.5.0",
  "engine_features": {
    "radix_attention": {
      "env_var": "SGLANG_ENABLE_RADIX_CACHE",
      "type": "boolean",
      "default": "false",
      "description": "RadixAttention: automatic KV-cache reuse across requests that share a prompt prefix, via a radix tree. Can reduce time-to-first-token on workloads with shared prefixes such as multi-turn chat, RAG, and agents."
    }
  }
}
