# ---------------------------------------------------------------------------
# SGLang Server Configuration
# ---------------------------------------------------------------------------
# Env prefix: SGLANG_ (sourced from serve.d/sglang/manifest.json env_var_prefix)
# Entrypoint: sglang serve  (the recommended SGLang >=0.5 CLI; replaces the
#             deprecated `python -m sglang.launch_server`, which emits a
#             UserWarning. min_version 0.5.0 in the manifest guarantees it.)
# Port: 8080 (SageMaker requirement)
# ---------------------------------------------------------------------------

<%# BL107: PREFIX is injected from serve.d/sglang/manifest.json (env_var_prefix)
    via the generation-time reader (src/lib/serve-manifest-reader.js), rather
    than a hardcoded literal. Defensive fallback to SGLANG_ keeps the rendered
    output byte-identical when the render context omits envVarPrefix. %>
PREFIX="<%= (typeof envVarPrefix !== 'undefined' && envVarPrefix) ? envVarPrefix : 'SGLANG_' %>"
ARG_PREFIX="--"
<%# _p mirrors PREFIX at generation time so the speculative env-var *names* below
    (e.g. SGLANG_SPECULATIVE_ALGORITHM) are emitted from the manifest-sourced
    prefix rather than a hardcoded literal, keeping the rendered names in lockstep
    with env_var_prefix. %>
<% const _p = (typeof envVarPrefix !== 'undefined' && envVarPrefix) ? envVarPrefix : 'SGLANG_'; %>

# ---------------------------------------------------------------------------
# Positive whitelist via --help introspection (same approach as vLLM).
#
# Only forward SGLANG_* env vars whose --<flag> the running server actually
# accepts. This is version-proof: it adapts to whatever SGLang version is in the
# image and silently drops env-only or unknown vars instead of crashing the
# server with an unrecognized-arg error. Note SGLang's flag names differ from
# vLLM (e.g. --tp-size, --context-length, --mem-fraction-static).
#
# Introspect the recommended `sglang serve --help` (>=0.5); fall back to the
# legacy `python -m sglang.launch_server --help` if that yields nothing, so the
# whitelist stays populated on any image. Same argparse → same --flag tokens.
# ---------------------------------------------------------------------------
VALID_ARGS_CACHE="/tmp/.sglang-valid-args"
if [ ! -s "${VALID_ARGS_CACHE}" ]; then
    sglang serve --help 2>/dev/null \
        | grep -oE '\-\-[a-z0-9][a-z0-9-]+' \
        | sort -u > "${VALID_ARGS_CACHE}" 2>/dev/null || true
    if [ ! -s "${VALID_ARGS_CACHE}" ]; then
        python3 -m sglang.launch_server --help 2>/dev/null \
            | grep -oE '\-\-[a-z0-9][a-z0-9-]+' \
            | sort -u > "${VALID_ARGS_CACHE}" 2>/dev/null || true
    fi
fi

# Fallback blocklist — used only if --help introspection produced nothing.
EXCLUDE_VARS=()

_have_whitelist=false
if [ -s "${VALID_ARGS_CACHE}" ]; then
    _have_whitelist=true
else
    echo "⚠️  Could not introspect sglang --help; falling back to exclude-list filtering" >&2
fi

# Declare and populate array of matching environment variables
mapfile -t env_vars < <(env | grep "^${PREFIX}")

# Convert SGLANG_ env vars to CLI arguments
for var in "${env_vars[@]}"; do
    IFS='=' read -r key value <<< "$var"

    # Remove prefix, convert to lowercase, replace underscores with dashes
    arg_name=$(echo "${key#"${PREFIX}"}" | tr '[:upper:]' '[:lower:]' | tr '_' '-')

    # Speculative decoding flags are assembled explicitly below so optional
    # values and the S3 draft-model validation follow one code path.
    #
    # <%= _p %>MODEL_PATH is also assembled explicitly (unconditionally) AFTER this
    # loop: --model-path is the one load-bearing flag the server cannot start
    # without, so it MUST NOT be gated behind the best-effort `--help` whitelist.
    # If introspection returns empty or omits --model-path (version drift, a cold
    # first run, or any transient exec failure — exactly the E2BIG cascade seen in
    # the field), the whitelist would silently drop it and the server would launch
    # with NO model. Skip it here so it is not double-added.
    case "${key}" in
        <%= _p %>MODEL_PATH|<%= _p %>SPECULATIVE_ALGORITHM|<%= _p %>SPECULATIVE_DRAFT_MODEL_PATH|<%= _p %>SPECULATIVE_NUM_STEPS|<%= _p %>SPECULATIVE_EAGLE_TOPK)
            continue
            ;;
    esac

    # Primary path: only forward args sglang actually accepts (from --help).
    if [ "$_have_whitelist" = true ]; then
        if ! grep -qx -- "${ARG_PREFIX}${arg_name}" "${VALID_ARGS_CACHE}"; then
            continue
        fi
    elif [ ${#EXCLUDE_VARS[@]} -gt 0 ]; then
        skip=false
        for exclude in "${EXCLUDE_VARS[@]}"; do
            if [ "$key" = "$exclude" ]; then skip=true; break; fi
        done
        if [ "$skip" = true ]; then continue; fi
    fi

    # Boolean handling: true = flag only, false = skip entirely
    if [ "$value" = "false" ]; then continue; fi

    SERVER_ARGS+=("${ARG_PREFIX}${arg_name}")
    if [ -n "$value" ] && [ "$value" != "true" ]; then
        SERVER_ARGS+=("$value")
    fi
done

# ---------------------------------------------------------------------------
# Model path (A) — assembled UNCONDITIONALLY, never gated by the --help
# whitelist. code/serve's resolve_model exported <%= _p %>MODEL_PATH to the
# resolved location (/opt/ml/model for s3/registry, or the HF id/local path).
# --model-path is the one flag SGLang cannot start without, so it bypasses the
# best-effort introspection that governs every optional knob above.
# ---------------------------------------------------------------------------
_sglang_model_path="${<%= _p %>MODEL_PATH:-}"

# Fail-loud guard (C) — the whitelist/introspection subshells deliberately
# swallow errors (`2>/dev/null || true`) to stay version-proof, which means a
# broken environment can otherwise produce a model-less `[--host --port]` arg
# list with NO warning (the field failure mode: server "up", serving nothing).
# Refuse to launch without a model path so the failure is obvious and early.
if [ -z "${_sglang_model_path}" ]; then
    echo "❌ FATAL: no model path resolved (<%= _p %>MODEL_PATH is empty). The model could not be located or downloaded; refusing to start SGLang with no model." >&2
    exit 1
fi
SERVER_ARGS+=(--model-path "${_sglang_model_path}")

# ---------------------------------------------------------------------------
# Speculative decoding (BL085) — SGLang discrete flags.
# The HyperPod CRD supplies engine-specific <%= _p %>SPECULATIVE_* values. The
# algorithm is already in SGLang's required uppercase enum form.
# ---------------------------------------------------------------------------
_speculative_draft_model="${<%= _p %>SPECULATIVE_DRAFT_MODEL_PATH:-${HP_SPECULATIVE_MODEL:-}}"
if [ -n "${_speculative_draft_model}" ] && [[ "${_speculative_draft_model}" == s3://* ]]; then
    echo "❌ HP_SPECULATIVE_MODEL must be a HuggingFace model ID or local path, not an s3:// URI. Stage it first with do/stage." >&2
    exit 1
fi
if [ -n "${<%= _p %>SPECULATIVE_ALGORITHM:-}" ]; then
    SERVER_ARGS+=(--speculative-algorithm "${<%= _p %>SPECULATIVE_ALGORITHM}")
    if [ -n "${<%= _p %>SPECULATIVE_DRAFT_MODEL_PATH:-}" ]; then
        SERVER_ARGS+=(--speculative-draft-model-path "${<%= _p %>SPECULATIVE_DRAFT_MODEL_PATH}")
    fi
    if [ -n "${<%= _p %>SPECULATIVE_NUM_STEPS:-}" ]; then
        SERVER_ARGS+=(--speculative-num-steps "${<%= _p %>SPECULATIVE_NUM_STEPS}")
    fi
    if [ -n "${<%= _p %>SPECULATIVE_EAGLE_TOPK:-}" ]; then
        SERVER_ARGS+=(--speculative-eagle-topk "${<%= _p %>SPECULATIVE_EAGLE_TOPK}")
    fi
fi

echo "-------------------------------------------------------------------"
echo "SGLang engine args: [${SERVER_ARGS[@]}]"
echo "-------------------------------------------------------------------"

exec sglang serve "${SERVER_ARGS[@]}"
