# ---------------------------------------------------------------------------
# vLLM Server Configuration
# ---------------------------------------------------------------------------
# Env prefix: VLLM_ (sourced from serve.d/vllm/manifest.json env_var_prefix)
# Entrypoint: python3 -m vllm.entrypoints.openai.api_server
# Port: 8080 (SageMaker requirement)
# ---------------------------------------------------------------------------

<%# ADR-004: PREFIX is injected from serve.d/vllm/manifest.json (env_var_prefix)
    via the generation-time reader (src/lib/serve-manifest-reader.js), rather
    than a hardcoded literal — matching sglang.ejs. Defensive fallback to VLLM_
    keeps the rendered output byte-identical when the render context omits
    envVarPrefix. %>
PREFIX="<%= (typeof envVarPrefix !== 'undefined' && envVarPrefix) ? envVarPrefix : 'VLLM_' %>"
ARG_PREFIX="--"
<%# _p mirrors PREFIX at generation time so the speculative env-var *names* below
    (e.g. VLLM_SPECULATIVE_ALGORITHM) are emitted from the manifest-sourced prefix
    rather than a hardcoded literal, keeping the rendered names in lockstep with
    env_var_prefix. %>
<% const _p = (typeof envVarPrefix !== 'undefined' && envVarPrefix) ? envVarPrefix : 'VLLM_'; %>

# ---------------------------------------------------------------------------
# Positive whitelist via --help introspection.
#
# vLLM v0.21+ bakes build-provenance env vars into the Docker image
# (VLLM_BUILD_URL, VLLM_IMAGE_TAG, VLLM_BUILD_PIPELINE, VLLM_BUILD_COMMIT, and
# 30+ others) that have NO CLI equivalent. Blindly forwarding every VLLM_* env
# var as --<name> makes api_server.py reject unknown args and the server never
# starts. Rather than chase a blocklist that breaks every release, we ask the
# server which args it actually accepts (--help) and forward only those.
# ---------------------------------------------------------------------------
VALID_ARGS_CACHE="/tmp/.vllm-valid-args"
if [ ! -s "${VALID_ARGS_CACHE}" ]; then
    python3 -m vllm.entrypoints.openai.api_server --help 2>/dev/null \
        | grep -oE '\-\-[a-z0-9][a-z0-9-]+' \
        | sort -u > "${VALID_ARGS_CACHE}" 2>/dev/null || true
fi

# Fallback blocklist — used only if --help introspection produced nothing
# (e.g. import error). Keeps the previous behavior for known env-only vars.
EXCLUDE_VARS=("VLLM_USAGE_SOURCE" "VLLM_ENABLE_CUDA_COMPATIBILITY" "VLLM_ALLOW_RUNTIME_LORA_UPDATING" \
              "VLLM_BUILD_URL" "VLLM_IMAGE_TAG" "VLLM_BUILD_PIPELINE" "VLLM_BUILD_COMMIT")

_have_whitelist=false
if [ -s "${VALID_ARGS_CACHE}" ]; then
    _have_whitelist=true
else
    echo "⚠️  Could not introspect vLLM --help; falling back to exclude-list filtering" >&2
fi

# Declare and populate array of matching environment variables
mapfile -t env_vars < <(env | grep "^${PREFIX}")

# Convert VLLM_ env vars to CLI arguments
for var in "${env_vars[@]}"; do
    IFS='=' read -r key value <<< "$var"

    # Remove prefix, convert to lowercase, replace underscores with dashes
    arg_name=$(echo "${key#"${PREFIX}"}" | tr '[:upper:]' '[:lower:]' | tr '_' '-')

    # Speculative decoding has a consolidated JSON API and is assembled below.
    # Never forward its component environment variables as individual flags.
    case "${key}" in
        <%= _p %>SPECULATIVE_ALGORITHM|<%= _p %>SPECULATIVE_MODEL|<%= _p %>SPECULATIVE_NUM_TOKENS|<%= _p %>SPECULATIVE_DRAFT_SAMPLE_METHOD|<%= _p %>SPECULATIVE_REJECTION_SAMPLE_METHOD)
            continue
            ;;
    esac

    # Primary path: only forward args vLLM actually accepts (from --help).
    if [ "$_have_whitelist" = true ]; then
        if ! grep -qx -- "${ARG_PREFIX}${arg_name}" "${VALID_ARGS_CACHE}"; then
            continue
        fi
    else
    # Skip excluded variables
    skip=false
    for exclude in "${EXCLUDE_VARS[@]}"; do
        if [ "$key" = "$exclude" ]; then
            skip=true
            break
        fi
    done
    if [ "$skip" = true ]; then continue; fi
    fi

    # Boolean handling: true = flag only, false = skip entirely
    if [ "$value" = "false" ]; then continue; fi

    SERVER_ARGS+=("${ARG_PREFIX}${arg_name}")
    if [ -n "$value" ] && [ "$value" != "true" ]; then
        SERVER_ARGS+=("$value")
    fi
done

# ---------------------------------------------------------------------------
# Speculative decoding (BL085) — vLLM consolidated `--speculative-config` JSON API.
# The HyperPod CRD supplies engine-specific VLLM_SPECULATIVE_* values. Build the
# JSON here so the CRD remains engine-neutral and never needs serve arguments.
# ---------------------------------------------------------------------------
_speculative_draft_model="${<%= _p %>SPECULATIVE_MODEL:-${HP_SPECULATIVE_MODEL:-}}"
if [ -n "${_speculative_draft_model}" ] && [[ "${_speculative_draft_model}" == s3://* ]]; then
    echo "❌ HP_SPECULATIVE_MODEL must be a HuggingFace model ID or local path, not an s3:// URI. Stage it first with do/stage." >&2
    exit 1
fi
if [ -n "${<%= _p %>SPECULATIVE_ALGORITHM:-}" ]; then
    SPECULATIVE_CONFIG=$(python3 -c '
import json
import sys

config = {
    "method": sys.argv[1],
    "num_speculative_tokens": int(sys.argv[3]),
}
if sys.argv[2]:
    config["model"] = sys.argv[2]
# DSpark (Kimi-K3) additionally requires draft/rejection sample methods. These
# are optional env vars — only emitted when non-empty so existing eagle/ngram/mtp
# configs stay byte-identical.
if len(sys.argv) > 4 and sys.argv[4]:
    config["draft_sample_method"] = sys.argv[4]
if len(sys.argv) > 5 and sys.argv[5]:
    config["rejection_sample_method"] = sys.argv[5]
print(json.dumps(config, separators=(",", ":")))
' "${<%= _p %>SPECULATIVE_ALGORITHM}" "${<%= _p %>SPECULATIVE_MODEL:-}" "${<%= _p %>SPECULATIVE_NUM_TOKENS:-5}" "${<%= _p %>SPECULATIVE_DRAFT_SAMPLE_METHOD:-}" "${<%= _p %>SPECULATIVE_REJECTION_SAMPLE_METHOD:-}") || {
        echo "❌ <%= _p %>SPECULATIVE_NUM_TOKENS must be an integer." >&2
        exit 1
    }
    SERVER_ARGS+=(--speculative-config "${SPECULATIVE_CONFIG}")
fi

echo "-------------------------------------------------------------------"
echo "vLLM engine args: [${SERVER_ARGS[@]}]"
echo "-------------------------------------------------------------------"

exec python3 -m vllm.entrypoints.openai.api_server "${SERVER_ARGS[@]}"
