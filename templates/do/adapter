#
# do/adapter — Manage LoRA adapters on a deployed endpoint or cluster.
#
# @mlcc-script
# type: deployment-centric
# guard: deployment-active
# lifecycle: post-deploy
# targets: realtime-inference, hyperpod-eks, eks

# Usage (identical on every target — ADR-013: the SOURCE resolves uniformly,
# the TARGET only selects the load mechanism):
#   ./do/adapter add <name> --from-weights <s3-uri>
#   ./do/adapter add <name> --from-tune [technique]
#   ./do/adapter add <name> --from-train [technique]
#   ./do/adapter add <name> --from-registry <version-arn>
#   ./do/adapter add <name> --from-hub <hf-repo-id>
#   ./do/adapter list
#   ./do/adapter remove <name>
#   ./do/adapter update <name> --from-weights <new-s3-uri>
#   ./do/adapter promote <name> --from-tune <technique> | --from-weights <s3-uri> [--update-config]
#   ./do/adapter --help
#
# Deprecated alias: --weights <s3-uri> == --from-weights <s3-uri> (prints a notice).

set -e
set -u
set -o pipefail

# ── Source project configuration ──────────────────────────────────────────────
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${SCRIPT_DIR}/lib/script-contract.sh"
_require_python_env
source "${SCRIPT_DIR}/config"
source "${SCRIPT_DIR}/lib/profile.sh"
source "${SCRIPT_DIR}/lib/s3-layout.sh"

# ── Target guard: DERIVED from the additive-deploy contract (ADR-013) ─────────
# do/adapter accepts lora_adapter artifacts and drives the vLLM hot-load (k8s:
# hyperpod-eks / eks) or SMAI adapter-IC (realtime-inference) mechanism. Which
# targets are legal is the intersection of those mechanisms with what each
# target exposes (_ADDITIVE_* tables in script-contract.sh) — not a hand list.
# An unsupported target (async / batch) gets the standard contract violation
# (exit 3) naming the targets that DO work.
_additive_verb_supported_on adapter "${DEPLOYMENT_TARGET:-}"
_ADAPTER_MECHANISMS="$(_additive_mechanism_for adapter "${DEPLOYMENT_TARGET:-}")"

# ── Profile-resolved variables (env var > profile > default) ──────────────────
# ADAPTER_S3_BUCKET is provided by profile.sh from moduleOutputs.training.AdaptersBucket.
# No invented fallback — a missing value means the training module isn't provisioned (guarded below).
ADAPTER_S3_BUCKET="${ADAPTER_S3_BUCKET:-}"

# ── Shared source helpers (both the SMAI and the Kubernetes paths) ────────────
# Defined BEFORE the Kubernetes branch so _resolve_additive_source --from-hub can
# reuse _download_from_hub on every target.

# ── Best-effort adapter_config.json validation ────────────────────────────────
# Downloads the adapter tar.gz, extracts adapter_config.json, and checks that
# base_model_name_or_path matches MODEL_NAME from do/config.
# Returns 0 always — failures are silently ignored (best-effort).
# INTENTIONALLY non-fatal (BL165 sweep reviewed, R9.1): this is an advisory
# base-model mismatch WARNING, not a gate — the real load (IC create / vLLM
# hot-load) surfaces any genuine artifact problem with its own error.
_validate_adapter_config() {
    local weights_uri="$1"
    local tmp_dir="/tmp/adapter_config_check_$$"

    (
        # Run in subshell so any failure is contained
        set +e

        # Skip if MODEL_NAME is not configured (non-transformers projects)
        if [ -z "${MODEL_NAME:-}" ]; then
            exit 0
        fi

        mkdir -p "${tmp_dir}"

        # Download the tar.gz
        if ! aws s3 cp "${weights_uri}" "${tmp_dir}/adapter.tar.gz" --region "${AWS_REGION}" --quiet 2>/dev/null; then
            exit 0
        fi

        # Extract just adapter_config.json
        if ! tar -xzf "${tmp_dir}/adapter.tar.gz" -C "${tmp_dir}" adapter_config.json 2>/dev/null; then
            exit 0
        fi

        # Read base_model_name_or_path from the JSON
        local adapter_base_model=""
        if command -v jq &>/dev/null; then
            adapter_base_model=$(jq -r '.base_model_name_or_path // empty' "${tmp_dir}/adapter_config.json" 2>/dev/null)
        else
            # Fallback: use grep/sed for environments without jq
            adapter_base_model=$(grep -o '"base_model_name_or_path"[[:space:]]*:[[:space:]]*"[^"]*"' "${tmp_dir}/adapter_config.json" 2>/dev/null | sed 's/.*"base_model_name_or_path"[[:space:]]*:[[:space:]]*"//' | sed 's/"$//')
        fi

        # Compare with MODEL_NAME
        if [ -n "${adapter_base_model}" ] && [ "${adapter_base_model}" != "${MODEL_NAME}" ]; then
            echo "⚠️  Adapter was trained on '${adapter_base_model}' but base model is '${MODEL_NAME}'. Adapter may not work correctly."
        fi
    ) 2>/dev/null

    # Clean up temp files
    rm -rf "${tmp_dir}" 2>/dev/null

    return 0
}

# ── Download adapter from HuggingFace Hub ─────────────────────────────────────
# Downloads adapter files from a HuggingFace Hub repository, validates
# adapter_config.json exists, creates a tar.gz, and uploads to S3.
# Sets the variable `weights_uri` to the resulting S3 path.
#
# Arguments:
#   $1 - HuggingFace repo ID (e.g., "org/adapter-name" or "adapter-name")
#   $2 - Adapter name (for S3 path construction)
#
# Returns 0 on success, exits on failure.
_download_from_hub() {
    local hf_repo_id="$1"
    local adapter_name="$2"
    local tmp_dir="/tmp/adapter_hub_download_$$"

    echo "📥 Downloading adapter from HuggingFace Hub: ${hf_repo_id}"
    echo ""

    # ── Resolve the canonical destination (bucket consolidation R3.4) ──────
    # A Hub adapter is published straight into its canonical home in the core
    # bucket (s3_layout.py: <base prefix>/.mlcc-adapters/<project>/<name>/, base =
    # this project's MODEL_NAME), as the content-addressed version v<hash12>/ the
    # layout module picks (BL199). The legacy adapters bucket is frozen for writes.
    _require_bucket CORE_S3_BUCKET || exit 1
    local _hub_dest_json _hub_dest
    _hub_dest_json=$(python3 "${SCRIPT_DIR}/lib/python/s3_layout.py" adapter-uri --bucket "${CORE_S3_BUCKET}" \
        --model "${MODEL_NAME:-}" --project "${PROJECT_NAME}" --name "${adapter_name}") || exit 1
    _hub_dest=$(_adapter_json_get "${_hub_dest_json}" uri)

    # ── Create temp directory ─────────────────────────────────────────────
    mkdir -p "${tmp_dir}/adapter_files"

    # ── Download adapter files ────────────────────────────────────────────
    if command -v hf &>/dev/null; then
        echo "   Using hf CLI to download..."
        local hf_args=("download" "${hf_repo_id}" "--local-dir" "${tmp_dir}/adapter_files")
        if [ -n "${HF_TOKEN:-}" ]; then
            hf_args+=("--token" "${HF_TOKEN}")
        fi
        local _hf_err
        if ! _hf_err=$(hf "${hf_args[@]}" 2>&1 >/dev/null); then
            echo "❌ Failed to download adapter from HuggingFace Hub: ${hf_repo_id}"
            [ -n "${_hf_err}" ] && echo "${_hf_err}" | tail -5 | sed 's/^/   hf: /'
            echo ""
            echo "   Check that:"
            echo "   • The repository exists: https://huggingface.co/${hf_repo_id}"
            echo "   • For gated repos, set HF_TOKEN environment variable"
            echo "   • You have network connectivity to huggingface.co"
            rm -rf "${tmp_dir}"
            exit 1
        fi
    elif command -v huggingface-cli &>/dev/null; then
        echo "   Using huggingface-cli to download..."
        local hf_args=("download" "${hf_repo_id}" "--local-dir" "${tmp_dir}/adapter_files")
        if [ -n "${HF_TOKEN:-}" ]; then
            hf_args+=("--token" "${HF_TOKEN}")
        fi
        local _hf_err
        if ! _hf_err=$(huggingface-cli "${hf_args[@]}" 2>&1 >/dev/null); then
            echo "❌ Failed to download adapter from HuggingFace Hub: ${hf_repo_id}"
            [ -n "${_hf_err}" ] && echo "${_hf_err}" | tail -5 | sed 's/^/   huggingface-cli: /'
            echo ""
            echo "   Check that:"
            echo "   • The repository exists: https://huggingface.co/${hf_repo_id}"
            echo "   • For gated repos, set HF_TOKEN environment variable"
            echo "   • You have network connectivity to huggingface.co"
            rm -rf "${tmp_dir}"
            exit 1
        fi
    else
        # Fallback: use curl with HF Hub API
        echo "   Using curl to download (huggingface-cli not found)..."

        # Get file listing from the repo
        local api_url="https://huggingface.co/api/models/${hf_repo_id}"
        local auth_header=""
        if [ -n "${HF_TOKEN:-}" ]; then
            auth_header="Authorization: Bearer ${HF_TOKEN}"
        fi

        local repo_info
        if [ -n "${auth_header}" ]; then
            repo_info=$(curl -sS -H "${auth_header}" "${api_url}" 2>/dev/null)
        else
            repo_info=$(curl -sS "${api_url}" 2>/dev/null)
        fi

        if [ -z "${repo_info}" ] || echo "${repo_info}" | grep -q '"error"'; then
            echo "❌ Failed to access HuggingFace Hub repository: ${hf_repo_id}"
            echo ""
            echo "   Check that:"
            echo "   • The repository exists: https://huggingface.co/${hf_repo_id}"
            echo "   • For gated repos, set HF_TOKEN environment variable"
            echo "   • You have network connectivity to huggingface.co"
            rm -rf "${tmp_dir}"
            exit 1
        fi

        # Extract file list from siblings array
        local files
        if command -v jq &>/dev/null; then
            files=$(echo "${repo_info}" | jq -r '.siblings[]?.rfilename // empty' 2>/dev/null)
        else
            files=$(echo "${repo_info}" | grep -o '"rfilename":"[^"]*"' | sed 's/"rfilename":"//;s/"$//')
        fi

        if [ -z "${files}" ]; then
            echo "❌ No files found in repository: ${hf_repo_id}"
            rm -rf "${tmp_dir}"
            exit 1
        fi

        # Download each file (only root-level files, skip subdirectories)
        local download_base="https://huggingface.co/${hf_repo_id}/resolve/main"
        while IFS= read -r filename; do
            # Skip files in subdirectories (we only want root-level adapter files)
            if echo "${filename}" | grep -q '/'; then
                continue
            fi
            # Skip hidden files and READMEs
            case "${filename}" in
                .gitattributes|.gitignore|README.md|LICENSE*) continue ;;
            esac

            echo "   Downloading: ${filename}"
            local curl_args=("-sS" "-L" "-o" "${tmp_dir}/adapter_files/${filename}")
            if [ -n "${auth_header}" ]; then
                curl_args+=("-H" "${auth_header}")
            fi
            if ! curl "${curl_args[@]}" "${download_base}/${filename}" 2>/dev/null; then
                echo "   ⚠️  Failed to download: ${filename} (skipping)"
            fi
        done <<< "${files}"
    fi

    # ── Remove .huggingface metadata if present ───────────────────────────
    rm -rf "${tmp_dir}/adapter_files/.cache" "${tmp_dir}/adapter_files/.huggingface" 2>/dev/null
    # Remove hidden files that huggingface-cli may create
    find "${tmp_dir}/adapter_files" -name ".*" -delete 2>/dev/null || true
    # Remove subdirectories (flatten to root-level files only)
    find "${tmp_dir}/adapter_files" -mindepth 2 -type f -exec mv {} "${tmp_dir}/adapter_files/" \; 2>/dev/null || true
    find "${tmp_dir}/adapter_files" -mindepth 1 -type d -exec rm -rf {} + 2>/dev/null || true

    # ── Validate adapter_config.json exists ───────────────────────────────
    if [ ! -f "${tmp_dir}/adapter_files/adapter_config.json" ]; then
        echo "❌ adapter_config.json not found in downloaded files."
        echo ""
        echo "   The repository '${hf_repo_id}' does not appear to contain"
        echo "   a valid PEFT/LoRA adapter. A valid adapter must include:"
        echo "   • adapter_config.json"
        echo "   • adapter_model.safetensors (or adapter_model.bin)"
        echo ""
        echo "   Verify the repository at: https://huggingface.co/${hf_repo_id}"
        rm -rf "${tmp_dir}"
        exit 1
    fi

    echo "✅ adapter_config.json found"

    # ── Optional: check base_model_name_or_path matches MODEL_NAME ────────
    if [ -n "${MODEL_NAME:-}" ]; then
        local adapter_base_model=""
        if command -v jq &>/dev/null; then
            adapter_base_model=$(jq -r '.base_model_name_or_path // empty' "${tmp_dir}/adapter_files/adapter_config.json" 2>/dev/null)
        else
            adapter_base_model=$(grep -o '"base_model_name_or_path"[[:space:]]*:[[:space:]]*"[^"]*"' "${tmp_dir}/adapter_files/adapter_config.json" 2>/dev/null | sed 's/.*"base_model_name_or_path"[[:space:]]*:[[:space:]]*"//' | sed 's/"$//')
        fi

        if [ -n "${adapter_base_model}" ] && [ "${adapter_base_model}" != "${MODEL_NAME}" ]; then
            echo "⚠️  Adapter was trained on '${adapter_base_model}' but base model is '${MODEL_NAME}'. Adapter may not work correctly."
        fi
    fi

    # ── Publish the adapter files (flat PEFT layout + mlcc-adapter.json) ──
    # Loose files, not a tarball: the same prefix serves the SMAI adapter IC
    # (ArtifactUrl = prefix) and the k8s mount (load by path). Content-addressed
    # (BL199): the same files are the same version ("unchanged"); new files are a
    # new <home>/v<hash12>/ and older versions are left untouched.
    local s3_path=""
    echo "☁️  Publishing under the canonical adapter home: ${_hub_dest}"
    local _pub_out
    if ! _pub_out=$(python3 "${SCRIPT_DIR}/lib/python/s3_layout.py" publish-local \
        --dir "${tmp_dir}/adapter_files" --dest "${_hub_dest}" --kind lora_adapter \
        --project "${PROJECT_NAME}" --name "${adapter_name}" --base-model "${MODEL_NAME:-}" \
        --source "hf://${hf_repo_id}" --created-by "do/adapter from-hub" --region "${AWS_REGION}"); then
        echo "❌ Failed to publish adapter to S3."
        echo ""
        echo "   Check that:"
        echo "   • The core bucket '${CORE_S3_BUCKET}' exists (ml-container-creator bootstrap update --module core)"
        echo "   • Your IAM credentials have s3:PutObject permission"
        rm -rf "${tmp_dir}"
        exit 1
    fi

    s3_path=$(_adapter_json_get "${_pub_out}" dest)
    echo "✅ Published ($(_adapter_json_get "${_pub_out}" action)): ${s3_path}"

    # ── Clean up ──────────────────────────────────────────────────────────
    rm -rf "${tmp_dir}"

    # Set the weights_uri variable for the caller
    weights_uri="${s3_path}"
}

# ── Small JSON field reader for helper output (lists are comma-joined) ────────
_adapter_json_get() {
    printf '%s' "$1" | python3 -c '
import json, sys
try:
    d = json.loads(sys.stdin.read() or "{}")
except ValueError:
    d = {}
v = d.get(sys.argv[1], "") if isinstance(d, dict) else ""
if isinstance(v, list):
    v = ",".join(str(x) for x in v)
print("" if v is None else v)
' "$2"
}

# ── Write or update a variable in do/config (same contract as do/tune) ────────
_adapter_update_config_var() {
    local var_name="$1" var_value="$2" config_file="${SCRIPT_DIR}/config"
    if grep -q "^export ${var_name}=" "${config_file}" 2>/dev/null; then
        sed -i.bak "s|^export ${var_name}=.*|export ${var_name}=\"${var_value}\"|" "${config_file}"
        rm -f "${config_file}.bak"
    else
        if [ -s "${config_file}" ] && [ -n "$(tail -c 1 "${config_file}")" ]; then
            echo "" >> "${config_file}"
        fi
        echo "export ${var_name}=\"${var_value}\"" >> "${config_file}"
    fi
}

# ── Promote a source into its canonical home (bucket consolidation R3) ────────
# _adapter_promote_canonical <src-uri> <name> <base-model-id> <kind> [technique] [created-by]
# Prints the canonical URI on stdout (progress on stderr). An already-canonical
# source (a version directory, or an unversioned pre-BL199 home / hand copy) is
# returned as-is. kind: lora_adapter → the content-addressed version
# <base prefix>/.mlcc-adapters/<project>/<name>/v<hash12>/ (BL199: identical
# content → the same version, "unchanged"; new content → a new directory, older
# versions untouched); full_model → models/mlcc-<project>/<name>/ (s3_layout.py).
_ADAPTER_PROMOTE_DRY_RUN=""
_adapter_promote_canonical() {
    local _src="$1" _name="$2" _base="$3" _kind="${4:-lora_adapter}" _tech="${5:-}" _by="${6:-do/adapter}"
    local _layout="${SCRIPT_DIR}/lib/python/s3_layout.py" _parsed _dest_json _dest _out
    _parsed=$(python3 "${_layout}" parse --uri "${_src}" 2>/dev/null || echo '{}')
    if [ -n "$(_adapter_json_get "${_parsed}" adapter)" ] || [ -n "$(_adapter_json_get "${_parsed}" finetune)" ]; then
        # Already canonical: used as-is, but normalized to ONE trailing slash (the
        # SMAI IC ArtifactUrl is this prefix; "…/sft" would also match "…/sft-w6/").
        printf '%s\n' "$(_adapter_json_get "${_parsed}" canonical_uri)"
        return 0
    fi
    _require_bucket CORE_S3_BUCKET || return 1
    if [ "${_kind}" = "full_model" ]; then
        _dest_json=$(python3 "${_layout}" finetune-uri --bucket "${CORE_S3_BUCKET}" \
            --project "${PROJECT_NAME}" --name "${_name}") || return 1
    else
        _dest_json=$(python3 "${_layout}" adapter-uri --bucket "${CORE_S3_BUCKET}" --model "${_base}" \
            --project "${PROJECT_NAME}" --name "${_name}") || return 1
    fi
    _dest=$(_adapter_json_get "${_dest_json}" uri)
    if [ -n "${_ADAPTER_PROMOTE_DRY_RUN}" ]; then
        # Read-only plan (s3_layout.py promote-plan): the version directory it would
        # create or reuse, every key it would copy, the stale keys it would delete
        # and the manifest it would write — no S3 write.
        local _plan
        _plan=$(python3 "${_layout}" promote-plan --source "${_src}" --dest "${_dest}" --kind "${_kind}" \
            --region "${AWS_REGION:-}") || return 1
        printf '%s' "${_plan}" | python3 -c '
import json, sys
p = json.load(sys.stdin)
print("🔎 Promotion plan (read-only): " + p["source"] + " -> " + p["dest"])
print("   action: " + p["action"] + ("  (" + p["refused"] + ")" if p["refused"] else ""))
if p.get("version"):
    print("   version: " + p["version"] + ("  (already published: same content)" if p["action"] == "unchanged"
          else "  (new content-addressed directory; existing versions are not touched)"))
print("   source content hash: " + str(p["content_hash"]) + "   dest manifest hash: " + str(p["dest_content_hash"]))
for c in p["copies"]:
    print("   copy   " + c["from"] + "  ->  " + c["to"])
for k in p["stale_deletes"]:
    print("   delete " + k + "  (stale file of this adapter)")
if p["manifest"]:
    print("   write  " + p["manifest"] + "  (last)")
sys.exit(3 if p["action"] == "refused" else 0)
' >&2 || return 1
        printf '%s\n' "$(_adapter_json_get "${_plan}" dest)"
        return 0
    fi
    echo "📤 Promoting ${_src} → ${_dest}" >&2
    if ! _out=$(python3 "${_layout}" promote --source "${_src}" --dest "${_dest}" --kind "${_kind}" \
        --project "${PROJECT_NAME}" --name "${_name}" --base-model "${_base}" \
        --technique "${_tech}" --created-by "${_by}" --region "${AWS_REGION:-}"); then
        echo "❌ Promotion into ${_dest} failed (see the error above)." >&2
        return 1
    fi
    # The promoted location: for an adapter, the content-addressed version directory.
    _dest=$(_adapter_json_get "${_out}" dest)
    echo "   ✅ Promotion $(_adapter_json_get "${_out}" action): ${_dest}" >&2
    printf '%s\n' "${_dest}"
}

# ── do/adapter promote (bucket consolidation R3.7) — every target ─────────────
# Backfill an already-finished job's output (or any S3 adapter) into the
# canonical prefix. Rewrites the do/config path var ONLY with --update-config
# (the old value is kept as TUNE_ADAPTER_SOURCE_<T> / TUNE_MODEL_SOURCE_<T>).
_adapter_promote_cmd() {
    shift  # 'promote'
    local _name="${1:-}"
    if [ -z "${_name}" ] || [[ "${_name}" == -* ]]; then
        echo "❌ 'do/adapter promote' requires a name argument"
        echo "   Usage: ./do/adapter promote <name> --from-tune <technique> | --from-weights <s3-uri> [--update-config] [--dry-run]"
        exit 1
    fi
    shift
    local _verb="" _arg="" _update=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --from-tune) _verb="from-tune"; _arg="${2:-}"; shift; shift || true ;;
            --from-weights) _verb="from-weights"; _arg="${2:-}"; shift; shift || true ;;
            --update-config) _update="true"; shift ;;
            --dry-run) _ADAPTER_PROMOTE_DRY_RUN="true"; shift ;;
            --help|-h)
                echo "Usage: ./do/adapter promote <name> --from-tune <technique> | --from-weights <s3-uri> [--update-config] [--dry-run]"
                exit 0
                ;;
            *) echo "❌ Unknown option: $1"; exit 1 ;;
        esac
    done
    if [ -z "${_verb}" ] || [ -z "${_arg}" ]; then
        echo "❌ promote needs --from-tune <technique> or --from-weights <s3-uri>"
        exit 1
    fi
    if ! echo "${_name}" | grep -qE '^[a-z0-9][a-z0-9-]{0,49}$'; then
        echo "❌ Invalid adapter name: ${_name} (lowercase alphanumeric + hyphens, 1-50 chars)"
        exit 1
    fi
    local _resolved RESOLVED_SOURCE="" RESOLVED_URI="" RESOLVED_KIND="" RESOLVED_META_TECHNIQUE=""
    _resolved=$(_resolve_additive_source "${_verb}" "${_arg}" "${_name}" "lora_adapter") || exit 1
    eval "${_resolved}"
    local _kind="${RESOLVED_KIND:-lora_adapter}" _base="${MODEL_NAME:-}"
    [ "${_verb}" = "from-tune" ] && [ -n "${TUNE_MODEL_ID:-}" ] && _base="${TUNE_MODEL_ID}"
    local _canonical
    _canonical=$(_adapter_promote_canonical "${RESOLVED_URI}" "${_name}" "${_base}" "${_kind}" \
        "${RESOLVED_META_TECHNIQUE:-}" "do/adapter promote") || exit 1
    if [ -n "${_ADAPTER_PROMOTE_DRY_RUN}" ]; then
        echo "🔎 Dry run: nothing was written (do/config unchanged). Destination: ${_canonical}"
        exit 0
    fi
    echo "✅ Canonical: ${_canonical}"
    if [ "${_verb}" = "from-tune" ]; then
        local _tu _pvar _svar
        _tu="$(_additive_upper "${_arg}")"
        if [ "${_kind}" = "full_model" ]; then
            _pvar="TUNE_MODEL_PATH_${_tu}"; _svar="TUNE_MODEL_SOURCE_${_tu}"
        else
            _pvar="TUNE_ADAPTER_PATH_${_tu}"; _svar="TUNE_ADAPTER_SOURCE_${_tu}"
        fi
        if [ -n "${_update}" ]; then
            if [ "${!_pvar:-}" != "${_canonical}" ]; then
                _adapter_update_config_var "${_svar}" "${!_pvar:-${RESOLVED_URI}}"
                _adapter_update_config_var "${_pvar}" "${_canonical}"
                echo "📝 do/config: ${_pvar} → canonical (previous value kept in ${_svar})"
            fi
        else
            echo "   do/config unchanged (pass --update-config to point ${_pvar} at the canonical prefix)."
        fi
    fi
    echo "   Next: ./do/adapter add ${_name} --from-weights ${_canonical}"
}
if [ "${1:-}" = "promote" ]; then
    _adapter_promote_cmd "$@"
    exit $?
fi


# ── Kubernetes path (vllm-hotload mechanism: hyperpod-eks + plain eks) ────────
# Both targets serve vLLM as k8s pods labelled app=${PROJECT_NAME} and support
# the same vLLM LoRA hot-load over a direct-pod port-forward. hyperpod-eks runs
# behind the HyperPod Inference Operator; eks (untested/unvalidated) runs the same
# vLLM without the operator — the hot-load mechanism is identical. The branch is
# selected by the contract-derived mechanism, not by naming targets.
case " ${_ADAPTER_MECHANISMS} " in
    *" vllm-hotload "*) _ADAPTER_USE_VLLM_HOTLOAD="true" ;;
    *) _ADAPTER_USE_VLLM_HOTLOAD="" ;;
esac
if [ -n "${_ADAPTER_USE_VLLM_HOTLOAD}" ]; then
    _adapter_hyperpod() {
        # Guard: HP_LORA_ENABLED must be true
        if [ "${HP_LORA_ENABLED:-false}" != "true" ]; then
            echo "❌ LoRA is not enabled for this ${DEPLOYMENT_TARGET} deployment."
            echo "   Set HP_LORA_ENABLED=true in do/config and redeploy: do/deploy --target ${DEPLOYMENT_TARGET}"
            exit 1
        fi

        # Parse subcommand
        local CMD="${1:-}"
        shift || true

        # ── Legacy-flag deprecation shims (BL112) ────────────────────────────
        # --load-lora / --unload-lora remain accepted for backward compatibility.
        # Each emits a deprecation warning and rewrites the invocation into the
        # unified verb before the router runs, so the downstream port-forward and
        # dispatch are shared with the unified path.
        case "${CMD}" in
            --load-lora)
                echo "⚠️  --load-lora is deprecated; use: do/adapter add <name> --from-weights s3://..." >&2
                CMD="add"
                ;;
            --unload-lora)
                echo "⚠️  --unload-lora is deprecated; use: do/adapter remove <name>" >&2
                CMD="remove"
                ;;
        esac

        # Parse unified verbs into an internal (ACTION, LORA_NAME, WEIGHTS_URI) triple.
        # ACTION ∈ load / unload / list / update. add/update take the SAME --from-*
        # source flags as the SMAI path (BL169 / ADR-013): every source resolves
        # through the shared _resolve_additive_source, independent of the target.
        local LORA_NAME=""
        local WEIGHTS_URI=""
        local ACTION=""
        local _SRC_VERB=""
        local _SRC_ARG=""
        local _SRC_COUNT=0

        case "${CMD}" in
            add|update)
                # add    → load
                # update → unload-then-load (remove-then-add)
                if [ "${CMD}" = "add" ]; then
                    ACTION="load"
                else
                    ACTION="update"
                fi
                LORA_NAME="${1:-}"
                shift || true
                if [ -z "${LORA_NAME}" ] || [[ "${LORA_NAME}" == -* ]]; then
                    echo "❌ 'do/adapter ${CMD}' requires a name argument"
                    echo "   Usage: do/adapter ${CMD} <name> --from-weights s3://... | --from-tune [technique] | --from-registry <arn>"
                    exit 1
                fi
                # Parse the --from-* source family (+ the deprecated --weights alias).
                while [ $# -gt 0 ]; do
                    case "$1" in
                        --from-weights|--weights)
                            [ "$1" = "--weights" ] && _deprecated_flag_alias --weights --from-weights
                            _SRC_VERB="from-weights"
                            _SRC_ARG="${2:-}"
                            _SRC_COUNT=$((_SRC_COUNT + 1))
                            shift
                            shift || true
                            ;;
                        --from-hub)
                            _SRC_VERB="from-hub"
                            _SRC_ARG="${2:-}"
                            _SRC_COUNT=$((_SRC_COUNT + 1))
                            shift
                            shift || true
                            ;;
                        --from-registry)
                            _SRC_VERB="from-registry"
                            _SRC_ARG="${2:-}"
                            _SRC_COUNT=$((_SRC_COUNT + 1))
                            shift
                            shift || true
                            ;;
                        --from-tune|--from-train)
                            _SRC_VERB="${1#--}"
                            _SRC_ARG=""
                            _SRC_COUNT=$((_SRC_COUNT + 1))
                            # Optional technique argument (anything not starting with -).
                            if [ -n "${2:-}" ] && [[ "${2}" != -* ]]; then
                                _SRC_ARG="$2"
                                shift 2
                            else
                                shift
                            fi
                            ;;
                        *)
                            echo "❌ Unknown option: $1"
                            echo "   Run ./do/adapter --help for usage."
                            exit 1
                            ;;
                    esac
                done
                if [ "${_SRC_COUNT}" -gt 1 ]; then
                    echo "❌ --from-weights, --from-hub, --from-tune, --from-train, and --from-registry are mutually exclusive"
                    exit 1
                fi
                if [ "${_SRC_COUNT}" -eq 0 ]; then
                    echo "❌ 'do/adapter ${CMD}' requires a source: --from-weights s3://... | --from-tune [technique] | --from-train [technique] | --from-registry <arn> | --from-hub <repo>"
                    echo "   Usage: do/adapter ${CMD} <name> --from-weights s3://..."
                    exit 1
                fi

                # ── Resolve the source (shared, target-uniform resolver) ─────
                # --from-weights is the straight-through fast path (the URI is
                # passed as-is); the rest call the existing helpers. A failed
                # resolution prints the helper's real error and exits non-zero.
                local _resolved
                _resolved=$(_resolve_additive_source "${_SRC_VERB}" "${_SRC_ARG}" "${LORA_NAME}" \
                    "$(_additive_accepts_kind adapter)") || exit 1
                local RESOLVED_SOURCE="" RESOLVED_URI="" RESOLVED_KIND=""
                eval "${_resolved}"
                WEIGHTS_URI="${RESOLVED_URI}"

                # ── ADR-013 kind gate (R5.3) — accepted kinds come from the table.
                # A full_model from ANY source is refused (it is not hot-loadable
                # as a LoRA); an UNKNOWN kind degrades to a content sniff.
                _guard_artifact_kind "${RESOLVED_KIND}" "$(_additive_accepts_kind adapter)" \
                    "A full fine-tuned model cannot be hot-loaded as a LoRA adapter. $(_additive_kind_guidance full_model "${DEPLOYMENT_TARGET}")"
                if [ -z "${RESOLVED_KIND}" ]; then
                    # Best-effort (never blocks): adapter_config.json ⇒ lora_adapter.
                    if [ "$(_additive_sniff_kind "${WEIGHTS_URI}")" = "lora_adapter" ]; then
                        echo "   ✅ Content check: adapter_config.json found at ${WEIGHTS_URI}"
                    else
                        echo "   ⚠️  Content check: could not confirm adapter_config.json at ${WEIGHTS_URI}."
                        echo "      Proceeding; vLLM will reject the load if this is not a LoRA adapter."
                    fi
                fi
                echo "📦 Source: --${RESOLVED_SOURCE} → ${WEIGHTS_URI}"
                ;;
            remove)
                ACTION="unload"
                LORA_NAME="${1:-}"
                shift || true
                if [ -z "${LORA_NAME}" ]; then
                    echo "❌ 'do/adapter remove' requires a name argument"
                    echo "   Usage: do/adapter remove <name>"
                    exit 1
                fi
                ;;
            list)
                ACTION="list"
                ;;
            --help|-h|"")
                echo "Usage: ./do/adapter <command> [options]"
                echo ""
                echo "Kubernetes commands (DEPLOYMENT_TARGET=${DEPLOYMENT_TARGET}; vLLM hot-load):"
                echo "  add <name> --from-weights s3://...      Hot-load a LoRA adapter from S3"
                echo "  add <name> --from-tune [technique]      Hot-load the do/tune adapter output"
                echo "  add <name> --from-train [technique]     Hot-load the do/train adapter output"
                echo "  add <name> --from-registry <arn>        Hot-load a registered adapter version"
                echo "  add <name> --from-hub <hf-repo-id>      Stage a HuggingFace adapter to S3, then hot-load"
                echo "  remove <name>                           Unload a LoRA adapter from vLLM"
                echo "  list                                    List loaded LoRA adapters"
                echo "  update <name> --from-weights s3://...   Swap a LoRA adapter to new weights on every pod"
                echo "                                          (unload + load the new version; every --from-* source)"
                echo "  promote <name> --from-tune <technique>  Publish a finished tune's adapter to its canonical"
                echo "                                          prefix (no load; --update-config rewrites do/config)"
                echo ""
                echo "Delivery: the canonical adapter home is <base prefix>/.mlcc-adapters/<project>/<name>/"
                echo "in the core bucket, which is on the pod's model mount. Each promotion is content-addressed:"
                echo "it lands in <home>/v<hash12>/ (same content → same version; new content → a new"
                echo "directory, older versions are never rewritten or deleted). add promotes a source there"
                echo "first, loads that version by path (lora_name stays <name>), and copies it only when this"
                echo "deployment serves the same base under a different prefix. remove unloads (and deletes only"
                echo "such copies); ./do/clean adapters deletes every version of this project's adapters."
                echo ""
                echo "Examples:"
                echo "  ./do/adapter add ectsum --from-weights s3://my-bucket/adapters/ectsum/"
                echo "  ./do/adapter add tuned-sft --from-tune"
                echo "  ./do/adapter add tuned-sft --from-tune sft"
                echo "  ./do/adapter list"
                echo "  ./do/adapter update ectsum --from-weights s3://my-bucket/adapters/ectsum-v2/"
                echo "  ./do/adapter remove ectsum"
                echo ""
                echo "A full fine-tuned model is refused here (not a LoRA)."
                echo "$(_additive_kind_guidance full_model "${DEPLOYMENT_TARGET:-}")"
                echo ""
                echo "Deprecated (still accepted, prints a notice):"
                echo "  --weights s3://...                      → --from-weights s3://..."
                echo "  --load-lora <name> --weights s3://...   → do/adapter add <name> --from-weights s3://..."
                echo "  --unload-lora <name>                    → do/adapter remove <name>"
                exit 0
                ;;
            *)
                echo "❌ Unknown command: ${CMD}"
                echo "   Run ./do/adapter --help for usage."
                exit 1
                ;;
        esac

        # ── Cluster connection (kubeconfig) ──────────────────────────────────
        # Get kubeconfig for HyperPod cluster
        KUBECONFIG_PATH="${HOME}/.kube/hyperpod-${HP_CLUSTER_NAME}"

        local _profile_arg=""
        [ -n "${_PROFILE_awsProfile:-}" ] && _profile_arg="--profile ${_PROFILE_awsProfile}"

        EKS_CLUSTER_ARN=$(aws sagemaker describe-cluster \
            --cluster-name "${HP_CLUSTER_NAME}" \
            --region "${AWS_REGION}" \
            ${_profile_arg} \
            --query "Orchestrator.Eks.ClusterArn" \
            --output text 2>&1) || {
            echo "❌ Failed to describe HyperPod cluster: ${HP_CLUSTER_NAME}"
            echo "   ${EKS_CLUSTER_ARN}"
            exit 4
        }
        EKS_CLUSTER_NAME=$(echo "${EKS_CLUSTER_ARN}" | awk -F'/' '{print $NF}')
        local _kubecfg_err
        if ! _kubecfg_err=$(aws eks update-kubeconfig \
            --name "${EKS_CLUSTER_NAME}" \
            --region "${AWS_REGION}" \
            ${_profile_arg} \
            --kubeconfig "${KUBECONFIG_PATH}" 2>&1 >/dev/null); then
            echo "❌ Failed to configure kubectl for cluster: ${EKS_CLUSTER_NAME}"
            [ -n "${_kubecfg_err}" ] && echo "   ${_kubecfg_err}"
            exit 4
        fi
        export KUBECONFIG="${KUBECONFIG_PATH}"

        # ── Every Running serving pod (Wave 6.1 R1.6) ────────────────────────
        # Adapters live in each vLLM process, so load/unload must reach EVERY
        # Running replica, not just the first. The phase guard keeps a
        # Terminating pod (mid-rollout) out of the set.
        local _PODS _pod_err
        _pod_err="$(mktemp)"
        _PODS=$(kubectl get pod -n "${HP_NAMESPACE:-default}" \
            -l "app=${PROJECT_NAME}" \
            --field-selector=status.phase=Running \
            -o jsonpath='{range .items[*]}{.metadata.name}{"\n"}{end}' 2>"${_pod_err}") || _PODS=""
        _PODS=$(printf '%s\n' "${_PODS}" | sed '/^[[:space:]]*$/d')
        if [ -z "${_PODS}" ]; then
            echo "❌ No Running pod found for app=${PROJECT_NAME} in namespace ${HP_NAMESPACE:-default}"
            if [ -s "${_pod_err}" ]; then
                sed 's/^/   kubectl: /' "${_pod_err}"
            fi
            echo "   Check: kubectl get pods -n ${HP_NAMESPACE:-default} -l app=${PROJECT_NAME}"
            rm -f "${_pod_err}"
            exit 1
        fi
        rm -f "${_pod_err}"

        # ── Delivery + rank pre-check (load/update only), before any engine call ──
        local _LORA_PATH=""
        local _iec_json_f="" _base_json _src_type="" _bucket="" _prefix="" _prefetch=""
        if [ "${ACTION}" = "unload" ]; then
            # remove: the deployment's model base locates a serving copy this verb
            # made on a base-prefix mismatch (deleted after a successful unload).
            _iec_json_f="$(mktemp)"
            if [ "${DEPLOYMENT_TARGET}" = "hyperpod-eks" ]; then
                kubectl get inferenceendpointconfig "${PROJECT_NAME}" -n "${HP_NAMESPACE:-default}" \
                    -o json >"${_iec_json_f}" 2>/dev/null || : >"${_iec_json_f}"
            fi
            _base_json=$(python3 "${SCRIPT_DIR}/lib/python/adapter_delivery.py" model-base \
                --target "${DEPLOYMENT_TARGET}" --iec-json "${_iec_json_f}" 2>/dev/null || echo '{}')
            rm -f "${_iec_json_f}"
            eval "$(printf '%s' "${_base_json}" | python3 -c '
import json, shlex, sys
try:
    d = json.load(sys.stdin)
except ValueError:
    d = {}
for k, v in (("_src_type", "source_type"), ("_bucket", "bucket"), ("_prefix", "prefix"), ("_prefetch", "prefetch")):
    print("%s=%s" % (k, shlex.quote(str(d.get(v) or ""))))
')"
        fi
        if [ "${ACTION}" = "load" ] || [ "${ACTION}" = "update" ]; then
            # Wave 6.1 R1.1/R1.3 + bucket consolidation R3 (Option D): vLLM loads
            # adapters from a LOCAL path and the pod has no AWS credentials. The
            # canonical adapter home is <base prefix>/.mlcc-adapters/<project>/<name>/
            # in the core bucket (s3_layout.py), which IS on the pod's model mount
            # for a deployment of that base (target descriptor adapter_delivery).
            # adapter_delivery.py deliver: a source not yet canonical (tune/train
            # raw output, --from-weights, --from-hub, registry) is promoted there
            # first; a canonical adapter under THIS deployment's prefix is loaded by
            # path; one under a different prefix is copied here only when the base
            # id (+ revision) matches, else refused. Refusals (HF source, prefetch
            # on, no S3 mount) are decided from config / the live IEC before any
            # copy. Never passes s3:// to vLLM.
            _iec_json_f="$(mktemp)"
            if [ "${DEPLOYMENT_TARGET}" = "hyperpod-eks" ]; then
                kubectl get inferenceendpointconfig "${PROJECT_NAME}" -n "${HP_NAMESPACE:-default}" \
                    -o json >"${_iec_json_f}" 2>/dev/null || : >"${_iec_json_f}"
            fi
            _base_json=$(python3 "${SCRIPT_DIR}/lib/python/adapter_delivery.py" model-base \
                --target "${DEPLOYMENT_TARGET}" --iec-json "${_iec_json_f}" 2>/dev/null || echo '{}')
            eval "$(printf '%s' "${_base_json}" | python3 -c '
import json, shlex, sys
try:
    d = json.load(sys.stdin)
except ValueError:
    d = {}
for k, v in (("_src_type", "source_type"), ("_bucket", "bucket"), ("_prefix", "prefix"), ("_prefetch", "prefetch")):
    print("%s=%s" % (k, shlex.quote(str(d.get(v) or ""))))
')"
            # The base the ADAPTER was trained on (where a not-yet-canonical source is
            # promoted): the tune's base for --from-tune (TUNE_MODEL_ID, catalog-mapped
            # to its HF id by s3_layout), else the project's model. An unmapped id is
            # refused, never guessed.
            local _adapter_base="${MODEL_NAME:-}"
            if [ "${_SRC_VERB}" = "from-tune" ] && [ -n "${TUNE_MODEL_ID:-}" ]; then
                _adapter_base="${TUNE_MODEL_ID}"
            elif [ "${_SRC_VERB}" = "from-registry" ] && [ -n "${RESOLVED_META_MODEL_NAME:-}" ]; then
                _adapter_base="${RESOLVED_META_MODEL_NAME}"
            fi
            local _technique_meta=""
            case "${_SRC_VERB}" in from-tune|from-train) _technique_meta="${_SRC_ARG%%-*}" ;; esac
            local _adapter_deliver_args
            _adapter_deliver_args=(
                --target "${DEPLOYMENT_TARGET}" --uri "${WEIGHTS_URI}" --project "${PROJECT_NAME}"
                --name "${LORA_NAME}" --source-type "${_src_type}" --bucket "${_bucket}"
                --prefix "${_prefix}" --prefetch "${_prefetch}" --core-bucket "${CORE_S3_BUCKET:-}"
                --adapter-base "${_adapter_base}" --deployment-model "${MODEL_NAME:-}"
                --technique "${_technique_meta}" --created-by "do/adapter ${_SRC_VERB}"
                --region "${AWS_REGION:-}"
            )
            local _plan_out _map_rc=0
            _plan_out=$(python3 "${SCRIPT_DIR}/lib/python/adapter_delivery.py" deliver --dry-run \
                "${_adapter_deliver_args[@]}") || _map_rc=$?
            if [ "${_map_rc}" -ne 0 ]; then
                printf '%s\n' "${_plan_out}"
                rm -f "${_iec_json_f}"
                exit 1
            fi
            # A planned promotion / serving copy decides the content-addressed version
            # (BL199), so the pod path is known only after delivery; the plan names the
            # home it will sit under (path_home).
            _LORA_PATH=$(_adapter_json_get "${_plan_out}" path)
            local _plan_promote _plan_copy
            _plan_promote=$(_adapter_json_get "${_plan_out}" promote_to)
            _plan_copy=$(_adapter_json_get "${_plan_out}" copy_to)
            [ -n "${_plan_promote}" ] && echo "📤 Promote: ${WEIGHTS_URI} → ${_plan_promote} (canonical home; version = content hash)"
            [ -n "${_plan_copy}" ] && echo "📋 Base-prefix mismatch: serving copy → ${_plan_copy} (same version)"
            if [ -n "${_LORA_PATH}" ]; then
                echo "📍 Pod path: ${_LORA_PATH}"
            else
                echo "📍 Pod path: $(_adapter_json_get "${_plan_out}" path_home)/<version> (fixed by the delivery below)"
            fi

            # Wave 6.1 R3.2: pre-check the adapter's rank (adapter_config.json r and
            # rank_pattern) against the LIVE serving max_lora_rank (pod env, else
            # the InferenceEndpointConfig env, else the engine default) and refuse
            # with the exact fix BEFORE calling the engine. vLLM fixes the limit at
            # start, so a too-big adapter can only be served after a redeploy.
            local _adapter_rank _pods_json_f _live_json _live_limit _live_src
            _adapter_rank=$(python3 "${SCRIPT_DIR}/lib/python/right_sizing.py" adapter-rank "${WEIGHTS_URI}" 2>/dev/null || echo "")
            _pods_json_f="$(mktemp)"
            kubectl get pod -n "${HP_NAMESPACE:-default}" -l "app=${PROJECT_NAME}" \
                --field-selector=status.phase=Running -o json >"${_pods_json_f}" 2>/dev/null || : >"${_pods_json_f}"
            _live_json=$(python3 "${SCRIPT_DIR}/lib/python/right_sizing.py" live-limit \
                --pods-json "${_pods_json_f}" --iec-json "${_iec_json_f}" 2>/dev/null || echo '{}')
            rm -f "${_pods_json_f}" "${_iec_json_f}"
            _live_limit=$(printf '%s' "${_live_json}" | python3 -c 'import json,sys; d=json.load(sys.stdin); print(d.get("limit") or "")' 2>/dev/null || echo "")
            _live_src=$(printf '%s' "${_live_json}" | python3 -c 'import json,sys; d=json.load(sys.stdin); print(d.get("source") or "")' 2>/dev/null || echo "")
            if [ -n "${_adapter_rank}" ] && [ -n "${_live_limit}" ]; then
                echo "🔍 Rank check: adapter r${_adapter_rank} vs serving max_lora_rank ${_live_limit} (${_live_src})"
                if ! python3 "${SCRIPT_DIR}/lib/python/right_sizing.py" rank-fit --name "${LORA_NAME}" \
                    --rank "${_adapter_rank}" --limit "${_live_limit}" --limit-kind live \
                    --target "${DEPLOYMENT_TARGET}"; then
                    echo "❌ Refusing to load '${LORA_NAME}' (nothing was sent to the engine)."
                    exit 1
                fi
            else
                echo "   ⚠️  Rank check skipped (adapter rank or serving limit unreadable); vLLM validates at load."
            fi

            # Execute the delivery plan (promote and/or serving copy) now that the
            # refusals and the rank check passed. Idempotent on the content hash.
            if [ -n "${_plan_promote}" ] || [ -n "${_plan_copy}" ]; then
                local _deliver_out _deliver_rc=0
                _deliver_out=$(python3 "${SCRIPT_DIR}/lib/python/adapter_delivery.py" deliver \
                    "${_adapter_deliver_args[@]}") || _deliver_rc=$?
                if [ "${_deliver_rc}" -ne 0 ]; then
                    printf '%s\n' "${_deliver_out}"
                    echo "❌ Adapter delivery failed (nothing was sent to the engine)."
                    exit 1
                fi
                echo "✅ Delivered ($(_adapter_json_get "${_deliver_out}" actions)): $(_adapter_json_get "${_deliver_out}" canonical)"
                _LORA_PATH=$(_adapter_json_get "${_deliver_out}" path)
                echo "📍 Pod path: ${_LORA_PATH}"
            fi
            if [ -z "${_LORA_PATH}" ]; then
                echo "❌ No in-pod path for '${LORA_NAME}' after delivery (nothing was sent to the engine)."
                exit 1
            fi
        fi

        # ── Per-pod direct port-forward (same pattern as do/test and do/benchmark) ──
        # Port-forward directly to each pod on 8080 (NOT a svc/ resource: the
        # routing Service exposes TLS/443 for production traffic), one pod at a
        # time on HP_LOCAL_PORT.
        local BASE_URL="http://localhost:${HP_LOCAL_PORT:-8080}"
        _PF_PID=""
        _adapter_pf_start() {
            local _pod="$1"
            echo "🔌 Port-forwarding pod/${_pod} to localhost:${HP_LOCAL_PORT:-8080}..."
            kubectl port-forward "pod/${_pod}" "${HP_LOCAL_PORT:-8080}:8080" \
                -n "${HP_NAMESPACE:-default}" >/dev/null 2>&1 &
            _PF_PID=$!
            trap "kill ${_PF_PID} 2>/dev/null || true" EXIT
            sleep "${HP_PF_WAIT:-3}"
            if ! kill -0 ${_PF_PID} 2>/dev/null; then
                echo "❌ Port-forward to pod/${_pod} failed to start"
                echo "   Check: kubectl get pods -n ${HP_NAMESPACE:-default} -l app=${PROJECT_NAME}"
                return 1
            fi
            echo "✅ Port-forward established"
            return 0
        }
        _adapter_pf_stop() {
            [ -n "${_PF_PID}" ] || return 0
            kill "${_PF_PID}" 2>/dev/null || true
            wait "${_PF_PID}" 2>/dev/null || true
            _PF_PID=""
        }

        # ── Dispatch to lora_vllm.py ─────────────────────────────────────────
        # Reusable helpers so `update` can compose unload-then-load without
        # duplicating the JSON inspection logic. Both load and unload are POST
        # operations in vLLM (there is no DELETE).
        #
        # BL165: lora_vllm.py exits 1 on a failed load/unload (with a JSON body
        # on stdout) and may crash outright (traceback on stderr, no JSON). Both
        # are captured and SURFACED — never a silent `set -e` exit or a generic
        # "Unknown error" that hides the helper's own message.
        _lora_helper_call() {
            # Usage: _lora_helper_call <out-var> <args...> — runs lora_vllm.py,
            # stores stdout in <out-var>, prints the helper's stderr on a crash.
            local _var="$1"
            shift
            local _errf _out _rc=0
            _errf="$(mktemp)"
            _out=$(python3 "${SCRIPT_DIR}/lib/python/lora_vllm.py" "$@" 2>"${_errf}") || _rc=$?
            if [ "${_rc}" -ne 0 ] && ! echo "${_out}" | grep -qE '^[[{]'; then
                echo "❌ lora_vllm.py $1 failed (exit ${_rc}) without a result."
                if [ -s "${_errf}" ]; then
                    echo "   ── helper error output ──"
                    sed 's/^/   /' "${_errf}"
                fi
                echo "   Check the venv has 'requests' installed and the port-forward to ${BASE_URL} is up."
            fi
            rm -f "${_errf}"
            printf -v "${_var}" '%s' "${_out}"
            return 0
        }

        _lora_json_field() {
            # Usage: _lora_json_field <json> <field> <default> — tolerant only of a
            # malformed/empty payload (ValueError), never of programming errors.
            printf '%s' "$1" | python3 -c '
import json, sys
try:
    d = json.loads(sys.stdin.read())
except ValueError:
    print(sys.argv[2]); sys.exit(0)
v = d.get(sys.argv[1], sys.argv[2]) if isinstance(d, dict) else sys.argv[2]
print(v)
' "$2" "$3"
        }

        _lora_do_load() {
            local _name="$1"
            local _uri="$2"
            echo "📦 Loading LoRA adapter '${_name}' from ${_uri}..."
            local RESULT=""
            _lora_helper_call RESULT load "${_name}" "${_uri}" "${BASE_URL}"
            if [ "$(_lora_json_field "${RESULT}" success False)" = "True" ]; then
                echo "✓ LoRA adapter '${_name}' loaded from ${_uri}"
                return 0
            fi
            local STATUS_CODE
            STATUS_CODE=$(_lora_json_field "${RESULT}" status_code 0)
            local ERROR_MSG
            ERROR_MSG=$(_lora_json_field "${RESULT}" error "${RESULT:-no output from lora_vllm.py}")
            if [ "${STATUS_CODE}" = "409" ]; then
                echo "❌ LoRA adapter '${_name}' already exists."
                echo "   Unload it first: do/adapter remove ${_name}"
            else
                echo "❌ Failed to load LoRA adapter '${_name}'"
                echo "   Error: ${ERROR_MSG}"
            fi
            return 1
        }

        _lora_do_unload() {
            local _name="$1"
            echo "🗑️  Unloading LoRA adapter '${_name}'..."
            local RESULT=""
            _lora_helper_call RESULT unload "${_name}" "${BASE_URL}"
            if [ "$(_lora_json_field "${RESULT}" success False)" = "True" ]; then
                echo "✓ LoRA adapter '${_name}' unloaded"
                return 0
            fi
            local ERROR_MSG
            ERROR_MSG=$(_lora_json_field "${RESULT}" error "${RESULT:-no output from lora_vllm.py}")
            echo "❌ Failed to unload LoRA adapter '${_name}'"
            echo "   Error: ${ERROR_MSG}"
            return 1
        }

        _lora_do_list() {
            local RESULT=""
            _lora_helper_call RESULT list "${BASE_URL}"
            local COUNT
            COUNT=$(printf '%s' "${RESULT}" | python3 -c '
import json, sys
try:
    d = json.loads(sys.stdin.read())
except ValueError:
    print("ERR"); sys.exit(0)
print(len(d) if isinstance(d, list) else "ERR")
')
            if [ "${COUNT}" = "ERR" ]; then
                echo "❌ Could not list LoRA adapters (unexpected helper output)."
                [ -n "${RESULT}" ] && echo "   Output: ${RESULT}"
                return 1
            elif [ "${COUNT}" = "0" ]; then
                echo "   No LoRA adapters loaded."
                echo ""
                echo "   Load one: do/adapter add <name> --from-weights s3://..."
            else
                printf "   %-30s %s\n" "NAME" "PATH"
                printf "   %-30s %s\n" "----" "----"
                echo "${RESULT}" | python3 -c "
import sys, json
loras = json.load(sys.stdin)
for l in loras:
    print(f'   {l[\"name\"]:<30} {l.get(\"path\", \"\")}')
"
            fi
            return 0
        }

        _lora_run_action() {
            case "${ACTION}" in
                load)
                    _lora_do_load "${LORA_NAME}" "${_LORA_PATH}" || return 1
                    ;;
                unload)
                    _lora_do_unload "${LORA_NAME}" || return 1
                    ;;
                update)
                    # remove-then-add: unload the existing adapter, then load the new
                    # version's path under the SAME lora_name (BL199: new content is a
                    # new v<hash12> directory, so the old version stays intact for any
                    # pod not yet swapped). A failed unload aborts before the load so
                    # weights are not half-swapped.
                    _lora_do_unload "${LORA_NAME}" || return 1
                    _lora_do_load "${LORA_NAME}" "${_LORA_PATH}" || return 1
                    ;;
                list)
                    _lora_do_list || return 1
                    ;;
            esac
            return 0
        }

        if [ "${ACTION}" = "list" ]; then
            echo "📋 Listing loaded LoRA adapters on ${PROJECT_NAME}..."
            echo ""
        fi
        local _pod_total=0 _pod_failed=0 _summary=""
        local _pod
        for _pod in ${_PODS}; do
            _pod_total=$((_pod_total + 1))
            echo ""
            echo "── pod/${_pod} ──"
            if _adapter_pf_start "${_pod}" && _lora_run_action; then
                _summary="${_summary}   ✓ pod/${_pod}
"
            else
                _pod_failed=$((_pod_failed + 1))
                _summary="${_summary}   ✗ pod/${_pod}
"
            fi
            _adapter_pf_stop
        done
        trap - EXIT
        if [ "${_pod_total}" -gt 1 ] || [ "${_pod_failed}" -gt 0 ]; then
            echo ""
            echo "📋 Per-pod result (${ACTION} '${LORA_NAME:-*}'): $((_pod_total - _pod_failed))/${_pod_total} succeeded"
            printf '%s' "${_summary}"
        fi
        if [ "${_pod_failed}" -gt 0 ]; then
            exit 1
        fi
        # remove (Wave 6.1 R1.3): delete the serving copy THIS verb made on a
        # base-prefix mismatch (its manifest carries serving_copy_of). A canonical
        # adapter is never deleted here — that is ./do/clean adapters.
        if [ "${ACTION}" = "unload" ] && [ "${_src_type}" = "s3" ] && [ -n "${_bucket}" ]; then
            local _rc_out
            if _rc_out=$(python3 "${SCRIPT_DIR}/lib/python/adapter_delivery.py" remove-copy \
                --bucket "${_bucket}" --prefix "${_prefix}" --project "${PROJECT_NAME}" \
                --name "${LORA_NAME}" --region "${AWS_REGION:-}" 2>&1); then
                if [ "$(_adapter_json_get "${_rc_out}" deleted)" != "0" ]; then
                    echo "🗑️  Deleted the serving copy $(_adapter_json_get "${_rc_out}" uri) (canonical kept: $(_adapter_json_get "${_rc_out}" copy_of))"
                fi
            else
                echo "⚠️  Could not check for a serving copy of '${LORA_NAME}': ${_rc_out}"
            fi
        fi
        return 0
    }

    _adapter_hyperpod "$@"
    exit $?
fi

source "${SCRIPT_DIR}/lib/wait.sh"

# ── Usage ─────────────────────────────────────────────────────────────────────
_usage() {
    echo "Usage: ./do/adapter <command> [options]"
    echo ""
    echo "Manage LoRA adapter inference components on endpoint: ${ENDPOINT_NAME:-<not deployed>}"
    echo ""
    echo "Commands:"
    echo "  add <name> --from-weights <s3-uri> Add a new LoRA adapter from S3"
    echo "  add <name> --from-hub <hf-repo-id>   Add a new LoRA adapter from HuggingFace Hub"
    echo "  add <name> --from-tune [technique]   Add adapter from do/tune output"
    echo "  add <name> --from-train [technique]  Add adapter from do/train output"
    echo "  add <name> --from-registry [arn]     Add adapter from model registry"
    echo "  list                                  List all adapters on the endpoint"
    echo "  remove <name>                         Remove an adapter"
    echo "  update <name> --from-weights <uri> Update adapter weights from S3 (new content → new version)"
    echo "  update <name> --from-hub <hf-repo-id> Update adapter weights from HuggingFace Hub"
    echo "  search [--limit N]                    Search HuggingFace Hub for compatible adapters"
    echo "  promote <name> --from-tune <t> | --from-weights <uri> [--update-config]"
    echo "                                        Publish an adapter to its canonical prefix (no IC)"
    echo ""
    echo "Options:"
    echo "  --help, -h    Show this help message"
    echo "  --force       Bypass adapter-model compatibility check (add command)"
    echo "  --local       Use local aws s3 cp instead of Processing Job (--from-tune)"
    echo "  --no-wait     Submit Processing Job and return immediately (--from-tune)"
    echo ""
    echo "Examples:"
    echo "  ./do/adapter add ectsum --from-weights s3://my-bucket/adapters/ectsum/adapter.tar.gz"
    echo "  ./do/adapter add ectsum --from-hub predibase/llama-3.1-8b-ectsum"
    echo "  ./do/adapter add tuned-sft --from-tune"
    echo "  ./do/adapter add tuned-sft --from-tune sft"
    echo "  ./do/adapter add tuned-sft --from-tune --local"
    echo "  ./do/adapter add tuned-sft --from-tune --no-wait"
    echo "  ./do/adapter add my-adapter --from-registry"
    echo "  ./do/adapter add my-adapter --from-registry arn:aws:sagemaker:...:model-package/proj/2"
    echo "  ./do/adapter list"
    echo "  ./do/adapter remove ectsum"
    echo "  ./do/adapter update ectsum --from-weights s3://my-bucket/adapters/ectsum-v2/adapter.tar.gz"
    echo "  ./do/adapter update ectsum --from-hub predibase/llama-3.1-8b-ectsum-v2"
    echo ""
    echo "Adapter metadata is stored in do/adapters/<name>.conf"
    echo ""
    echo "Versions: every source is promoted to its canonical home"
    echo "<base prefix>/.mlcc-adapters/<project>/<name>/ as the content-addressed version"
    echo "v<hash12>/ (same content → same version; new content → a new directory). The adapter"
    echo "IC's ArtifactUrl is that version, so update always points the IC at a NEW URI when the"
    echo "content changed and is a no-op when it did not. Old versions are kept (an IC may still"
    echo "use one); ./do/clean adapters removes every version of this project's adapters."
    echo ""
    echo "Note: --from-weights, --from-hub, --from-tune, --from-train, and --from-registry are mutually exclusive."
    echo ""
    echo "Deprecated: --weights <s3-uri> is an alias of --from-weights (prints a notice)."
    echo "The same --from-* sources work on hyperpod-eks / eks (vLLM hot-load); a full"
    echo "fine-tuned model is refused by do/adapter — use do/add-ic on realtime-inference."
}

# ── Validate LoRA is enabled ──────────────────────────────────────────────────
_validate_lora_enabled() {
    if [ "${ENABLE_LORA:-}" != "true" ]; then
        echo "❌ LoRA adapter serving is not enabled for this project."
        echo ""
        echo "   ENABLE_LORA=true was not found in do/config."
        echo ""
        echo "   To enable LoRA adapters, regenerate your project with --enable-lora"
        echo "   or add ENABLE_LORA=true to do/config and configure your model server"
        echo "   environment (e.g., VLLM_ENABLE_LORA=true)."
        exit 1
    fi
}

# ── Resolve base IC name ──────────────────────────────────────────────────────
_resolve_base_ic_name() {
    local base_ic_name=""

    # Try multi-IC path first: do/ic/default.conf
    if [ -f "${SCRIPT_DIR}/ic/default.conf" ]; then
        base_ic_name=$(grep "^export IC_DEPLOYED_NAME=" "${SCRIPT_DIR}/ic/default.conf" 2>/dev/null | sed 's/^export IC_DEPLOYED_NAME="//' | sed 's/"$//' || echo "")
    fi

    # Fallback to legacy config: INFERENCE_COMPONENT_NAME
    if [ -z "${base_ic_name}" ]; then
        base_ic_name="${INFERENCE_COMPONENT_NAME:-}"
    fi

    if [ -z "${base_ic_name}" ]; then
        # stderr: callers capture this function's stdout ($(...)), so an error on
        # stdout would be swallowed along with the exit (BL165).
        {
            echo "❌ Cannot determine base inference component name."
            echo ""
            echo "   No IC_DEPLOYED_NAME found in do/ic/default.conf and no"
            echo "   INFERENCE_COMPONENT_NAME in do/config."
            echo ""
            echo "   Deploy your base model first with: ./do/deploy"
        } >&2
        exit 1
    fi

    echo "${base_ic_name}"
}

# ── Subcommand implementations ────────────────────────────────────────────────

_adapter_add() {
    local adapter_name=""
    local weights_uri=""
    local from_hub=""
    local from_tune=""
    local from_tune_technique=""
    local from_train=""
    local from_train_technique=""
    local from_registry=""
    local registry_arn=""
    local use_local=""
    local no_wait=""
    local force=""

    # Parse add arguments
    shift  # remove 'add' from args
    while [ $# -gt 0 ]; do
        case "$1" in
            --from-weights|--weights)
                # --weights is the DEPRECATED alias of --from-weights (ADR-013 / R2).
                [ "$1" = "--weights" ] && _deprecated_flag_alias --weights --from-weights
                if [ -z "${2:-}" ]; then
                    echo "❌ $1 requires an S3 URI argument"
                    echo "   Usage: ./do/adapter add <name> --from-weights <s3-uri>"
                    exit 1
                fi
                weights_uri="$2"
                shift 2
                ;;
            --from-hub)
                if [ -z "${2:-}" ]; then
                    echo "❌ --from-hub requires a HuggingFace repo ID argument"
                    echo "   Usage: ./do/adapter add <name> --from-hub <hf-repo-id>"
                    exit 1
                fi
                from_hub="$2"
                shift 2
                ;;
            --from-tune)
                from_tune="true"
                # Check if next argument is a technique (not another flag and not empty)
                if [ -n "${2:-}" ] && [[ "${2}" != -* ]]; then
                    from_tune_technique="$2"
                    shift 2
                else
                    shift
                fi
                ;;
            --from-train)
                from_train="true"
                # Check if next argument is a technique (not another flag and not empty)
                if [ -n "${2:-}" ] && [[ "${2}" != -* ]]; then
                    from_train_technique="$2"
                    shift 2
                else
                    shift
                fi
                ;;
            --from-registry)
                from_registry="true"
                # Check if next argument is an ARN (starts with arn:)
                if [ -n "${2:-}" ] && [[ "${2}" == arn:* ]]; then
                    registry_arn="$2"
                    shift 2
                else
                    shift
                fi
                ;;
            --local)
                use_local="true"
                shift
                ;;
            --no-wait)
                no_wait="true"
                shift
                ;;
            --force)
                force="true"
                shift
                ;;
            --help|-h)
                echo "Usage: ./do/adapter add <name> --from-weights <s3-uri>"
                echo "       ./do/adapter add <name> --from-hub <hf-repo-id>"
                echo "       ./do/adapter add <name> --from-tune [technique]"
                echo "       ./do/adapter add <name> --from-registry [version-arn]"
                echo ""
                echo "Add a new LoRA adapter to the endpoint."
                echo ""
                echo "Arguments:"
                echo "  <name>                      Adapter name (lowercase alphanumeric + hyphens, 1-50 chars)"
                echo "  --from-weights <s3-uri>          S3 prefix or .tar.gz of the adapter weights"
                echo "  --from-hub <hf-repo-id>     Download adapter from HuggingFace Hub"
                echo "  --from-tune [technique]     Use adapter output from do/tune"
                echo "                              Without technique: uses latest tune output"
                echo "                              With technique (e.g., sft, dpo): uses technique-specific output"
                echo "  --from-registry [arn]       Add adapter from model registry"
                echo "                              Without ARN: presents interactive selection"
                echo "                              With ARN: adds directly using specified version ARN"
                echo "  --local                     Use local aws s3 cp instead of Processing Job (--from-tune only)"
                echo "  --no-wait                   Submit Processing Job and return immediately (--from-tune only)"
                echo "  --force                     Bypass adapter-model compatibility check"
                echo ""
                echo "Note: --from-weights, --from-hub, --from-tune, --from-train, and --from-registry are mutually exclusive."
                echo ""
                echo "Examples:"
                echo "  ./do/adapter add ectsum --from-weights s3://bucket/adapters/ectsum/adapter.tar.gz"
                echo "  ./do/adapter add ectsum --from-hub predibase/llama-3.1-8b-ectsum"
                echo "  ./do/adapter add tuned-sft --from-tune"
                echo "  ./do/adapter add tuned-sft --from-tune sft"
                echo "  ./do/adapter add tuned-sft --from-tune --local"
                echo "  ./do/adapter add tuned-sft --from-tune --no-wait"
                echo "  ./do/adapter add my-adapter --from-registry"
                echo "  ./do/adapter add my-adapter --from-registry arn:aws:sagemaker:...:model-package/proj/2"
                exit 0
                ;;
            -*)
                echo "❌ Unknown option: $1"
                echo "   Usage: ./do/adapter add <name> --from-weights <s3-uri>"
                echo "          ./do/adapter add <name> --from-hub <hf-repo-id>"
                echo "          ./do/adapter add <name> --from-tune [technique]"
                echo "          ./do/adapter add <name> --from-registry [version-arn]"
                exit 1
                ;;
            *)
                if [ -z "${adapter_name}" ]; then
                    adapter_name="$1"
                else
                    echo "❌ Unexpected argument: $1"
                    echo "   Usage: ./do/adapter add <name> --from-weights <s3-uri>"
                    echo "          ./do/adapter add <name> --from-hub <hf-repo-id>"
                    echo "          ./do/adapter add <name> --from-tune [technique]"
                    echo "          ./do/adapter add <name> --from-registry [version-arn]"
                    exit 1
                fi
                shift
                ;;
        esac
    done

    # Validate required arguments
    if [ -z "${adapter_name}" ]; then
        echo "❌ Adapter name is required"
        echo "   Usage: ./do/adapter add <name> --from-weights <s3-uri>"
        echo "          ./do/adapter add <name> --from-hub <hf-repo-id>"
        echo "          ./do/adapter add <name> --from-tune [technique]"
        exit 1
    fi

    # ── Mutual exclusivity check ─────────────────────────────────────────
    local source_count=0
    [ -n "${weights_uri}" ] && source_count=$((source_count + 1))
    [ -n "${from_hub}" ] && source_count=$((source_count + 1))
    [ -n "${from_tune}" ] && source_count=$((source_count + 1))
    [ -n "${from_train}" ] && source_count=$((source_count + 1))
    [ -n "${from_registry}" ] && source_count=$((source_count + 1))

    if [ "${source_count}" -gt 1 ]; then
        echo "❌ --from-weights, --from-hub, --from-tune, --from-train, and --from-registry are mutually exclusive"
        echo ""
        echo "   Use one of:"
        echo "   ./do/adapter add ${adapter_name} --from-weights <s3-uri>"
        echo "   ./do/adapter add ${adapter_name} --from-hub <hf-repo-id>"
        echo "   ./do/adapter add ${adapter_name} --from-tune [technique]"
        echo "   ./do/adapter add ${adapter_name} --from-registry [version-arn]"
        exit 1
    fi

    if [ "${source_count}" -eq 0 ]; then
        echo "❌ One of --from-weights, --from-hub, --from-tune, --from-train, or --from-registry is required"
        echo "   Usage: ./do/adapter add <name> --from-weights <s3-uri>"
        echo "          ./do/adapter add <name> --from-hub <hf-repo-id>"
        echo "          ./do/adapter add <name> --from-tune [technique]"
        echo "          ./do/adapter add <name> --from-registry [version-arn]"
        exit 1
    fi

    # ── ADR-013 kind gate guidance (shared by every source below) ──────────
    local _kind_guidance
    _kind_guidance="A full fine-tuned model cannot be hot-loaded as a LoRA adapter. $(_additive_kind_guidance full_model "${DEPLOYMENT_TARGET:-}")"
    local _resolved_kind=""

    # ── Resolve --from-tune to weights_uri (shared resolver) ──────────────
    # _resolve_additive_source reads TUNE_ADAPTER_PATH_<T>[_<SLUG>] /
    # TUNE_MODEL_PATH_<T> / TUNE_OUTPUT_PATH_LATEST and records the kind; the
    # kind gate runs BEFORE any staging so a full model is refused up front.
    if [ -n "${from_tune}" ]; then
        local _tune_resolved
        _tune_resolved=$(_resolve_additive_source from-tune "${from_tune_technique}" "${adapter_name}" \
            "$(_additive_accepts_kind adapter)") || exit 1
        local RESOLVED_SOURCE="" RESOLVED_URI="" RESOLVED_KIND="" RESOLVED_META_TECHNIQUE=""
        eval "${_tune_resolved}"
        weights_uri="${RESOLVED_URI}"
        _resolved_kind="${RESOLVED_KIND}"
        _guard_artifact_kind "${_resolved_kind}" "$(_additive_accepts_kind adapter)" "${_kind_guidance}"
        echo "📦 Using tune adapter output (${RESOLVED_META_TECHNIQUE}): ${weights_uri}"
        echo ""

        # Bucket consolidation R3 (Option D): the old Processing-Job / --local
        # staging into the legacy adapters bucket is retired for new writes. The
        # source is promoted into its canonical home below (server-side S3 copy,
        # your credentials), which the adapter IC loads directly.
        if [ -n "${use_local}" ] || [ -n "${no_wait}" ]; then
            echo "ℹ️  --local / --no-wait no longer apply: the adapter is promoted with a server-side copy."
        fi
    fi

    # ── Resolve --from-train to weights_uri (shared resolver) ─────────────
    if [ -n "${from_train}" ]; then
        local _train_resolved
        _train_resolved=$(_resolve_additive_source from-train "${from_train_technique}" "${adapter_name}" \
            "$(_additive_accepts_kind adapter)") || exit 1
        local RESOLVED_SOURCE="" RESOLVED_URI="" RESOLVED_KIND="" RESOLVED_META_TECHNIQUE=""
        eval "${_train_resolved}"
        weights_uri="${RESOLVED_URI}"
        _resolved_kind="${RESOLVED_KIND}"
        _guard_artifact_kind "${_resolved_kind}" "$(_additive_accepts_kind adapter)" "${_kind_guidance}"
        echo "📦 Using train adapter output (${RESOLVED_META_TECHNIQUE}): ${weights_uri}"
        echo ""

        # Promoted into the canonical prefix below (bucket consolidation R3).
        echo ""
    fi

    # ── Resolve --from-registry to weights_uri ────────────────────────────
    if [ -n "${from_registry}" ]; then
        if [ -z "${registry_arn}" ]; then
            # Interactive mode: query registry and present selection (AC-4.2)
            # Check if stdin is a TTY (AC-4.4)
            if [ ! -t 0 ]; then
                echo "Error: --from-registry requires an explicit version ARN in non-interactive mode."
                echo "Usage: ./do/adapter add <name> --from-registry <version-arn>"
                exit 1
            fi

            echo "📦 Querying model registry for available adapters..."
            echo ""

            local adapters_json _list_err _list_rc=0
            _list_err="$(mktemp)"
            # BL165: capture the helper's stderr instead of discarding it, so a
            # credentials/permission/import failure is shown, not a silent exit.
            adapters_json=$(python3 "${SCRIPT_DIR}/.register_helper.py" list-adapters \
                --project-name "${PROJECT_NAME}" \
                --region "${AWS_REGION}" 2>"${_list_err}") || _list_rc=$?

            # Extract JSON line (filter out any non-JSON noise)
            local json_line
            json_line=$(echo "${adapters_json}" | grep -E '^\{' | tail -1 || true)

            if [ -z "${json_line}" ] || [ "${_list_rc}" -ne 0 ]; then
                echo "❌ Failed to query model registry (.register_helper.py list-adapters exit ${_list_rc})."
                if [ -s "${_list_err}" ]; then
                    echo "   ── helper error output ──"
                    sed 's/^/   /' "${_list_err}"
                fi
                rm -f "${_list_err}"
                echo "   Check that your AWS credentials are configured and the project has registered adapters."
                exit 1
            fi
            rm -f "${_list_err}"

            # Parse adapter count
            local adapter_count
            adapter_count=$(echo "${json_line}" | python3 -c "import sys,json; data=json.loads(sys.stdin.read()); print(len(data.get('adapters',[])))" 2>/dev/null || echo "0")

            if [ "${adapter_count}" -eq 0 ]; then
                echo "❌ No adapters found in the model registry for project: ${PROJECT_NAME}"
                echo ""
                echo "   Register an adapter first with: ./do/register (after do/tune)"
                echo "   Or use --from-weights or --from-hub to add an adapter manually."
                exit 1
            fi

            # Display selection menu
            echo "Available adapters in registry (${adapter_count} found):"
            echo ""
            printf '  %-4s%-10s%-12s%-20s%s\n' "#" "VERSION" "TECHNIQUE" "CREATED" "PARENT MODEL"

            local i=0
            while [ "${i}" -lt "${adapter_count}" ]; do
                local version technique created_at parent_arn
                version=$(echo "${json_line}" | python3 -c "import sys,json; data=json.loads(sys.stdin.read()); print(data['adapters'][${i}].get('version','?'))" 2>/dev/null)
                technique=$(echo "${json_line}" | python3 -c "import sys,json; data=json.loads(sys.stdin.read()); print(data['adapters'][${i}].get('tuneTechnique','?'))" 2>/dev/null)
                created_at=$(echo "${json_line}" | python3 -c "import sys,json; data=json.loads(sys.stdin.read()); t=data['adapters'][${i}].get('createdAt',''); print(t[:10] if t else '?')" 2>/dev/null)
                parent_arn=$(echo "${json_line}" | python3 -c "import sys,json; data=json.loads(sys.stdin.read()); a=data['adapters'][${i}].get('parentModelVersionArn',''); print(a.split('/')[-2]+'/'+a.split('/')[-1] if '/' in a else a[:40])" 2>/dev/null)

                local num=$((i + 1))
                printf '  %-4s%-10s%-12s%-20s%s\n' "${num}" "v${version}" "${technique}" "${created_at}" "${parent_arn}"
                i=$((i + 1))
            done

            echo ""
            echo -n "Select adapter (1-${adapter_count}): "
            read -r selection

            # Validate selection
            if ! echo "${selection}" | grep -qE '^[0-9]+$'; then
                echo "❌ Invalid selection: ${selection}"
                exit 1
            fi
            if [ "${selection}" -lt 1 ] || [ "${selection}" -gt "${adapter_count}" ]; then
                echo "❌ Selection out of range. Choose 1-${adapter_count}."
                exit 1
            fi

            # Get the ARN of the selected adapter
            local sel_idx=$((selection - 1))
            registry_arn=$(echo "${json_line}" | python3 -c "import sys,json; data=json.loads(sys.stdin.read()); print(data['adapters'][${sel_idx}]['arn'])" 2>/dev/null)

            if [ -z "${registry_arn}" ]; then
                echo "❌ Failed to retrieve ARN for selected adapter."
                exit 1
            fi

            echo ""
            echo "✅ Selected: ${registry_arn}"
            echo ""
        fi

        # Direct mode (AC-4.3): resolve the provided or selected ARN through the
        # shared resolver (it calls .register_helper.py get-version and surfaces
        # the helper's real error on failure).
        echo "📦 Retrieving adapter details from registry: ${registry_arn}"
        echo ""

        local _reg_resolved
        _reg_resolved=$(_resolve_additive_source from-registry "${registry_arn}" "${adapter_name}" \
            "$(_additive_accepts_kind adapter)") || {
            echo "   Run ./do/adapter list to see available registry adapters."
            exit 1
        }
        local RESOLVED_SOURCE="" RESOLVED_URI="" RESOLVED_KIND=""
        local RESOLVED_META_VERSION_ARN="" RESOLVED_META_VERSION="" RESOLVED_META_PARENT_ARN="" RESOLVED_META_MODEL_NAME=""
        eval "${_reg_resolved}"
        weights_uri="${RESOLVED_URI}"
        _resolved_kind="${RESOLVED_KIND}"
        # Registry provenance for the compat check + conf metadata below.
        local version_line="registry:${RESOLVED_META_VERSION_ARN}"
        _guard_artifact_kind "${_resolved_kind}" "$(_additive_accepts_kind adapter)" "${_kind_guidance}"

        echo "✅ Resolved adapter weights from registry: ${weights_uri}"
        echo ""
    fi

    # ── Validate HF repo ID format (if --from-hub) ───────────────────────
    if [ -n "${from_hub}" ]; then
        # Valid formats: "org/name" or "name" (alphanumeric, hyphens, underscores, dots)
        if ! echo "${from_hub}" | grep -qE '^[a-zA-Z0-9._-]+(/[a-zA-Z0-9._-]+)?$'; then
            echo "❌ Invalid HuggingFace repo ID: ${from_hub}"
            echo ""
            echo "   Repo ID must be in format 'org/name' or 'name'"
            echo "   Examples: predibase/llama-3.1-8b-ectsum, my-adapter"
            exit 1
        fi
    fi

    # ── Validate adapter name format ──────────────────────────────────────
    if ! echo "${adapter_name}" | grep -qE '^[a-z0-9][a-z0-9-]{0,49}$'; then
        echo "❌ Invalid adapter name: ${adapter_name}"
        echo ""
        echo "   Adapter names must be:"
        echo "   • 1-50 characters long"
        echo "   • Lowercase alphanumeric and hyphens only"
        echo "   • Start with a letter or number"
        echo ""
        echo "   Examples: ectsum, finance-qa, my-adapter-v2"
        exit 1
    fi

    # ── Validate S3 URI format (only when --from-weights is explicitly used) ──
    if [ -n "${weights_uri}" ] && [ -z "${from_hub}" ] && [ -z "${from_tune}" ] && [ -z "${from_train}" ] && [ -z "${from_registry}" ]; then
        # A .tar.gz archive OR an S3 prefix of loose PEFT files (bucket R3.4): both
        # are promoted into the canonical prefix, which is what the IC loads. A
        # prefix is what ./do/adapter promote prints as the next step.
        if ! echo "${weights_uri}" | grep -qE '^s3://[^/]+/.+'; then
            echo "❌ Invalid S3 URI: ${weights_uri}"
            echo ""
            echo "   Adapter weights must be one of:"
            echo "   • An S3 prefix holding adapter_config.json + adapter weights (s3://bucket/path/)"
            echo "   • A .tar.gz archive containing those files at its top level"
            echo ""
            echo "   Example: s3://my-bucket/adapters/ectsum/adapter.tar.gz"
            exit 1
        fi
    fi

    # ── Validate adapter name uniqueness (AC-1.7: overwrite when --from-tune) ──
    if [ -f "${SCRIPT_DIR}/adapters/${adapter_name}.conf" ]; then
        if [ -n "${from_tune}" ]; then
            # AC-1.7: Overwrite existing adapter when re-running auto-register
            echo "ℹ️  Adapter '${adapter_name}' already exists — overwriting (re-tune)"
            # Delete existing IC if deployed, then remove conf
            local _existing_ic_name=""
            _existing_ic_name=$(grep "^export ADAPTER_IC_NAME=" "${SCRIPT_DIR}/adapters/${adapter_name}.conf" 2>/dev/null | sed 's/^export ADAPTER_IC_NAME="//' | sed 's/"$//' || echo "")
            if [ -n "${_existing_ic_name}" ]; then
                echo "   Deleting existing IC: ${_existing_ic_name}..."
                aws sagemaker delete-inference-component \
                    --inference-component-name "${_existing_ic_name}" \
                    --region "${AWS_REGION}" 2>/dev/null || true
                # Wait for IC to be fully deleted (async operation)
                local _wait_count=0
                while [ ${_wait_count} -lt 30 ]; do
                    local _ic_status=""
                    _ic_status=$(aws sagemaker describe-inference-component \
                        --inference-component-name "${_existing_ic_name}" \
                        --region "${AWS_REGION}" \
                        --query 'InferenceComponentStatus' --output text 2>/dev/null || echo "GONE")
                    if [ "${_ic_status}" = "GONE" ] || [ "${_ic_status}" = "None" ]; then
                        break
                    fi
                    sleep 5
                    _wait_count=$((_wait_count + 1))
                done
            fi
            rm -f "${SCRIPT_DIR}/adapters/${adapter_name}.conf"
        else
            echo "❌ Adapter already exists: ${adapter_name}"
            echo ""
            echo "   An adapter with this name is already registered."
            echo "   To update its weights, use: ./do/adapter update ${adapter_name} --from-weights <new-uri>"
            echo "   To remove it first: ./do/adapter remove ${adapter_name}"
            exit 1
        fi
    fi

    # ── ADR-013 artifact-kind gate (BL164 R4) for the remaining sources ────
    # --from-tune/--from-train/--from-registry were already gated right after
    # they resolved (before any staging). --from-weights and --from-hub carry no
    # recorded kind → the gate degrades (unknown) and the adapter_config.json
    # content check below (_validate_adapter_config / _download_from_hub) applies.
    if [ -z "${from_tune}" ] && [ -z "${from_train}" ] && [ -z "${from_registry}" ]; then
        _guard_artifact_kind "" "$(_additive_accepts_kind adapter)" "${_kind_guidance}"
    fi

    echo "🔌 Adding adapter: ${adapter_name}"
    if [ -n "${from_hub}" ]; then
        echo "   Source: HuggingFace Hub (${from_hub})"
    elif [ -n "${from_tune}" ]; then
        echo "   Source: do/tune output"
        echo "   Weights: ${weights_uri}"
    elif [ -n "${from_registry}" ]; then
        echo "   Source: Model Registry (${registry_arn})"
        echo "   Weights: ${weights_uri}"
    else
        echo "   Weights: ${weights_uri}"
    fi
    echo ""

    # ── If --from-hub: download, tar, upload to S3 ────────────────────────
    if [ -n "${from_hub}" ]; then
        # Shared resolver → the existing _download_from_hub (stage to S3).
        local _hub_resolved
        _hub_resolved=$(_resolve_additive_source from-hub "${from_hub}" "${adapter_name}") || exit 1
        local RESOLVED_SOURCE="" RESOLVED_URI="" RESOLVED_KIND=""
        eval "${_hub_resolved}"
        weights_uri="${RESOLVED_URI}"
        echo ""
    fi

    # ── Validate base IC is InService ─────────────────────────────────────
    local base_ic_name
    base_ic_name=$(_resolve_base_ic_name)

    echo "🔍 Checking base inference component: ${base_ic_name}"
    local base_status
    base_status=$(_get_ic_status "${base_ic_name}")

    if [ "${base_status}" != "InService" ]; then
        echo "❌ Base inference component is not InService: ${base_ic_name}"
        echo "   Current status: ${base_status:-not found}"
        echo ""
        echo "   Adapters require a running base model. Deploy first with:"
        echo "   ./do/deploy"
        exit 1
    fi
    echo "✅ Base IC is InService: ${base_ic_name}"

    # ── Validate S3 object exists (best-effort, only for --from-weights) ──────
    if [ -z "${from_hub}" ]; then
        echo "🔍 Checking S3 object exists..."
        if ! aws s3 ls "${weights_uri}" --region "${AWS_REGION}" &>/dev/null; then
            echo "⚠️  Could not verify S3 object: ${weights_uri}"
            echo "   This may be a permissions issue. Proceeding anyway..."
            echo "   SageMaker will fail at load time if the object doesn't exist."
            echo ""
        else
            echo "✅ S3 object verified: ${weights_uri}"
        fi

        # ── Best-effort: validate adapter_config.json base model ─────────────
        # Downloads the tar.gz, extracts adapter_config.json, and checks that
        # base_model_name_or_path matches MODEL_NAME from do/config.
        # If anything fails (download, extraction, parsing), skip silently.
        _validate_adapter_config "${weights_uri}" || true
    fi

    # ── Compatibility check: adapter parent model vs deployed model ───────
    # Derive parent metadata early (same logic used later for conf file)
    local _compat_parent_arn=""
    local _compat_parent_slug=""

    if [ -n "${from_tune}" ]; then
        _compat_parent_slug="${MODEL_NAME:-}"
        if [ -n "${MODEL_PKG_ARN:-}" ]; then
            _compat_parent_arn="${MODEL_PKG_ARN}"
        fi
    elif [ -n "${from_registry}" ] && [ -n "${version_line:-}" ]; then
        # Parent metadata was parsed once by the shared resolver (RESOLVED_META_*).
        _compat_parent_arn="${RESOLVED_META_PARENT_ARN:-}"
        _compat_parent_slug="${RESOLVED_META_MODEL_NAME:-}"
    fi

    if [ -z "${_compat_parent_arn}" ] && [ -z "${_compat_parent_slug}" ]; then
        echo "ℹ️  No parent model metadata — skipping compatibility check."
    elif [ "${force}" = "true" ]; then
        echo "ℹ️  --force: skipping compatibility check."
    else
        # Resolve base IC name for compat check (already validated InService above)
        local _compat_base_ic_name
        _compat_base_ic_name="${base_ic_name}"

        # Get deployed model identity from base IC
        local _compat_deployed_model=""
        _compat_deployed_model=$(aws sagemaker describe-inference-component \
            --inference-component-name "${_compat_base_ic_name}" \
            --query 'Specification.Container.ArtifactUrl' --output text \
            --region "${AWS_REGION}" 2>/dev/null) || _compat_deployed_model=""

        if [ -z "${_compat_deployed_model}" ] || [ "${_compat_deployed_model}" = "None" ]; then
            echo "ℹ️  Could not verify compatibility (DescribeInferenceComponent returned no artifact URL). Proceeding."
        else
            # Primary check: compare adapter parent MPG ARN against deployed MPG ARN
            local _compat_deployed_mpg="${MODEL_PKG_ARN:-}"
            local _compat_expected_slug="${_compat_parent_slug}"

            local _compat_mismatch="false"
            if [ -n "${_compat_parent_arn}" ] && [ -n "${_compat_deployed_mpg}" ] && \
               [ "${_compat_parent_arn}" != "${_compat_deployed_mpg}" ]; then
                _compat_mismatch="true"
            fi

            if [ "${_compat_mismatch}" = "true" ]; then
                # Fallback: check if artifact URL contains the expected model slug
                if [ -n "${_compat_expected_slug}" ] && \
                   [[ "${_compat_deployed_model}" == *"${_compat_expected_slug}"* ]]; then
                    : # Slug match — compatible despite ARN mismatch
                else
                    echo "⚠️  Adapter was trained on: ${_compat_parent_arn}"
                    echo "   Deployed model:          ${_compat_deployed_mpg:-${_compat_deployed_model:-unknown}}"
                    if [ -t 0 ]; then
                        read -p "   Continue anyway? [y/N] " confirm
                        [[ "${confirm}" =~ ^[Yy] ]] || exit 1
                    else
                        echo "   Aborting (non-interactive). Use --force to override."
                        exit 1
                    fi
                fi
            fi
        fi
    fi

    # ── Promote into the canonical adapter home (bucket consolidation R3.4) ──
    # Every source (tune/train output, --from-weights, registry; --from-hub was
    # published there already) lands in <base prefix>/.mlcc-adapters/<project>/
    # <name>/ in the core bucket (s3_layout.py); the adapter IC loads that prefix.
    # The base is the tune's base for --from-tune (TUNE_MODEL_ID, catalog-mapped),
    # the registry's model for --from-registry, else this project's MODEL_NAME.
    local _adapter_source_uri="${weights_uri}" _promote_base="${MODEL_NAME:-}" _promote_tech=""
    if [ -n "${from_tune}" ]; then
        [ -n "${TUNE_MODEL_ID:-}" ] && _promote_base="${TUNE_MODEL_ID}"
        _promote_tech="${from_tune_technique%%-*}"
    elif [ -n "${from_train}" ]; then
        _promote_tech="${from_train_technique}"
    elif [ -n "${from_registry}" ] && [ -n "${RESOLVED_META_MODEL_NAME:-}" ]; then
        _promote_base="${RESOLVED_META_MODEL_NAME}"
    fi
    weights_uri=$(_adapter_promote_canonical "${weights_uri}" "${adapter_name}" "${_promote_base}" \
        lora_adapter "${_promote_tech}" "do/adapter add") || exit 1

    # ── Rank pre-check vs the LIVE serving limit (Wave 6.1 R3.2) ─────────
    # The base IC's container env carries the engine's MAX_LORA_RANK when it is
    # overridden (IC_ENV_*); otherwise the engine default applies. Refuse with the
    # exact fix before creating the adapter IC — vLLM would reject it at load.
    local _smai_rank _smai_env_f _smai_live _smai_limit _smai_src
    _smai_rank=$(python3 "${SCRIPT_DIR}/lib/python/right_sizing.py" adapter-rank "${weights_uri}" 2>/dev/null || echo "")
    if [ -n "${_smai_rank}" ]; then
        _smai_env_f="$(mktemp)"
        aws sagemaker describe-inference-component \
            --inference-component-name "${base_ic_name}" \
            --query 'Specification.Container.Environment' --output json \
            --region "${AWS_REGION}" >"${_smai_env_f}" 2>/dev/null || : >"${_smai_env_f}"
        _smai_live=$(python3 "${SCRIPT_DIR}/lib/python/right_sizing.py" live-limit --env-json "${_smai_env_f}" 2>/dev/null || echo '{}')
        rm -f "${_smai_env_f}"
        _smai_limit=$(printf '%s' "${_smai_live}" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("limit") or "")' 2>/dev/null || echo "")
        _smai_src=$(printf '%s' "${_smai_live}" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("source") or "")' 2>/dev/null || echo "")
        if [ -n "${_smai_limit}" ]; then
            echo "🔍 Rank check: adapter r${_smai_rank} vs serving max_lora_rank ${_smai_limit} (${_smai_src})"
            if ! python3 "${SCRIPT_DIR}/lib/python/right_sizing.py" rank-fit --name "${adapter_name}" \
                --rank "${_smai_rank}" --limit "${_smai_limit}" --limit-kind live \
                --target "${DEPLOYMENT_TARGET:-realtime-inference}"; then
                echo "❌ Refusing to create the adapter inference component (nothing was created)."
                exit 1
            fi
        fi
    fi

    # ── Build adapter IC name ─────────────────────────────────────────────
    local adapter_ic_name="${PROJECT_NAME}-adapter-${adapter_name}"

    # ── Create adapter inference component ────────────────────────────────
    echo "🚀 Creating adapter inference component: ${adapter_ic_name}"
    if ! aws sagemaker create-inference-component \
        --inference-component-name "${adapter_ic_name}" \
        --endpoint-name "${ENDPOINT_NAME}" \
        --specification "{\"BaseInferenceComponentName\":\"${base_ic_name}\",\"Container\":{\"ArtifactUrl\":\"${weights_uri}\"}}" \
        --region "${AWS_REGION}"; then

        echo "❌ Failed to create adapter inference component"
        echo "   Check that:"
        echo "   • Your IAM credentials have sagemaker:CreateInferenceComponent permission"
        echo "   • The base IC '${base_ic_name}' is InService"
        echo "   • The S3 URI is accessible by the SageMaker execution role"
        exit 1
    fi

    echo "✅ Adapter IC creation initiated: ${adapter_ic_name}"

    # ── Wait for adapter IC to reach InService ────────────────────────────
    echo "⏳ Waiting for adapter IC to reach InService..."
    echo "   This typically takes 1-3 minutes for adapters."

    wait_ic "${adapter_ic_name}"

    echo "✅ Adapter IC is InService: ${adapter_ic_name}"

    # ── Create adapter metadata conf file ─────────────────────────────────
    local created_at
    created_at=$(date -u +"%Y-%m-%dT%H:%M:%SZ")

    mkdir -p "${SCRIPT_DIR}/adapters"
    cat > "${SCRIPT_DIR}/adapters/${adapter_name}.conf" <<EOF
export ADAPTER_NAME="${adapter_name}"
export ADAPTER_IC_NAME="${adapter_ic_name}"
export ADAPTER_WEIGHTS_URI="${weights_uri}"
export ADAPTER_CREATED_AT="${created_at}"
export ADAPTER_SOURCE_URI="${_adapter_source_uri}"
EOF

    # Add hub-specific metadata if --from-hub was used
    if [ -n "${from_hub}" ]; then
        cat >> "${SCRIPT_DIR}/adapters/${adapter_name}.conf" <<EOF
export ADAPTER_SOURCE="hub"
export ADAPTER_HF_REPO="${from_hub}"
EOF
    fi

    # Add tune-specific metadata if --from-tune was used
    if [ -n "${from_tune}" ]; then
        local tune_technique_meta="${from_tune_technique:-latest}"
        local tune_dataset_meta=""
        if [ -n "${from_tune_technique}" ] && [[ "${from_tune_technique}" == *-* ]]; then
            tune_technique_meta="${from_tune_technique%%-*}"
            tune_dataset_meta="${from_tune_technique#*-}"
        fi
        cat >> "${SCRIPT_DIR}/adapters/${adapter_name}.conf" <<EOF
export ADAPTER_SOURCE="tune"
export ADAPTER_TUNE_TECHNIQUE="${tune_technique_meta}"
export ADAPTER_TUNE_DATASET="${tune_dataset_meta}"
EOF

        # Store parent model metadata for compat check (US-3 prerequisite)
        # ADAPTER_PARENT_MODEL_SLUG from MODEL_NAME in do/config
        local parent_model_slug="${MODEL_NAME:-}"
        # ADAPTER_PARENT_MODEL_ARN: resolve base model version ARN from deployment MPG
        local parent_model_arn=""
        if [ -n "${MODEL_PKG_ARN:-}" ]; then
            parent_model_arn="${MODEL_PKG_ARN}"
        else
            # Query the deployment MPG for the latest base model version
            local models_json
            models_json=$(python3 "${SCRIPT_DIR}/.register_helper.py" list-models \
                --project-name "${PROJECT_NAME}" \
                --region "${AWS_REGION}" 2>/dev/null || echo "")
            local models_line
            # `|| true`: no JSON line (helper failed / no MPG) just means no parent ARN.
            # Without it pipefail + set -e aborted HERE — after the IC was created but
            # before do/adapters/<name>.conf was written (an IC remove can't find).
            models_line=$(echo "${models_json}" | grep -E '^\{' | tail -1 || true)
            if [ -n "${models_line}" ]; then
                parent_model_arn=$(echo "${models_line}" | python3 -c "
import sys, json
data = json.loads(sys.stdin.read())
models = data.get('models', [])
if models:
    print(models[0].get('arn', ''))
else:
    print('')
" 2>/dev/null || echo "")
            fi
        fi

        if [ -n "${parent_model_arn}" ] || [ -n "${parent_model_slug}" ]; then
            cat >> "${SCRIPT_DIR}/adapters/${adapter_name}.conf" <<EOF
export ADAPTER_PARENT_MODEL_ARN="${parent_model_arn}"
export ADAPTER_PARENT_MODEL_SLUG="${parent_model_slug}"
EOF
        fi
    fi

    # Add train-specific metadata if --from-train was used
    if [ -n "${from_train}" ]; then
        local train_technique_meta="${from_train_technique:-${TRAIN_TECHNIQUE:-custom}}"
        cat >> "${SCRIPT_DIR}/adapters/${adapter_name}.conf" <<EOF
export ADAPTER_SOURCE="train"
export ADAPTER_TECHNIQUE="${train_technique_meta}"
export ADAPTER_TRAIN_JOB="${TRAIN_JOB_NAME:-}"
EOF
    fi

    # Add registry-specific metadata if --from-registry was used
    if [ -n "${from_registry}" ]; then
        cat >> "${SCRIPT_DIR}/adapters/${adapter_name}.conf" <<EOF
export ADAPTER_SOURCE="registry"
export ADAPTER_REGISTRY_ARN="${registry_arn}"
EOF

        # Store parent model metadata for compat check (US-3 prerequisite)
        # Extract parentModelVersionArn and modelName from registry version metadata
        local parent_model_arn=""
        local parent_model_slug=""
        if [ -n "${version_line:-}" ]; then
            # Parsed once by the shared resolver (RESOLVED_META_*).
            parent_model_arn="${RESOLVED_META_PARENT_ARN:-}"
            parent_model_slug="${RESOLVED_META_MODEL_NAME:-}"
        fi

        if [ -n "${parent_model_arn}" ] || [ -n "${parent_model_slug}" ]; then
            cat >> "${SCRIPT_DIR}/adapters/${adapter_name}.conf" <<EOF
export ADAPTER_PARENT_MODEL_ARN="${parent_model_arn}"
export ADAPTER_PARENT_MODEL_SLUG="${parent_model_slug}"
EOF
        fi
    fi

    # Default source: bare S3 URI (no --from-* flag). --from-train wrote its own
    # ADAPTER_SOURCE="train" above; a second line here would override it.
    if [ -z "${from_hub}" ] && [ -z "${from_tune}" ] && [ -z "${from_train}" ] && [ -z "${from_registry}" ]; then
        cat >> "${SCRIPT_DIR}/adapters/${adapter_name}.conf" <<EOF
export ADAPTER_SOURCE="s3"
EOF
    fi

    echo ""
    echo "✅ Adapter added successfully!"
    echo ""
    echo "📋 Adapter Details:"
    echo "   Name: ${adapter_name}"
    echo "   IC Name: ${adapter_ic_name}"
    echo "   Weights: ${weights_uri}"
    if [ -n "${from_hub}" ]; then
        echo "   Source: HuggingFace Hub (${from_hub})"
    elif [ -n "${from_tune}" ]; then
        echo "   Source: do/tune (${from_tune_technique:-latest})"
    elif [ -n "${from_registry}" ]; then
        echo "   Source: Model Registry (${registry_arn})"
    fi
    echo "   Created: ${created_at}"
    echo ""
    echo "🧪 Test your adapter:"
    echo "   ./do/test ${adapter_name}"
    echo ""
    echo "🗑️  Remove when done:"
    echo "   ./do/adapter remove ${adapter_name}"
}

_adapter_list() {
    # Delegate to Python for Bash 3.2 compatibility (no associative arrays needed).
    # Merges 3 data sources: local confs, deployed adapter ICs, and registry.
    python3 - "${SCRIPT_DIR}" "${PROJECT_NAME}" "${ENDPOINT_NAME:-}" "${AWS_REGION}" <<'ADAPTER_LIST_PY'
import sys, os, json, subprocess, glob

script_dir, project_name, endpoint_name, region = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]

# ── Data source 1: Local adapter confs ──
adapters = {}  # name → {source, ic_name, technique, dataset}
adapters_dir = os.path.join(script_dir, "adapters")
if os.path.isdir(adapters_dir):
    for conf_path in sorted(glob.glob(os.path.join(adapters_dir, "*.conf"))):
        if os.path.basename(conf_path) == ".gitkeep":
            continue
        props = {}
        with open(conf_path) as f:
            for line in f:
                if line.startswith("export "):
                    line = line[7:].strip()
                    if "=" in line:
                        k, v = line.split("=", 1)
                        props[k] = v.strip('"').strip("'")
        name = props.get("ADAPTER_NAME", os.path.basename(conf_path).replace(".conf", ""))
        adapters[name] = {
            "source": props.get("ADAPTER_SOURCE", "s3"),
            "ic_name": props.get("ADAPTER_IC_NAME", ""),
            "technique": props.get("ADAPTER_TUNE_TECHNIQUE", props.get("ADAPTER_TECHNIQUE", "")),
            "dataset": props.get("ADAPTER_TUNE_DATASET", ""),
            "status": "not deployed",
        }

# ── Data source 2: Deployed adapter ICs ──
if endpoint_name:
    try:
        result = subprocess.run(
            ["aws", "sagemaker", "list-inference-components",
             "--endpoint-name-equals", endpoint_name, "--region", region],
            capture_output=True, text=True, timeout=15)
        if result.returncode == 0:
            ic_data = json.loads(result.stdout)
            for ic in ic_data.get("InferenceComponents", []):
                ic_name = ic["InferenceComponentName"]
                ic_status = ic.get("InferenceComponentStatus", "Unknown")
                # Check if adapter (has BaseInferenceComponentName) via describe
                desc = subprocess.run(
                    ["aws", "sagemaker", "describe-inference-component",
                     "--inference-component-name", ic_name, "--region", region],
                    capture_output=True, text=True, timeout=10)
                if desc.returncode == 0:
                    detail = json.loads(desc.stdout)
                    base_ic = detail.get("Specification", {}).get("BaseInferenceComponentName", "")
                    if not base_ic:
                        continue  # Base IC, not adapter
                    ic_status = detail.get("InferenceComponentStatus", ic_status)
                    display = ic_name
                    prefix = f"{project_name}-adapter-"
                    if ic_name.startswith(prefix):
                        display = ic_name[len(prefix):]
                    if display in adapters:
                        adapters[display]["status"] = ic_status
                    else:
                        adapters[display] = {"source": "external", "ic_name": ic_name,
                                             "technique": "", "dataset": "", "status": ic_status}
    except Exception:
        print("⚠️  Could not query endpoint — showing local confs only.", file=sys.stderr)

# ── Data source 3: Registry (MPG) adapters ──
# Query the deployment MPG for registered adapter versions (if .register_helper.py exists)
helper_path = os.path.join(script_dir, ".register_helper.py")
if os.path.exists(helper_path):
    try:
        result = subprocess.run(
            ["python3", helper_path, "list-adapters",
             "--project-name", project_name, "--region", region],
            capture_output=True, text=True, timeout=15)
        if result.returncode == 0:
            # Extract JSON line
            for line in result.stdout.strip().split("\n"):
                if line.startswith("{"):
                    reg_data = json.loads(line)
                    for adapter in reg_data.get("adapters", []):
                        reg_name = adapter.get("name", "")
                        if not reg_name:
                            continue
                        # Only add if not already tracked locally
                        if reg_name not in adapters:
                            adapters[reg_name] = {
                                "source": "registry",
                                "ic_name": "",
                                "technique": adapter.get("technique", ""),
                                "dataset": "",
                                "status": f"v{adapter.get('version', '?')}",
                            }
                        else:
                            # Annotate existing entry with registry version
                            ver = adapter.get("version", "")
                            if ver:
                                adapters[reg_name]["status"] += f" (reg:v{ver})"
                    break
    except Exception:
        pass  # Registry query is best-effort

# ── Output ──
if not adapters:
    print("No adapters found.")
    print("")
    print("Add one with: ./do/adapter add <name> --from-weights <s3-uri>")
    print("              ./do/adapter add <name> --from-hub <hf-repo-id>")
    print("              ./do/adapter add <name> --from-registry")
    sys.exit(0)

print(f"Adapters on endpoint: {endpoint_name or '<not deployed>'}")
print("")

# Column widths
max_n = max(len("NAME"), max(len(n) for n in adapters))
max_s = max(len("SOURCE"), max(len(a["source"]) for a in adapters.values()))
fmt = f"  {{:<{max_n + 3}}}{{:<{max_s + 3}}}{{}}  {{}}"

print(fmt.format("NAME", "SOURCE", "STATUS", ""))
print(fmt.format("----", "------", "------", ""))
for name in sorted(adapters):
    a = adapters[name]
    tune_info = ""
    if a["technique"]:
        tune_info = f"(tune: {a['technique']}" + (f" / {a['dataset']}" if a["dataset"] else "") + ")"
    print(fmt.format(name, a["source"], a["status"], tune_info))

print("")
print("Add adapter:      ./do/adapter add <name> --from-weights <s3-uri>")
print("From registry:    ./do/adapter add <name> --from-registry [version-arn]")
ADAPTER_LIST_PY
}

_adapter_remove() {
    local adapter_name=""

    # Parse remove arguments
    shift  # remove 'remove' from args
    while [ $# -gt 0 ]; do
        case "$1" in
            --help|-h)
                echo "Usage: ./do/adapter remove <name>"
                echo ""
                echo "Remove a LoRA adapter from the endpoint."
                echo ""
                echo "Arguments:"
                echo "  <name>  Adapter name to remove"
                exit 0
                ;;
            -*)
                echo "❌ Unknown option: $1"
                echo "   Usage: ./do/adapter remove <name>"
                exit 1
                ;;
            *)
                if [ -z "${adapter_name}" ]; then
                    adapter_name="$1"
                else
                    echo "❌ Unexpected argument: $1"
                    echo "   Usage: ./do/adapter remove <name>"
                    exit 1
                fi
                shift
                ;;
        esac
    done

    if [ -z "${adapter_name}" ]; then
        echo "❌ Adapter name is required"
        echo "   Usage: ./do/adapter remove <name>"
        exit 1
    fi

    echo "🗑️  Removing adapter: ${adapter_name}"
    echo ""

    # ── Validate adapter conf exists ──────────────────────────────────────
    local conf_file="${SCRIPT_DIR}/adapters/${adapter_name}.conf"
    if [ ! -f "${conf_file}" ]; then
        echo "❌ Adapter not found: ${adapter_name}"
        echo ""
        echo "   No configuration file at: do/adapters/${adapter_name}.conf"
        echo ""
        echo "   Available adapters:"
        if [ -d "${SCRIPT_DIR}/adapters" ]; then
            for f in "${SCRIPT_DIR}"/adapters/*.conf; do
                [ -f "${f}" ] || continue
                echo "   • $(basename "${f}" .conf)"
            done
        else
            echo "   (none)"
        fi
        exit 1
    fi

    # ── Read adapter IC name from conf ────────────────────────────────────
    local adapter_ic_name
    adapter_ic_name=$(grep "^export ADAPTER_IC_NAME=" "${conf_file}" 2>/dev/null | sed 's/^export ADAPTER_IC_NAME="//' | sed 's/"$//')

    if [ -z "${adapter_ic_name}" ]; then
        echo "❌ Could not read ADAPTER_IC_NAME from: do/adapters/${adapter_name}.conf"
        echo "   The conf file may be corrupted. Removing it manually."
        rm -f "${conf_file}"
        exit 1
    fi

    echo "📋 Adapter IC: ${adapter_ic_name}"

    # ── Delete the inference component ────────────────────────────────────
    echo "🔄 Deleting inference component: ${adapter_ic_name}"
    if ! aws sagemaker delete-inference-component \
        --inference-component-name "${adapter_ic_name}" \
        --region "${AWS_REGION}" 2>/dev/null; then

        # Check if it's already gone
        local current_status
        current_status=$(_get_ic_status "${adapter_ic_name}")
        if [ -z "${current_status}" ]; then
            echo "   Inference component already deleted or not found. Cleaning up local files."
        else
            echo "❌ Failed to delete inference component: ${adapter_ic_name}"
            echo "   Current status: ${current_status}"
            echo ""
            echo "   Check that your IAM credentials have sagemaker:DeleteInferenceComponent permission."
            exit 1
        fi
    fi

    # ── Wait for deletion to complete ─────────────────────────────────────
    echo "⏳ Waiting for adapter IC deletion to complete..."
    local wait_start
    wait_start=$(date +%s)
    local timeout=600  # 10 minutes

    while true; do
        local status
        status=$(_get_ic_status "${adapter_ic_name}")

        if [ -z "${status}" ] || [ "${status}" = "None" ]; then
            break
        fi

        local elapsed=$(( $(date +%s) - wait_start ))
        if [ "${elapsed}" -ge "${timeout}" ]; then
            echo "⚠️  Adapter IC still deleting after ${timeout}s."
            echo "   It may complete in the background. Local conf removed."
            break
        fi

        echo "   $(date +%H:%M:%S) Status: ${status} (${elapsed}s elapsed)..."
        sleep 10
    done

    echo "✅ Adapter IC deleted: ${adapter_ic_name}"

    # ── Remove local conf file ────────────────────────────────────────────
    rm -f "${conf_file}"
    echo "✅ Removed: do/adapters/${adapter_name}.conf"

    echo ""
    echo "✅ Adapter removed successfully: ${adapter_name}"
}

_adapter_update() {
    local adapter_name=""
    local weights_uri=""
    local from_hub=""

    # Parse update arguments
    shift  # remove 'update' from args
    while [ $# -gt 0 ]; do
        case "$1" in
            --from-weights|--weights)
                # --weights is the DEPRECATED alias of --from-weights (ADR-013 / R2).
                [ "$1" = "--weights" ] && _deprecated_flag_alias --weights --from-weights
                if [ -z "${2:-}" ]; then
                    echo "❌ $1 requires an S3 URI argument"
                    echo "   Usage: ./do/adapter update <name> --from-weights <new-s3-uri>"
                    exit 1
                fi
                weights_uri="$2"
                shift 2
                ;;
            --from-hub)
                if [ -z "${2:-}" ]; then
                    echo "❌ --from-hub requires a HuggingFace repo ID argument"
                    echo "   Usage: ./do/adapter update <name> --from-hub <hf-repo-id>"
                    exit 1
                fi
                from_hub="$2"
                shift 2
                ;;
            --help|-h)
                echo "Usage: ./do/adapter update <name> --from-weights <new-s3-uri>"
                echo "       ./do/adapter update <name> --from-hub <hf-repo-id>"
                echo ""
                echo "Update the weights of an existing LoRA adapter."
                echo ""
                echo "The new weights are promoted to a content-addressed version <home>/v<hash12>/ and the"
                echo "adapter IC is pointed at that NEW ArtifactUrl; the previous version is left intact"
                echo "(roll back with --from-weights <previous version URI>). Identical content is a no-op."
                echo ""
                echo "Arguments:"
                echo "  <name>                    Adapter name to update"
                echo "  --from-weights <new-s3-uri>  New S3 prefix or .tar.gz of the adapter weights"
                echo "                            (--weights is a deprecated alias)"
                echo "  --from-hub <hf-repo-id>   Download new weights from HuggingFace Hub"
                echo ""
                echo "Note: --from-weights and --from-hub are mutually exclusive."
                echo ""
                echo "Examples:"
                echo "  ./do/adapter update ectsum --from-weights s3://bucket/adapters/ectsum-v2/adapter.tar.gz"
                echo "  ./do/adapter update ectsum --from-hub predibase/llama-3.1-8b-ectsum-v2"
                exit 0
                ;;
            -*)
                echo "❌ Unknown option: $1"
                echo "   Usage: ./do/adapter update <name> --from-weights <new-s3-uri>"
                echo "          ./do/adapter update <name> --from-hub <hf-repo-id>"
                exit 1
                ;;
            *)
                if [ -z "${adapter_name}" ]; then
                    adapter_name="$1"
                else
                    echo "❌ Unexpected argument: $1"
                    echo "   Usage: ./do/adapter update <name> --from-weights <new-s3-uri>"
                    echo "          ./do/adapter update <name> --from-hub <hf-repo-id>"
                    exit 1
                fi
                shift
                ;;
        esac
    done

    # Validate required arguments
    if [ -z "${adapter_name}" ]; then
        echo "❌ Adapter name is required"
        echo "   Usage: ./do/adapter update <name> --from-weights <new-s3-uri>"
        echo "          ./do/adapter update <name> --from-hub <hf-repo-id>"
        exit 1
    fi

    # ── Mutual exclusivity check ─────────────────────────────────────────
    if [ -n "${weights_uri}" ] && [ -n "${from_hub}" ]; then
        echo "❌ --from-weights and --from-hub are mutually exclusive"
        echo ""
        echo "   Use one or the other:"
        echo "   ./do/adapter update ${adapter_name} --from-weights <s3-uri>"
        echo "   ./do/adapter update ${adapter_name} --from-hub <hf-repo-id>"
        exit 1
    fi

    if [ -z "${weights_uri}" ] && [ -z "${from_hub}" ]; then
        echo "❌ Either --from-weights or --from-hub is required"
        echo "   Usage: ./do/adapter update <name> --from-weights <new-s3-uri>"
        echo "          ./do/adapter update <name> --from-hub <hf-repo-id>"
        exit 1
    fi

    # ── Validate HF repo ID format (if --from-hub) ───────────────────────
    if [ -n "${from_hub}" ]; then
        if ! echo "${from_hub}" | grep -qE '^[a-zA-Z0-9._-]+(/[a-zA-Z0-9._-]+)?$'; then
            echo "❌ Invalid HuggingFace repo ID: ${from_hub}"
            echo ""
            echo "   Repo ID must be in format 'org/name' or 'name'"
            echo "   Examples: predibase/llama-3.1-8b-ectsum-v2, my-adapter"
            exit 1
        fi
    fi

    # ── Validate S3 URI format (only when --from-weights is used) ─────────────
    if [ -n "${weights_uri}" ]; then
        # A .tar.gz archive OR an S3 prefix of loose PEFT files (bucket R3.4): both
        # are promoted into the canonical prefix, which is what the IC loads. A
        # prefix is what ./do/adapter promote prints as the next step.
        if ! echo "${weights_uri}" | grep -qE '^s3://[^/]+/.+'; then
            echo "❌ Invalid S3 URI: ${weights_uri}"
            echo ""
            echo "   Adapter weights must be one of:"
            echo "   • An S3 prefix holding adapter_config.json + adapter weights (s3://bucket/path/)"
            echo "   • A .tar.gz archive containing those files at its top level"
            echo ""
            echo "   Example: s3://my-bucket/adapters/ectsum-v2/adapter.tar.gz"
            exit 1
        fi
    fi

    # ── Validate adapter conf exists ──────────────────────────────────────
    local conf_file="${SCRIPT_DIR}/adapters/${adapter_name}.conf"
    if [ ! -f "${conf_file}" ]; then
        echo "❌ Adapter not found: ${adapter_name}"
        echo ""
        echo "   No configuration file at: do/adapters/${adapter_name}.conf"
        echo ""
        echo "   Available adapters:"
        if [ -d "${SCRIPT_DIR}/adapters" ]; then
            for f in "${SCRIPT_DIR}"/adapters/*.conf; do
                [ -f "${f}" ] || continue
                echo "   • $(basename "${f}" .conf)"
            done
        else
            echo "   (none)"
        fi
        exit 1
    fi

    # ── Read adapter IC name from conf ────────────────────────────────────
    local adapter_ic_name
    adapter_ic_name=$(grep "^export ADAPTER_IC_NAME=" "${conf_file}" 2>/dev/null | sed 's/^export ADAPTER_IC_NAME="//' | sed 's/"$//')

    if [ -z "${adapter_ic_name}" ]; then
        echo "❌ Could not read ADAPTER_IC_NAME from: do/adapters/${adapter_name}.conf"
        echo "   The conf file may be corrupted."
        exit 1
    fi

    echo "🔄 Updating adapter: ${adapter_name}"
    echo "   IC Name: ${adapter_ic_name}"
    if [ -n "${from_hub}" ]; then
        echo "   Source: HuggingFace Hub (${from_hub})"
    else
        echo "   New weights: ${weights_uri}"
    fi
    echo ""

    # ── If --from-hub: download, tar, upload to S3 ────────────────────────
    if [ -n "${from_hub}" ]; then
        # Shared resolver → the existing _download_from_hub (stage to S3).
        local _hub_resolved
        _hub_resolved=$(_resolve_additive_source from-hub "${from_hub}" "${adapter_name}") || exit 1
        local RESOLVED_SOURCE="" RESOLVED_URI="" RESOLVED_KIND=""
        eval "${_hub_resolved}"
        weights_uri="${RESOLVED_URI}"
        echo ""
    fi

    # ── Promote the new weights into the canonical home (bucket consolidation R3.4) ──
    # BL199: the promotion is content-addressed (<home>/v<hash12>/), so new content
    # is a NEW ArtifactUrl (atomic and roll-back-able: the old version is never
    # rewritten) and identical content is the SAME URI.
    weights_uri=$(_adapter_promote_canonical "${weights_uri}" "${adapter_name}" "${MODEL_NAME:-}" \
        lora_adapter "" "do/adapter update") || exit 1

    # ── Unchanged content → no UpdateInferenceComponent ───────────────────
    # The IC already serves exactly this version; resending a byte-identical spec
    # is not a reliable reload, and there is nothing to reload.
    local _current_uri
    _current_uri=$(grep "^export ADAPTER_WEIGHTS_URI=" "${conf_file}" 2>/dev/null | sed 's/^export ADAPTER_WEIGHTS_URI="//' | sed 's/"$//' || echo "")
    if [ -n "${_current_uri}" ] && [ "${_current_uri%/}" = "${weights_uri%/}" ]; then
        echo "✅ Adapter '${adapter_name}' is unchanged: ${adapter_ic_name} already serves ${weights_uri}"
        echo "   (same content hash, same version). No UpdateInferenceComponent was sent."
        return 0
    fi
    [ -n "${_current_uri}" ] && echo "   Previous version (kept for rollback): ${_current_uri}"

    # ── Update the inference component ────────────────────────────────────
    echo "🚀 Updating inference component: ${adapter_ic_name}"
    if ! aws sagemaker update-inference-component \
        --inference-component-name "${adapter_ic_name}" \
        --specification "{\"Container\":{\"ArtifactUrl\":\"${weights_uri}\"}}" \
        --region "${AWS_REGION}"; then

        echo "❌ Failed to update adapter inference component"
        echo "   Check that:"
        echo "   • Your IAM credentials have sagemaker:UpdateInferenceComponent permission"
        echo "   • The adapter IC '${adapter_ic_name}' exists and is InService"
        echo "   • The new S3 URI is accessible by the SageMaker execution role"
        exit 1
    fi

    echo "✅ Adapter IC update initiated: ${adapter_ic_name}"

    # ── Wait for adapter IC to return to InService ────────────────────────
    echo "⏳ Waiting for adapter IC to return to InService..."
    echo "   The IC will transition through Updating state."

    wait_ic "${adapter_ic_name}"

    echo "✅ Adapter IC is InService: ${adapter_ic_name}"

    # ── Update conf file ──────────────────────────────────────────────────
    sed -i.bak "s|^export ADAPTER_WEIGHTS_URI=.*|export ADAPTER_WEIGHTS_URI=\"${weights_uri}\"|" "${conf_file}"
    rm -f "${conf_file}.bak"

    # Update hub-specific metadata
    if [ -n "${from_hub}" ]; then
        # Add or update ADAPTER_SOURCE
        if grep -q "^export ADAPTER_SOURCE=" "${conf_file}"; then
            sed -i.bak "s|^export ADAPTER_SOURCE=.*|export ADAPTER_SOURCE=\"hub\"|" "${conf_file}"
            rm -f "${conf_file}.bak"
        else
            echo "export ADAPTER_SOURCE=\"hub\"" >> "${conf_file}"
        fi

        # Add or update ADAPTER_HF_REPO
        if grep -q "^export ADAPTER_HF_REPO=" "${conf_file}"; then
            sed -i.bak "s|^export ADAPTER_HF_REPO=.*|export ADAPTER_HF_REPO=\"${from_hub}\"|" "${conf_file}"
            rm -f "${conf_file}.bak"
        else
            echo "export ADAPTER_HF_REPO=\"${from_hub}\"" >> "${conf_file}"
        fi
    fi

    echo ""
    echo "✅ Adapter updated successfully!"
    echo ""
    echo "📋 Updated Details:"
    echo "   Name: ${adapter_name}"
    echo "   IC Name: ${adapter_ic_name}"
    echo "   New Weights: ${weights_uri}"
    if [ -n "${from_hub}" ]; then
        echo "   Source: HuggingFace Hub (${from_hub})"
    fi
    echo ""
    echo "🧪 Test your updated adapter:"
    echo "   ./do/test ${adapter_name}"
}

_adapter_search() {
    local limit=10

    # Parse search arguments
    shift  # remove 'search' from args
    while [ $# -gt 0 ]; do
        case "$1" in
            --limit)
                if [ -z "${2:-}" ]; then
                    echo "❌ --limit requires a numeric argument"
                    echo "   Usage: ./do/adapter search [--limit N]"
                    exit 1
                fi
                limit="$2"
                shift 2
                ;;
            --help|-h)
                echo "Usage: ./do/adapter search [--limit N]"
                echo ""
                echo "Search HuggingFace Hub for LoRA adapters compatible with your base model."
                echo ""
                echo "Options:"
                echo "  --limit N   Maximum number of results (default: 10)"
                echo ""
                echo "Examples:"
                echo "  ./do/adapter search"
                echo "  ./do/adapter search --limit 20"
                echo ""
                echo "To add a found adapter:"
                echo "  ./do/adapter add <name> --from-hub <repo-id>"
                exit 0
                ;;
            -*)
                echo "❌ Unknown option: $1"
                echo "   Usage: ./do/adapter search [--limit N]"
                exit 1
                ;;
            *)
                echo "❌ Unexpected argument: $1"
                echo "   Usage: ./do/adapter search [--limit N]"
                exit 1
                ;;
        esac
    done

    # ── Validate MODEL_NAME is set ────────────────────────────────────────
    if [ -z "${MODEL_NAME:-}" ]; then
        echo "❌ MODEL_NAME is not configured in do/config."
        echo ""
        echo "   The search command requires a base model to find compatible adapters."
        exit 1
    fi

    echo "LoRA adapters for ${MODEL_NAME}:"
    echo ""

    # ── Build API URL ─────────────────────────────────────────────────────
    local encoded_model
    encoded_model=$(echo "${MODEL_NAME}" | sed 's|/|%2F|g')
    local api_url="https://huggingface.co/api/models?filter=peft&other=base_model:adapter:${encoded_model}&sort=downloads&direction=-1&limit=${limit}"

    # ── Make API request ──────────────────────────────────────────────────
    local curl_args=("-sS" "-f")
    if [ -n "${HF_TOKEN:-}" ]; then
        curl_args+=("-H" "Authorization: Bearer ${HF_TOKEN}")
    fi

    local response
    if ! response=$(curl "${curl_args[@]}" "${api_url}" 2>/dev/null); then
        echo "❌ Could not reach HuggingFace Hub. Check network connectivity."
        exit 1
    fi

    # ── Parse and display results ─────────────────────────────────────────
    local count=0

    if command -v jq &>/dev/null; then
        count=$(echo "${response}" | jq 'length' 2>/dev/null)
    else
        # Fallback: count array elements by counting "id" fields
        count=$(echo "${response}" | grep -o '"id"' | wc -l | tr -d ' ')
    fi

    if [ "${count}" -eq 0 ] || [ -z "${count}" ]; then
        echo "No adapters found for ${MODEL_NAME}."
        echo ""
        echo "Try searching with a different model name or check:"
        echo "  https://huggingface.co/models?other=base_model:adapter:${MODEL_NAME}&sort=downloads"
        return 0
    fi

    # ── Print results table ───────────────────────────────────────────────
    printf '%-4s%-42s%-12s%s\n' "#" "REPO ID" "DOWNLOADS" "DESCRIPTION"

    if command -v jq &>/dev/null; then
        local i=0
        while [ "${i}" -lt "${count}" ]; do
            local repo_id downloads description
            repo_id=$(echo "${response}" | jq -r ".[${i}].id // \"\"" 2>/dev/null)
            downloads=$(echo "${response}" | jq -r ".[${i}].downloads // 0" 2>/dev/null)
            description=$(echo "${response}" | jq -r ".[${i}].pipeline_tag // .[${i}].tags[0] // \"\"" 2>/dev/null)

            # Format downloads with commas
            local formatted_downloads
            formatted_downloads=$(printf "%'d" "${downloads}" 2>/dev/null || echo "${downloads}")

            local num=$((i + 1))
            printf '%-4s%-42s%-12s%s\n' "${num}" "${repo_id}" "${formatted_downloads}" "${description}"
            i=$((i + 1))
        done
    else
        # Fallback without jq: basic parsing
        local idx=1
        echo "${response}" | grep -o '"id":"[^"]*"' | sed 's/"id":"//;s/"$//' | while IFS= read -r repo_id; do
            printf '%-4s%-42s\n' "${idx}" "${repo_id}"
            idx=$((idx + 1))
        done
    fi

    echo ""
    echo "Add an adapter: ./do/adapter add <name> --from-hub <repo-id>"
}

# ── Main: parse subcommand ────────────────────────────────────────────────────
if [ $# -eq 0 ]; then
    _usage
    exit 1
fi

SUBCOMMAND="$1"

case "${SUBCOMMAND}" in
    add)
        _validate_lora_enabled
        _adapter_add "$@"
        ;;
    list)
        _validate_lora_enabled
        _adapter_list
        ;;
    remove)
        _validate_lora_enabled
        _adapter_remove "$@"
        ;;
    update)
        _validate_lora_enabled
        _adapter_update "$@"
        ;;
    search)
        _validate_lora_enabled
        _adapter_search "$@"
        ;;
    --help|-h)
        _usage
        exit 0
        ;;
    *)
        echo "❌ Unknown command: ${SUBCOMMAND}"
        echo ""
        _usage
        exit 1
        ;;
esac
