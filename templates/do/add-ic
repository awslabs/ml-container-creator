#!/bin/bash
# Copyright Amazon.com, Inc. or its affiliates. All Rights Reserved.
# SPDX-License-Identifier: Apache-2.0
#
# do/add-ic — Add a new inference component to this project.
#
# @mlcc-script
# type: deployment-centric
# guard: deployment-active
# lifecycle: post-deploy
# targets: realtime-inference

# Creates a new IC config file in do/ic/ and deploys it immediately.
#
# Usage:
#   ./do/add-ic [name] [--from-weights <s3-uri> | --from-tune [technique] | --from-registry <version-arn>]
#   ./do/add-ic --help
#
# Sources resolve through the shared ADR-013 resolver (_resolve_additive_source in
# lib/script-contract.sh); do/add-ic accepts full_model artifacts only (a LoRA
# adapter is refused → use do/adapter).
# Deprecated alias: --model-data <s3-uri> == --from-weights <s3-uri> (prints a notice).
# (Not to be confused with do/register's --model-data-url, which is unchanged.)

set -e
set -u
set -o pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${SCRIPT_DIR}/lib/script-contract.sh"
_require_python_env
source "${SCRIPT_DIR}/config"

# ── Target guard: DERIVED from the additive-deploy contract (ADR-013) ─────────
# do/add-ic accepts full_model artifacts and drives the SMAI Inference Component
# mechanism, which only realtime-inference exposes. The refusal on every other
# target (hyperpod-eks / eks / async / batch) is derived from the contract
# table's empty mechanism intersection and names the right verb — e.g. on
# hyperpod-eks a LoRA goes through `do/adapter add <name> --from-tune` and a
# full model through `do/add-pod <name> --from-tune` (BL149); plain eks has no
# full-model verb yet (do/add-pod on eks is post-2.0).
_additive_verb_supported_on add-ic "${DEPLOYMENT_TARGET:-}"

# ============================================================
# Usage
# ============================================================
_usage() {
    echo "Usage: ./do/add-ic [name] [options]"
    echo ""
    echo "Add a new inference component to this project, or update an existing one in-place."
    echo ""
    echo "Arguments:"
    echo "  [name]                     IC name (required for --update, optional otherwise)"
    echo ""
    echo "Options:"
    echo "  --from-weights <s3-uri>    S3 URI to model data (tar.gz or model directory)"
    echo "  --from-tune [technique]    Use model output from do/tune (TUNE_MODEL_PATH_<T> or TUNE_OUTPUT_PATH_LATEST)"
    echo "  --from-registry <arn>      Use a registered full-model package version"
    echo "  --update                   Update an existing IC in-place (zero-disruption swap)"
    echo "  --help, -h                 Show this help message"
    echo ""
    echo "Note: --from-weights, --from-tune, and --from-registry are mutually exclusive."
    echo "Deprecated: --model-data <s3-uri> is an alias of --from-weights (prints a notice)."
    echo "do/add-ic accepts full models only; a LoRA adapter is refused — use do/adapter add <name> --from-tune."
    echo ""
    echo "Update mode (--update):"
    echo "  Updates the model artifact on an existing deployed IC using UpdateInferenceComponent."
    echo "  This is a zero-disruption in-place swap — the IC is NOT deleted and recreated."
    echo "  Reads the deployed IC name from do/ic/<name>.conf (IC_DEPLOYED_NAME)."
    echo ""
    echo "Examples:"
    echo "  ./do/add-ic                                    # Interactive mode"
    echo "  ./do/add-ic tuned-v1 --from-tune               # Use latest tune output"
    echo "  ./do/add-ic tuned-v1 --from-weights s3://bucket/model.tar.gz"
    echo "  ./do/add-ic tuned-v1 --from-registry arn:aws:sagemaker:...:model-package/proj/3"
    echo ""
    echo "  # Update an existing IC in-place:"
    echo "  ./do/add-ic default --update                   # Re-deploy same artifact"
    echo "  ./do/add-ic default --update --from-tune       # Swap to latest tune output"
    echo "  ./do/add-ic default --update --from-weights s3://bucket/model.tar.gz"
    echo ""
}

# ============================================================
# Parse arguments
# ============================================================
IC_NAME=""
FROM_TUNE=""
FROM_TUNE_TECHNIQUE=""
FROM_REGISTRY=""
MODEL_DATA=""
UPDATE_MODE=""

while [ $# -gt 0 ]; do
    case "$1" in
        --from-tune)
            FROM_TUNE="true"
            # Optional technique argument (anything not starting with -), but only
            # once the IC name is known — `add-ic --from-tune` alone stays valid.
            if [ -n "${IC_NAME}" ] && [ -n "${2:-}" ] && [[ "${2}" != -* ]]; then
                FROM_TUNE_TECHNIQUE="$2"
                shift 2
            else
                shift
            fi
            ;;
        --from-weights|--model-data)
            # --model-data is the DEPRECATED alias of --from-weights (ADR-013 / R2).
            [ "$1" = "--model-data" ] && _deprecated_flag_alias --model-data --from-weights
            if [ -z "${2:-}" ]; then
                echo "❌ $1 requires an S3 URI argument"
                echo "   Usage: ./do/add-ic <name> --from-weights <s3-uri>"
                exit 1
            fi
            MODEL_DATA="$2"
            shift 2
            ;;
        --from-registry)
            if [ -z "${2:-}" ] || [[ "${2}" == -* ]]; then
                echo "❌ --from-registry requires a model-package version ARN"
                echo "   Usage: ./do/add-ic <name> --from-registry arn:aws:sagemaker:...:model-package/<group>/<version>"
                exit 1
            fi
            FROM_REGISTRY="$2"
            shift 2
            ;;
        --update)
            UPDATE_MODE="true"
            shift
            ;;
        --help|-h)
            _usage
            exit 0
            ;;
        -*)
            echo "❌ Unknown option: $1"
            _usage
            exit 1
            ;;
        *)
            if [ -z "${IC_NAME}" ]; then
                IC_NAME="$1"
            else
                echo "❌ Unexpected argument: $1"
                _usage
                exit 1
            fi
            shift
            ;;
    esac
done

# ============================================================
# Mutual exclusivity check
# ============================================================
_SOURCE_COUNT=0
[ -n "${FROM_TUNE}" ] && _SOURCE_COUNT=$((_SOURCE_COUNT + 1))
[ -n "${MODEL_DATA}" ] && _SOURCE_COUNT=$((_SOURCE_COUNT + 1))
[ -n "${FROM_REGISTRY}" ] && _SOURCE_COUNT=$((_SOURCE_COUNT + 1))
if [ "${_SOURCE_COUNT}" -gt 1 ]; then
    echo "❌ --from-weights, --from-tune, and --from-registry are mutually exclusive"
    echo ""
    echo "   Use one of:"
    echo "   ./do/add-ic <name> --from-tune [technique]"
    echo "   ./do/add-ic <name> --from-weights <s3-uri>"
    echo "   ./do/add-ic <name> --from-registry <version-arn>"
    exit 1
fi

# ============================================================
# Resolve the source through the shared ADR-013 resolver
# ============================================================
# --from-weights (raw S3), --from-tune and --from-registry all go through
# _resolve_additive_source; RESOLVED_URI becomes MODEL_DATA for the existing
# IC-config write + deploy --ic path. The kind gate reads the accepted kind from
# the contract table: a lora_adapter is refused (→ do/adapter); an unknown kind
# (raw S3 with no recorded kind) degrades to an advisory content check.
_IC_SOURCE_VERB=""
_IC_SOURCE_ARG=""
if [ -n "${FROM_TUNE}" ]; then
    _IC_SOURCE_VERB="from-tune"
    _IC_SOURCE_ARG="${FROM_TUNE_TECHNIQUE}"
elif [ -n "${FROM_REGISTRY}" ]; then
    _IC_SOURCE_VERB="from-registry"
    _IC_SOURCE_ARG="${FROM_REGISTRY}"
elif [ -n "${MODEL_DATA}" ]; then
    _IC_SOURCE_VERB="from-weights"
    _IC_SOURCE_ARG="${MODEL_DATA}"
fi
if [ -n "${_IC_SOURCE_VERB}" ]; then
    _IC_RESOLVED=$(_resolve_additive_source "${_IC_SOURCE_VERB}" "${_IC_SOURCE_ARG}" "${IC_NAME}" \
        "$(_additive_accepts_kind add-ic)") || exit 1
    RESOLVED_SOURCE="" RESOLVED_URI="" RESOLVED_KIND=""
    eval "${_IC_RESOLVED}"
    MODEL_DATA="${RESOLVED_URI}"
    _guard_artifact_kind "${RESOLVED_KIND}" "$(_additive_accepts_kind add-ic)" \
        "A LoRA adapter is not a standalone model — use: do/adapter add <name> --from-tune (or --from-weights s3://...)."
    if [ -z "${RESOLVED_KIND}" ] && [ "$(_additive_sniff_kind "${MODEL_DATA}")" = "lora_adapter" ]; then
        # Advisory only (R4.4 — unknown never hard-blocks).
        echo "⚠️  ${MODEL_DATA} contains adapter_config.json — it looks like a LoRA adapter."
        echo "   If so, use: do/adapter add <name> --from-weights ${MODEL_DATA}"
    fi
    echo "📦 Using --${RESOLVED_SOURCE} model data: ${MODEL_DATA}"
    echo ""
fi

# ============================================================
# UPDATE MODE: In-place update of existing IC
# ============================================================
if [ -n "${UPDATE_MODE}" ]; then
    # IC name is required for --update
    if [ -z "${IC_NAME}" ]; then
        echo "❌ IC name is required for --update"
        echo ""
        echo "   Usage: ./do/add-ic <ic-name> --update [--from-tune | --from-weights <s3-uri>]"
        echo ""
        echo "   Available ICs:"
        if [ -d "${SCRIPT_DIR}/ic" ]; then
            for conf_file in "${SCRIPT_DIR}"/ic/*.conf; do
                [ -f "${conf_file}" ] || continue
                _bn=$(basename "${conf_file}" .conf)
                echo "     ${_bn}"
            done
        else
            echo "     (none — no do/ic/ directory)"
        fi
        exit 1
    fi

    # Validate IC config exists
    IC_CONF_PATH="${SCRIPT_DIR}/ic/${IC_NAME}.conf"
    if [ ! -f "${IC_CONF_PATH}" ]; then
        echo "❌ IC config not found: do/ic/${IC_NAME}.conf"
        echo ""
        echo "   Available ICs:"
        for conf_file in "${SCRIPT_DIR}"/ic/*.conf; do
            [ -f "${conf_file}" ] || continue
            _bn=$(basename "${conf_file}" .conf)
            echo "     ${_bn}"
        done
        exit 1
    fi

    # Source the IC config to get IC_DEPLOYED_NAME
    source "${IC_CONF_PATH}"

    if [ -z "${IC_DEPLOYED_NAME:-}" ]; then
        echo "❌ IC '${IC_NAME}' has never been deployed (no IC_DEPLOYED_NAME in config)."
        echo ""
        echo "   Deploy it first with: ./do/deploy --ic ${IC_NAME}"
        exit 1
    fi

    # Resolve model data: --from-weights / --from-tune / --from-registry > current IC_MODEL_DATA
    if [ -z "${MODEL_DATA}" ] && [ -n "${IC_MODEL_DATA:-}" ]; then
        MODEL_DATA="${IC_MODEL_DATA}"
        echo "📦 Using current model data from IC config: ${MODEL_DATA}"
        echo ""
    fi

    # Resolve container image
    IC_IMAGE="${ECR_REPOSITORY:-}:${IC_IMAGE_TAG:-${PROJECT_NAME}-latest}"

    echo "🔄 Update Inference Component (in-place)"
    echo "   Project:  ${PROJECT_NAME}"
    echo "   IC name:  ${IC_DEPLOYED_NAME}"
    echo "   IC config: do/ic/${IC_NAME}.conf"
    if [ -n "${MODEL_DATA}" ]; then
        echo "   Model data: ${MODEL_DATA}"
    fi
    echo "   Image:    ${IC_IMAGE}"
    echo ""

    # Build python args
    PYTHON_ARGS=(
        "--ic-name" "${IC_DEPLOYED_NAME}"
        "--region" "${AWS_REGION:-us-east-1}"
    )
    if [ -n "${MODEL_DATA}" ]; then
        PYTHON_ARGS+=("--from-weights" "${MODEL_DATA}")
    fi
    if [ -n "${IC_IMAGE}" ]; then
        PYTHON_ARGS+=("--image" "${IC_IMAGE}")
    fi

    # Call the update helper
    # BL165: capture the exit code explicitly — a bare `X=$(cmd)` under set -e
    # would abort silently on failure before the error below could be shown.
    UPDATE_EXIT=0
    UPDATE_OUTPUT=$(python3 "${SCRIPT_DIR}/lib/python/ic_update.py" "${PYTHON_ARGS[@]}") || UPDATE_EXIT=$?

    if [ ${UPDATE_EXIT} -ne 0 ]; then
        echo "❌ IC update failed"
        echo ""
        _err_msg=$(echo "${UPDATE_OUTPUT}" | python3 -c "import sys,json; print(json.loads(sys.stdin.read()).get('message','Unknown error'))" 2>/dev/null || echo "${UPDATE_OUTPUT}")
        echo "   ${_err_msg}"
        exit 4
    fi

    # Parse result
    _status=$(echo "${UPDATE_OUTPUT}" | python3 -c "import sys,json; print(json.loads(sys.stdin.read()).get('status','Unknown'))" 2>/dev/null)
    _elapsed=$(echo "${UPDATE_OUTPUT}" | python3 -c "import sys,json; print(json.loads(sys.stdin.read()).get('elapsed_seconds',0))" 2>/dev/null)

    echo ""
    echo "✅ Inference component updated successfully"
    echo "   IC name:  ${IC_DEPLOYED_NAME}"
    echo "   Status:   ${_status}"
    echo "   Duration: ${_elapsed}s"
    if [ -n "${MODEL_DATA}" ]; then
        echo "   Model:    ${MODEL_DATA}"
    fi
    echo ""

    # Persist the new model data back to IC config if it changed
    if [ -n "${MODEL_DATA}" ]; then
        source "${SCRIPT_DIR}/lib/wait.sh"
        _update_config_var "IC_MODEL_DATA" "${MODEL_DATA}" "${IC_CONF_PATH}"
    fi

    exit 0
fi

echo "➕ Add New Inference Component"
echo "   Project: ${PROJECT_NAME}"
if [ -n "${MODEL_DATA}" ]; then
    echo "   Model data: ${MODEL_DATA}"
fi
echo ""

# ============================================================
# Query model registry for available versions (AC-5.1)
# Non-intrusive: if registry query fails, skip silently
# ============================================================
REGISTRY_MODELS_JSON=""
REGISTRY_MODEL_COUNT=0
REGISTRY_SELECTED_MODEL_DATA=""
REGISTRY_SELECTED_IMAGE=""

if [ -z "${MODEL_DATA}" ]; then
    # Only query registry if MODEL_DATA was not already provided via a --from-* source
    if [ -t 0 ]; then
        # Interactive mode: query registry for available models
        _registry_json=$(python3 "${SCRIPT_DIR}/.register_helper.py" list-models \
            --project-name "${PROJECT_NAME}" \
            --region "${AWS_REGION:-us-east-1}" 2>/dev/null || echo "")

        _registry_line=$(echo "${_registry_json}" | grep -E '^\{' | tail -1)

        if [ -n "${_registry_line}" ]; then
            REGISTRY_MODEL_COUNT=$(echo "${_registry_line}" | python3 -c "import sys,json; data=json.loads(sys.stdin.read()); print(len(data.get('models',[])))" 2>/dev/null || echo "0")

            if [ "${REGISTRY_MODEL_COUNT}" -gt 0 ]; then
                REGISTRY_MODELS_JSON="${_registry_line}"

                echo "📦 Available registered models:"
                echo ""
                printf '  %-4s%-10s%-12s%-38s%s\n' "#" "VERSION" "CONFIG" "MODEL" "INSTANCE"

                _i=0
                while [ "${_i}" -lt "${REGISTRY_MODEL_COUNT}" ]; do
                    _v=$(echo "${REGISTRY_MODELS_JSON}" | python3 -c "import sys,json; data=json.loads(sys.stdin.read()); print(data['models'][${_i}].get('version','?'))" 2>/dev/null)
                    _c=$(echo "${REGISTRY_MODELS_JSON}" | python3 -c "import sys,json; data=json.loads(sys.stdin.read()); print(data['models'][${_i}].get('deploymentConfig','?'))" 2>/dev/null)
                    _m=$(echo "${REGISTRY_MODELS_JSON}" | python3 -c "import sys,json; data=json.loads(sys.stdin.read()); m=data['models'][${_i}].get('modelName','?'); print(m[:36]+'…' if len(m)>36 else m)" 2>/dev/null)
                    _inst=$(echo "${REGISTRY_MODELS_JSON}" | python3 -c "import sys,json; data=json.loads(sys.stdin.read()); print(data['models'][${_i}].get('instanceType','?'))" 2>/dev/null)

                    _num=$((_i + 1))
                    printf '  %-4s%-10s%-12s%-38s%s\n' "${_num}" "v${_v}" "${_c}" "${_m}" "${_inst}"
                    _i=$((_i + 1))
                done

                echo ""
                read -p "Select a model (1-${REGISTRY_MODEL_COUNT}) or press Enter to specify manually: " _selection

                if [ -n "${_selection}" ]; then
                    # Validate selection
                    if echo "${_selection}" | grep -qE '^[0-9]+$' && [ "${_selection}" -ge 1 ] && [ "${_selection}" -le "${REGISTRY_MODEL_COUNT}" ]; then
                        _sel_idx=$((_selection - 1))
                        REGISTRY_SELECTED_MODEL_DATA=$(echo "${REGISTRY_MODELS_JSON}" | python3 -c "import sys,json; data=json.loads(sys.stdin.read()); print(data['models'][${_sel_idx}].get('modelDataUrl',''))" 2>/dev/null || echo "")
                        REGISTRY_SELECTED_IMAGE=$(echo "${REGISTRY_MODELS_JSON}" | python3 -c "import sys,json; data=json.loads(sys.stdin.read()); img=data['models'][${_sel_idx}].get('containerImage',''); print(img.split('/')[-1] if '/' in img else img)" 2>/dev/null || echo "")

                        echo ""
                        echo "✅ Selected registry model v$(echo "${REGISTRY_MODELS_JSON}" | python3 -c "import sys,json; data=json.loads(sys.stdin.read()); print(data['models'][${_sel_idx}].get('version','?'))" 2>/dev/null)"
                        echo ""
                    else
                        echo "   ⚠️  Invalid selection, proceeding with manual entry."
                        echo ""
                    fi
                fi
                # If user pressed Enter without selection, proceed with manual entry
            fi
        fi
    fi
fi

# ============================================================
# Prompt for IC name (if not provided as argument)
# ============================================================
if [ -z "${IC_NAME}" ]; then
    while true; do
        read -p "IC name (lowercase alphanumeric + hyphens): " IC_NAME

        # Validate: non-empty
        if [ -z "${IC_NAME}" ]; then
            echo "   ❌ IC name cannot be empty."
            continue
        fi

        # Validate: lowercase alphanumeric + hyphens only
        if ! echo "${IC_NAME}" | grep -qE '^[a-z0-9]([a-z0-9-]*[a-z0-9])?$'; then
            echo "   ❌ IC name must be lowercase alphanumeric with hyphens (e.g., 'llama-70b')."
            echo "      Must start and end with a letter or number."
            continue
        fi

        # Validate: no collision with existing config
        if [ -f "${SCRIPT_DIR}/ic/${IC_NAME}.conf" ]; then
            echo "   ❌ IC config already exists: do/ic/${IC_NAME}.conf"
            echo "      Choose a different name or edit the existing config."
            continue
        fi

        break
    done
else
    # Validate provided IC name
    if ! echo "${IC_NAME}" | grep -qE '^[a-z0-9]([a-z0-9-]*[a-z0-9])?$'; then
        echo "❌ Invalid IC name: ${IC_NAME}"
        echo "   IC name must be lowercase alphanumeric with hyphens (e.g., 'llama-70b')."
        echo "   Must start and end with a letter or number."
        exit 1
    fi

    if [ -f "${SCRIPT_DIR}/ic/${IC_NAME}.conf" ]; then
        echo "❌ IC config already exists: do/ic/${IC_NAME}.conf"
        echo "   Choose a different name or edit the existing config."
        exit 1
    fi
fi

# ============================================================
# Prompt for image tag (AC-5.2, AC-5.3: pre-fill from registry, user can override)
# ============================================================
if [ -n "${REGISTRY_SELECTED_IMAGE}" ]; then
    DEFAULT_IMAGE_TAG="${REGISTRY_SELECTED_IMAGE}"
else
    DEFAULT_IMAGE_TAG="${PROJECT_NAME}-latest"
fi
read -p "Image tag [${DEFAULT_IMAGE_TAG}]: " IC_IMAGE_TAG
IC_IMAGE_TAG="${IC_IMAGE_TAG:-${DEFAULT_IMAGE_TAG}}"

# ============================================================
# Prompt for model data URL (AC-5.2, AC-5.3: pre-fill from registry, user can override)
# ============================================================
if [ -z "${MODEL_DATA}" ] && [ -n "${REGISTRY_SELECTED_MODEL_DATA}" ]; then
    # Pre-fill from registry selection — user can override (AC-5.3)
    read -p "Model data URL [${REGISTRY_SELECTED_MODEL_DATA}]: " _model_data_input
    MODEL_DATA="${_model_data_input:-${REGISTRY_SELECTED_MODEL_DATA}}"
elif [ -z "${MODEL_DATA}" ]; then
    # No registry selection — offer manual entry (optional)
    read -p "Model data URL (S3 URI, optional — press Enter to skip): " _model_data_input
    MODEL_DATA="${_model_data_input:-}"
fi

# ============================================================
# Prompt for GPU count
# ============================================================
read -p "GPU count [1]: " IC_GPU_COUNT
IC_GPU_COUNT="${IC_GPU_COUNT:-1}"

# Validate numeric
if ! echo "${IC_GPU_COUNT}" | grep -qE '^[0-9]+$'; then
    echo "   ❌ GPU count must be a positive integer."
    exit 1
fi

# ============================================================
# Prompt for copy count
# ============================================================
read -p "Copy count [1]: " IC_COPY_COUNT
IC_COPY_COUNT="${IC_COPY_COUNT:-1}"

# Validate numeric
if ! echo "${IC_COPY_COUNT}" | grep -qE '^[0-9]+$'; then
    echo "   ❌ Copy count must be a positive integer."
    exit 1
fi

# ============================================================
# Prompt for memory MB
# ============================================================
read -p "Min memory MB [1024]: " IC_MIN_MEMORY_MB
IC_MIN_MEMORY_MB="${IC_MIN_MEMORY_MB:-1024}"

# Validate numeric
if ! echo "${IC_MIN_MEMORY_MB}" | grep -qE '^[0-9]+$'; then
    echo "   ❌ Memory MB must be a positive integer."
    exit 1
fi

# ============================================================
# Create IC config file
# ============================================================
IC_CONF_PATH="${SCRIPT_DIR}/ic/${IC_NAME}.conf"
mkdir -p "${SCRIPT_DIR}/ic"

cat > "${IC_CONF_PATH}" <<EOF
# Per-IC configuration: ${IC_NAME}
# Created by do/add-ic on $(date -u +"%Y-%m-%dT%H:%M:%SZ")
#
# This file is sourced by do/lib/inference-component.sh during deployment.
# After deployment, IC_DEPLOYED_NAME and IC_DEPLOYED_AT will be appended
# by the deploy script to track the active inference component.

export IC_IMAGE_TAG="${IC_IMAGE_TAG}"
export IC_GPU_COUNT=${IC_GPU_COUNT}
export IC_COPY_COUNT=${IC_COPY_COUNT}
export IC_MIN_MEMORY_MB=${IC_MIN_MEMORY_MB}
export IC_STARTUP_TIMEOUT=900
EOF

# Add model data if provided (from a --from-* source or registry selection)
if [ -n "${MODEL_DATA}" ]; then
    cat >> "${IC_CONF_PATH}" <<EOF
export IC_MODEL_DATA="${MODEL_DATA}"
EOF
fi

cat >> "${IC_CONF_PATH}" <<EOF

# Optional overrides:
# export IC_MODEL_NAME="my-model-v2"
# export IC_CONTAINER_ENV_EXTRA='"KEY":"value"'

EOF

echo ""
echo "✅ Created IC config: do/ic/${IC_NAME}.conf"
echo "   Image tag:  ${IC_IMAGE_TAG}"
echo "   GPU count:  ${IC_GPU_COUNT}"
echo "   Copy count: ${IC_COPY_COUNT}"
echo "   Memory MB:  ${IC_MIN_MEMORY_MB}"
if [ -n "${MODEL_DATA}" ]; then
    echo "   Model data: ${MODEL_DATA}"
fi
echo ""

# ============================================================
# Deploy the new IC immediately
# ============================================================
# Wave 10 (ADR-014 R3.3): an IC added later is not registered for scale-to-zero.
source "${SCRIPT_DIR}/lib/scale-to-zero.sh"
if stz_active "${DEPLOYMENT_TARGET:-}"; then
    stz_add_ic_notice
    echo ""
    export MLCC_STZ_ADD_IC_NOTICE=1
fi
echo "🚀 Deploying IC '${IC_NAME}'..."
echo ""
exec "${SCRIPT_DIR}/deploy" --ic "${IC_NAME}"
