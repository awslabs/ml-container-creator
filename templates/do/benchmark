# lifecycle: post-deploy
# targets: all

# Uses NVIDIA AIPerf via the SageMaker AI Benchmarking service to measure
# LLM endpoint performance: throughput, latency, TTFT, and ITL.

set -e
set -u
set -o pipefail

# Normalize --flag=value → --flag value before any arg inspection below.
# This lets users pass either `--min-tp 4` or `--min-tp=4`.
_NORMALIZED_ARGS=()
for _a in "$@"; do
    case "$_a" in
        --*=*) _NORMALIZED_ARGS+=("${_a%%=*}" "${_a#*=}") ;;
        *)     _NORMALIZED_ARGS+=("$_a") ;;
    esac
done
set -- "${_NORMALIZED_ARGS[@]+"${_NORMALIZED_ARGS[@]}"}"

# ── Source project configuration ──────────────────────────────────────────────
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Check for --json or --compare-baseline flag early — suppress config output for structured output modes
_BENCHMARK_JSON_MODE=false
for _arg in "$@"; do
    case "$_arg" in
        --json|--compare-baseline|--gpu-metrics|--peak|--list|--set-baseline)
            _BENCHMARK_JSON_MODE=true; break ;;
    esac
done

source "${SCRIPT_DIR}/lib/script-contract.sh"
_require_python_env
if [ "${_BENCHMARK_JSON_MODE}" = true ]; then
    # Source config with stdout redirected to stderr — config vars load correctly,
    # but the "Configuration loaded" header goes to stderr (visible in terminal,
    # doesn't pollute stdout piping or --json output).
    source "${SCRIPT_DIR}/config" 1>&2
else
    source "${SCRIPT_DIR}/config"
fi
source "${SCRIPT_DIR}/lib/profile.sh"
source "${SCRIPT_DIR}/lib/resolve-instance.sh"

# ── BL165: capture-and-surface for PRIMARY operation failures ─────────────────
# A `2>/dev/null` on a primary operation (describe the endpoint / benchmark job,
# download results, resolve the dataset, query benchmark history) turned real
# failures — AWS AccessDenied, expired credentials, a helper traceback — into a
# generic message, a misleading "not found", or a silent exit under `set -e`.
# Primary calls now capture stderr to a temp file and pass it here on failure.
# `2>/dev/null` remains only on genuinely optional probes (existence checks,
# process-liveness `kill -0`, pretty-print / parse-only fallbacks, the opt-in
# Phase 2 poller), each commented with why it is safe.
#   _bm_surface_stderr <stderr-file> [label]   (prints to stderr, removes file)
_bm_surface_stderr() {
    local _f="${1:-}" _label="${2:-error output}"
    if [ -n "${_f}" ] && [ -s "${_f}" ]; then
        echo "   ── ${_label} ──────────────────────────────────────" >&2
        sed 's/^/   /' "${_f}" >&2
        echo "   ─────────────────────────────────────────────────────" >&2
    fi
    if [ -n "${_f}" ]; then
        rm -f "${_f}"
    fi
    return 0
}

# ── Phase 2 engine /metrics scrape (BL086, HyperPod EKS opt-in) ───────────────
# BL108 upgrades the BL086 point-in-time /metrics scrape into a background
# poller. When HP_BENCHMARK_METRICS_ENABLED=true, DEPLOYMENT_TARGET is
# hyperpod-eks/eks, AND the active engine's serve.d/<engine>/manifest.json
# declares a metrics_endpoint (BL105), a background poller is spawned at
# benchmark start (Req 1.1). It samples engine /metrics every 5s for the whole
# run and writes peak/avg per pod to benchmarks/<job>/gpu_metrics-c<level>-<pod>.json
# at the end (Req 2, 3; Wave 9 R6.2/R6.3: every Running pod, per job + level). When no metrics_endpoint is declared, Phase 2 is silently skipped
# (Req 4.1). The port-forward is started before the poller (Req 7.1) and stopped
# after benchmark end, on both normal and abnormal exit (Req 7.2).
#
# State shared between _phase2_start_poller and _phase2_stop_poller
# (Wave 9 R6.2: one port-forward + poller per Running pod, bash 3.2 arrays):
_PHASE2_PF_PIDS=()       # kubectl port-forward PIDs
_PHASE2_POLLER_PIDS=()   # phase2_poller.py PIDs
_PHASE2_STOP_FILE=""     # sentinel file that signals every poller to stop
_PHASE2_ACTIVE=false     # true once at least one poller has been spawned
_PHASE2_SIDECAR_DIR=""   # benchmarks/<job>/ — per-pod sidecars for this level
_PHASE2_LEVEL=""         # concurrency level the sidecars belong to
_PHASE2_MAX_PODS=8       # cap on concurrent per-pod port-forwards

# ── Spawn the poller (Req 1, 4, 7.1) ──────────────────────────────────────────
# Resolves the metrics_endpoint from the engine manifest and, only if declared,
# starts the port-forward and spawns the background poller. Always non-fatal:
# any failure degrades to "no Phase 2 file" and returns 0.
# BL165 (kept swallows): every `2>/dev/null` / `|| return 0` in this function and
# in _phase2_stop_poller is intentional — Phase 2 is an OPT-IN enrichment
# (HP_BENCHMARK_METRICS_ENABLED) whose documented contract (BL086/BL108 Req 4.1,
# 7.x) is "silently skip, never fail the benchmark". `kill -0` calls are
# process-liveness probes, not operations.
_phase2_start_poller() {
    # Outer opt-in guards (subsume the BL086 gates). Silent skip if not opted in.
    if [ "${HP_BENCHMARK_METRICS_ENABLED:-false}" != "true" ]; then
        return 0
    fi
    if [ "${DEPLOYMENT_TARGET:-}" != "hyperpod-eks" ] && [ "${DEPLOYMENT_TARGET:-}" != "eks" ]; then
        return 0
    fi

    local _sd
    _sd="$(dirname "${BASH_SOURCE[0]}")"

    # Req 4.1: spawn only if the engine manifest declares a metrics_endpoint.
    # serve_manifest.py exits non-zero (and prints nothing usable) when absent.
    local _me_json
    _me_json=$(python3 "${_sd}/lib/python/serve_manifest.py" metrics_endpoint "${MODEL_SERVER}" 2>/dev/null) || _me_json=""
    if [ -z "${_me_json}" ] || [ "${_me_json}" = "null" ]; then
        # No metrics_endpoint → silently skip Phase 2 (no poller, no error).
        return 0
    fi

    # Extract the remote port from the metrics_endpoint (default 8080, matching
    # the historical hardcoded value). Parsing failures fall back to 8080.
    local _remote_port
    _remote_port=$(printf '%s' "${_me_json}" | python3 -c \
        'import json,sys
try:
    print(int(json.load(sys.stdin).get("port", 8080)))
except Exception:
    print(8080)' 2>/dev/null) || _remote_port=8080
    [ -z "${_remote_port}" ] && _remote_port=8080

    # Resolve kubeconfig for the cluster. The exec credential (aws eks get-token)
    # must run with the correct AWS profile, only available after do/config is
    # sourced — so always run update-kubeconfig rather than reusing a stale file.
    local _kubeconfig _eks_name
    local _profile_arg=""
    [ -n "${AWS_PROFILE:-}" ] && _profile_arg="--profile ${AWS_PROFILE}"
    if [ "${DEPLOYMENT_TARGET:-}" = "eks" ]; then
        # Plain EKS (BL157/R5): the cluster is a native EKS cluster, NOT a HyperPod
        # cluster — resolve it directly via `aws eks update-kubeconfig` on
        # HP_CLUSTER_NAME (mirror the eks run's kubeconfig block), not the HyperPod
        # `aws sagemaker describe-cluster` API. Skip silently when unset.
        [ -z "${HP_CLUSTER_NAME:-}" ] && return 0
        _eks_name="${HP_CLUSTER_NAME}"
        _kubeconfig="${HOME}/.kube/eks-${HP_CLUSTER_NAME}"
    else
        # HyperPod EKS: the EKS cluster ARN is resolved from the HyperPod cluster.
        _kubeconfig="${HOME}/.kube/hyperpod-${HP_CLUSTER_NAME:-}"
        local _eks_arn
        _eks_arn=$(aws sagemaker describe-cluster \
            --cluster-name "${HP_CLUSTER_NAME:-}" \
            --region "${AWS_REGION}" \
            --query "Orchestrator.Eks.ClusterArn" \
            --output text 2>/dev/null) || return 0
        [ -z "${_eks_arn}" ] || [ "${_eks_arn}" = "None" ] && return 0
        _eks_name=$(echo "${_eks_arn}" | awk -F'/' '{print $NF}')
    fi
    aws eks update-kubeconfig \
        --name "${_eks_name}" \
        --region "${AWS_REGION}" \
        ${_profile_arg} \
        --kubeconfig "${_kubeconfig}" >/dev/null 2>&1 || return 0
    export KUBECONFIG="${_kubeconfig}"

    kubectl cluster-info >/dev/null 2>&1 || return 0

    # Wave 9 R6.2: discover EVERY Running serving pod (not just items[0]); the
    # cap bounds the number of concurrent port-forwards. Empty → silent skip.
    local _pods
    _pods=$(kubectl get pods -n "${HP_NAMESPACE:-default}" \
        -l "app=${PROJECT_NAME}" \
        --field-selector=status.phase=Running \
        -o jsonpath='{.items[*].metadata.name}' 2>/dev/null) || return 0
    [ -z "${_pods}" ] && return 0

    # Wave 9 R6.3: per-job, per-level sidecars, one per pod. The writer merges
    # them for this level; the fixed .last_gpu_metrics.json is only a display
    # copy written at stop time and is never a write input.
    _PHASE2_SIDECAR_DIR="${SCRIPT_DIR}/../benchmarks/${BENCHMARK_JOB_NAME:-unnamed}"
    _PHASE2_LEVEL="${BENCHMARK_CONCURRENCY:-1}"
    mkdir -p "${_PHASE2_SIDECAR_DIR}" 2>/dev/null || return 0
    _PHASE2_STOP_FILE="$(mktemp -t mlcc_phase2_stop.XXXXXX)"
    rm -f "${_PHASE2_STOP_FILE}" 2>/dev/null || true  # sentinel must not pre-exist

    local _pod _i=0 _local_port _pf_pid _poller_pid
    for _pod in ${_pods}; do
        [ "${_i}" -ge "${_PHASE2_MAX_PODS}" ] && break
        # Ports 18180+i: clear of the eks load port-forward (HP_BENCHMARK_PORT,
        # default 18080), which runs at the same time.
        _local_port=$((18180 + _i))
        # Req 7.1: start the port-forward BEFORE the poller.
        kubectl port-forward "pod/${_pod}" "${_local_port}:${_remote_port}" \
            -n "${HP_NAMESPACE:-default}" >/dev/null 2>&1 &
        _pf_pid=$!
        sleep 3
        if ! kill -0 "${_pf_pid}" 2>/dev/null; then
            # Port-forward failed → non-fatal, skip this pod (Error Handling).
            _i=$((_i + 1))
            continue
        fi
        _PHASE2_PF_PIDS+=("${_pf_pid}")
        # Req 1.1: spawn the background poller only after the port-forward is live.
        python3 "${_sd}/lib/python/phase2_poller.py" \
            "http://localhost:${_local_port}" "${MODEL_SERVER}" \
            "${_PHASE2_SIDECAR_DIR}/gpu_metrics-c${_PHASE2_LEVEL}-${_i}.json" \
            --interval 5 --min-samples 5 --stop-file "${_PHASE2_STOP_FILE}" \
            >/dev/null 2>&1 &
        _poller_pid=$!
        if kill -0 "${_poller_pid}" 2>/dev/null; then
            _PHASE2_POLLER_PIDS+=("${_poller_pid}")
            _PHASE2_ACTIVE=true
        else
            # Req 1.2: poller failed to spawn → continue without it, warn.
            echo "⚠️  Phase 2 metrics poller failed to spawn for pod/${_pod} (non-fatal)" >&2
        fi
        _i=$((_i + 1))
    done
    if [ "${_PHASE2_ACTIVE}" != "true" ]; then
        # Nothing spawned: tear down any live port-forwards now.
        local _p
        for _p in ${_PHASE2_PF_PIDS[@]+"${_PHASE2_PF_PIDS[@]}"}; do
            kill "${_p}" 2>/dev/null || true
        done
        _PHASE2_PF_PIDS=()
        rm -f "${_PHASE2_STOP_FILE}" 2>/dev/null || true
        _PHASE2_STOP_FILE=""
    fi
    return 0
}

# ── Stop the poller and port-forward (Req 3, 7.2) ─────────────────────────────
# Signals the pollers to stop (each aggregates + writes its per-pod sidecar),
# waits for it to finish, then stops the port-forward. Safe to call multiple
# times and from an EXIT trap; runs regardless of how the benchmark ended.
_phase2_stop_poller() {
    if [ "${_PHASE2_ACTIVE}" != "true" ]; then
        return 0
    fi
    _PHASE2_ACTIVE=false

    # Signal every poller to stop via the sentinel file (Req 3.1: each writes on stop).
    [ -n "${_PHASE2_STOP_FILE}" ] && : > "${_PHASE2_STOP_FILE}" 2>/dev/null || true

    # Wait for the pollers to finish writing (bounded so a hung poller cannot
    # stall the benchmark). Each should exit within ~1 interval of the sentinel.
    local _pid _waited
    for _pid in ${_PHASE2_POLLER_PIDS[@]+"${_PHASE2_POLLER_PIDS[@]}"}; do
        _waited=0
        while kill -0 "${_pid}" 2>/dev/null; do
            sleep 1
            _waited=$((_waited + 1))
            if [ ${_waited} -ge 15 ]; then
                kill "${_pid}" 2>/dev/null || true
                break
            fi
        done
        wait "${_pid}" 2>/dev/null || true
    done
    _PHASE2_POLLER_PIDS=()

    # Req 7.2: stop the port-forwards AFTER the pollers have finished.
    for _pid in ${_PHASE2_PF_PIDS[@]+"${_PHASE2_PF_PIDS[@]}"}; do
        kill "${_pid}" 2>/dev/null || true
    done
    _PHASE2_PF_PIDS=()

    [ -n "${_PHASE2_STOP_FILE}" ] && rm -f "${_PHASE2_STOP_FILE}" 2>/dev/null || true
    _PHASE2_STOP_FILE=""

    # Display copy for `do/benchmark --gpu-metrics` only (read-only view of the
    # latest level, merged across pods). The Athena write never reads it (R6.3).
    if [ -n "${_PHASE2_SIDECAR_DIR}" ]; then
        local _sd _merged
        _sd="$(dirname "${BASH_SOURCE[0]}")"
        _merged=$(python3 "${_sd}/lib/python/gpu_metrics.py" merge-sidecars \
            "${_PHASE2_SIDECAR_DIR}" "${_PHASE2_LEVEL:-1}" 2>/dev/null) || _merged=""
        if [ -n "${_merged}" ] && [ "${_merged}" != "{}" ]; then
            printf '%s\n' "${_merged}" > "${SCRIPT_DIR}/../benchmarks/.last_gpu_metrics.json" 2>/dev/null || true
        fi
    fi
    return 0
}

# Req 7.3: ensure the port-forward is stopped on any exit (normal or abnormal,
# including a poller crash or an interrupt during the run).
trap '_phase2_stop_poller' EXIT

# ── Target guard: benchmark uses InvokeEndpoint (real-time only) ──────────────
# BL086: run-window timestamps for post-run CloudWatch enrichment (set at
# job creation / completion). Default empty so ${VAR:+...} expansions are safe.
BENCHMARK_RUN_START="${BENCHMARK_RUN_START:-}"
BENCHMARK_RUN_END="${BENCHMARK_RUN_END:-}"
# async-inference and batch-transform carry distinct guidance and sit above the
# plain-EKS path below, so they stay explicit branches; _contract_violation
# gives each the standard contract-violation format + exit 3.
if [ "${DEPLOYMENT_TARGET:-}" = "async-inference" ]; then
    _contract_violation "target" \
        "do/benchmark is not supported on async-inference. AIPerf benchmarking uses synchronous InvokeEndpoint calls; async endpoints only support invoke-endpoint-async." \
        "Switch target: do/deploy --target realtime-inference"
fi
if [ "${DEPLOYMENT_TARGET:-}" = "batch-transform" ]; then
    _contract_violation "target" \
        "do/benchmark is not supported on batch-transform. AIPerf benchmarking requires a real-time endpoint." \
        "Switch target: do/deploy --target realtime-inference"
fi

# ── Plain EKS benchmark: local AIPerf via pod port-forward (BL103 + BL157) ─────
# The eks target has no SageMaker endpoint, so the SageMaker AI Benchmarking
# service path below (create-ai-workload-config / create-ai-benchmark-job) does
# not apply. BL157 gives eks the SAME capability as the SageMaker-endpoint path
# (workload profiles, concurrency sweep, BYOD, TTFT/ITL/throughput, Athena) by
# running NVIDIA AIPerf LOCALLY against the port-forwarded pod and emitting the
# SAME profile_export.jsonl the pipeline already consumes.
#
# The actual run is DEFERRED until after the flag parser, the workload-catalog
# read, the dataset resolver, and the multi-level sweep setup, so eks honors
# --workload / --dataset / BENCHMARK_CONCURRENCY_LEVELS exactly as the other
# targets (R1). _run_eks_aiperf_benchmark (defined below) is invoked at that
# single-level execution point; the port-forward + fail-fast (BL103 edge 6.1/6.2)
# and endpoint derivation (R4) live inside it.

# ── _run_eks_aiperf_benchmark() — the local-AIPerf eks path (BL157) ───────────
# Invoked once per concurrency level (the sweep sets _BENCHMARK_SINGLE_LEVEL=1)
# AFTER flags/workload/dataset are resolved. Preserves the BL103 invariants:
# reaches the pod via `kubectl port-forward` and fails fast with a clear error.
# Endpoint port is DERIVED from serve.d/<engine>/manifest.json (R4), not the old
# hardcoded :8080/ping. Produces ${JOB_DIR}/output/profile_export.jsonl + the
# /tmp marker so the shared sweep/aggregator/writer consume it unchanged.
_run_eks_aiperf_benchmark() {
    [ "${DEPLOYMENT_TARGET:-}" = "eks" ] || return 0
    local _sd
    _sd="$(dirname "${BASH_SOURCE[0]}")"
    HP_NAMESPACE="${HP_NAMESPACE:-default}"
    local _profile_arg=""
    [ -n "${_PROFILE_awsProfile:-${AWS_PROFILE:-}}" ] && _profile_arg="--profile ${_PROFILE_awsProfile:-${AWS_PROFILE}}"

    echo "📊 Plain EKS benchmark (local AIPerf via pod port-forward)"
    echo "   Project: ${PROJECT_NAME}"
    echo "   Namespace: ${HP_NAMESPACE}"
    echo "   Model server: ${MODEL_SERVER}"
    echo "   Concurrency: ${BENCHMARK_CONCURRENCY}"

    # ── AIPerf availability (R6, OQ-2): fail loud, never silently degrade. ────
    # AIPerf (`pip install aiperf`) is the SAME load generator SageMaker managed
    # benchmarking runs server-side; here it runs locally in the project venv.
    if ! command -v aiperf >/dev/null 2>&1; then
        echo "❌ do/benchmark: AIPerf is not installed."
        echo "   The eks benchmark path drives NVIDIA AIPerf locally against the"
        echo "   port-forwarded pod. Install it into the active Python env:"
        echo "     pip install aiperf"
        echo "   (The same venv do/ scripts use — see 'mcc hey init'.)"
        exit 1
    fi

    # Kubeconfig update is gated on HP_CLUSTER_NAME (as in deploy/test).
    if [ -n "${HP_CLUSTER_NAME:-}" ]; then
        local KUBECONFIG_PATH="${HOME}/.kube/eks-${HP_CLUSTER_NAME}"
        local _eks_name="${HP_CLUSTER_NAME}"
        local _eks_arn
        # Probe (kept): a plain EKS cluster is NOT a HyperPod cluster, so this
        # describe-cluster legitimately fails; the fallback (HP_CLUSTER_NAME as the
        # EKS name) is the expected path, and update-kubeconfig below fails loudly.
        _eks_arn=$(aws sagemaker describe-cluster \
            --cluster-name "${HP_CLUSTER_NAME}" \
            --region "${AWS_REGION}" \
            ${_profile_arg} \
            --query "Orchestrator.Eks.ClusterArn" \
            --output text 2>/dev/null) || _eks_arn=""
        if [ -n "${_eks_arn}" ] && [ "${_eks_arn}" != "None" ]; then
            _eks_name=$(echo "${_eks_arn}" | awk -F'/' '{print $NF}')
        fi
        aws eks update-kubeconfig \
            --name "${_eks_name}" \
            --region "${AWS_REGION}" \
            ${_profile_arg} \
            --kubeconfig "${KUBECONFIG_PATH}" >/dev/null 2>&1 || {
            echo "❌ do/benchmark could not configure kubectl for cluster '${HP_CLUSTER_NAME}'."
            echo "   Port-forward to the serving pod cannot be established."
            exit 1
        }
        export KUBECONFIG="${KUBECONFIG_PATH}"
    fi

    # Resolve the running serving pod by label. This is the LOAD target (AIPerf
    # drives one port-forwarded pod); the opt-in metrics scrape covers every
    # Running pod separately (_phase2_start_poller, Wave 9 R6.2).
    local _EKS_POD _eks_pod_err
    # BL165: capture kubectl's stderr so an auth/connectivity error is shown
    # instead of being reported as "no running pod".
    _eks_pod_err="$(mktemp)"
    _EKS_POD=$(kubectl get pods -n "${HP_NAMESPACE}" \
        -l "app=${PROJECT_NAME}" \
        --field-selector=status.phase=Running \
        -o jsonpath='{.items[0].metadata.name}' 2>"${_eks_pod_err}") || _EKS_POD=""
    if [ -z "${_EKS_POD}" ]; then
        echo "❌ do/benchmark: no running pod found for app=${PROJECT_NAME} in namespace ${HP_NAMESPACE}."
        echo "   Port-forward to the serving pod cannot be established."
        echo "   Check: kubectl get pods -n ${HP_NAMESPACE} -l app=${PROJECT_NAME}"
        _bm_surface_stderr "${_eks_pod_err}" "kubectl output"
        exit 1
    fi
    rm -f "${_eks_pod_err}"

    # Derive the pod's serving port from the engine manifest (R4, ADR-008),
    # replacing the stub's hardcoded :8080. Falls back to 8080 only when the
    # manifest declares no port.
    local _EKS_REMOTE_PORT _eks_port_err
    # BL165: eks_aiperf.py serving-port already returns the 8080 default when the
    # manifest declares no port, so a NON-ZERO exit here is a real helper error —
    # surface it (still falling back to 8080 so the run can proceed).
    _eks_port_err="$(mktemp)"
    if ! _EKS_REMOTE_PORT=$(python3 "${_sd}/lib/python/eks_aiperf.py" serving-port "${MODEL_SERVER}" 2>"${_eks_port_err}"); then
        echo "⚠️  Could not derive the serving port from the ${MODEL_SERVER} manifest — falling back to 8080" >&2
        _EKS_REMOTE_PORT=8080
    fi
    _bm_surface_stderr "${_eks_port_err}" "eks_aiperf.py serving-port output"
    [ -z "${_EKS_REMOTE_PORT}" ] && _EKS_REMOTE_PORT=8080

    local _EKS_LOCAL_PORT="${HP_BENCHMARK_PORT:-18080}"
    echo "🔌 Port-forwarding pod/${_EKS_POD}:${_EKS_REMOTE_PORT} to localhost:${_EKS_LOCAL_PORT}..."
    kubectl port-forward "pod/${_EKS_POD}" "${_EKS_LOCAL_PORT}:${_EKS_REMOTE_PORT}" \
        -n "${HP_NAMESPACE}" >/dev/null 2>&1 &
    local _EKS_PF_PID=$!
    sleep 3
    # `kill`/`kill -0` on the port-forward PID below are liveness probes and
    # idempotent teardown — the process may already be gone (swallow is safe).
    trap "kill ${_EKS_PF_PID} 2>/dev/null || true" EXIT

    # Fail fast on port-forward failure (Requirement 6.2, BL103 edge 6.1/6.2).
    if ! kill -0 "${_EKS_PF_PID}" 2>/dev/null; then
        echo "❌ do/benchmark: port-forward to pod/${_EKS_POD} failed."
        echo "   The serving pod could not be reached via kubectl port-forward."
        echo "   Check: kubectl get pods -n ${HP_NAMESPACE} -l app=${PROJECT_NAME}"
        exit 1
    fi

    # Wave 6.1 R7c.1/R7c.2: --adapter sends "model": "<adapter>" in every AIPerf
    # request (vLLM routes by model name), after confirming the adapter is loaded.
    if [ -n "${ADAPTER_ARG:-}" ]; then
        local _eks_models
        _eks_models=$(curl -s -m 30 "http://localhost:${_EKS_LOCAL_PORT}/v1/models" 2>/dev/null || echo "")
        if ! printf '%s' "${_eks_models}" | ADAPTER="${ADAPTER_ARG}" python3 -c 'import json,os,sys; ids=[m.get("id") for m in json.load(sys.stdin).get("data",[])]; sys.exit(0 if os.environ["ADAPTER"] in ids else 1)' 2>/dev/null; then
            echo "❌ do/benchmark: adapter '${ADAPTER_ARG}' is not loaded on pod/${_EKS_POD} (/v1/models)."
            echo "   Load it first: ./do/adapter add ${ADAPTER_ARG} --from-weights s3://..."
            kill "${_EKS_PF_PID}" 2>/dev/null || true
            exit 1
        fi
        echo "✅ Adapter '${ADAPTER_ARG}' is loaded — requests will name it"
        export BENCHMARK_SERVED_MODEL="${ADAPTER_ARG}"
    fi
    # Per-run output dir mirrors the SageMaker path's benchmarks/<job>/output/
    # layout so the multi-level sweep + aggregator find the jsonl unchanged.
    local _EKS_JOB_DIR="${SCRIPT_DIR}/../benchmarks/${BENCHMARK_JOB_NAME}"
    local _EKS_ARTIFACT_DIR="${_EKS_JOB_DIR}/aiperf"
    local _EKS_OUTPUT_JSONL="${_EKS_JOB_DIR}/output/profile_export.jsonl"
    mkdir -p "${_EKS_ARTIFACT_DIR}" "${_EKS_JOB_DIR}/output"

    # Build the `aiperf profile` invocation from the resolved config (the SAME
    # workload-spec parameterization SageMaker managed benchmarking uses). The
    # served-model + flag map are DERIVED in eks_aiperf.py (no hardcoding, R3/R4).
    local _EKS_AIPERF_CMD=()
    while IFS= read -r _tok; do
        _EKS_AIPERF_CMD+=("${_tok}")
    done < <(BENCHMARK_DATASET_LOCAL_FILE="${BENCHMARK_DATASET_LOCAL_FILE:-}" \
        python3 "${_sd}/lib/python/eks_aiperf.py" build-command \
        --local-port "${_EKS_LOCAL_PORT}" --artifact-dir "${_EKS_ARTIFACT_DIR}")

    if [ ${#_EKS_AIPERF_CMD[@]} -eq 0 ]; then
        echo "❌ do/benchmark: failed to build the aiperf invocation."
        kill "${_EKS_PF_PID}" 2>/dev/null || true
        exit 1
    fi

    # Phase 2 GPU metrics (R5, BL108): opt-in poller scrapes the engine /metrics
    # for the whole run. Self-skips unless HP_BENCHMARK_METRICS_ENABLED=true and
    # the engine manifest declares a metrics_endpoint; always non-fatal. It uses
    # its OWN port-forward (independent of the one above) and the eks-aware
    # kubeconfig branch added to _phase2_start_poller.
    _phase2_start_poller || true

    echo ""
    echo "🏁 Running AIPerf (concurrency ${BENCHMARK_CONCURRENCY}) against localhost:${_EKS_LOCAL_PORT}/v1/chat/completions..."
    local _EKS_RC=0
    "${_EKS_AIPERF_CMD[@]}" || _EKS_RC=$?

    # Stop Phase 2 (aggregates + writes the per-pod sidecars) before tearing
    # down the load port-forward.
    _phase2_stop_poller || true

    kill "${_EKS_PF_PID}" 2>/dev/null || true
    trap - EXIT

    if [ ${_EKS_RC} -ne 0 ]; then
        echo "❌ do/benchmark: aiperf profile exited ${_EKS_RC}."
        echo "   The port-forwarded pod may not serve the OpenAI /v1/chat/completions route,"
        echo "   or the tokenizer (${HF_MODEL_ID:-${MODEL_NAME}}) could not be loaded."
        exit "${_EKS_RC}"
    fi

    # Relocate AIPerf's profile_export.jsonl to the aggregator's expected path
    # (no change to the shared aggregator — findings §2/§5, R2).
    if ! python3 "${_sd}/lib/python/eks_aiperf.py" relocate \
        "${_EKS_ARTIFACT_DIR}" "${_EKS_OUTPUT_JSONL}" >/dev/null; then
        echo "❌ do/benchmark: aiperf produced no profile_export.jsonl under ${_EKS_ARTIFACT_DIR}."
        exit 1
    fi
    echo "✅ AIPerf run complete — results at ${_EKS_OUTPUT_JSONL}"

    # Marker for the multi-level parent to find this results dir (findings §2).
    # Best-effort hint only — the parent falls back to `ls -td` (safe swallow).
    echo "${_EKS_JOB_DIR}" > "/tmp/.mlcc-benchmark-latest-${PROJECT_NAME}" 2>/dev/null || true

    # ── Persist to Athena via the SHARED writer (R2, R7) ──────────────────────
    # Skip when a child of multi-level mode — the parent aggregates one row per
    # level (same contract as the SageMaker path). --deployment-target eks is
    # already carried through by the writer.
    if [ -n "${CI_BENCHMARK_RESULTS_BUCKET:-}" ] && [ -z "${_BENCHMARK_SINGLE_LEVEL:-}" ]; then
        echo ""
        echo "📊 Persisting benchmark results to Athena..."
        # Wave 9 R6.3: this run's per-pod, per-level sidecars (never the fixed
        # benchmarks/.last_gpu_metrics.json, which may belong to another run).
        local _EKS_GPU_METRICS_DIR="${_EKS_JOB_DIR}"
        # deployment_target=eks is carried through the --config-file (do/config
        # has DEPLOYMENT_TARGET=eks); the writer maps it to the Athena column and
        # derives the eks metrics_source branch from it (findings §5, R5).
        # Instance type: eks has no SageMaker endpoint, so use BENCHMARK_INSTANCE_TYPE
        # / HP_INSTANCE_TYPE / INSTANCE_TYPE (same key resolve-serving-config.sh uses).
        local _EKS_INSTANCE_TYPE="${BENCHMARK_INSTANCE_TYPE:-${HP_INSTANCE_TYPE:-${INSTANCE_TYPE:-}}}"
        if python3 "${_sd}/.benchmark_writer.py" write \
            --results-file "${_EKS_OUTPUT_JSONL}" \
            --config-file "${_sd}/config" \
            ${DEPLOYMENT_TARGET:+--deployment-target "${DEPLOYMENT_TARGET}"} \
            --project-name "${PROJECT_NAME}" \
            --workload "${BENCHMARK_WORKLOAD:-manual}" \
            --concurrency "${BENCHMARK_CONCURRENCY}" \
            --bucket "${CI_BENCHMARK_RESULTS_BUCKET}" \
            --region "${AWS_REGION:-${REGION}}" \
            ${_EKS_INSTANCE_TYPE:+--instance-type "${_EKS_INSTANCE_TYPE}"} \
            ${ADAPTER_ARG:+--adapter-name "${ADAPTER_ARG}"} \
            ${BENCHMARK_JOB_NAME:+--benchmark-job-name "${BENCHMARK_JOB_NAME}"} \
            ${BENCHMARK_RUN_NAME:+--run-name "${BENCHMARK_RUN_NAME}"} \
            --gpu-metrics-dir "${_EKS_GPU_METRICS_DIR}"; then
            echo "✅ Benchmark results persisted to S3"
        else
            echo "⚠️  Failed to persist benchmark results to Athena (non-fatal)"
            echo "   Results remain available locally in: benchmarks/${BENCHMARK_JOB_NAME}/"
        fi
    fi

    echo ""
    echo "ℹ️  eks runs NVIDIA AIPerf locally against the port-forwarded pod; no"
    echo "   SageMaker AI Benchmarking service is used. Results land in the SAME"
    echo "   Athena table as the SageMaker-endpoint targets."
    echo "   For engine/GPU metrics, set HP_BENCHMARK_METRICS_ENABLED=true."
    return 0
}

