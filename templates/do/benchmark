# ── Wave 6.1 R7c: --adapter on hyperpod-eks must target the adapter, or refuse ──
# hyperpod-eks runs the MANAGED SageMaker AI benchmark against the operator's
# endpoint. Its workload spec has no request model-name parameter (the documented
# `parameters` set has tokenizer/concurrency/... but no model field, and unknown
# keys are rejected), so requests would hit the BASE model while the Athena row
# said adapter_name=<adapter> (seen live, job fresh-ai-ml-benchmark-20261023-152219).
# Refuse instead of mislabeling (R7c.1/R7c.3). eks runs AIPerf locally and does
# send "model": "<adapter>" (see _run_eks_aiperf_benchmark).
if [ -n "${ADAPTER_ARG}" ] && [ "${DEPLOYMENT_TARGET:-}" = "hyperpod-eks" ] && [ "${ARG_STATUS}" != true ]; then
    _contract_violation "target" \
        "do/benchmark --adapter is not supported on hyperpod-eks: the managed benchmark's workload spec cannot set the request model name, so requests would go to the base model and the result would be mislabeled '${ADAPTER_ARG}'." \
        "Benchmark the base model (drop --adapter), verify the adapter with ./do/test --adapter ${ADAPTER_ARG} --compare-base, or benchmark adapters on eks / realtime-inference."
fi
# ── Handle --status (early exit) ─────────────────────────────────────────────
# Query the tracked benchmark job, display status, and if completed:
# download results, display metrics, and write to Athena (if not already done).
if [ "${ARG_STATUS}" = true ]; then
    # Resolve instance type: BENCHMARK_INSTANCE_TYPE > DEPLOYED_INSTANCE_TYPE > INSTANCE_TYPE
    _STATUS_INSTANCE_TYPE="${BENCHMARK_INSTANCE_TYPE:-${DEPLOYED_INSTANCE_TYPE:-${INSTANCE_TYPE:-}}}"

    JOB_NAME="${BENCHMARK_JOB_NAME:-}"
    if [ -z "${JOB_NAME}" ]; then
        echo "❌ No benchmark job tracked"
        echo "   Run ./do/benchmark --workload <name> to start one."
        exit 1
    fi

    echo "📊 Benchmark Job Status"
    echo ""
    echo "   Job: ${JOB_NAME}"

    # BL165: capture the describe error so "not found" vs "expired credentials"
    # vs "AccessDenied" is visible rather than guessed.
    _st_err="$(mktemp)"
    STATUS=$(aws sagemaker describe-ai-benchmark-job \
        --ai-benchmark-job-name "${JOB_NAME}" \
        --region "${AWS_REGION}" \
        --query 'AIBenchmarkJobStatus' \
        --output text 2>"${_st_err}") || STATUS=""

    if [ -z "${STATUS}" ]; then
        echo "   Status: Unknown (job not found or credentials expired)"
        _bm_surface_stderr "${_st_err}" "describe-ai-benchmark-job output"
        exit 1
    fi
    rm -f "${_st_err}"

    echo "   Status: ${STATUS}"

    case "${STATUS}" in
        Completed)
            # Check if results already exist locally
            PROJECT_ROOT="${SCRIPT_DIR}/.."
            LOCAL_RESULTS_DIR="${PROJECT_ROOT}/benchmarks/${JOB_NAME}"
            # `find` existence probes (here and below): a missing dir just means
            # "not downloaded yet" — swallowing find's "No such file" is safe.
            RESULTS_JSONL=$(find "${LOCAL_RESULTS_DIR}" -name "profile_export.jsonl" -type f 2>/dev/null | head -1 || true)

            if [ -z "${RESULTS_JSONL}" ]; then
                echo ""
                echo "   📥 Downloading results..."
                # BL165: this used to be `2>/dev/null` with no `||`, so a failure
                # exited silently under `set -e`. Surface it.
                _st_err="$(mktemp)"
                if ! RESULTS_S3_PATH=$(aws sagemaker describe-ai-benchmark-job \
                    --ai-benchmark-job-name "${JOB_NAME}" \
                    --region "${AWS_REGION}" \
                    --query 'OutputConfig.S3OutputLocation' \
                    --output text 2>"${_st_err}"); then
                    echo "❌ Could not read the benchmark job's S3 output location"
                    _bm_surface_stderr "${_st_err}" "describe-ai-benchmark-job output"
                    exit 1
                fi
                rm -f "${_st_err}"

                if [ -n "${RESULTS_S3_PATH}" ]; then
                    mkdir -p "${LOCAL_RESULTS_DIR}/output"
                    aws s3 sync "${RESULTS_S3_PATH}" "${LOCAL_RESULTS_DIR}/output/" \
                        --region "${AWS_REGION}" --quiet
                    # Untar if output.tar.gz exists
                    tar_file=""
                    tar_file=$(find "${LOCAL_RESULTS_DIR}" -name "output.tar.gz" -type f 2>/dev/null | head -1 || true)
                    if [ -n "${tar_file}" ]; then
                        # Detect whether ALL entries share a common leading directory prefix
                        # `tar -tzf` layout probes: only decide strip-vs-flat; a bad
                        # archive is reported by the extraction below (safe swallow).
                        _tar_prefix_count=""
                        _tar_prefix_count=$(tar -tzf "${tar_file}" 2>/dev/null | sed 's|/.*||' | sort -u | wc -l | tr -d ' ')
                        _tar_first_dir=""
                        _tar_first_dir=$(tar -tzf "${tar_file}" 2>/dev/null | head -1)
                        # BL165: extraction is the primary operation — surface a
                        # failure (non-fatal, as before) instead of discarding it.
                        _tar_err="$(mktemp)"
                        if [ "${_tar_prefix_count}" = "1" ] && echo "${_tar_first_dir}" | grep -qE '^[^/]+/$'; then
                            tar -xzf "${tar_file}" --strip-components=1 -C "${LOCAL_RESULTS_DIR}/output/" 2>"${_tar_err}" \
                                || echo "   ⚠️  Could not extract ${tar_file} (non-fatal)" >&2
                        else
                            tar -xzf "${tar_file}" -C "${LOCAL_RESULTS_DIR}/output/" 2>"${_tar_err}" \
                                || echo "   ⚠️  Could not extract ${tar_file} (non-fatal)" >&2
                        fi
                        _bm_surface_stderr "${_tar_err}" "tar output"
                    fi
                    # Re-search after extraction
                    RESULTS_JSONL=$(find "${LOCAL_RESULTS_DIR}" -name "profile_export.jsonl" -type f 2>/dev/null | head -1 || true)
                    echo "   ✅ Results downloaded to: benchmarks/${JOB_NAME}/"
                fi
            else
                echo "   ✅ Results already available locally"
            fi

            # Write to Athena if CI bucket is configured and results exist
            if [ -n "${CI_BENCHMARK_RESULTS_BUCKET:-}" ]; then
                _WRITER_INPUT=""
                if [ -n "${RESULTS_JSONL}" ] && [ -f "${RESULTS_JSONL}" ]; then
                    _WRITER_INPUT="${RESULTS_JSONL}"
                else
                    _WRITER_INPUT=$(find "${LOCAL_RESULTS_DIR}" -name "profile_export_aiperf.json" -type f 2>/dev/null | head -1 || true)
                fi

                if [ -n "${_WRITER_INPUT}" ]; then
                    echo ""
                    echo "   📊 Writing to Athena..."
                    # BL213: the inference component THIS job benchmarked (its
                    # BenchmarkTarget), so the row's target follows the job, not a
                    # DEPLOYMENT_TARGET that may have changed since. Optional
                    # read-only probe: no IC / any error → "" (safe swallow).
                    _STATUS_IC_NAME=$(aws sagemaker describe-ai-benchmark-job \
                        --ai-benchmark-job-name "${JOB_NAME}" \
                        --region "${AWS_REGION}" \
                        --query 'BenchmarkTarget.Endpoint.InferenceComponents[0].Identifier' \
                        --output text 2>/dev/null) || _STATUS_IC_NAME=""
                    [ "${_STATUS_IC_NAME}" != "None" ] || _STATUS_IC_NAME=""
                    # Wave 9 R1.2 / R6.3: the resume path gets a run window too —
                    # the writer reads the downloaded AIPerf start/end (else
                    # DescribeAIBenchmarkJob times via --benchmark-job-name, which
                    # also names the endpoint + IC). Scrape sidecars, if the
                    # original run had the opt-in poller, are THIS job's own.
                    if python3 "$(dirname "${BASH_SOURCE[0]}")/.benchmark_writer.py" write \
                        --results-file "${_WRITER_INPUT}" \
                        --config-file "$(dirname "${BASH_SOURCE[0]}")/config" \
                        ${DEPLOYMENT_TARGET:+--deployment-target "${DEPLOYMENT_TARGET}"} \
                        ${_STATUS_IC_NAME:+--ic-name "${_STATUS_IC_NAME}"} \
                        --project-name "${PROJECT_NAME}" \
                        --workload "${BENCHMARK_WORKLOAD:-manual}" \
                        --concurrency "${BENCHMARK_CONCURRENCY:-2}" \
                        --bucket "${CI_BENCHMARK_RESULTS_BUCKET}" \
                        --region "${AWS_REGION:-${REGION:-us-east-1}}" \
                        ${_STATUS_INSTANCE_TYPE:+--instance-type "${_STATUS_INSTANCE_TYPE}"} \
                        ${ADAPTER_ARG:+--adapter-name "${ADAPTER_ARG}"} \
                        ${ENDPOINT_NAME:+--endpoint-name "${ENDPOINT_NAME}"} \
                        --benchmark-job-name "${JOB_NAME}" \
                        ${BENCHMARK_RUN_NAME:+--run-name "${BENCHMARK_RUN_NAME}"} \
                        --gpu-metrics-dir "${LOCAL_RESULTS_DIR}"; then
                        echo "   ✅ Results persisted to Athena"
                    else
                        echo "   ⚠️  Athena write failed (non-fatal)"
                    fi
                fi
            fi
            ;;
        InProgress|Starting|Pending)
            echo ""
            echo "   Job is still running. Check again with: ./do/benchmark --status"
            ;;
        Failed)
            # Secondary detail read (kept): the job status (primary) was already
            # read successfully above; "unknown" is an honest fallback (safe).
            FAILURE_REASON=$(aws sagemaker describe-ai-benchmark-job \
                --ai-benchmark-job-name "${JOB_NAME}" \
                --region "${AWS_REGION}" \
                --query 'FailureReason' \
                --output text 2>/dev/null) || FAILURE_REASON="unknown"
            echo "   Reason: ${FAILURE_REASON}"
            ;;
    esac
    exit 0
fi


# ── Handle --compare-baseline (early exit) ────────────────────────────────────
# Compare latest local benchmark results against historical best in Athena.
if [ "${ARG_COMPARE_BASELINE}" = true ]; then
    # BL101 R1/R4: resolve the canonical Serving_Config_Key via the shared
    # library. This early-exit path runs BEFORE RESOLVED_INSTANCE_TYPE is
    # computed at the end of the file, so the resolver's per-target chain
    # (BENCHMARK_INSTANCE_TYPE-first for HyperPod) is the authoritative source.
    source "${SCRIPT_DIR}/lib/resolve-serving-config.sh"

    # Existence probes: no local results is handled explicitly below (safe).
    _LATEST_RESULTS_DIR=$(ls -td "${SCRIPT_DIR}/../benchmarks/${PROJECT_NAME}-benchmark-"* 2>/dev/null | head -1) || _LATEST_RESULTS_DIR=""
    _LATEST_JSONL=""

    if [ -n "${_LATEST_RESULTS_DIR}" ]; then
        _LATEST_JSONL=$(find "${_LATEST_RESULTS_DIR}" -name "profile_export.jsonl" -type f 2>/dev/null | head -1) || _LATEST_JSONL=""
    fi

    if [ -z "${_LATEST_JSONL}" ]; then
        echo "❌ No local benchmark results found. Run ./do/benchmark --workload <name> first."
        exit 1
    fi

    # Resolve benchmark bucket from profile. BL165: python's stderr is NOT
    # discarded — a corrupt profile file surfaces its parse error instead of
    # reading as "No benchmark results bucket configured".
    _CB_BUCKET=$(python3 -c "
import json, os
cfg = os.path.expanduser('~/.ml-container-creator/config.json')
if os.path.exists(cfg):
    d = json.load(open(cfg))
    profiles = d.get('profiles', {})
    active = d.get('activeProfile', next(iter(profiles), ''))
    print(profiles.get(active, {}).get('ciBenchmarkResultsBucket', ''))
else:
    print('')
") || _CB_BUCKET=""

    if [ -z "${_CB_BUCKET}" ]; then
        echo "❌ No benchmark results bucket configured."
        echo "   Run: mcc bootstrap add-module benchmark"
        exit 1
    fi

    # Build threshold args
    _THRESHOLD_ARGS=()
    for _t in "${ARG_THRESHOLDS[@]+"${ARG_THRESHOLDS[@]}"}"; do
        if [ -n "$_t" ]; then
            _THRESHOLD_ARGS+=("--threshold" "$_t")
        fi
    done

    _JSON_FLAG=""
    [ "${ARG_JSON}" = "true" ] && _JSON_FLAG="--json"

    # BL101 R2.6: conditionally extend the key with max_model_len / kv_cache_dtype
    # only when this run specifies them (positive int / non-empty non-auto), so
    # pre-existing baselines that omit these dimensions are not invalidated.
    _KEY_EXT_ARGS=()
    if [ -n "${SERVING_MAX_MODEL_LEN}" ]; then
        _KEY_EXT_ARGS+=("--max-model-len" "${SERVING_MAX_MODEL_LEN}")
    fi
    if [ -n "${SERVING_KV_CACHE_DTYPE}" ] && [ "${SERVING_KV_CACHE_DTYPE}" != "auto" ]; then
        _KEY_EXT_ARGS+=("--kv-cache-dtype" "${SERVING_KV_CACHE_DTYPE}")
    fi

    # BL101 R5/set-baseline: when a baseline is pinned, compare against it.
    _PINNED_ARGS=()
    if [ -n "${BENCHMARK_PINNED_BASELINE:-}" ]; then
        _PINNED_ARGS+=("--pinned-baseline" "${BENCHMARK_PINNED_BASELINE}")
    fi

    # Run the comparison engine — it handles all display directly (text or JSON based on --json flag)
    python3 "$(dirname "${BASH_SOURCE[0]}")/.optimize_engine.py" compare-baseline \
        --results-file "${_LATEST_JSONL}" \
        --model-name "${SERVING_MODEL_NAME}" \
        --instance-type "${SERVING_INSTANCE_TYPE}" \
        --quantization "${SERVING_QUANTIZATION}" \
        --tensor-parallel "${SERVING_TENSOR_PARALLEL}" \
        --bucket "${_CB_BUCKET}" \
        --region "${AWS_REGION:-${REGION:-us-east-1}}" \
        "${_KEY_EXT_ARGS[@]+"${_KEY_EXT_ARGS[@]}"}" \
        "${_PINNED_ARGS[@]+"${_PINNED_ARGS[@]}"}" \
        "${_THRESHOLD_ARGS[@]+"${_THRESHOLD_ARGS[@]}"}" \
        ${ADAPTER_ARG:+--adapter-name "${ADAPTER_ARG}"} \
        ${_JSON_FLAG}
    exit $?
fi


# ── BL101 analytics helpers ───────────────────────────────────────────────────
# Resolve the benchmark results bucket from the active profile (shared by --peak
# and --list). Echoes the bucket name or empty string. BL165: stderr flows
# through so a corrupt profile file is visible (stdout stays the bare bucket).
_bl101_resolve_bucket() {
    python3 -c "
