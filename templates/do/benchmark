_run_athena_recommendations() {
    local model_name="${HF_MODEL_ID:-${MODEL_NAME:-}}"
    local instance_type="${DEPLOYED_INSTANCE_TYPE:-${INSTANCE_TYPE:-}}"
    # Resolve current serving config — target-aware.
    # realtime-inference uses IC_ENV_* (Inference Component vars).
    # hyperpod-eks and async-inference use bare VLLM_* vars.
    local quantization kv_dtype tp max_len
    if [ "${DEPLOYMENT_TARGET:-realtime-inference}" = "hyperpod-eks" ] || \
       [ "${DEPLOYMENT_TARGET:-realtime-inference}" = "async-inference" ]; then
        quantization="${VLLM_QUANTIZATION:-none}"
        tp="${VLLM_TENSOR_PARALLEL_SIZE:-1}"
        max_len="${VLLM_MAX_MODEL_LEN:-4096}"
        kv_dtype="${VLLM_KV_CACHE_DTYPE:-auto}"
    else
        quantization="${IC_ENV_VLLM_QUANTIZATION:-${IC_ENV_QUANTIZATION:-bf16}}"
        tp="${IC_ENV_VLLM_TENSOR_PARALLEL_SIZE:-1}"
        # BL046: This 4096 is a runtime shell fallback only, retained intentionally.
        max_len="${IC_ENV_VLLM_MAX_MODEL_LEN:-4096}"
        kv_dtype="${IC_ENV_VLLM_KV_CACHE_DTYPE:-auto}"
    fi

    if [ -z "$model_name" ] || [ -z "$instance_type" ]; then
        echo "⚠️  Cannot query benchmark history — MODEL_NAME and INSTANCE_TYPE required" >&2
        return 1
    fi

    # Resolve benchmark bucket from profile (stderr not discarded — BL165).
    local bucket
    bucket=$(python3 -c "
import json, os
cfg = os.path.expanduser('~/.ml-container-creator/config.json')
if os.path.exists(cfg):
    d = json.load(open(cfg))
    profiles = d.get('profiles', {})
    active = d.get('activeProfile', next(iter(profiles), ''))
    print(profiles.get(active, {}).get('ciBenchmarkResultsBucket', ''))
else:
    print('')
") || bucket=""

    if [ -z "$bucket" ]; then
        echo "⚠️  No benchmark results bucket configured — run 'mcc bootstrap add-module benchmark'" >&2
        return 1
    fi

    local bedrock_flag=""
    if [ "${ARG_NO_BEDROCK}" = "false" ] && [ "${MCC_NO_BEDROCK:-0}" != "1" ]; then
        bedrock_flag="--bedrock-interpret"
    fi

    python3 "$(dirname "${BASH_SOURCE[0]}")/.optimize_engine.py" recommend \
        --model-name "$model_name" \
        --instance-type "$instance_type" \
        --quantization "$quantization" \
        --tensor-parallel "$tp" \
        --max-model-len "$max_len" \
        --kv-cache-dtype "$kv_dtype" \
        --metric "${ARG_RECOMMEND_METRIC}" \
        --bucket "$bucket" \
        --region "${AWS_REGION:-${REGION:-us-east-1}}" \
        ${bedrock_flag}
}

_display_recommendations() {
    local json_data="$1"

    local status
    # Parse-only reads; they fail CLOSED (status "" → reported as failed below).
    status=$(echo "$json_data" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('status',''))" 2>/dev/null) || status=""

    if [ "$status" != "ok" ]; then
        local error
        error=$(echo "$json_data" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('error','Unknown error'))" 2>/dev/null) || error="Unknown error"
        echo "⚠️  Optimization query failed: $error" >&2
        return 1
    fi

    # Use Python to format the display
    echo "$json_data" | python3 -c "
import sys, json

data = json.load(sys.stdin)
recs = data.get('recommendations', [])
model = data.get('model_name', 'unknown')
instance = data.get('instance_type', 'unknown')
match_level = data.get('match_level', 'none')
metric = data.get('target_metric', 'output_token_throughput_tps')
total = data.get('total_records_found', 0)

if not recs:
    print()
    print('ℹ️  No recommendations available — no matching benchmark data found.')
    print(f'   Model: {model}')
    print(f'   Instance: {instance}')
    print(f'   Match level: {match_level}')
    sys.exit(0)

# Header
model_short = model.split('/')[-1] if '/' in model else model
print()
print(f'Optimization Recommendations for {model_short} on {instance}')
print('─' * 60)
print()
print(f'  Based on {total} benchmark records ({match_level} match)')
print(f'  Optimizing for: {metric}')
print()

# Table
print(f'  {\"Dimension\":<22s} {\"Current\":<12s} {\"Recommended\":<14s} {\"Expected Gain\":<18s} {\"Confidence\":<20s}')
print(f'  {\"-\" * 22} {\"-\" * 12} {\"-\" * 14} {\"-\" * 18} {\"-\" * 20}')

for r in recs:
    dim = r['dimension']
    current = str(r['current_value'])
    recommended = str(r['recommended_value'])
    gain = f'+{r[\"improvement_pct\"]}%'
    confidence = f'{r[\"confidence\"].upper()} ({r[\"num_runs\"]} runs)'
    print(f'  {dim:<22s} {current:<12s} {recommended:<14s} {gain:<18s} {confidence:<20s}')

# Analysis section
analysis = data.get('analysis', '')
if analysis:
    print()
    if isinstance(analysis, dict):
        headline = analysis.get('headline', '')
        risks = analysis.get('risks', [])
        next_steps = analysis.get('next_steps', [])
        if headline:
            print('💡 Analysis:')
            print(f'  {headline}')
        if risks:
            print()
            print('  ⚠️  Risks:')
            for r in risks:
                print(f'     • {r}')
        if next_steps:
            print()
            print('  ✅ Suggested next steps:')
            for s in next_steps:
                print(f'     • {s}')
    else:
        print('💡 Analysis:')
        print(f'  {analysis}')

# Footer
print()
print('Next steps:')
print('  Apply these changes:     ./do/benchmark --recommend --apply')
print('  See raw recommendation:  ./do/benchmark --recommend --json')
print('  Apply and deploy:        ./do/deploy')
print()
" || {
        # BL165: the renderer's stderr used to be discarded, so a render bug
        # printed NOTHING. Its traceback now shows above; fall back to raw JSON.
        echo "⚠️  Could not render recommendations — raw result:" >&2
        echo "$json_data"
    }
}

_apply_recommendations() {
    local json_data="$1"
    local config_file="${SCRIPT_DIR}/config"
    local ic_conf="${SCRIPT_DIR}/ic/default.conf"

    # Create backups
    if [ -f "$config_file" ]; then
        cp "$config_file" "${config_file}.bak"
    fi
    if [ -f "$ic_conf" ]; then
        cp "$ic_conf" "${ic_conf}.bak"
    fi

    # Parse and apply each recommendation
    echo "$json_data" | python3 -c "
import sys, json

data = json.load(sys.stdin)
recs = data.get('recommendations', [])
if not recs:
    print('ℹ️  No changes to apply — current config is already optimal.')
    sys.exit(0)

for r in recs:
    key = r.get('config_key', '')
    value = r.get('recommended_value', '')
    if key and value != '':
        print(f'{key}={value}')
" | while IFS='=' read -r key value; do
        if [ -n "$key" ] && [ -n "$value" ]; then
            _recommend_apply_config_change "$key" "$value"
            echo "   ✅ ${key}=${value}"
        fi
    done
    _APPLIED_COUNT=$?

    # Check if python found any recs (it exits 0 with output, or exits 0 with no-change message)
    # Parse-only probe on JSON already validated by _display_recommendations (safe).
    if echo "$json_data" | python3 -c "import sys,json; d=json.load(sys.stdin); sys.exit(0 if d.get('recommendations') else 1)" 2>/dev/null; then
        echo ""
        echo "✅ Recommendations applied to do/config"
        echo "   Backups: do/config.bak, do/ic/default.conf.bak"
        echo "   Run ./do/deploy to deploy with optimized configuration."
    else
        echo ""
        echo "ℹ️  No changes applied — current config is already optimal."
        rm -f "${config_file}.bak" "${ic_conf}.bak" 2>/dev/null || true  # cleanup; may not exist
    fi
}

_recommend_apply_config_change() {
    local key="$1" value="$2"
    local config_file="${SCRIPT_DIR}/config"
    local ic_conf="${SCRIPT_DIR}/ic/default.conf"

    # Special case: tensor_parallel_degree — secondary writes per target
    # (primary config_key is already target-resolved by Python _dimension_config_key)
    case "${DEPLOYMENT_TARGET:-realtime-inference}" in
        hyperpod-eks)
            # Also write HP_GPU_COUNT so the CRD resource request stays in sync
            if [ "${key}" = "VLLM_TENSOR_PARALLEL_SIZE" ]; then
                _recommend_update_or_append "${config_file}" "HP_GPU_COUNT" "${value}"
            fi
            ;;
        realtime-inference)
            # Also update IC_GPU_COUNT in do/ic/default.conf
            if [ "${key}" = "IC_ENV_VLLM_TENSOR_PARALLEL_SIZE" ] && [ -f "${ic_conf}" ]; then
                _recommend_update_or_append "${ic_conf}" "IC_GPU_COUNT" "${value}"
            fi
            ;;
    esac

    # Write the primary config var
    _recommend_update_or_append "${config_file}" "${key}" "${value}"
}

_recommend_update_or_append() {
    local file="$1" key="$2" value="$3"
    if [ ! -f "$file" ]; then
        return
    fi
    # Key-presence probes (absent key → append below; safe swallow).
    if grep -q "^export ${key}=" "${file}" 2>/dev/null || grep -q "^${key}=" "${file}" 2>/dev/null; then
        sed -i.tmp "s|^export ${key}=.*|export ${key}=\"${value}\"|" "${file}"
        sed -i.tmp "s|^${key}=.*|${key}=\"${value}\"|" "${file}"
        rm -f "${file}.tmp"
    else
        echo "export ${key}=\"${value}\"" >> "${file}"
    fi
}

    # Run the Athena recommendation query.
    # BL165: this was `2>/dev/null || _RECOMMEND_RESULT=""`, so EVERY failure —
    # missing bucket/model config, Athena AccessDenied, an optimize-engine
    # traceback — read as "No benchmark history available" with exit 0. Now a
    # failed query surfaces its structured error + stderr and exits non-zero; a
    # successful query still surfaces any warnings (e.g. Athena/Bedrock) it hit.
    _RECOMMEND_RESULT=""
    _RECOMMEND_RC=0
    _RECOMMEND_STDERR="$(mktemp)"
    _RECOMMEND_RESULT=$(_run_athena_recommendations 2>"${_RECOMMEND_STDERR}") || _RECOMMEND_RC=$?

    if [ "${_RECOMMEND_RC}" -ne 0 ]; then
        _REC_ERR_JSON=$(printf '%s\n' "${_RECOMMEND_RESULT}" | grep -E '^\{' | tail -1 || true)
        _REC_ERR_MSG=""
        if [ -n "${_REC_ERR_JSON}" ]; then
            # Parse-only: the raw stderr below still carries the cause (safe).
            _REC_ERR_MSG=$(printf '%s' "${_REC_ERR_JSON}" | python3 -c "import sys,json; print(json.load(sys.stdin).get('error',''))" 2>/dev/null) || _REC_ERR_MSG=""
        fi
        echo "❌ Benchmark-history recommendation query failed${_REC_ERR_MSG:+: ${_REC_ERR_MSG}}" >&2
        _bm_surface_stderr "${_RECOMMEND_STDERR}"
        echo "   Check the benchmark results bucket (mcc bootstrap add-module benchmark)," >&2
        echo "   Athena permissions, and MODEL_NAME / INSTANCE_TYPE in do/config." >&2
        exit 1
    fi
    _bm_surface_stderr "${_RECOMMEND_STDERR}" "warnings"

    if [ -z "${_RECOMMEND_RESULT}" ]; then
        echo "ℹ️  No benchmark history available for recommendations."
        echo "   Run benchmarks first: ./do/benchmark --workload <name>"
        echo ""
        echo "   Or use SageMaker AI Inference Optimizer:"
        echo "   ./do/optimize --goal throughput"
        exit 0
    fi

    # Check if it's valid JSON with status=ok
    # Parse-only; fails CLOSED (non-JSON → status "" → reported below).
    _RECOMMEND_STATUS=$(echo "${_RECOMMEND_RESULT}" | python3 -c "import sys,json; print(json.load(sys.stdin).get('status',''))" 2>/dev/null) || _RECOMMEND_STATUS=""

    if [ "${_RECOMMEND_STATUS}" != "ok" ]; then
        echo "⚠️  Optimization query returned non-ok status"
        echo "   Result: ${_RECOMMEND_RESULT}"
        echo "   Run benchmarks first: ./do/benchmark --workload <name>"
        exit 1
    fi

    if [ "${ARG_JSON}" = "true" ]; then
        echo "${_RECOMMEND_RESULT}"
        exit 0
    fi

    if [ "${ARG_RECOMMEND_APPLY}" = "true" ]; then
        # OQ-3 (BL157): read-only recommendations work on eks (Athena is
        # target-agnostic), but --apply writes do/ic/default.conf — a
        # realtime-inference Inference-Component artifact that does NOT apply to
        # a plain-eks Kubernetes Deployment. Degrade with a clear message rather
        # than mis-applying realtime-only config to an eks project.
        if [ "${DEPLOYMENT_TARGET:-}" = "eks" ]; then
            _display_recommendations "${_RECOMMEND_RESULT}"
            echo ""
            echo "ℹ️  --apply does not apply on the eks target (read-only recommendations only)."
            echo "   --apply writes do/ic/default.conf (an Inference-Component artifact used by"
            echo "   realtime-inference); plain eks serves a Kubernetes Deployment with no IC."
            echo "   The recommendations above still hold — edit do/config / your eks manifest"
            echo "   manually, then ./do/deploy --target eks."
            exit 0
        fi
        _display_recommendations "${_RECOMMEND_RESULT}"
        _apply_recommendations "${_RECOMMEND_RESULT}"
        exit 0
    fi

    # Default: display recommendations
    _display_recommendations "${_RECOMMEND_RESULT}"

    # AI Interpretation via Reasoning MCP server (non-blocking — skipped if unavailable).
    # Kept swallows: the MCP reasoning server is an OPTIONAL enrichment that is
    # commonly not installed; its absence must not add noise or fail --recommend.
    if [ "${ARG_NO_BEDROCK}" = "false" ] && [ "${MCC_NO_BEDROCK:-0}" != "1" ] && [ -n "${_RECOMMEND_RESULT}" ]; then
        _REASONING_OUT=$(python3 "$(dirname "${BASH_SOURCE[0]}")/lib/python/mcp_client.py" \
            --server reasoning \
            --tool interpret \
            --input "{
                \"context\": \"Project: ${PROJECT_NAME}, model: ${MODEL_NAME:-unknown}, instance: ${INSTANCE_TYPE:-unknown}\",
                \"data\": ${_RECOMMEND_RESULT},
                \"objective\": \"Explain these configuration recommendations in plain language and flag any known interaction risks between the suggested settings\"
            }" 2>/dev/null) || _REASONING_OUT=""
        if [ -n "${_REASONING_OUT}" ]; then
            _INTERP=$(echo "${_REASONING_OUT}" | python3 -c "import sys,json; d=json.loads(sys.stdin.read()); print(d.get('interpretation',''))" 2>/dev/null) || _INTERP=""
            if [ -n "${_INTERP}" ]; then
                echo ""
                echo "AI Interpretation:"
                echo "${_INTERP}" | fold -s -w 80 | sed 's/^/  /'
            fi
        fi
    fi

    exit 0
fi


# ── Require --workload or --dataset flag ──────────────────────────────────────
# --dataset alone is valid (BL100 BYOD path) — synthetic token shape isn't needed.
if [ -z "${ARG_WORKLOAD}" ] && [ -z "${ARG_DATASET}" ]; then
    echo "❌ --workload <name> or --dataset <name> is required"
    echo ""
    # List available workloads from the MCP catalog
    _CATALOG_FOR_HELP=""
    # Optional probes: npm / the workload catalog may legitimately be absent;
    # this only enriches the usage error we are already exiting with.
    if command -v npm &>/dev/null; then
        _NPM_ROOT=$(npm root -g 2>/dev/null) || _NPM_ROOT=""
        if [ -n "${_NPM_ROOT}" ] && [ -f "${_NPM_ROOT}/@aws/ml-container-creator/servers/workload-picker/catalogs/workload-profiles.json" ]; then
            _CATALOG_FOR_HELP="${_NPM_ROOT}/@aws/ml-container-creator/servers/workload-picker/catalogs/workload-profiles.json"
        fi
    fi
    if [ -n "${_CATALOG_FOR_HELP}" ]; then
        echo "   Available workloads:"
        python3 -c "
import json
with open('${_CATALOG_FOR_HELP}') as f:
    catalog = json.load(f)
for name, wl in catalog.get('workloads', {}).items():
    print(f'     {name:30s} {wl.get("description", "")[:50]}')
" 2>/dev/null || echo "   (could not read workload catalog)"
    else
        echo "   Run 'ml-container-creator mcp init' to install workload profiles"
    fi
    echo ""
    echo "   Usage: ./do/benchmark --workload multi-turn-chat   (or --dataset <name> for BYOD)"
    exit 1
fi

# ── Workload Resolution (from workload-picker MCP server catalog) ─────────────
# If --workload is passed with a named workload (not "manual"), resolve
# the workload parameters from the MCP server's catalog file. This overrides
# BENCHMARK_INPUT_TOKENS_MEAN, BENCHMARK_OUTPUT_TOKENS_MEAN, BENCHMARK_STREAMING,
# and BENCHMARK_CONCURRENCY_LEVELS from do/config.
BENCHMARK_WORKLOAD="${ARG_WORKLOAD:-manual}"

if [ "${BENCHMARK_WORKLOAD}" != "manual" ]; then
    # Locate the workload catalog (npm global or local)
    _WORKLOAD_CATALOG=""
    if [ -f "$(dirname "${BASH_SOURCE[0]}")/../node_modules/@aws/ml-container-creator/servers/workload-picker/catalogs/workload-profiles.json" ]; then
        _WORKLOAD_CATALOG="$(dirname "${BASH_SOURCE[0]}")/../node_modules/@aws/ml-container-creator/servers/workload-picker/catalogs/workload-profiles.json"
    elif command -v npm &>/dev/null; then
        # Probe: npm may be absent / have no global root (catalog-not-found below).
        _NPM_ROOT=$(npm root -g 2>/dev/null) || _NPM_ROOT=""
        if [ -n "${_NPM_ROOT}" ] && [ -f "${_NPM_ROOT}/@aws/ml-container-creator/servers/workload-picker/catalogs/workload-profiles.json" ]; then
            _WORKLOAD_CATALOG="${_NPM_ROOT}/@aws/ml-container-creator/servers/workload-picker/catalogs/workload-profiles.json"
        fi
    fi

    if [ -n "${_WORKLOAD_CATALOG}" ]; then
        # BL165: a corrupt catalog used to read as "Unknown workload" (stderr
        # discarded). Capture and surface the parse error; fallback unchanged.
        _WL_ERR="$(mktemp)"
        _WL_PARAMS=$(python3 -c "
import json, sys
with open('${_WORKLOAD_CATALOG}') as f:
    catalog = json.load(f)
wl = catalog.get('workloads', {}).get('${BENCHMARK_WORKLOAD}')
if wl:
    print(json.dumps(wl))
else:
    print('null')
" 2>"${_WL_ERR}") || {
            echo "⚠️  Could not read workload catalog ${_WORKLOAD_CATALOG}" >&2
            _WL_PARAMS="null"
        }
        _bm_surface_stderr "${_WL_ERR}" "workload catalog error"

        if [ "${_WL_PARAMS}" != "null" ] && [ -n "${_WL_PARAMS}" ]; then
            echo "📋 Workload profile: ${BENCHMARK_WORKLOAD}"
            BENCHMARK_INPUT_TOKENS_MEAN=$(echo "${_WL_PARAMS}" | python3 -c "import sys,json; print(json.load(sys.stdin)['input_tokens_mean'])")
            BENCHMARK_OUTPUT_TOKENS_MEAN=$(echo "${_WL_PARAMS}" | python3 -c "import sys,json; print(json.load(sys.stdin)['output_tokens_mean'])")
            BENCHMARK_STREAMING=$(echo "${_WL_PARAMS}" | python3 -c "import sys,json; print(str(json.load(sys.stdin)['streaming']).lower())")
            # Set concurrency levels for multi-level mode if not already overridden
            if [ -z "${BENCHMARK_CONCURRENCY_LEVELS:-}" ]; then
                BENCHMARK_CONCURRENCY_LEVELS=$(echo "${_WL_PARAMS}" | python3 -c "import sys,json; print(','.join(str(x) for x in json.load(sys.stdin)['concurrency_levels']))")
            fi
            # Also override single-level BENCHMARK_CONCURRENCY with first level from workload
            BENCHMARK_CONCURRENCY=$(echo "${_WL_PARAMS}" | python3 -c "import sys,json; print(json.load(sys.stdin)['concurrency_levels'][0])")
            echo "   Input tokens: ${BENCHMARK_INPUT_TOKENS_MEAN}, Output tokens: ${BENCHMARK_OUTPUT_TOKENS_MEAN}"
            echo "   Streaming: ${BENCHMARK_STREAMING}, Concurrency: ${BENCHMARK_CONCURRENCY_LEVELS:-${BENCHMARK_CONCURRENCY}}"
            echo ""
        else
            echo "⚠️  Unknown workload '${BENCHMARK_WORKLOAD}' — using do/config defaults"
        fi
    else
        echo "⚠️  Workload catalog not found — using do/config defaults"
    fi
fi

# ── Resolve profile-level values ──────────────────────────────────────────────
# Read S3 buckets and account info from the bootstrap profile
_PROFILE_JSON=""
if command -v python3 &>/dev/null; then
    _PROFILE_JSON=$(python3 -c "
import json, os, sys
config_path = os.path.expanduser('~/.ml-container-creator/config.json')
try:
    with open(config_path) as f:
        config = json.load(f)
    profile = config['profiles'][config['activeProfile']]
    print(json.dumps(profile))
# BL165/R9.2: was a bare except (also swallowed NameError); narrowed to the
# expected missing/corrupt-profile errors, and the reason is now reported.
except (OSError, ValueError, KeyError, TypeError) as e:
    print(f'⚠️  Could not read active profile from {config_path}: {e!r}', file=sys.stderr)
    print('{}')
") || _PROFILE_JSON="{}"
fi

# Extract benchmark-relevant profile values
# The profile is the SOLE source of truth for bucket names — bootstrap writes
# benchmarkS3Bucket from the CDK stack output. Do NOT reconstruct a name from a
# convention: an empty value means bootstrap has not provisioned it (guarded below).
# The field reads below are parse-only on _PROFILE_JSON, which is always valid
# JSON (the profile or the "{}" fallback above, whose failure is now reported) —
# an empty result is handled explicitly, so these swallows are safe.
BENCHMARK_S3_OUTPUT_PATH=$(echo "${_PROFILE_JSON}" | python3 -c "
import sys, json
p = json.load(sys.stdin)
bucket = p.get('benchmarkS3Bucket', '')
print(f's3://{bucket}/${PROJECT_NAME}/' if bucket else '')
" 2>/dev/null) || BENCHMARK_S3_OUTPUT_PATH=""

if [ -z "${BENCHMARK_S3_OUTPUT_PATH}" ]; then
    echo "❌ No benchmark S3 bucket recorded in profile (benchmarkS3Bucket is empty)."
    echo "   Run 'ml-container-creator bootstrap' to set up your profile."
    exit 1
fi

CI_BENCHMARK_RESULTS_BUCKET=$(echo "${_PROFILE_JSON}" | python3 -c "import sys,json; print(json.load(sys.stdin).get('ciBenchmarkResultsBucket', ''))" 2>/dev/null) || CI_BENCHMARK_RESULTS_BUCKET=""

ROLE_ARN=$(echo "${_PROFILE_JSON}" | python3 -c "import sys,json; print(json.load(sys.stdin).get('roleArn', ''))" 2>/dev/null) || ROLE_ARN=""

# ── Custom dataset (BYOD) resolution (BL100) ──────────────────────────────────
# When --dataset <name> is passed, resolve it to an S3 URI via the shared dataset
# sidecar registry (same resolve-dataset helper used by do/optimize / do/tune) and
# drive the benchmark's traffic from that dataset instead of synthetic prompts.
# CORE_BUCKET (the core models bucket) backs the sidecar registry — resolved ONLY
# from the profile key coreS3Bucket (CORE_S3_BUCKET via do/lib/profile.sh), never
# the CodeBuild source bucket (bucket consolidation R2.3).
CORE_BUCKET="${CORE_BUCKET:-${CORE_S3_BUCKET:-}}"
if [ -z "${CORE_BUCKET}" ]; then
    # Parse-only read on the always-valid _PROFILE_JSON (see above) — safe.
    CORE_BUCKET=$(echo "${_PROFILE_JSON}" | python3 -c "import sys,json; print(json.load(sys.stdin).get('coreS3Bucket', ''))" 2>/dev/null) || CORE_BUCKET=""
fi
# Dataset-derived values, empty unless --dataset resolves successfully.
BENCHMARK_DATASET_S3URI=""
BENCHMARK_DATASET_FORMAT=""
BENCHMARK_DATASET_INPUT_FILE=""

if [ -n "${ARG_DATASET}" ]; then
    # Support the same name@vN / name@v1.2.3 version-pin syntax as do/optimize.
    _DATASET_NAME="${ARG_DATASET}"
    _DATASET_VERSION=""
    if [[ "${ARG_DATASET}" =~ ^(.+)@v([0-9]+\.[0-9]+\.[0-9]+)$ ]]; then
        _DATASET_NAME="${BASH_REMATCH[1]}"
        _DATASET_VERSION="${BASH_REMATCH[2]}"
    elif [[ "${ARG_DATASET}" =~ ^(.+)@v([0-9]+)$ ]]; then
        _DATASET_NAME="${BASH_REMATCH[1]}"
        _DATASET_VERSION="${BASH_REMATCH[2]}"
    fi

    echo "🔍 Resolving dataset '${_DATASET_NAME}' from registry (BYOD benchmark traffic)..."
    _ds_resolve_args=("--name" "${_DATASET_NAME}")
    if [ -n "${_DATASET_VERSION}" ]; then
        _ds_resolve_args+=("--version" "${_DATASET_VERSION}")
        echo "   Version: v${_DATASET_VERSION}"
    fi
    [ -n "${CORE_BUCKET}" ] && _ds_resolve_args+=("--core-bucket" "${CORE_BUCKET}")
    [ -n "${AWS_REGION}" ] && _ds_resolve_args+=("--region" "${AWS_REGION}")

    # BL165: capture the resolver's stderr (was discarded) — it distinguishes
    # "not registered" from MLflow/S3 transport errors and helper crashes.
    _ds_resolve_err="$(mktemp)"
    _ds_resolve_rc=0
    _ds_resolve_result=$(python3 "${SCRIPT_DIR}/.register_helper.py" resolve-dataset \
        "${_ds_resolve_args[@]}" 2>"${_ds_resolve_err}") || _ds_resolve_rc=$?
    if [ "${_ds_resolve_rc}" -ne 0 ]; then
        # Keep the structured {"error","code"} JSON line for the message below,
        # but never treat a failed resolve's output as a resolved URI.
        _ds_resolve_json=$(printf '%s\n' "${_ds_resolve_result}" | grep -E '^\{' | tail -1 || true)
        _ds_resolve_result=""
    fi

    if [ -n "${_ds_resolve_result}" ]; then
        # Parse s3_uri + format from the resolver JSON. custom_dataset_type comes
        # from the dataset's stored format (e.g. "jsonl"). input_file points at the
        # file within the DatasetConfig mount (/opt/ml/input/data/<channel>/<file>)
        # when the S3 URI names a specific file; a prefix URI leaves it unset so the
        # benchmark tool discovers the file under the mount. Parse-only reads;
        # an empty URI is reported explicitly just below (safe).
        BENCHMARK_DATASET_S3URI=$(echo "${_ds_resolve_result}" | grep -E '^\{' | tail -1 | python3 -c "import sys,json; print(json.load(sys.stdin).get('s3_uri',''))" 2>/dev/null) || BENCHMARK_DATASET_S3URI=""
        BENCHMARK_DATASET_FORMAT=$(echo "${_ds_resolve_result}" | grep -E '^\{' | tail -1 | python3 -c "import sys,json; print(json.load(sys.stdin).get('format','') or '')" 2>/dev/null) || BENCHMARK_DATASET_FORMAT=""
    fi

    if [ -z "${BENCHMARK_DATASET_S3URI}" ]; then
        echo "❌ Could not resolve dataset '${_DATASET_NAME}' from the registry."
        echo "   The dataset may not exist, or the registry helper is unavailable."
        if [ -n "${_ds_resolve_json:-}" ]; then
            echo "   Resolver error: ${_ds_resolve_json}"
        fi
        _bm_surface_stderr "${_ds_resolve_err}" "resolve-dataset output"
        echo "   Register one first: ./do/register dataset <name> ..."
        echo "   List datasets:      ./do/optimize --list-datasets"
        exit 1
    fi

    # Derive input_file only when the S3 URI names a concrete file (has an
    # extension); prefix URIs (trailing '/') mount a directory instead.
    BENCHMARK_DATASET_CHANNEL="traffic"
    _DS_BASENAME="${BENCHMARK_DATASET_S3URI##*/}"
    if [ -n "${_DS_BASENAME}" ] && [[ "${_DS_BASENAME}" == *.* ]]; then
        BENCHMARK_DATASET_INPUT_FILE="/opt/ml/input/data/${BENCHMARK_DATASET_CHANNEL}/${_DS_BASENAME}"
    fi

    rm -f "${_ds_resolve_err}"
    echo "   Resolved to: ${BENCHMARK_DATASET_S3URI}"
    echo "   Format (custom_dataset_type): ${BENCHMARK_DATASET_FORMAT:-jsonl}"
    [ -n "${BENCHMARK_DATASET_INPUT_FILE}" ] && echo "   input_file: ${BENCHMARK_DATASET_INPUT_FILE}"
    echo "   ℹ️  BYOD traffic replaces synthetic prompt generation (token-mean params omitted)."
    echo ""
fi

# Derive job names at runtime (unique per invocation).
# Preserve BENCHMARK_JOB_NAME if already set (from do/config or env) for resume logic.
BENCHMARK_JOB_NAME="${BENCHMARK_JOB_NAME:-${PROJECT_NAME}-benchmark-$(date +%Y%m%d-%H%M%S)}"
BENCHMARK_WORKLOAD_CONFIG_NAME="${PROJECT_NAME}-benchmark-config-$(date +%Y%m%d-%H%M%S)"

# ── Generate human-readable run name ─────────────────────────────────────────
# Format: {adjective-noun}_{workload}_{max-concurrency}
# e.g. coral-hawk_multi-turn-chat_16
# Generated once per run, stored in BENCHMARK_RUN_NAME in do/config.
_BENCHMARK_ADJECTIVES=(smart fast clever bright swift agile sharp quick wise keen
    bold sleek neat cool fresh prime vivid rapid elite noble lucid adept deft epic
    crisp vital zen hyper turbo cosmic lunar solar quantum atomic neon stellar
    iron amber coral jade onyx ruby opal ivory silver golden silent hollow calm)
_BENCHMARK_NOUNS=(river hawk fox wolf bear deer crane raven finch swift oak pine
    stone peak ridge grove creek vale cove reef mesa dune glade fern dawn dusk
    mist frost ember blaze cedar birch cliff shore brook glen ridge helm sable)
_BM_ADJ="${_BENCHMARK_ADJECTIVES[$(( RANDOM % ${#_BENCHMARK_ADJECTIVES[@]} ))]}"
_BM_NOUN="${_BENCHMARK_NOUNS[$(( RANDOM % ${#_BENCHMARK_NOUNS[@]} ))]}"
_BM_WORKLOAD_SLUG="${BENCHMARK_WORKLOAD//_/-}"
# Max concurrency: use levels if set, else BENCHMARK_CONCURRENCY
if [ -n "${BENCHMARK_CONCURRENCY_LEVELS:-}" ]; then
    _BM_MAX_CONC=$(echo "${BENCHMARK_CONCURRENCY_LEVELS}" | tr -d '[] ' | tr ',' '\n' | sort -n | tail -1)
else
    _BM_MAX_CONC="${BENCHMARK_CONCURRENCY:-1}"
fi
BENCHMARK_RUN_NAME="${_BM_ADJ}-${_BM_NOUN}_${_BM_WORKLOAD_SLUG}_${_BM_MAX_CONC}"

echo ""
echo "🎲 Run: ${_BM_ADJ}-${_BM_NOUN} | ${_BM_WORKLOAD_SLUG} | conc ${BENCHMARK_CONCURRENCY_LEVELS:-${BENCHMARK_CONCURRENCY}}"
echo "   Run ID: ${BENCHMARK_RUN_NAME}"
echo ""

# Ensure benchmark params have defaults (in case workload catalog wasn't found)
BENCHMARK_CONCURRENCY=${BENCHMARK_CONCURRENCY:-10}
BENCHMARK_INPUT_TOKENS_MEAN=${BENCHMARK_INPUT_TOKENS_MEAN:-550}
BENCHMARK_OUTPUT_TOKENS_MEAN=${BENCHMARK_OUTPUT_TOKENS_MEAN:-150}
BENCHMARK_STREAMING=${BENCHMARK_STREAMING:-true}



# ── Multi-level concurrency support (CI Stage 2) ─────────────────────────────
# When BENCHMARK_CONCURRENCY_LEVELS is set (comma-separated integers, e.g. "1,4,8"
# or JSON array string, e.g. "[1,4,8]"), and we are NOT already in single-level
# execution mode (_BENCHMARK_SINGLE_LEVEL), the script iterates over each level,
# re-invoking itself for each one.
# Results from all levels are aggregated into a combined JSON for the benchmark writer.
# This supports Requirement 1.5: configurable concurrency levels per config.
if [ -n "${BENCHMARK_CONCURRENCY_LEVELS:-}" ] && [ -z "${_BENCHMARK_SINGLE_LEVEL:-}" ]; then
    # Normalize: strip brackets and spaces, convert to comma-separated
    _NORMALIZED_LEVELS=$(echo "${BENCHMARK_CONCURRENCY_LEVELS}" | tr -d '[] ' )

    # Skip if empty after normalization
    if [ -n "${_NORMALIZED_LEVELS}" ]; then
        echo "📊 Multi-level benchmark: running concurrency levels [${_NORMALIZED_LEVELS}]"
        echo ""

        IFS=',' read -ra _LEVELS <<< "${_NORMALIZED_LEVELS}"
        _ALL_RESULTS_DIR="${SCRIPT_DIR}/../benchmarks/multi-level-$(date +%Y%m%d-%H%M%S)"
        mkdir -p "${_ALL_RESULTS_DIR}"
        _LEVEL_FAILURES=0

        for _LEVEL in "${_LEVELS[@]}"; do
            _LEVEL=$(echo "${_LEVEL}" | tr -d ' ')
            # Skip non-numeric values
            if ! [[ "${_LEVEL}" =~ ^[0-9]+$ ]]; then
                echo "⚠️  Skipping invalid concurrency level: ${_LEVEL}"
                continue
            fi
            echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
            echo "  Running benchmark at concurrency level: ${_LEVEL}"
            echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
            echo ""

            # Re-invoke self with overridden concurrency and single-level flag
            export BENCHMARK_CONCURRENCY="${_LEVEL}"
            export _BENCHMARK_SINGLE_LEVEL=1
            # Build argument list for re-invocation
            _REINVOKE_ARGS="--force"
            if [ "${CLEAN_AFTER}" = true ]; then _REINVOKE_ARGS="${_REINVOKE_ARGS} --clean"; fi
            if [ "${ARG_NO_STALE_WARNING}" = true ]; then _REINVOKE_ARGS="${_REINVOKE_ARGS} --no-stale-warning"; fi
            if [ -n "${ARG_WORKLOAD}" ]; then _REINVOKE_ARGS="${_REINVOKE_ARGS} --workload ${ARG_WORKLOAD}"; fi
            if [ -n "${ARG_DATASET}" ]; then _REINVOKE_ARGS="${_REINVOKE_ARGS} --dataset ${ARG_DATASET}"; fi
            if [ -n "${IC_ARG}" ]; then _REINVOKE_ARGS="${_REINVOKE_ARGS} --ic ${IC_ARG}"; fi
            if [ -n "${ADAPTER_ARG}" ]; then _REINVOKE_ARGS="${_REINVOKE_ARGS} --adapter ${ADAPTER_ARG}"; fi

            _CHILD_EXIT=0
            "${BASH_SOURCE[0]}" ${_REINVOKE_ARGS} || _CHILD_EXIT=$?

            if [ ${_CHILD_EXIT} -eq 130 ]; then
                # Child was interrupted (Ctrl+C) — propagate cleanly
                exit 130
            fi

            if [ ${_CHILD_EXIT} -eq 0 ]; then
                # Copy results to aggregation directory — find the child's results
                # Try the marker file first (set by child), then fall back to ls -td
                _LATEST_JOB_DIR=""
                # Marker / `ls -td` existence probes; a miss is handled by the
                # -d / -f checks below (safe swallows).
                if [ -f "/tmp/.mlcc-benchmark-latest-${PROJECT_NAME}" ]; then
                    _LATEST_JOB_DIR=$(cat "/tmp/.mlcc-benchmark-latest-${PROJECT_NAME}" 2>/dev/null)
                fi
                if [ -z "${_LATEST_JOB_DIR}" ] || [ ! -d "${_LATEST_JOB_DIR}" ]; then
                    _LATEST_JOB_DIR=$(ls -td "${SCRIPT_DIR}/../benchmarks/${PROJECT_NAME}-benchmark-"* 2>/dev/null | head -1)
                fi
                # Wave 9 R1.3: keep BOTH the per-request JSONL and the AIPerf
                # aggregate (its start_time/end_time is this level's run window
                # and its request_error_rate the level's error rate), plus the
                # child job name and this level's scrape sidecars, so the writer
                # gives every row its own window, identity and signals. The same
                # results-concurrency-<L>.json feeds the BL128 Effective/Active
                # columns (W9 R10.1); JSONL stays the metrics source — the
                # aggregator only falls back to these JSONs without JSONL.
                if [ -n "${_LATEST_JOB_DIR}" ] && [ -d "${_LATEST_JOB_DIR}" ]; then
                    if [ -f "${_LATEST_JOB_DIR}/output/profile_export.jsonl" ]; then
                        cp "${_LATEST_JOB_DIR}/output/profile_export.jsonl" "${_ALL_RESULTS_DIR}/profile-concurrency-${_LEVEL}.jsonl"
                    fi
                    if [ -f "${_LATEST_JOB_DIR}/output/profile_export_aiperf.json" ]; then
                        cp "${_LATEST_JOB_DIR}/output/profile_export_aiperf.json" "${_ALL_RESULTS_DIR}/results-concurrency-${_LEVEL}.json"
                    fi
                    basename "${_LATEST_JOB_DIR}" > "${_ALL_RESULTS_DIR}/job-concurrency-${_LEVEL}.txt"
                    for _gm_sidecar in "${_LATEST_JOB_DIR}"/gpu_metrics-c"${_LEVEL}"-*.json; do
                        if [ -f "${_gm_sidecar}" ]; then
                            cp "${_gm_sidecar}" "${_ALL_RESULTS_DIR}/"
                        fi
                    done
                fi
            else
                echo "⚠️  Benchmark at concurrency ${_LEVEL} failed (non-fatal, continuing)"
                _LEVEL_FAILURES=$((_LEVEL_FAILURES + 1))
            fi
            unset _BENCHMARK_SINGLE_LEVEL
            echo ""
        done

        # Aggregate results into a combined JSON file for the benchmark writer
        # Reads per-level JSONL files and computes aggregate metrics per concurrency level
        echo "📊 Aggregating multi-level results..."
        _COMBINED_FILE="${_ALL_RESULTS_DIR}/results.json"
        python3 -c "
import json, glob, sys, os, math

def percentile(sorted_vals, pct):
    if not sorted_vals:
        return 0.0
    idx = (pct / 100.0) * (len(sorted_vals) - 1)
    lower = int(math.floor(idx))
    upper = int(math.ceil(idx))
    if lower == upper:
        return sorted_vals[lower]
    frac = idx - lower
    return sorted_vals[lower] * (1 - frac) + sorted_vals[upper] * frac

def get_val(metrics, key):
    m = metrics.get(key)
    if isinstance(m, dict):
        return m.get('value')
    return m

results_dir = '${_ALL_RESULTS_DIR}'
combined = {'metrics': []}

# Process JSONL files (preferred)
for f in sorted(glob.glob(os.path.join(results_dir, 'profile-concurrency-*.jsonl'))):
    try:
        level = int(os.path.basename(f).replace('profile-concurrency-', '').replace('.jsonl', ''))
        records = []
        with open(f) as fp:
            for line in fp:
                line = line.strip()
                if line:
                    records.append(json.loads(line))

        if not records:
            continue

        # Aggregate per-request metrics
        latencies, ttfts, itls, ttsts, out_tokens = [], [], [], [], []
        start_times, end_times, in_tokens = [], [], []
        prefill_tps, output_tps = [], []
        # Wave 9 R3: AIPerf marks a failed request with a top-level 'error'.
        error_count = sum(1 for r in records if r.get('error') is not None)

        for rec in records:
            meta = rec.get('metadata', {})
            metrics = rec.get('metrics', {})
            lat = get_val(metrics, 'request_latency')
            if lat is not None: latencies.append(lat)
            ttft = get_val(metrics, 'time_to_first_token') or get_val(metrics, 'time_to_first_output_token')
            if ttft is not None: ttfts.append(ttft)
            itl = get_val(metrics, 'inter_token_latency')
            if itl is not None: itls.append(itl)
            ttst = get_val(metrics, 'time_to_second_token')
            if ttst is not None: ttsts.append(ttst)
            otc = get_val(metrics, 'output_token_count')
            if otc is not None: out_tokens.append(otc)
            isl = get_val(metrics, 'input_sequence_length')
            if isl is not None: in_tokens.append(isl)
            ptps = get_val(metrics, 'prefill_throughput_per_user')
            if ptps is not None: prefill_tps.append(ptps)
            otps = get_val(metrics, 'output_token_throughput_per_user')
            if otps is not None: output_tps.append(otps)
            rs = meta.get('request_start_ns')
            re_ = meta.get('request_end_ns')
            if rs: start_times.append(rs)
            if re_: end_times.append(re_)

        # Sort for percentiles
        latencies.sort()
        ttfts.sort()
        itls.sort()
        ttsts.sort()
        prefill_tps.sort()
        output_tps.sort()

        # Compute throughput
        duration_s = (max(end_times) - min(start_times)) / 1e9 if start_times and end_times else 1.0
        duration_s = max(duration_s, 0.001)
        req_throughput = len(records) / duration_s
        token_throughput = sum(out_tokens) / duration_s if out_tokens else 0.0

        entry = {
            'concurrency': level,
            'request_throughput': req_throughput,
            'output_token_throughput': token_throughput,
            'total_requests': len(records),
            'error_count': error_count,
            'duration_seconds': duration_s,
            'time_to_first_token': {
                'avg': sum(ttfts)/len(ttfts) if ttfts else 0.0,
                'p50': percentile(ttfts, 50),
                'p90': percentile(ttfts, 90),
                'p99': percentile(ttfts, 99),
            },
            'inter_token_latency': {
                'avg': sum(itls)/len(itls) if itls else 0.0,
                'p50': percentile(itls, 50),
                'p90': percentile(itls, 90),
                'p99': percentile(itls, 99),
            },
            'e2e_latency': {
                'avg': sum(latencies)/len(latencies) if latencies else 0.0,
                'p50': percentile(latencies, 50),
                'p90': percentile(latencies, 90),
                'p99': percentile(latencies, 99),
            },
            'time_to_second_token': {
                'p50': percentile(ttsts, 50),
                'p90': percentile(ttsts, 90),
            },
            'prefill_throughput': {
                'avg': sum(prefill_tps)/len(prefill_tps) if prefill_tps else 0.0,
                'p50': percentile(prefill_tps, 50),
            },
            'output_token_throughput_detail': {
                'avg': sum(output_tps)/len(output_tps) if output_tps else 0.0,
                'p50': percentile(output_tps, 50),
                'p90': percentile(output_tps, 90),
            },
            'total_token_throughput': (sum(out_tokens) + sum(in_tokens)) / duration_s if (out_tokens or in_tokens) else 0.0,
            'output_sequence_length': sum(out_tokens)/len(out_tokens) if out_tokens else 0.0,
            'input_sequence_length': sum(in_tokens)/len(in_tokens) if in_tokens else 0.0,
            'request_count': len(records),
            'input_tokens_mean': ${BENCHMARK_INPUT_TOKENS_MEAN:-0},
            'output_tokens_mean': ${BENCHMARK_OUTPUT_TOKENS_MEAN:-0},
        }
        combined['metrics'].append(entry)
    except Exception as e:
        print(f'Warning: Could not parse {f}: {e}', file=sys.stderr)

# Fallback: process old-style JSON files if no JSONL found
if not combined['metrics']:
    for f in sorted(glob.glob(os.path.join(results_dir, 'results-concurrency-*.json'))):
        try:
            with open(f) as fp:
                data = json.load(fp)
            level = int(os.path.basename(f).replace('results-concurrency-', '').replace('.json', ''))
            if isinstance(data, dict):
                data['concurrency'] = level
                combined['metrics'].append(data)
        except Exception as e:
            print(f'Warning: Could not parse {f}: {e}', file=sys.stderr)

with open('${_COMBINED_FILE}', 'w') as fp:
    try:
        json.dump(combined, fp, indent=2)
    except TypeError as te:
        print(f'Warning: JSON serialize error: {str(te)}', file=sys.stderr)
        fp.write(json.dumps({'metrics': []}, indent=2))
n_metrics = len(combined.get('metrics', []))
print(f'Combined {n_metrics} concurrency level results')
" 2>&1

        # Persist to Athena if CI mode is active
        if [ -n "${CI_BENCHMARK_RESULTS_BUCKET:-}" ] && [ -f "${_COMBINED_FILE}" ]; then
            echo ""
            echo "📊 Persisting multi-level benchmark results to Athena..."

            _compute_config_id() {
                local input="${DEPLOYMENT_CONFIG}:${MODEL_NAME:-none}:${INSTANCE_TYPE}:${AWS_REGION}:${DEPLOYMENT_TARGET}:ic${IC_COUNT:-1}:adapt${ADAPTER_COUNT:-0}"
                if command -v sha256sum &> /dev/null; then
                    echo -n "$input" | sha256sum | cut -c1-16
                else
                    echo -n "$input" | shasum -a 256 | cut -c1-16
                fi
            }
            CONFIG_ID=$(_compute_config_id)

            # Wave 9 R1.3 / R5.1 / R6.3: each level's window, child job name and
            # scrape sidecars sit in ${_ALL_RESULTS_DIR} (copy step above); the
            # writer resolves them per row. --endpoint-name / --ic-name scope the
            # realtime PromQL selector (the writer falls back to each level's
            # DescribeAIBenchmarkJob BenchmarkTarget when they are unset here).
            if python3 "$(dirname "${BASH_SOURCE[0]}")/.benchmark_writer.py" write \
                --results-file "${_COMBINED_FILE}" \
                --config-file "$(dirname "${BASH_SOURCE[0]}")/config" \
                ${DEPLOYMENT_TARGET:+--deployment-target "${DEPLOYMENT_TARGET}"} \
                --project-name "${PROJECT_NAME}" \
                --workload "${BENCHMARK_WORKLOAD:-manual}" \
                --bucket "${CI_BENCHMARK_RESULTS_BUCKET}" \
                --region "${AWS_REGION:-${REGION}}" \
                ${RESOLVED_INSTANCE_TYPE:+--instance-type "${RESOLVED_INSTANCE_TYPE}"} \
                ${ADAPTER_ARG:+--adapter-name "${ADAPTER_ARG}"} \
                ${ENDPOINT_NAME:+--endpoint-name "${ENDPOINT_NAME}"} \
                ${IC_NAME:+--ic-name "${IC_NAME}"} \
                --gpu-metrics-dir "${_ALL_RESULTS_DIR}" \
                ${BENCHMARK_RUN_NAME:+--run-name "${BENCHMARK_RUN_NAME}"}; then
                echo "✅ Multi-level benchmark results persisted to S3"
            else
                echo "⚠️  Failed to persist multi-level benchmark results to Athena (non-fatal)"
            fi
        fi

        echo ""
        echo "📋 Multi-level Summary:"
        echo "   Levels tested: ${#_LEVELS[@]}"
        echo "   Failures: ${_LEVEL_FAILURES} / ${#_LEVELS[@]}"
        echo "   Results: ${_ALL_RESULTS_DIR}/"

        if [ ${_LEVEL_FAILURES} -ge ${#_LEVELS[@]} ]; then
            echo "❌ All concurrency levels failed"
            exit 1
        fi
        exit 0
    fi
fi

# ── Plain EKS single-level run: local AIPerf (BL157) ──────────────────────────
# Reached AFTER the flag parser, workload catalog, dataset resolver, and the
# multi-level sweep setup — so eks honors --workload / --dataset / concurrency
# exactly as the SageMaker-endpoint targets (R1). A multi-level parent run is
# handled entirely by the sweep above (which re-invokes self per level with
# _BENCHMARK_SINGLE_LEVEL=1 and exits); only a single-level run (child or an
# eks invocation with no levels) reaches here. The SageMaker service path below
# (endpoint preflight, create-ai-*, poll, S3 download) is skipped for eks (R6).
if [ "${DEPLOYMENT_TARGET:-}" = "eks" ]; then
