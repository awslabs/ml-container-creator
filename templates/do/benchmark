# do/benchmark — Run SageMaker AI Benchmark against deployed endpoint.
#
# @mlcc-script
# type: deployment-centric
# guard: deployment-active
# lifecycle: post-deploy
# targets: all

# Uses NVIDIA AIPerf via the SageMaker AI Benchmarking service to measure
# LLM endpoint performance: throughput, latency, TTFT, and ITL.

set -e
set -u
set -o pipefail

# Normalize --flag=value → --flag value before any arg inspection below.
# This lets users pass either `--min-tp 4` or `--min-tp=4`.
_NORMALIZED_ARGS=()
for _a in "$@"; do
    case "$_a" in
        --*=*) _NORMALIZED_ARGS+=("${_a%%=*}" "${_a#*=}") ;;
        *)     _NORMALIZED_ARGS+=("$_a") ;;
    esac
done
set -- "${_NORMALIZED_ARGS[@]+"${_NORMALIZED_ARGS[@]}"}"

# ── Source project configuration ──────────────────────────────────────────────
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Check for --json or --compare-baseline flag early — suppress config output for structured output modes
_BENCHMARK_JSON_MODE=false
for _arg in "$@"; do
    case "$_arg" in
        --json|--compare-baseline|--gpu-metrics|--peak|--list|--set-baseline)
            _BENCHMARK_JSON_MODE=true; break ;;
    esac
done

source "${SCRIPT_DIR}/lib/script-contract.sh"
_require_python_env
if [ "${_BENCHMARK_JSON_MODE}" = true ]; then
    # Source config with stdout redirected to stderr — config vars load correctly,
    # but the "Configuration loaded" header goes to stderr (visible in terminal,
    # doesn't pollute stdout piping or --json output).
    source "${SCRIPT_DIR}/config" 1>&2
else
    source "${SCRIPT_DIR}/config"
fi
source "${SCRIPT_DIR}/lib/profile.sh"
source "${SCRIPT_DIR}/lib/resolve-instance.sh"

# ── Phase 2 engine /metrics scrape (BL086, HyperPod EKS opt-in) ───────────────
# BL108 upgrades the BL086 point-in-time /metrics scrape into a background
# poller. When HP_BENCHMARK_METRICS_ENABLED=true, DEPLOYMENT_TARGET is
# hyperpod-eks/eks, AND the active engine's serve.d/<engine>/manifest.json
# declares a metrics_endpoint (BL105), a background poller is spawned at
# benchmark start (Req 1.1). It samples engine /metrics every 5s for the whole
# run and writes peak/avg to benchmarks/.last_gpu_metrics.json at the end
# (Req 2, 3). When no metrics_endpoint is declared, Phase 2 is silently skipped
# (Req 4.1). The port-forward is started before the poller (Req 7.1) and stopped
# after benchmark end, on both normal and abnormal exit (Req 7.2).
#
# State shared between _phase2_start_poller and _phase2_stop_poller:
_PHASE2_PF_PID=""        # kubectl port-forward PID
_PHASE2_POLLER_PID=""    # phase2_poller.py PID
_PHASE2_STOP_FILE=""     # sentinel file that signals the poller to stop
_PHASE2_ACTIVE=false     # true once a poller has been spawned

# ── Spawn the poller (Req 1, 4, 7.1) ──────────────────────────────────────────
# Resolves the metrics_endpoint from the engine manifest and, only if declared,
# starts the port-forward and spawns the background poller. Always non-fatal:
# any failure degrades to "no Phase 2 file" and returns 0.
_phase2_start_poller() {
    # Outer opt-in guards (subsume the BL086 gates). Silent skip if not opted in.
    if [ "${HP_BENCHMARK_METRICS_ENABLED:-false}" != "true" ]; then
        return 0
    fi
    if [ "${DEPLOYMENT_TARGET:-}" != "hyperpod-eks" ] && [ "${DEPLOYMENT_TARGET:-}" != "eks" ]; then
        return 0
    fi

    local _sd
    _sd="$(dirname "${BASH_SOURCE[0]}")"

    # Req 4.1: spawn only if the engine manifest declares a metrics_endpoint.
    # serve_manifest.py exits non-zero (and prints nothing usable) when absent.
    local _me_json
    _me_json=$(python3 "${_sd}/lib/python/serve_manifest.py" metrics_endpoint "${MODEL_SERVER}" 2>/dev/null) || _me_json=""
    if [ -z "${_me_json}" ] || [ "${_me_json}" = "null" ]; then
        # No metrics_endpoint → silently skip Phase 2 (no poller, no error).
        return 0
    fi

    # Extract the remote port from the metrics_endpoint (default 8080, matching
    # the historical hardcoded value). Parsing failures fall back to 8080.
    local _remote_port
    _remote_port=$(printf '%s' "${_me_json}" | python3 -c \
        'import json,sys
try:
    print(int(json.load(sys.stdin).get("port", 8080)))
except Exception:
    print(8080)' 2>/dev/null) || _remote_port=8080
    [ -z "${_remote_port}" ] && _remote_port=8080

    # Resolve kubeconfig for the cluster. The exec credential (aws eks get-token)
    # must run with the correct AWS profile, only available after do/config is
    # sourced — so always run update-kubeconfig rather than reusing a stale file.
    local _kubeconfig="${HOME}/.kube/hyperpod-${HP_CLUSTER_NAME:-}"
    local _eks_arn _eks_name
    _eks_arn=$(aws sagemaker describe-cluster \
        --cluster-name "${HP_CLUSTER_NAME:-}" \
        --region "${AWS_REGION}" \
        --query "Orchestrator.Eks.ClusterArn" \
        --output text 2>/dev/null) || return 0
    [ -z "${_eks_arn}" ] || [ "${_eks_arn}" = "None" ] && return 0
    _eks_name=$(echo "${_eks_arn}" | awk -F'/' '{print $NF}')
    local _profile_arg=""
    [ -n "${AWS_PROFILE:-}" ] && _profile_arg="--profile ${AWS_PROFILE}"
    aws eks update-kubeconfig \
        --name "${_eks_name}" \
        --region "${AWS_REGION}" \
        ${_profile_arg} \
        --kubeconfig "${_kubeconfig}" >/dev/null 2>&1 || return 0
    export KUBECONFIG="${_kubeconfig}"

    kubectl cluster-info >/dev/null 2>&1 || return 0

    # Discover the Running serving pod (empty → pod not Running → silent skip).
    local _pod_name
    _pod_name=$(kubectl get pods -n "${HP_NAMESPACE:-default}" \
        -l "app=${PROJECT_NAME}" \
        --field-selector=status.phase=Running \
        -o jsonpath='{.items[0].metadata.name}' 2>/dev/null) || return 0
    [ -z "${_pod_name}" ] && return 0

    # Req 7.1: start the port-forward BEFORE the poller.
    local _local_port=18080
    kubectl port-forward "pod/${_pod_name}" "${_local_port}:${_remote_port}" \
        -n "${HP_NAMESPACE:-default}" >/dev/null 2>&1 &
    _PHASE2_PF_PID=$!
    sleep 3
    if ! kill -0 "${_PHASE2_PF_PID}" 2>/dev/null; then
        # Port-forward failed → non-fatal, do not spawn the poller (Error Handling).
        _PHASE2_PF_PID=""
        return 0
    fi

    # Req 1.1: spawn the background poller only after the port-forward is live.
    _PHASE2_STOP_FILE="$(mktemp -t mlcc_phase2_stop.XXXXXX)"
    rm -f "${_PHASE2_STOP_FILE}" 2>/dev/null || true  # sentinel must not pre-exist
    local _output="${SCRIPT_DIR}/../benchmarks/.last_gpu_metrics.json"
    python3 "${_sd}/lib/python/phase2_poller.py" \
        "http://localhost:${_local_port}" "${MODEL_SERVER}" "${_output}" \
        --interval 5 --min-samples 5 --stop-file "${_PHASE2_STOP_FILE}" \
        >/dev/null 2>&1 &
    _PHASE2_POLLER_PID=$!
    if ! kill -0 "${_PHASE2_POLLER_PID}" 2>/dev/null; then
        # Req 1.2: poller failed to spawn → continue without Phase 2, warn.
        echo "⚠️  Phase 2 metrics poller failed to spawn (non-fatal)" >&2
        _PHASE2_POLLER_PID=""
        kill "${_PHASE2_PF_PID}" 2>/dev/null || true
        _PHASE2_PF_PID=""
        return 0
    fi
    _PHASE2_ACTIVE=true
    return 0
}

# ── Stop the poller and port-forward (Req 3, 7.2) ─────────────────────────────
# Signals the poller to stop (it aggregates + writes .last_gpu_metrics.json),
# waits for it to finish, then stops the port-forward. Safe to call multiple
# times and from an EXIT trap; runs regardless of how the benchmark ended.
_phase2_stop_poller() {
    if [ "${_PHASE2_ACTIVE}" != "true" ]; then
        return 0
    fi
    _PHASE2_ACTIVE=false

    # Signal the poller to stop via the sentinel file (Req 3.1: it writes on stop).
    [ -n "${_PHASE2_STOP_FILE}" ] && : > "${_PHASE2_STOP_FILE}" 2>/dev/null || true

    # Wait for the poller to finish writing (bounded so a hung poller cannot
    # stall the benchmark). It should exit within ~1 interval of the sentinel.
    if [ -n "${_PHASE2_POLLER_PID}" ]; then
        local _waited=0
        while kill -0 "${_PHASE2_POLLER_PID}" 2>/dev/null; do
            sleep 1
            _waited=$((_waited + 1))
            if [ ${_waited} -ge 15 ]; then
                kill "${_PHASE2_POLLER_PID}" 2>/dev/null || true
                break
            fi
        done
        wait "${_PHASE2_POLLER_PID}" 2>/dev/null || true
        _PHASE2_POLLER_PID=""
    fi

    # Req 7.2: stop the port-forward AFTER the poller has finished.
    if [ -n "${_PHASE2_PF_PID}" ]; then
        kill "${_PHASE2_PF_PID}" 2>/dev/null || true
        _PHASE2_PF_PID=""
    fi

    [ -n "${_PHASE2_STOP_FILE}" ] && rm -f "${_PHASE2_STOP_FILE}" 2>/dev/null || true
    _PHASE2_STOP_FILE=""
    return 0
}

# Req 7.3: ensure the port-forward is stopped on any exit (normal or abnormal,
# including a poller crash or an interrupt during the run).
trap '_phase2_stop_poller' EXIT

# ── Target guard: benchmark uses InvokeEndpoint (real-time only) ──────────────
# BL086: run-window timestamps for post-run CloudWatch enrichment (set at
# job creation / completion). Default empty so ${VAR:+...} expansions are safe.
BENCHMARK_RUN_START="${BENCHMARK_RUN_START:-}"
BENCHMARK_RUN_END="${BENCHMARK_RUN_END:-}"
# async-inference and batch-transform carry distinct guidance and sit above the
# plain-EKS path below, so they stay explicit branches; _contract_violation
# gives each the standard contract-violation format + exit 3.
if [ "${DEPLOYMENT_TARGET:-}" = "async-inference" ]; then
    _contract_violation "target" \
        "do/benchmark is not supported on async-inference. AIPerf benchmarking uses synchronous InvokeEndpoint calls; async endpoints only support invoke-endpoint-async." \
        "Switch target: do/deploy --target realtime-inference"
fi
if [ "${DEPLOYMENT_TARGET:-}" = "batch-transform" ]; then
    _contract_violation "target" \
        "do/benchmark is not supported on batch-transform. AIPerf benchmarking requires a real-time endpoint." \
        "Switch target: do/deploy --target realtime-inference"
fi

# ── Plain EKS benchmark: direct pod port-forward (BL103, Requirement 6) ────────
# The eks target has no SageMaker endpoint, so the SageMaker AI Benchmarking
# service path below does not apply. Instead, reach the serving pod directly via
# `kubectl port-forward pod/<pod> 8080` (same mechanism hyperpod-eks uses for its
# pod-facing paths) and drive a local latency/throughput measurement. If the
# port-forward cannot be established, fail fast with a clear error (Req 6.2).
if [ "${DEPLOYMENT_TARGET:-}" = "eks" ]; then
    HP_NAMESPACE="${HP_NAMESPACE:-default}"
    _profile_arg=""
    [ -n "${_PROFILE_awsProfile:-${AWS_PROFILE:-}}" ] && _profile_arg="--profile ${_PROFILE_awsProfile:-${AWS_PROFILE}}"

    echo "📊 Plain EKS benchmark (direct pod port-forward)"
    echo "   Project: ${PROJECT_NAME}"
    echo "   Namespace: ${HP_NAMESPACE}"
    echo "   Model server: ${MODEL_SERVER}"

    # Kubeconfig update is gated on HP_CLUSTER_NAME (as in deploy/test).
    if [ -n "${HP_CLUSTER_NAME:-}" ]; then
        KUBECONFIG_PATH="${HOME}/.kube/eks-${HP_CLUSTER_NAME}"
        _eks_name="${HP_CLUSTER_NAME}"
        _eks_arn=$(aws sagemaker describe-cluster \
            --cluster-name "${HP_CLUSTER_NAME}" \
            --region "${AWS_REGION}" \
            ${_profile_arg} \
            --query "Orchestrator.Eks.ClusterArn" \
            --output text 2>/dev/null) || _eks_arn=""
        if [ -n "${_eks_arn}" ] && [ "${_eks_arn}" != "None" ]; then
            _eks_name=$(echo "${_eks_arn}" | awk -F'/' '{print $NF}')
        fi
        aws eks update-kubeconfig \
            --name "${_eks_name}" \
            --region "${AWS_REGION}" \
            ${_profile_arg} \
            --kubeconfig "${KUBECONFIG_PATH}" >/dev/null 2>&1 || {
            echo "❌ do/benchmark could not configure kubectl for cluster '${HP_CLUSTER_NAME}'."
            echo "   Port-forward to the serving pod cannot be established."
            exit 1
        }
        export KUBECONFIG="${KUBECONFIG_PATH}"
    fi

    # Resolve the running serving pod by label.
    _EKS_POD=$(kubectl get pods -n "${HP_NAMESPACE}" \
        -l "app=${PROJECT_NAME}" \
        --field-selector=status.phase=Running \
        -o jsonpath='{.items[0].metadata.name}' 2>/dev/null) || _EKS_POD=""
    if [ -z "${_EKS_POD}" ]; then
        echo "❌ do/benchmark: no running pod found for app=${PROJECT_NAME} in namespace ${HP_NAMESPACE}."
        echo "   Port-forward to the serving pod cannot be established."
        echo "   Check: kubectl get pods -n ${HP_NAMESPACE} -l app=${PROJECT_NAME}"
        exit 1
    fi

    _EKS_LOCAL_PORT="${HP_BENCHMARK_PORT:-18080}"
    echo "🔌 Port-forwarding pod/${_EKS_POD}:8080 to localhost:${_EKS_LOCAL_PORT}..."
    kubectl port-forward "pod/${_EKS_POD}" "${_EKS_LOCAL_PORT}:8080" \
        -n "${HP_NAMESPACE}" >/dev/null 2>&1 &
    _EKS_PF_PID=$!
    sleep 3
    trap "kill ${_EKS_PF_PID} 2>/dev/null || true" EXIT

    # Fail fast on port-forward failure (Requirement 6.2).
    if ! kill -0 "${_EKS_PF_PID}" 2>/dev/null; then
        echo "❌ do/benchmark: port-forward to pod/${_EKS_POD} failed."
        echo "   The serving pod could not be reached via kubectl port-forward."
        echo "   Check: kubectl get pods -n ${HP_NAMESPACE} -l app=${PROJECT_NAME}"
        exit 1
    fi
    if ! curl -s -o /dev/null -m 10 "http://localhost:${_EKS_LOCAL_PORT}/ping"; then
        echo "❌ do/benchmark: port-forward established but /ping did not respond."
        echo "   The serving pod is not ready to accept traffic."
        kill "${_EKS_PF_PID}" 2>/dev/null || true
        exit 1
    fi
    echo "✅ Port-forward established — pod is reachable at http://localhost:${_EKS_LOCAL_PORT}"

    # Drive a lightweight local latency/throughput measurement against the pod.
    _EKS_BENCH_URL="http://localhost:${_EKS_LOCAL_PORT}"
    if [ "${FRAMEWORK}" = "diffusors" ]; then
        _EKS_BENCH_PATH="/v1/images/generations"
        _EKS_BENCH_PAYLOAD='{"prompt": "A white cat", "n": 1, "size": "512x512"}'
    elif [ "${MODEL_SERVER}" = "vllm" ] || [ "${MODEL_SERVER}" = "sglang" ]; then
        _EKS_MODEL="${MODEL_NAME}"
        if [[ "${MODEL_NAME}" == s3://* ]] || [[ "${MODEL_NAME}" == /opt/ml/* ]]; then
            _EKS_MODEL="/opt/ml/model"
        fi
        _EKS_BENCH_PATH="/invocations"
        _EKS_BENCH_PAYLOAD='{"model": "'"${_EKS_MODEL}"'", "messages": [{"role": "user", "content": "What is machine learning?"}], "max_tokens": 64, "temperature": 0.7}'
    else
        _EKS_BENCH_PATH="/invocations"
        _EKS_BENCH_PAYLOAD='{"inputs": "What is machine learning?", "parameters": {"max_new_tokens": 64}}'
    fi

    _EKS_ITERS="${BENCHMARK_REQUEST_COUNT:-20}"
    echo ""
    echo "🏁 Running ${_EKS_ITERS} sequential requests against ${_EKS_BENCH_URL}${_EKS_BENCH_PATH}..."
    _EKS_OK=0
    _EKS_TOTAL_MS=0
    for _i in $(seq 1 "${_EKS_ITERS}"); do
        _t=$(curl -s -o /dev/null -m 120 -w "%{http_code} %{time_total}" -X POST \
            "${_EKS_BENCH_URL}${_EKS_BENCH_PATH}" \
            -H "Content-Type: application/json" \
            -d "${_EKS_BENCH_PAYLOAD}" 2>/dev/null) || _t="000 0"
        _code=$(echo "${_t}" | awk '{print $1}')
        _secs=$(echo "${_t}" | awk '{print $2}')
        if [ "${_code}" = "200" ]; then
            _EKS_OK=$((_EKS_OK + 1))
            _ms=$(awk "BEGIN{printf \"%d\", ${_secs} * 1000}")
            _EKS_TOTAL_MS=$((_EKS_TOTAL_MS + _ms))
        fi
    done

    kill "${_EKS_PF_PID}" 2>/dev/null || true
    trap - EXIT

    echo ""
    echo "📊 Plain EKS benchmark results:"
    echo "   Requests:   ${_EKS_ITERS}"
    echo "   Successful: ${_EKS_OK}"
    if [ "${_EKS_OK}" -gt 0 ]; then
        _EKS_AVG_MS=$((_EKS_TOTAL_MS / _EKS_OK))
        echo "   Avg latency: ${_EKS_AVG_MS} ms"
    fi
    echo ""
    echo "ℹ️  The eks target serves plain Kubernetes objects with no SageMaker"
    echo "   endpoint, so the SageMaker AI Benchmarking service is not used."
    echo "   For richer engine metrics, set HP_BENCHMARK_METRICS_ENABLED=true."
    exit 0
fi

# ── Parse flags ───────────────────────────────────────────────────────────────
CLEAN_AFTER=false
FORCE=false
ARG_STATUS=false
IC_ARG=""
ADAPTER_ARG=""
ARG_NO_STALE_WARNING=false
ARG_WORKLOAD=""
ARG_DATASET=""
ARG_COMPARE_BASELINE=false
ARG_RECOMMEND=false
ARG_RECOMMEND_APPLY=false
ARG_RECOMMEND_METRIC="output_token_throughput_tps"
ARG_NO_BEDROCK=false
ARG_THRESHOLDS=()
ARG_JSON=false
# BL101 analytics surface flags
ARG_GPU_METRICS=false
ARG_PEAK=false
ARG_PEAK_METRIC=""
ARG_LIST=false
ARG_LIST_MODEL=""
ARG_LIST_SORT=""
ARG_LIST_LIMIT=""
ARG_LIST_MIN_TP=""
ARG_LIST_QUANT=""
ARG_LIST_MAX_LEN=""
ARG_LIST_KV_DTYPE=""
ARG_LIST_EXCLUDE_INSTANCES=""
ARG_LIST_INCLUDE_INSTANCES=""
ARG_SET_BASELINE=false
ARG_SET_BASELINE_VALUE=""
ARG_SET_BASELINE_CLEAR=false
while [ $# -gt 0 ]; do
    case "$1" in
        --clean) CLEAN_AFTER=true; shift ;;
        --force) FORCE=true; shift ;;
        --status) ARG_STATUS=true; shift ;;
        --no-stale-warning) ARG_NO_STALE_WARNING=true; shift ;;
        --workload) shift; ARG_WORKLOAD="${1:-}"; shift ;;
        --dataset) shift; ARG_DATASET="${1:-}"; shift ;;
        --ic) shift; IC_ARG="${1:-}"; shift ;;
        --adapter) shift; ADAPTER_ARG="${1:-}"; shift ;;
        --compare-baseline) ARG_COMPARE_BASELINE=true; shift ;;
        --recommend) ARG_RECOMMEND=true; shift ;;
        --apply) ARG_RECOMMEND_APPLY=true; shift ;;
        --metric) shift; ARG_RECOMMEND_METRIC="${1:-output_token_throughput_tps}"; ARG_PEAK_METRIC="${1:-}"; shift ;;
        --no-bedrock) ARG_NO_BEDROCK=true; shift ;;
        --threshold) shift; ARG_THRESHOLDS+=("${1:-}"); shift ;;
        --json) ARG_JSON=true; shift ;;
        --gpu-metrics) ARG_GPU_METRICS=true; shift ;;
        --peak) ARG_PEAK=true; shift ;;
        --list) ARG_LIST=true; shift ;;
        --model) shift; ARG_LIST_MODEL="${1:-}"; shift ;;
        --sort) shift; ARG_LIST_SORT="${1:-}"; shift ;;
        --limit) shift; ARG_LIST_LIMIT="${1:-}"; shift ;;
        --min-tp) shift; ARG_LIST_MIN_TP="${1:-}"; shift ;;
        --quantization) shift; ARG_LIST_QUANT="${1:-}"; shift ;;
        --max-model-len) shift; ARG_LIST_MAX_LEN="${1:-}"; shift ;;
        --kv-cache-dtype) shift; ARG_LIST_KV_DTYPE="${1:-}"; shift ;;
        --exclude-instance) shift; ARG_LIST_EXCLUDE_INSTANCES="${1:-}"; shift ;;
        --include-instance) shift; ARG_LIST_INCLUDE_INSTANCES="${1:-}"; shift ;;
        --set-baseline)
            ARG_SET_BASELINE=true; shift
            # Optional positional value: <job-name> | latest | --clear
            if [ "${1:-}" = "--clear" ]; then
                ARG_SET_BASELINE_CLEAR=true; shift
            elif [ $# -gt 0 ] && [ "${1#-}" = "${1}" ]; then
                ARG_SET_BASELINE_VALUE="${1}"; shift
            fi
            ;;
        --clear) ARG_SET_BASELINE_CLEAR=true; shift ;;
        --help|-h)
            echo "Usage: ./do/benchmark --workload <name> [OPTIONS]"
            echo "       ./do/benchmark --workload <name> --dataset <name> [OPTIONS]"
            echo "       ./do/benchmark --status"
            echo "       ./do/benchmark --recommend [--apply] [--metric <m>]"
            echo ""
            echo "Workload profiles (--workload value):"
            echo "  sample                  Quick smoke test (low concurrency)"
            echo "  multi-turn-chat         Multi-turn chat  (concurrency=10, 550 in / 150 out tokens)"
            echo "  rag-document-qa         RAG workload     (concurrency=8,  2048 in / 256 out tokens)"
            echo "  agent-tool-calling      Tool calling     (concurrency=4,  800 in / 100 out tokens)"
            echo "  long-context-scaling    Long context     (concurrency=2,  8192 in / 512 out tokens)"
            echo "  production-traffic-mix  Mixed production (concurrency=16, 1024 in / 200 out tokens)"
            echo "  shared-system-prompt    Shared prompt    (concurrency=12, 300 in / 150 out tokens)"
            echo ""
            echo "Custom dataset (BYOD):"
            echo "  --dataset <name>    Drive benchmark traffic from a registered dataset instead of"
            echo "                      synthetic prompts. <name> is resolved to its S3 URI via the"
            echo "                      dataset registry (see 'do/register dataset'); it is passed as"
            echo "                      the create-ai-workload-config DatasetConfig channel 'traffic'."
            echo "                      Supports version pinning: --dataset <name>@v2 or @v1.0.0."
            echo "                      When set, synthetic token-mean parameters are omitted (BYOD"
            echo "                      traffic replaces synthetic generation); concurrency, streaming,"
            echo "                      tokenizer, and request_count still apply. Can be combined with"
            echo "                      --workload to reuse its concurrency profile."
            echo ""
            echo "Run SageMaker AI Benchmark against the deployed endpoint."
            echo ""
            echo "Options:"
            echo "  --status            Check job status; if completed, download results + write to Athena"
            echo "  --compare-baseline  Compare latest results against historical best in Athena"
            echo "  --gpu-metrics       Show GPU/engine efficiency signals from the most recent local run"
            echo "  --peak              Show the best historical record for this config (Athena)"
            echo "                      Optional: --workload <name> --metric <throughput|ttft|itl|latency|cost>"
            echo "  --set-baseline [<job|latest>]  Pin a benchmark run as the --compare-baseline reference"
            echo "  --set-baseline --clear         Remove the pinned baseline (revert to rolling most-recent)"
            echo "  --list              List all runs for a model grouped by config key (Athena)"
            echo "    --model <name>      Exact name or family prefix (e.g. llama-3.1)"
            echo "    --workload <name>   Filter by workload"
            echo "    --sort <metric>     Sort metric (default: throughput)"
            echo "    --limit <n>         Max rows (default: 100)"
            echo "    --min-tp <n>        Minimum tensor parallel degree (hides tp=1 etc.)"
            echo "    --quantization <q>  Filter by quantization (e.g. fp8, none)"
            echo "    --max-model-len <n> Filter by max_model_len value"
            echo "    --kv-cache-dtype <d> Filter by kv_cache_dtype (e.g. fp8, auto)"
            echo "    --min-tp <n>         Minimum tensor parallel degree (e.g. 2 hides tp=1 runs)"
            echo "    --quantization <q>   Filter by quantization (e.g. fp8, none)"
            echo "    --max-model-len <n>  Filter by max_model_len value"
            echo "    --kv-cache-dtype <d> Filter by kv_cache_dtype (e.g. fp8, auto)"
            echo "    --exclude-instance <types> Comma-separated instance types to exclude"
            echo "                         (e.g. ml.m5.large,ml.g6.2xlarge)"
            echo "    --include-instance <types> Comma-separated instance types to include (whitelist)"
            echo "                      Optional: --model <name|family> --workload <n> --sort <metric> --limit <N>"
            echo "  --recommend         Show Athena-backed config recommendations for current model/instance"
            echo "  --apply             (with --recommend) Write recommended changes to do/ic/default.conf"
            echo "  --metric <name>     (with --recommend) Metric to optimize (default: output_token_throughput_tps)"
