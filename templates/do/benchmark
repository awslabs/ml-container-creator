# Echo the most-recent local profile_export.jsonl path, or empty.
# (ls/find here and in _bl101_latest_job_name are existence probes — "no local
# results" is an expected state handled by every caller; safe swallows.)
_bl101_latest_jsonl() {
    local _dir
    _dir=$(ls -td "${SCRIPT_DIR}/../benchmarks/${PROJECT_NAME}-benchmark-"* 2>/dev/null | head -1) || _dir=""
    [ -z "${_dir}" ] && return 0
    find "${_dir}" -name "profile_export.jsonl" -type f 2>/dev/null | head -1 || true
}

# Echo the most-recent local benchmark job name (dir basename), or empty.
_bl101_latest_job_name() {
    local _dir
    _dir=$(ls -td "${SCRIPT_DIR}/../benchmarks/${PROJECT_NAME}-benchmark-"* 2>/dev/null | head -1) || _dir=""
    [ -z "${_dir}" ] && return 0
    basename "${_dir}"
}


