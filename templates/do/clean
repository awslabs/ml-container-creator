#!/bin/bash
# do/clean — Universal cleanup dispatcher
# Routes to clean.d/<target> based on DEPLOYMENT_TARGET env var or --target flag.
# Generated by ml-container-creator (BL062: universal deploy model)

set -e

# Source configuration
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${SCRIPT_DIR}/config"

# Parse --target flag
CLEAN_ARGS=()
while [ $# -gt 0 ]; do
    case "$1" in
        --target)
            shift
            if [ $# -eq 0 ]; then
                echo "❌ --target requires a value"
                exit 1
            fi
            DEPLOYMENT_TARGET="$1"
            shift
            ;;
        --help|-h)
            echo "Usage: ./do/clean [--target <mode>] [clean-script-flags...]"
            echo ""
            echo "Targets: managed-inference, async-inference, batch-transform, hyperpod-eks"
            exit 0
            ;;
        *)
            CLEAN_ARGS+=("$1")
            shift
            ;;
    esac
done

# Normalize alias
if [ "${DEPLOYMENT_TARGET:-}" = "realtime-inference" ]; then
    DEPLOYMENT_TARGET="realtime-inference"
fi

# If no target configured, prompt interactively (matching do/deploy pattern)
if [ -z "${DEPLOYMENT_TARGET:-}" ]; then
    if command -v node &>/dev/null && [ -t 0 ]; then
        _CLEAN_TARGET=$(node -e "
import { select } from '@inquirer/prompts';
const target = await select({
    message: 'Which deployment to clean up?',
    choices: [
        { name: 'Managed Inference', value: 'managed-inference' },
        { name: 'Async Inference', value: 'async-inference' },
        { name: 'Batch Transform', value: 'batch-transform' },
        { name: 'HyperPod EKS', value: 'hyperpod-eks' },
    ],
});
process.stdout.write(target);
" 2>/dev/null) || _CLEAN_TARGET=""
        if [ -n "$_CLEAN_TARGET" ]; then
            DEPLOYMENT_TARGET="$_CLEAN_TARGET"
        fi
    fi
fi

# Final default
DEPLOYMENT_TARGET="${DEPLOYMENT_TARGET:-realtime-inference}"

# Dispatch
case "$DEPLOYMENT_TARGET" in
    realtime-inference|managed-inference)
        source "${SCRIPT_DIR}/clean.d/realtime-inference" "${CLEAN_ARGS[@]+"${CLEAN_ARGS[@]}"}"
        ;;
    async-inference)
        source "${SCRIPT_DIR}/clean.d/async-inference" "${CLEAN_ARGS[@]+"${CLEAN_ARGS[@]}"}"
        ;;
    batch-transform)
        source "${SCRIPT_DIR}/clean.d/batch-transform" "${CLEAN_ARGS[@]+"${CLEAN_ARGS[@]}"}"
        ;;
    hyperpod-eks)
        source "${SCRIPT_DIR}/clean.d/hyperpod-eks" "${CLEAN_ARGS[@]+"${CLEAN_ARGS[@]}"}"
        ;;
    *)
        echo "❌ Unknown DEPLOYMENT_TARGET: $DEPLOYMENT_TARGET"
        exit 1
        ;;
esac