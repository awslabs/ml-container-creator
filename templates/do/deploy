        async)                      FLAG_TARGET="async-inference" ;;
    esac
    DEPLOYMENT_TARGET="$FLAG_TARGET"
fi

# ── Status var back-fill for v1.4 migration (FR-9.1) ─────────────────────
# v1.4 projects have DEPLOYMENT_TARGET set but no per-target status vars.
# On first run with the new code, back-fill the status var so that
# switch-or-deploy logic works correctly.
_backfill_status_var() {
    local target="${DEPLOYMENT_TARGET:-}"
    [ -z "$target" ] && return 0

    local status_var=""
    case "$target" in
        realtime-inference|managed-inference) status_var="DEPLOYMENT_TARGET_SMAI_STATUS" ;;
        hyperpod-eks)      status_var="DEPLOYMENT_TARGET_HP_STATUS" ;;
        async-inference)   status_var="DEPLOYMENT_TARGET_ASYNC_STATUS" ;;
        batch-transform)   status_var="DEPLOYMENT_TARGET_BATCH_STATUS" ;;
        *) return 0 ;;
    esac

    # Only back-fill if status var is empty (not yet migrated)
    [ -n "${!status_var:-}" ] && return 0

    # Try to detect status from live API
    local live_status=""
    case "$target" in
        realtime-inference|managed-inference)
            local ep_name="${ENDPOINT_NAME:-}"
            # Only back-fill if there's an IC deployed (SMAI uses ICs)
            if [ -n "$ep_name" ] && [ -n "${INFERENCE_COMPONENT_NAME:-}" ]; then
                live_status=$(aws sagemaker describe-endpoint \
                    --endpoint-name "$ep_name" \
                    --region "${AWS_REGION:-us-east-1}" \
                    --query 'EndpointStatus' \
                    --output text 2>/dev/null) || live_status=""
            fi
            ;;
        async-inference)
            # Async uses model-based endpoints (no IC). Only back-fill
            # if ASYNC_S3_OUTPUT_PATH is set (indicates prior async deploy)
            local ep_name="${ENDPOINT_NAME:-}"
            if [ -n "$ep_name" ] && [ -n "${ASYNC_S3_OUTPUT_PATH:-}" ]; then
                live_status=$(aws sagemaker describe-endpoint \
                    --endpoint-name "$ep_name" \
                    --region "${AWS_REGION:-us-east-1}" \
                    --query 'EndpointStatus' \
                    --output text 2>/dev/null) || live_status=""
            fi
            ;;
        hyperpod-eks)
            # If cluster name and instance type are set, assume running
            if [ -n "${HP_CLUSTER_NAME:-}" ] && [ -n "${INSTANCE_TYPE:-}" ]; then
                live_status="Running"
            fi
            ;;
        batch-transform)
            # Batch jobs are one-shot; if config exists, mark as completed
            if [ -n "${BATCH_INPUT_PATH:-}" ] && [ -n "${BATCH_OUTPUT_PATH:-}" ]; then
                live_status="Completed"
            fi
            ;;
    esac

    # Write back-fill if we got a status
    if [ -n "$live_status" ]; then
        _update_config "$status_var" "$live_status"
        # Also export so current run sees it
        export "$status_var=$live_status"
    fi
}

# Back-fill disabled: in multi-target scenarios, the shared ENDPOINT_NAME
# var causes incorrect status detection across targets. Status is managed
# explicitly by each target's deploy.d script on success/failure.
# _backfill_status_var

# ── Status display (FR-2.8, FR-4.7) ──────────────────────────
# Show deployment state for all targets without triggering prompts or redeployment.
if [ "${FLAG_STATUS:-0}" -eq 1 ]; then
    status_json=$(python3 "${SCRIPT_DIR}/.deploy_helper.py" status \
      --config-file "${SCRIPT_DIR}/config" \
      ${FLAG_TARGET:+--target "$FLAG_TARGET"})
    echo "$status_json" | python3 -c "
import json, sys

data = json.load(sys.stdin)
targets = data.get('targets', {})
active = data.get('active_target', '')

# Determine max target name length for alignment
max_len = max((len(n) for n in targets), default=0)

for name, info in targets.items():
    status = info.get('status', 'not deployed')
    instance = info.get('instance_type', '')
    details = []
    if instance:
        details.append(instance)
    # Target-specific details
    if name == 'managed-inference' and info.get('endpoint_name'):
        details.append(info['endpoint_name'])
    elif name == 'hyperpod-eks' and info.get('gpu_count'):
        details.append(f\"{info['gpu_count']} GPUs\")
    elif name == 'async-inference' and info.get('s3_output_path'):
        details.append(info['s3_output_path'])
    elif name == 'batch-transform' and info.get('input_path'):
        details.append(info['input_path'])
    padding = ' ' * (max_len - len(name) + 2)
    if status == 'not deployed':
        print(f'  {name}:{padding}\u2014 (not deployed)')
    else:
        detail_str = f' ({(chr(44) + chr(32)).join(details)})' if details else ''
        print(f'  {name}:{padding}{status}{detail_str}')

print()
print(f'  Active target: {active or \"(none)\"}')
"
    exit 0
fi

# ── Reconfigure logic ─────────────────────────────────────────
# --reconfigure: clean existing deployment, clear config vars for the
# active target, then re-run the interactive builder from scratch.
if [ "${FLAG_RECONFIGURE:-0}" -eq 1 ]; then
    _RECONFIG_TARGET="${FLAG_TARGET:-${DEPLOYMENT_TARGET:-realtime-inference}}"
    if [ "$_RECONFIG_TARGET" = "realtime-inference" ]; then
        _RECONFIG_TARGET="realtime-inference"
    fi

    # Show current config
    echo ""
    echo "   Current: target=${_RECONFIG_TARGET}, instance=${INSTANCE_TYPE:-<empty>}"
    echo ""

    # Check for active deployment
    _RECONFIG_STATUS_VAR=""
    case "$_RECONFIG_TARGET" in
        realtime-inference|managed-inference) _RECONFIG_STATUS_VAR="DEPLOYMENT_TARGET_SMAI_STATUS" ;;
        hyperpod-eks)      _RECONFIG_STATUS_VAR="DEPLOYMENT_TARGET_HP_STATUS" ;;
        async-inference)   _RECONFIG_STATUS_VAR="DEPLOYMENT_TARGET_ASYNC_STATUS" ;;
        batch-transform)   _RECONFIG_STATUS_VAR="DEPLOYMENT_TARGET_BATCH_STATUS" ;;
    esac

    if [ -n "$_RECONFIG_STATUS_VAR" ] && [ -n "${!_RECONFIG_STATUS_VAR:-}" ]; then
        echo "   ⚠️  Active deployment detected (${!_RECONFIG_STATUS_VAR})."
        echo ""
        read -rp "   Clean up before reconfiguring? (Y/n) " _RECONFIG_CLEAN
        if [ "${_RECONFIG_CLEAN:-Y}" != "n" ] && [ "${_RECONFIG_CLEAN:-Y}" != "N" ]; then
            echo ""
            echo "   🧹 Cleaning ${_RECONFIG_TARGET}..."
            # Each target has its own cleanup subcommand
            case "$_RECONFIG_TARGET" in
                realtime-inference|managed-inference) "${SCRIPT_DIR}/clean" --target realtime-inference endpoint --force 2>/dev/null || true ;;
                async-inference)   "${SCRIPT_DIR}/clean" --target async-inference endpoint --force 2>/dev/null || true ;;
                batch-transform)   "${SCRIPT_DIR}/clean" --target batch-transform batch --force 2>/dev/null || true ;;
                hyperpod-eks)      "${SCRIPT_DIR}/clean" --target hyperpod-eks hyperpod --force 2>/dev/null || true ;;
            esac
            _update_config "$_RECONFIG_STATUS_VAR" ""
            # Clear IC deployment refs from do/ic/*.conf
            if [ "$_RECONFIG_TARGET" = "realtime-inference" ] || [ "$_RECONFIG_TARGET" = "managed-inference" ] || [ "$_RECONFIG_TARGET" = "async-inference" ]; then
                for _ic_conf in "${SCRIPT_DIR}"/ic/*.conf; do
                    [ -f "$_ic_conf" ] || continue
                    sed -i.bak '/^export IC_DEPLOYED_NAME=/d;/^export IC_DEPLOYED_AT=/d' "$_ic_conf"
                    rm -f "${_ic_conf}.bak"
                done
            fi
            echo "   ✅ Cleaned"
            echo ""
        else
            echo ""
            echo "   ⚠️  WARNING: The existing deployment will continue running"
            echo "   and incurring charges. You are responsible for cleaning"
            echo "   it up manually."
            echo ""
            read -rp "   Proceed without cleanup? (y/N) " _RECONFIG_ABANDON
            if [ "${_RECONFIG_ABANDON:-N}" != "y" ] && [ "${_RECONFIG_ABANDON:-N}" != "Y" ]; then
                echo "   Aborted."
                exit 0
            fi
            echo ""
            # Clear old deployment references per target
            case "$_RECONFIG_TARGET" in
                realtime-inference|managed-inference)
                    _update_config "INFERENCE_COMPONENT_NAME" ""
                    _update_config "IC_DEPLOYED_AT" ""
                    _update_config "SMAI_ENDPOINT_NAME" ""
                    _update_config "ENDPOINT_NAME" ""
                    _update_config "ENDPOINT_CONFIG_NAME" ""
                    # Clear deployed IC references from do/ic/*.conf
                    # (preserves IC_ENV_*, IC_GPU_COUNT, etc.)
                    for _ic_conf in "${SCRIPT_DIR}"/ic/*.conf; do
                        [ -f "$_ic_conf" ] || continue
                        sed -i.bak '/^export IC_DEPLOYED_NAME=/d;/^export IC_DEPLOYED_AT=/d' "$_ic_conf"
                        rm -f "${_ic_conf}.bak"
                    done
                    ;;
                async-inference)
                    _update_config "ASYNC_ENDPOINT_NAME" ""
                    _update_config "ENDPOINT_NAME" ""
                    _update_config "ENDPOINT_CONFIG_NAME" ""
                    ;;
                hyperpod-eks)
                    _update_config "HP_DEPLOYMENT_NAME" ""
                    ;;
                batch-transform)
                    # Batch jobs are one-shot — no persistent resource to clear
                    ;;
            esac
        fi
    fi

    # Clear deployment vars for the target so builder prompts fresh
    _update_config "INSTANCE_TYPE" ""
    _update_config "INFERENCE_AMI_VERSION" ""
    case "$_RECONFIG_TARGET" in
        realtime-inference|managed-inference)
            _update_config "SMAI_ENDPOINT_NAME" ""
            _update_config "ENDPOINT_NAME" ""
            _update_config "ENDPOINT_STRATEGY" ""
            _update_config "INSTANCE_TYPES" ""
            _update_config "IC_GPU_COUNT" ""
            ;;
        hyperpod-eks)
            _update_config "HP_CLUSTER_NAME" ""
            _update_config "HP_GPU_COUNT" ""
            _update_config "HP_NAMESPACE" ""
            _update_config "HP_REPLICAS" ""
            _update_config "HP_QUEUE" ""
            ;;
        async-inference)
            _update_config "ASYNC_ENDPOINT_NAME" ""
            _update_config "ENDPOINT_NAME" ""
            _update_config "ASYNC_S3_OUTPUT_PATH" ""
            _update_config "ASYNC_SNS_TOPIC" ""
            _update_config "ASYNC_MAX_CONCURRENT" ""
            ;;
        batch-transform)
            _update_config "BATCH_INPUT_PATH" ""
            _update_config "BATCH_OUTPUT_PATH" ""
            _update_config "BATCH_SPLIT_TYPE" ""
            _update_config "BATCH_STRATEGY" ""
            _update_config "BATCH_MAX_CONCURRENT" ""
            ;;
    esac

    # Re-source config to pick up cleared values
    source "${SCRIPT_DIR}/config" 2>/dev/null

    # Force the builder to run
    _NEEDS_HELPER=1
    # Set the target for the builder
    FLAG_TARGET="${_RECONFIG_TARGET}"
    DEPLOYMENT_TARGET="${_RECONFIG_TARGET}"
fi

# ── Switch-or-deploy logic (FR-4.4) ──────────────────────────
# If --target was provided and that target already has a deployment,
# just switch focus without redeploying (CP-5: <1 second).
_NEEDS_HELPER=0
if [ -n "$FLAG_TARGET" ]; then
    # Map target to its status variable name
    case "$FLAG_TARGET" in
        realtime-inference|managed-inference) _STATUS_VAR="DEPLOYMENT_TARGET_SMAI_STATUS" ;;
        hyperpod-eks)      _STATUS_VAR="DEPLOYMENT_TARGET_HP_STATUS" ;;
        async-inference)   _STATUS_VAR="DEPLOYMENT_TARGET_ASYNC_STATUS" ;;
        batch-transform)   _STATUS_VAR="DEPLOYMENT_TARGET_BATCH_STATUS" ;;
        *)                 _STATUS_VAR="" ;;
    esac

    if [ -n "$_STATUS_VAR" ] && [ -n "${!_STATUS_VAR:-}" ]; then
        # Existing deployment — switch focus only (FR-4.4, FR-4.5)
        _update_config DEPLOYMENT_TARGET "$FLAG_TARGET"
        # Resolve ENDPOINT_NAME and INSTANCE_TYPE from target-specific vars
        case "$FLAG_TARGET" in
            realtime-inference|managed-inference)
                _update_config ENDPOINT_NAME "${SMAI_ENDPOINT_NAME:-}"
                _update_config INSTANCE_TYPE "${SMAI_INSTANCE_TYPE:-}"
                ;;
            async-inference)
                _update_config ENDPOINT_NAME "${ASYNC_ENDPOINT_NAME:-}"
                _update_config INSTANCE_TYPE "${ASYNC_INSTANCE_TYPE:-}"
                ;;
            batch-transform)
                _update_config INSTANCE_TYPE "${BATCH_INSTANCE_TYPE:-}"
                ;;
            hyperpod-eks)
                _update_config INSTANCE_TYPE "${HP_INSTANCE_TYPE:-}"
                ;;
        esac
        echo "Focused on $FLAG_TARGET"
        exit 0
    fi
    # No existing deployment — fall through to deploy flow
    _NEEDS_HELPER=1
    # Deploying to a new target: clear INSTANCE_TYPE in config so the
    # builder prompts fresh (a GPU instance from SMAI isn't for batch)
    _update_config "INSTANCE_TYPE" ""
    export INSTANCE_TYPE=""
fi

# Also check: target is set but required vars are missing (e.g.,
# INSTANCE_TYPE empty). Invoke helper to prompt only for missing values.
if [ "$_NEEDS_HELPER" -eq 0 ] && [ -n "${DEPLOYMENT_TARGET:-}" ]; then
    _missing=$(python3 -c "
import sys, os
sys.path.insert(0, os.path.join('${SCRIPT_DIR}', 'lib', 'python'))
from deploy_schema import validate_config
from deploy_prompts import parse_config
config = parse_config('${SCRIPT_DIR}/config')
missing = validate_config('${DEPLOYMENT_TARGET}', config)
print(','.join(missing))
" 2>/dev/null) || _missing=""
    if [ -n "$_missing" ]; then
        _NEEDS_HELPER=1
    fi
fi

# If DEPLOYMENT_TARGET is still empty (not in config AND no --target flag),
# or if --target was provided with no existing deployment (_NEEDS_HELPER),
# invoke the interactive deploy builder (FR-2.1, FR-2.6, FR-3.2)
_HELPER_INVOKED=0
if [ -z "${DEPLOYMENT_TARGET:-}" ] || [ "$_NEEDS_HELPER" -eq 1 ]; then
    # Invoke the deploy helper prompt to collect deployment parameters
    python3 "${SCRIPT_DIR}/.deploy_helper.py" prompt --target "${FLAG_TARGET:-${DEPLOYMENT_TARGET:-}}" 2>/dev/null || true

    _DEPLOY_JSON_TMP=$(mktemp "${TMPDIR:-/tmp}/mlcc-deploy-config.XXXXXX")
    trap 'rm -f "$_DEPLOY_JSON_TMP"' EXIT

    # Resolve the deploy-config-builder.js path (same search as do/train)
    _BUILDER_PATH=""
    if command -v node &>/dev/null; then
        _NPM_GLOBAL=$(npm root -g 2>/dev/null || echo /usr/local/lib/node_modules)
        _BUILDER_PATH="${_NPM_GLOBAL}/@aws/ml-container-creator/src/lib/deploy-config-builder.js"

        _project_root=$(cd "${SCRIPT_DIR}/.." && pwd)
        if [ ! -f "${_BUILDER_PATH}" ]; then
            _BUILDER_PATH="${_project_root}/node_modules/@aws/ml-container-creator/src/lib/deploy-config-builder.js"
        fi
        if [ ! -f "${_BUILDER_PATH}" ]; then
            _BUILDER_PATH="${_project_root}/src/lib/deploy-config-builder.js"
        fi
    fi

    if [ -n "${_BUILDER_PATH}" ] && [ -f "${_BUILDER_PATH}" ]; then
        # Run interactively from the builder's project root so Node.js ESM
        # resolution finds node_modules (MCP SDK, @inquirer/prompts).
        # Resolve symlinks to get the real file location.
        _REAL_BUILDER=$(python3 -c "import os; print(os.path.realpath('${_BUILDER_PATH}'))" 2>/dev/null || readlink -f "${_BUILDER_PATH}" 2>/dev/null || echo "${_BUILDER_PATH}")
        _BUILDER_DIR=$(cd "$(dirname "${_REAL_BUILDER}")/../.." && pwd)
        _ABS_CONFIG=$(cd "${SCRIPT_DIR}" && pwd)/config
        (cd "${_BUILDER_DIR}" && node "${_REAL_BUILDER}" \
          --config-file "${_ABS_CONFIG}" \
          --output-file "$_DEPLOY_JSON_TMP" \
          ${FLAG_TARGET:+--target "$FLAG_TARGET"} \
          ${DEPLOYMENT_TARGET:+--target "$DEPLOYMENT_TARGET"} \
          ${FLAG_INSTANCE:+--instance-type "$FLAG_INSTANCE"}) || true
    else
        echo "❌ Deploy interactive mode requires Node.js and @aws/ml-container-creator."
        echo "   Install: npm install -g @aws/ml-container-creator"
        echo "   Or pass all required flags: --target --instance-type"
        exit 1
    fi

    # Parse JSON response from temp file and export all vars
    json_output=$(cat "$_DEPLOY_JSON_TMP" 2>/dev/null || echo '{}')
    eval "$(echo "$json_output" | python3 -c "
import json, sys
KEY_MAP = {
    'target': 'DEPLOYMENT_TARGET',
    'instance_type': 'INSTANCE_TYPE',
    'smai_instance_type': 'SMAI_INSTANCE_TYPE',
    'async_instance_type': 'ASYNC_INSTANCE_TYPE',
    'batch_instance_type': 'BATCH_INSTANCE_TYPE',
    'hp_instance_type': 'HP_INSTANCE_TYPE',
    'smai_endpoint_name': 'SMAI_ENDPOINT_NAME',
    'async_endpoint_name': 'ASYNC_ENDPOINT_NAME',
    'endpoint_strategy': 'ENDPOINT_STRATEGY',
    'instance_types': 'INSTANCE_TYPES',
    'gpu_count': 'IC_GPU_COUNT',
    'cluster_name': 'HP_CLUSTER_NAME',
    'hp_gpu_count': 'HP_GPU_COUNT',
    'namespace': 'HP_NAMESPACE',
    'replicas': 'HP_REPLICAS',
    'queue': 'HP_QUEUE',
    'async_output_path': 'ASYNC_S3_OUTPUT_PATH',
    'async_sns_topic': 'ASYNC_SNS_TOPIC',
    'async_max_concurrent': 'ASYNC_MAX_CONCURRENT_INVOCATIONS',
    'batch_input_path': 'BATCH_INPUT_PATH',
    'batch_output_path': 'BATCH_OUTPUT_PATH',
    'batch_split_type': 'BATCH_SPLIT_TYPE',
    'batch_strategy': 'BATCH_STRATEGY',
    'batch_max_concurrent': 'BATCH_MAX_CONCURRENT',
    'inference_ami_version': 'INFERENCE_AMI_VERSION',
}
data = json.load(sys.stdin)
if 'error' in data:
    err = data['error']
    print(f'echo \"❌ {err}\" >&2; exit 1')
else:
    for key, var in KEY_MAP.items():
        if key in data and data[key]:
            val = str(data[key]).replace('\"', '\\\\\"')
            print(f'export {var}=\"{val}\"')
")"
    _HELPER_INVOKED=1
fi

# ── Persist answers before dispatch (FR-2.5, CP-7) ────────
# Write all deployment vars to do/config so retry doesn't re-prompt.
# Only writes vars that have non-empty values. Runs only when the
# interactive helper was invoked (first deploy or missing config).
#
# ATOMICITY (CP-7): All vars are applied to a temp copy of config,
# then atomically replaced via `mv` (POSIX atomic on same filesystem).
# Either ALL vars are written, or NONE are — no partial writes.
_persist_deploy_vars() {
    local config="${SCRIPT_DIR}/config"
    local tmp_config="${config}.tmp.$$"
    local vars=(
        DEPLOYMENT_TARGET INSTANCE_TYPE
        SMAI_INSTANCE_TYPE ASYNC_INSTANCE_TYPE BATCH_INSTANCE_TYPE HP_INSTANCE_TYPE
        SMAI_ENDPOINT_NAME ASYNC_ENDPOINT_NAME
        ENDPOINT_STRATEGY IC_GPU_COUNT INSTANCE_TYPES HP_CLUSTER_NAME HP_GPU_COUNT
        HP_NAMESPACE HP_REPLICAS HP_QUEUE ASYNC_S3_OUTPUT_PATH
        ASYNC_SNS_TOPIC ASYNC_MAX_CONCURRENT_INVOCATIONS BATCH_INPUT_PATH
        BATCH_OUTPUT_PATH BATCH_SPLIT_TYPE BATCH_STRATEGY BATCH_MAX_CONCURRENT
        INFERENCE_AMI_VERSION
    )

    # Copy current config to temp file
    cp "$config" "$tmp_config"

    # Apply all changes to the temp file
    for var in "${vars[@]}"; do
        local val="${!var:-}"
        if [ -n "$val" ]; then
            if grep -q "^export ${var}=" "$tmp_config" 2>/dev/null; then
                sed -i.bak \
                  "s|^export ${var}=.*|export ${var}=\"${val}\"|" \
                  "$tmp_config"
                rm -f "${tmp_config}.bak"
            else
                echo "export ${var}=\"${val}\"" >> "$tmp_config"
            fi
        fi
    done

    # Atomic replace: mv is atomic on POSIX when src and dst are on
    # the same filesystem. If we crash before mv, original is intact.
    mv "$tmp_config" "$config"
}

if [ "$_HELPER_INVOKED" -eq 1 ]; then
    _persist_deploy_vars
fi

# Normalize legacy value
if [ "$DEPLOYMENT_TARGET" = "realtime-inference" ]; then
    DEPLOYMENT_TARGET="realtime-inference"
fi

# ── Dry-run output (FR-3.6, CP-4) ────────────────────────────
# Show resolved config and the command that would execute, without deploying.
if [ "${FLAG_DRY_RUN:-0}" -eq 1 ]; then
    echo "── Dry Run ──────────────────────────────────────────────"
    echo ""
    echo "Target: $DEPLOYMENT_TARGET"
    echo "Script: ${SCRIPT_DIR}/deploy.d/${DEPLOYMENT_TARGET}"
    echo ""
    echo "Resolved configuration:"
    for var in DEPLOYMENT_TARGET INSTANCE_TYPE ENDPOINT_NAME ENDPOINT_STRATEGY \
               IC_GPU_COUNT INSTANCE_TYPES HP_CLUSTER_NAME HP_GPU_COUNT \
               HP_NAMESPACE HP_REPLICAS HP_QUEUE ASYNC_S3_OUTPUT_PATH \
               ASYNC_SNS_TOPIC ASYNC_MAX_CONCURRENT_INVOCATIONS BATCH_INPUT_PATH \
               BATCH_OUTPUT_PATH BATCH_SPLIT_TYPE BATCH_STRATEGY BATCH_MAX_CONCURRENT; do
        val="${!var:-}"
        if [ -n "$val" ]; then
            echo "  $var=$val"
        fi
    done
    echo ""
    echo "Would execute:"
    echo "  source ${SCRIPT_DIR}/deploy.d/${DEPLOYMENT_TARGET} ${DEPLOY_ARGS[*]:-}"
    echo ""
    echo "── No changes made (dry run) ──────────────────────────"
    exit 0
fi

# Resolve ENDPOINT_NAME from the target-specific var before dispatch.
# Resolve ENDPOINT_NAME and INSTANCE_TYPE from target-specific vars before dispatch.
# This ensures deploy.d/* scripts and do/test, do/logs use the right values.
case "${DEPLOYMENT_TARGET}" in
    realtime-inference|managed-inference)
        export ENDPOINT_NAME="${SMAI_ENDPOINT_NAME:-${ENDPOINT_NAME:-}}"
        export INSTANCE_TYPE="${SMAI_INSTANCE_TYPE:-${INSTANCE_TYPE:-}}"
        ;;
    async-inference)
        export ENDPOINT_NAME="${ASYNC_ENDPOINT_NAME:-${ENDPOINT_NAME:-}}"
        export INSTANCE_TYPE="${ASYNC_INSTANCE_TYPE:-${INSTANCE_TYPE:-}}"
        ;;
    batch-transform)
        export INSTANCE_TYPE="${BATCH_INSTANCE_TYPE:-${INSTANCE_TYPE:-}}"
        ;;
    hyperpod-eks)
        export INSTANCE_TYPE="${HP_INSTANCE_TYPE:-${INSTANCE_TYPE:-}}"
        ;;
esac

# Dispatch to target-specific deploy script
case "$DEPLOYMENT_TARGET" in
    realtime-inference|managed-inference)
        source "${SCRIPT_DIR}/deploy.d/realtime-inference" "${DEPLOY_ARGS[@]+"${DEPLOY_ARGS[@]}"}"
        ;;
    async-inference)
        source "${SCRIPT_DIR}/deploy.d/async-inference" "${DEPLOY_ARGS[@]+"${DEPLOY_ARGS[@]}"}"
        ;;
    batch-transform)
        source "${SCRIPT_DIR}/deploy.d/batch-transform" "${DEPLOY_ARGS[@]+"${DEPLOY_ARGS[@]}"}"
        ;;
    hyperpod-eks)
        source "${SCRIPT_DIR}/deploy.d/hyperpod-eks" "${DEPLOY_ARGS[@]+"${DEPLOY_ARGS[@]}"}"
        ;;
    *)
        echo "❌ Unknown DEPLOYMENT_TARGET: $DEPLOYMENT_TARGET"
        echo "   Valid targets: managed-inference, async-inference, batch-transform, hyperpod-eks"
        exit 1
        ;;
esac

# Write DEPLOYMENT_TARGET back to do/config after successful deploy
_update_config DEPLOYMENT_TARGET "$DEPLOYMENT_TARGET"
