# do/deploy.d/eks — Plain EKS deployment target (BL103).
#
# Serves the model as standard Kubernetes objects — a Deployment, a Service,
# and a ConfigMap — WITHOUT the HyperPod inference operator or its
# InferenceEndpointConfig CRD, and WITHOUT any SageMaker endpoint machinery
# (no SageMakerEndpointRegistration, no describe-endpoint polling, no SageMaker
# cleanup). It works on any conformant EKS cluster, including a HyperPod EKS
# cluster used as plain EKS.
#
# This mirrors deploy.d/hyperpod-eks's shared preamble (AWS credential
# validation, ECR image verification, secret resolution, the envsubst shim, and
# GPU/CPU/memory auto-detection) but replaces the CRD render/apply and status
# polling with a plain manifest apply + `kubectl rollout status`.

set -e
set -u
set -o pipefail

# Parse flags (kept compatible with the hyperpod-eks target's flag shape)
FORCE_NEW=false
while [ $# -gt 0 ]; do
    case "$1" in
        --force) FORCE_NEW=true; shift ;;
        --help|-h)
            echo "Usage: ./do/deploy --target eks [--force]"
            echo ""
            echo "Options:"
            echo "  --force   Redeploy even if a deployment already exists."
            echo ""
            echo "Deploys the model as a plain Kubernetes Deployment + Service + ConfigMap."
            echo "No HyperPod inference operator and no SageMaker endpoint are used."
            exit 0
            ;;
        *)
            echo "❌ Unknown option: $1"
            echo "   Run ./do/deploy --target eks --help for usage."
            exit 1
            ;;
    esac
done

# Configuration is already sourced by the do/deploy dispatcher.
# Resolve SCRIPT_DIR to do/ (parent of deploy.d/) for lib/ access.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "${SCRIPT_DIR}/lib/profile.sh"
source "${SCRIPT_DIR}/lib/aws-preflight.sh"
source "${SCRIPT_DIR}/lib/eks-contract.sh"

# ── Profile-resolved variables (env var > profile > default) ──────────────────
export AWS_REGION="${AWS_REGION:-${_PROFILE_awsRegion:-us-east-1}}"
ECR_REPOSITORY_NAME="${ECR_REPOSITORY_NAME:-${_PROFILE_ecrRepositoryName:-ml-container-creator}}"
HP_NAMESPACE="${HP_NAMESPACE:-default}"
HP_REPLICAS="${HP_REPLICAS:-1}"

echo "🚀 Deploying to plain EKS"
echo "   Project: ${PROJECT_NAME}"
echo "   Deployment config: ${DEPLOYMENT_CONFIG}"
echo "   Region: ${AWS_REGION}"
echo "   Build target: ${BUILD_TARGET}"
echo "   Deployment target: ${DEPLOYMENT_TARGET}"
echo "   Cluster: ${HP_CLUSTER_NAME:-<ambient kubectl context>}"
echo "   Namespace: ${HP_NAMESPACE}"
echo "   Replicas: ${HP_REPLICAS}"

# ── Shared: Validate AWS credentials ──────────────────────────────────────────
_aws_preflight --verbose

ECR_REPOSITORY="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_REPOSITORY_NAME}"

# ── Shared: Verify ECR image exists ───────────────────────────────────────────
echo "🔍 Verifying ECR image exists..."
if ! aws ecr describe-images \
    --repository-name "${ECR_REPOSITORY_NAME}" \
    --image-ids imageTag="${PROJECT_NAME}-latest" \
    --region "${AWS_REGION}" &> /dev/null; then

    echo "❌ ECR image not found: ${ECR_REPOSITORY}:${PROJECT_NAME}-latest"
    echo ""
    echo "Please build and push your image first:"
    echo "  ./do/submit"
    echo ""
    echo "After the build completes successfully, run this deploy script again."
    exit 4
fi

echo "✅ ECR image found: ${ECR_REPOSITORY}:${PROJECT_NAME}-latest"
IMAGE_TAG="${PROJECT_NAME}-latest"
export ECR_IMAGE="${ECR_REPOSITORY}:${IMAGE_TAG}"
export AWS_ACCOUNT_ID

# ── Shared: Resolve secrets for the HuggingFace token ─────────────────────────
# BL076: fall back to profile secrets when ARN is not explicitly set in do/config
HF_TOKEN_ARN="${HF_TOKEN_ARN:-${_PROFILE_secrets_hfToken:-}}"
RESOLVED_HF_TOKEN=""
if [ -n "${HF_TOKEN_ARN:-}" ]; then
    echo "🔐 Resolving HuggingFace token from Secrets Manager..."
    RESOLVED_HF_TOKEN=$(aws secretsmanager get-secret-value --secret-id "${HF_TOKEN_ARN}" --query SecretString --output text --region "${AWS_REGION}") || {
        echo "❌ Failed to resolve HuggingFace token from Secrets Manager"
        exit 3
    }
elif [ -n "${HF_TOKEN:-}" ]; then
    RESOLVED_HF_TOKEN="${HF_TOKEN}"
fi

# ── Kubeconfig update (Requirement 3) ─────────────────────────────────────────
# Only resolve/update kubeconfig when HP_CLUSTER_NAME is set. Otherwise use the
# ambient kubectl context (a plain EKS cluster the user already targets).
_profile_arg=""
[ -n "${_PROFILE_awsProfile:-${AWS_PROFILE:-}}" ] && _profile_arg="--profile ${_PROFILE_awsProfile:-${AWS_PROFILE}}"

if [ -n "${HP_CLUSTER_NAME:-}" ]; then
    echo "🔑 Configuring kubectl for cluster: ${HP_CLUSTER_NAME}"
    KUBECONFIG_PATH="${HOME}/.kube/eks-${HP_CLUSTER_NAME}"

    # A HyperPod EKS cluster wraps an underlying EKS cluster; a plain EKS cluster
    # name is used directly. Try the HyperPod indirection first, then fall back
    # to treating HP_CLUSTER_NAME as an EKS cluster name.
    EKS_CLUSTER_NAME="${HP_CLUSTER_NAME}"
    EKS_CLUSTER_ARN=$(aws sagemaker describe-cluster \
        --cluster-name "${HP_CLUSTER_NAME}" \
        --region "${AWS_REGION}" \
        ${_profile_arg} \
        --query "Orchestrator.Eks.ClusterArn" \
        --output text 2>/dev/null) || EKS_CLUSTER_ARN=""
    if [ -n "${EKS_CLUSTER_ARN}" ] && [ "${EKS_CLUSTER_ARN}" != "None" ]; then
        EKS_CLUSTER_NAME=$(echo "${EKS_CLUSTER_ARN}" | awk -F'/' '{print $NF}')
        echo "   HyperPod cluster: ${HP_CLUSTER_NAME}"
    fi
    echo "   EKS cluster: ${EKS_CLUSTER_NAME}"

    if ! aws eks update-kubeconfig \
        --name "${EKS_CLUSTER_NAME}" \
        --region "${AWS_REGION}" \
        ${_profile_arg} \
        --kubeconfig "${KUBECONFIG_PATH}" 2>&1; then
        echo "❌ Failed to configure kubectl for EKS cluster: ${EKS_CLUSTER_NAME}"
        echo ""
        echo "   Required IAM permissions:"
        echo "   • eks:DescribeCluster"
        echo "   • eks:AccessKubernetesApi"
        exit 4
    fi
    export KUBECONFIG="${KUBECONFIG_PATH}"
    echo "✅ Kubeconfig saved to: ${KUBECONFIG_PATH}"
else
    echo "🔑 HP_CLUSTER_NAME not set — using ambient kubectl context"
fi

# Verify cluster connectivity (surfaces an unusable ambient context early).
echo "🔍 Verifying cluster connectivity..."
if ! kubectl cluster-info &> /dev/null; then
    echo "❌ Cannot connect to the target Kubernetes cluster"
    echo ""
    echo "   Check that:"
    echo "   • kubectl is configured for a reachable cluster"
    echo "   • Set HP_CLUSTER_NAME in do/config to auto-resolve kubeconfig, or"
    echo "   • Point your current kubectl context at the target cluster"
    exit 4
fi
echo "✅ Connected to cluster"

# ── Cluster-contract preflight (BL156, ADR-012) ───────────────────────────────
# Detect + validate + fail-fast on the CLUSTER-PROVIDED capabilities this deploy
# needs (pod identity for an S3-staged model; the CSI driver + PV/StorageClass
# backing when EKS_MODEL_MOUNT selects a mount), BEFORE the ServiceAccount block
# and the manifest apply. Runs after the UNCONDITIONAL connectivity verify so
# kubectl is confirmed working for BOTH a kubeconfig-updated cluster and a BYO
# ambient-context deploy. Read-only (describe/get/list); the ONE write — the
# inference ServiceAccount below — stays in this driver, not the lib. The gate
# uses STAGED_MODEL_PATH (available now from do/config) as the S3 signal;
# HP_MODEL_SOURCE is resolved later and is NOT a gate signal.
export EKS_INFERENCE_SA="mlcc-eks-inference-sa"
_eks_contract_preflight

# ── Ensure namespace + HuggingFace token secret ───────────────────────────────
echo "📁 Ensuring namespace exists: ${HP_NAMESPACE}"
if ! kubectl create namespace "${HP_NAMESPACE}" --dry-run=client -o yaml | kubectl apply -f - 2>&1; then
    echo "⚠️  Warning: Could not create/verify namespace"
fi

if [ -n "${RESOLVED_HF_TOKEN:-}" ]; then
    echo "🔑 Creating K8s Secret 'hf-token-secret' in namespace '${HP_NAMESPACE}'..."
    kubectl create secret generic hf-token-secret \
        --from-literal=token="${RESOLVED_HF_TOKEN}" \
        --namespace "${HP_NAMESPACE}" \
        --dry-run=client -o yaml | kubectl apply -f - 2>&1 || {
        echo "⚠️  Warning: Could not create hf-token-secret (will continue)"
    }
    echo "✅ HuggingFace token secret ready"
else
    echo "   ⚠️  No HuggingFace token configured"
    echo "   (Continuing — token only required for gated HuggingFace models)"
fi

# ── ServiceAccount for pod AWS identity (IRSA) ────────────────────────────────
# A plain-EKS inference pod has NO AWS identity by default (the `default` SA is
# unannotated), so code/serve's `aws s3 sync` of a staged model fails with
# "Unable to locate credentials". Unlike HyperPod — where the operator pulls S3
# weights with its own role and the pod never calls S3 — a plain-EKS pod must
# download the model itself and therefore needs its OWN IRSA role.
#
# This driver creates the inference ServiceAccount `mlcc-eks-inference-sa` — the
# ONE write a plain-EKS deploy performs (consume-don't-provision, ADR-012: MLCC
# owns its own namespaced SA, nothing else) — and the Deployment runs under it
# (serviceAccountName). The pod assumes an IRSA role with S3 read on the
# mlcc-core models bucket, resolved in this order:
#   1. EKS_INFERENCE_ROLE_ARN  — explicit, set in do/config, OR
#   2. _PROFILE_eksInferenceRoleArn — denormalized from the active bootstrap
#      profile once the `eks` bootstrap module provisions the role.
# The cluster-contract preflight above already VALIDATED (and failed fast on) the
# identity requirement for an S3-staged model — a resolvable role AND IRSA/Pod
# Identity — so reaching here means either an HF-source deploy (no role needed)
# or a validated role. This block only WIRES the SA (create + IRSA annotation),
# it no longer re-checks or warns about identity (that moved into the gate).
EKS_INFERENCE_SA="mlcc-eks-inference-sa"
EKS_INFERENCE_ROLE_ARN="${EKS_INFERENCE_ROLE_ARN:-${_PROFILE_eksInferenceRoleArn:-}}"
export EKS_INFERENCE_SA

echo "🔐 Ensuring ServiceAccount '${EKS_INFERENCE_SA}' in namespace '${HP_NAMESPACE}'..."
if ! kubectl create serviceaccount "${EKS_INFERENCE_SA}" \
    --namespace "${HP_NAMESPACE}" \
    --dry-run=client -o yaml | kubectl apply -f - 2>&1; then
    echo "⚠️  Warning: could not create ServiceAccount ${EKS_INFERENCE_SA} (will continue)"
fi

if [ -n "${EKS_INFERENCE_ROLE_ARN}" ]; then
    # Annotate for IRSA. --overwrite so a re-deploy updates a changed role ARN.
    # (Harmless for a Pod Identity cluster, where the association — not the
    # annotation — grants the identity; the annotation is simply unused there.)
    if kubectl annotate serviceaccount "${EKS_INFERENCE_SA}" \
        --namespace "${HP_NAMESPACE}" \
        "eks.amazonaws.com/role-arn=${EKS_INFERENCE_ROLE_ARN}" \
        --overwrite 2>&1; then
        echo "✅ ServiceAccount annotated with IRSA role: ${EKS_INFERENCE_ROLE_ARN}"
    else
        echo "⚠️  Warning: could not annotate ServiceAccount with the IRSA role"
    fi
else
    echo "ℹ️  No EKS inference IRSA role set — HuggingFace-source deploy (no AWS credentials needed)."
fi

# ── Auto-resolve GPU count / CPU / memory from the instance type ──────────────
# Mirrors deploy.d/hyperpod-eks (BL096): the GPU-derived resource requests are
# resolved at DEPLOY time so changing the instance type keeps node affinity and
# tensor-parallel degree in sync.
#
# derive-dont-hardcode (ADR-008): the GPU count is OWNED by the instance catalog,
# shipped into the project at .mlcc/instances.json (the same source
# deploy-config-builder.js, hyperpod-eks, and the benchmark writer use). Read it
# first so new instance families (g7/g7e, p6-b200, ...) resolve without editing
# this script; the hardcoded case is ONLY a fallback for when the catalog is
# absent/unreadable.
_eks_detect_gpu_count() {
    local itype="${1}"
    [ -n "${itype}" ] || { echo 1; return; }

    # 1) Authoritative source: .mlcc/instances.json (catalog[<ml.type>].gpus).
    #    ${SCRIPT_DIR:-} so an unset SCRIPT_DIR degrades to the fallback case.
    local _catalog="${SCRIPT_DIR:-}/../.mlcc/instances.json"
    if [ -n "${SCRIPT_DIR:-}" ] && [ -f "${_catalog}" ] && command -v python3 >/dev/null 2>&1; then
        local _gpus
        _gpus="$(ITYPE="${itype}" CATALOG="${_catalog}" python3 -c '
import json, os
try:
    cat = json.load(open(os.environ["CATALOG"]))["catalog"]
    g = cat.get(os.environ["ITYPE"], {}).get("gpus")
    print(int(g) if g and int(g) > 0 else "")
except Exception:
    print("")
' 2>/dev/null)" || _gpus=""
        if [ -n "${_gpus}" ]; then
            echo "${_gpus}"
            return
        fi
    fi

    # 2) Fallback only when the catalog is unavailable or lacks the type.
    local suffix="${itype#ml.}"
    case "${suffix}" in
        g5.xlarge|g5.2xlarge|g5.4xlarge|g5.8xlarge|g5.16xlarge) echo 1 ;;
        g5.12xlarge|g5.24xlarge) echo 4 ;;
        g5.48xlarge) echo 8 ;;
        g6.xlarge|g6.2xlarge|g6.4xlarge|g6.8xlarge|g6.16xlarge) echo 1 ;;
        g6.12xlarge|g6.24xlarge) echo 4 ;;
        g6.48xlarge) echo 8 ;;
        g7.2xlarge|g7.4xlarge|g7.8xlarge) echo 1 ;;
        g7.12xlarge) echo 2 ;;
        g7.24xlarge) echo 4 ;;
        g7.48xlarge) echo 8 ;;
        g7e.2xlarge|g7e.4xlarge|g7e.8xlarge) echo 1 ;;
        g7e.12xlarge) echo 2 ;;
        g7e.24xlarge) echo 4 ;;
        g7e.48xlarge) echo 8 ;;
        p4d.24xlarge|p4de.24xlarge|p5.48xlarge) echo 8 ;;
        p6-b300.48xlarge) echo 8 ;;
        *) echo 1 ;;
    esac
}

export HP_INSTANCE_TYPE="${HP_INSTANCE_TYPE:-${HP_NODE_SELECTOR:-${INSTANCE_TYPE:-}}}"
_EKS_DETECTED_GPU_COUNT="$(_eks_detect_gpu_count "${HP_INSTANCE_TYPE}")"
if [ -n "${HP_INSTANCE_TYPE}" ]; then
    export HP_GPU_COUNT="${_EKS_DETECTED_GPU_COUNT}"
else
    export HP_GPU_COUNT="${HP_GPU_COUNT:-1}"
fi
export HP_CPU_REQUEST="${HP_CPU_REQUEST:-$(( HP_GPU_COUNT * 4 ))}"
export HP_MEM_REQUEST="${HP_MEM_REQUEST:-$(( HP_GPU_COUNT * 16 ))Gi}"
export HP_NAMESPACE HP_REPLICAS

echo "   Instance type: ${HP_INSTANCE_TYPE:-<unset>}"
echo "   GPU count (auto-detected): ${HP_GPU_COUNT}"
echo "   CPU request: ${HP_CPU_REQUEST}  Memory request: ${HP_MEM_REQUEST}"

# ── Ephemeral-storage capacity fail-fast (BL155, emptyDir path) ───────────────
# Runs AFTER HP_GPU_COUNT is resolved from the instance type (so the model-size
# proxy is accurate) and BEFORE the render/apply. Only the emptyDir path draws
# from the node root volume; on the hostPath/CSI-mount path this is a no-op. Hard
# fails (exit 4) only when the LARGEST GPU node cannot fit the model; an
# indeterminate node list warns and proceeds (OQ-3, fail-open).
_eks_storage_capacity_preflight

# ── Resolve model source env ──────────────────────────────────────────────────
# The BYOC entrypoint (code/serve) reads MODEL_SOURCE + engine env. For a plain
# EKS deployment there is NO operator to pre-download/mount weights (unlike
# HyperPod), so the POD itself downloads from S3 at startup:
#   • STAGED_MODEL_PATH set → s3. code/serve's resolve_model() needs the S3 URI in
#     MODEL_ARTIFACT_URI to `aws s3 sync` it to /opt/ml/model, then it rewrites the
#     engine model key to that local path. HP_MODEL_ID (the engine's model-path
#     env) is also the staged URI; code/serve overwrites it post-download.
#   • otherwise            → huggingface (server pulls MODEL_NAME directly)
if [ -n "${STAGED_MODEL_PATH:-}" ]; then
    export HP_MODEL_SOURCE="s3"
    export HP_MODEL_ID="${STAGED_MODEL_PATH}"
    # Plain EKS has no model-mounting operator; the pod downloads from S3 itself,
    # so code/serve requires the artifact URI explicitly (HyperPod gets it mounted
    # at /opt/ml/model instead and never needs this).
    export HP_MODEL_ARTIFACT_URI="${STAGED_MODEL_PATH}"
else
    export HP_MODEL_SOURCE="huggingface"
    export HP_MODEL_ID="${MODEL_NAME:-}"
    export HP_MODEL_ARTIFACT_URI=""
fi
export MODEL_NAME="${MODEL_NAME:-}"

# ── Tier-1 engine config: derive from the serve manifest (ADR-010) ────────────
# derive-dont-hardcode: the per-engine env-var names, value shapes, and LoRA
# companion contract are OWNED by serve.d/<engine>/manifest.json (capability_map),
# resolved here through serve_manifest.py — never a hardcoded VLLM_* block. MLCC
# computes only the Tier-1 VALUES (model id, tensor-parallel degree = GPU count,
# quantization pass-through, LoRA toggle); the resolver maps them onto the active
# engine's env vars and omits any capability whose companions are unmet (so a
# boolean like SGLang lora_enable never emits a server-crashing bare flag).
# Everything else is Tier-2 prefix pass-through (handled by the EJS renderer).
_EKS_ENGINE="${MODEL_SERVER:-vllm}"

# The active engine's capability_map tells us WHICH LoRA companions this engine
# requires (ADR-010), so MLCC can supply pure-dynamic defaults for them without
# branching on the engine name.
_EKS_CAP_MAP="$(python3 "${SCRIPT_DIR}/lib/python/serve_manifest.py" capability_map "${_EKS_ENGINE}" 2>/dev/null || echo '{}')"

# Canonical Tier-1 values as a JSON object keyed by capability name. Only keys
# with a resolvable value are set; unset valued caps (e.g. quantization) are
# OMITTED so the resolver drops them rather than emitting an empty/sentinel value
# that breaks engine startup (ADR-010 "omit-when-unset"). LoRA is a boolean
# toggle gated on HP_LORA_ENABLED. When LoRA is on, MLCC supplies pure-dynamic
# defaults for any companion the engine's capability_map requires and the user
# did not set (e.g. SGLang needs max_lora_rank + lora_target_modules for a
# no-initial-adapters start); vLLM requires no companions and stays bare. Users
# override any companion via Tier-2 SGLANG_*/VLLM_* pass-through.
# ── LoRA sizing (Wave 6.1 R2, BL188) ───────────────────────────────────────────
# derive-dont-hardcode: the LoRA sizing defaults (e.g. vLLM lora_max=4,
# lora_max_rank=16) are each capability's `default` in serve.d/<engine>/
# manifest.json — the single source the generator, Dockerfile and schema also
# derive from (drift-tested). max_lora_rank is then DERIVED by the shared
# right_sizing.effective_lora_rank: snap_up(max(recorded tune adapters'
# adapter_config.json r / rank_pattern, TUNE_LORA_RANK_*, manifest default),
# the engine's allowed set). Tuning techniques drive the rank; an explicit
# <engine>_MAX_LORA_RANK wins (with a warning when below what recorded adapters
# need). The LoRA buffer must fit 10% of the post-weights GPU memory; an
# auto-raise over that cap refuses the deploy naming the adapters (never a
# silent cap). vLLM's own defaults are max_loras=1 / max_lora_rank=16.
_EKS_CAP_DEFAULTS="$(python3 "${SCRIPT_DIR}/lib/python/serve_manifest.py" capability_defaults "${_EKS_ENGINE}" 2>/dev/null || echo '{}')"
_EKS_EFFECTIVE_RANK=""
if [ "${HP_LORA_ENABLED:-false}" = "true" ]; then
    _EKS_RANK_RC=0
    # Wave 8: the do/deploy preflight already ran `right_sizing.py check` and
    # printed every finding (incl. these), so ask only for the rank VALUE
    # (--quiet) instead of re-reporting. A block is still honored here (a
    # driver sourced without the preflight), and --ignore-sizing (OQ-8.7,
    # MLCC_IGNORE_SIZING=1 from do/deploy) overrides it like every sizing block.
    _EKS_RANK_QUIET=""
    [ "${MLCC_SIZING_PREFLIGHT_DONE:-0}" = "1" ] && _EKS_RANK_QUIET="--quiet"
    _EKS_RANK_JSON="$(python3 "${SCRIPT_DIR}/lib/python/right_sizing.py" effective-lora-rank ${_EKS_RANK_QUIET})" || _EKS_RANK_RC=$?
    if [ "${_EKS_RANK_RC}" -eq 2 ]; then
        if [ "${MLCC_IGNORE_SIZING:-0}" = "1" ]; then
            echo "⚠️  --ignore-sizing: proceeding despite the LoRA right-sizing block." >&2
        else
            echo "❌ LoRA right-sizing refused this deploy (see the finding above)." >&2
            echo "   Nothing was applied; the running deployment is unchanged." >&2
            echo "   Override (at your own risk): ./do/deploy --target eks --ignore-sizing" >&2
            exit 1
        fi
    fi
    _EKS_EFFECTIVE_RANK="$(printf '%s' "${_EKS_RANK_JSON}" | python3 -c 'import json,sys; r=json.load(sys.stdin).get("rank"); print("" if r is None else r)' 2>/dev/null || echo "")"
    if [ -n "${_EKS_EFFECTIVE_RANK}" ]; then
        echo "   LoRA max_lora_rank: ${_EKS_EFFECTIVE_RANK} (derived from recorded tune adapters + engine default; explicit override wins)"
    else
        echo "   ⚠️  Could not derive max_lora_rank (right_sizing.py unavailable); using the engine manifest default." >&2
    fi
fi
_EKS_TIER1_VALUES=$(
    MODEL_ID="${HP_MODEL_ID:-${MODEL_NAME:-}}" \
    TP_DEGREE="${VLLM_TENSOR_PARALLEL_SIZE:-${HP_GPU_COUNT}}" \
    QUANT="${VLLM_QUANTIZATION:-}" \
    LORA_ON="$([ "${HP_LORA_ENABLED:-false}" = "true" ] && echo true || echo false)" \
    LORA_MAX_RANK="${_EKS_EFFECTIVE_RANK:-${VLLM_MAX_LORA_RANK:-}}" \
    CAP_DEFAULTS="${_EKS_CAP_DEFAULTS}" \
    LORA_MAX="${VLLM_MAX_LORAS:-}" \
    LORA_TARGET_MODULES="${VLLM_LORA_TARGET_MODULES:-}" \
    CAP_MAP="${_EKS_CAP_MAP}" \
    python3 - <<'_PYEOF'
import json, os
v = {}
if os.environ.get("MODEL_ID"):
    v["model"] = os.environ["MODEL_ID"]
if os.environ.get("TP_DEGREE"):
    v["tensor_parallel_degree"] = os.environ["TP_DEGREE"]
if os.environ.get("QUANT"):
    v["quantization"] = os.environ["QUANT"]
if os.environ.get("LORA_ON") == "true":
    v["lora_enable"] = "true"
    # Explicit user-set companion values always win.
    user = {
        "lora_max_rank": os.environ.get("LORA_MAX_RANK") or "",
        "lora_max": os.environ.get("LORA_MAX") or "",
        "lora_target_modules": os.environ.get("LORA_TARGET_MODULES") or "",
    }
    for k, val in user.items():
        if val:
            v[k] = val
    # LoRA sizing/companion defaults, keyed by CAPABILITY (not engine name) and
    # READ from the active engine's manifest (capability_map `default`, passed in
    # as CAP_DEFAULTS) — never a literal here. max_lora_rank arrives already
    # derived (LORA_MAX_RANK = right_sizing.effective_lora_rank). Fill a default
    # for every capability the ACTIVE engine DECLARES (not only ones gated as
    # "required"): vLLM gets lora_max; SGLang (no lora_max) gets its
    # lora_target_modules companion. Explicit user values (above) always win.
    try:
        caps = json.loads(os.environ.get("CAP_MAP") or "{}")
    except ValueError:
        caps = {}
    try:
        cap_defaults = json.loads(os.environ.get("CAP_DEFAULTS") or "{}")
    except ValueError:
        cap_defaults = {}
    lora_decl = caps.get("lora_enable") or {}
    declared = set(k for k in caps.keys())
    for group in (lora_decl.get("requiresAnyOf") or [lora_decl.get("requires") or []]):
        declared.update(group)
    for comp, default in cap_defaults.items():
        if comp in declared and not v.get(comp):
            v[comp] = str(default)
print(json.dumps(v))
_PYEOF
)

# Resolve Tier-1 values → concrete {resolved:[{key,value}], skipped:[...]} for the
# active engine. Fail-open: if the resolver is unavailable the render falls back
# to the template's own ${VAR:-default} shapes.
EKS_TIER1_ENV_JSON="$(python3 "${SCRIPT_DIR}/lib/python/serve_manifest.py" \
    resolve_capability_vars "${_EKS_ENGINE}" "${_EKS_TIER1_VALUES}" 2>/dev/null || echo '')"
export EKS_TIER1_ENV_JSON
export MODEL_SERVER="${_EKS_ENGINE}"

# Surface any companion-gated omissions (e.g. SGLang LoRA without rank/target
# modules) so an operator sees WHY a requested capability was not injected.
if [ -n "${EKS_TIER1_ENV_JSON}" ]; then
    printf '%s' "${EKS_TIER1_ENV_JSON}" | python3 -c '
import json, sys
try:
    data = json.load(sys.stdin)
except Exception:
    sys.exit(0)
for s in data.get("skipped", []):
    print("   ⚠️  engine config: %s" % s.get("reason", s.get("capability", "")))
' 2>/dev/null || true
fi

# ── Tier-2 engine config: unbounded prefix pass-through (ADR-010) ─────────────
# Every OTHER engine flag (batch_size, advanced knobs, a custom plugin's bespoke
# options) is NOT enumerated by MLCC. Any env var under the active engine's
# manifest prefix that is not already a Tier-1 key is forwarded verbatim into the
# pod env. The exclusion set is DERIVED from the capability_map (the Tier-1 keys
# the resolver already placed) — never a hardcoded VLLM_* literal — so a custom
# engine participates with zero MLCC edits.
ENGINE_ENV_PREFIX=$(python3 "${SCRIPT_DIR}/lib/python/serve_manifest.py" env_var_prefix "${_EKS_ENGINE}" 2>/dev/null || true)
[ -n "${ENGINE_ENV_PREFIX}" ] || ENGINE_ENV_PREFIX="VLLM_"
EKS_TIER2_ENV_JSON=$(
    ENGINE_ENV_PREFIX="${ENGINE_ENV_PREFIX}" \
    EKS_TIER1_ENV_JSON="${EKS_TIER1_ENV_JSON}" \
    python3 - <<'_PYEOF'
import json, os
prefix = os.environ.get("ENGINE_ENV_PREFIX", "VLLM_")
# Tier-1 keys already emitted by the resolver — exclude them so we never
# double-emit (and never override a companion-gated omission).
try:
    t1 = json.loads(os.environ.get("EKS_TIER1_ENV_JSON") or "{}")
except Exception:
    t1 = {}
tier1_keys = {e.get("key") for e in t1.get("resolved", []) if isinstance(e, dict)}
# Speculative-decoding env vars are assembled by the serve wrapper from their own
# components; they are not plain pass-through flags.
pairs = []
for k, v in sorted(os.environ.items()):
    if k in ("ENGINE_ENV_PREFIX", "EKS_TIER1_ENV_JSON"):
        continue
    if not k.startswith(prefix):
        continue
    if k in tier1_keys:
        continue
    if "SPECULATIVE" in k:
        continue
    if v == "":
        continue
    pairs.append({"key": k, "value": v})
print(json.dumps({"resolved": pairs}))
_PYEOF
)
export EKS_TIER2_ENV_JSON

# ── Portable variable-substitution shim (matches hyperpod-eks) ────────────────
# GNU envsubst does not understand ${VAR:-default}; route substitution through a
# perl pass that resolves BOTH ${VAR:-default} and bare ${VAR} forms. This keeps
# the manifests renderable now (envsubst) and by BL111's node+ejs re-render.
envsubst() {
    perl -pe '
        s/\$\{([A-Za-z_][A-Za-z0-9_]*):-([^}]*)\}/
            (defined $ENV{$1} && length $ENV{$1}) ? $ENV{$1} : $2/ge;
        s/\$\{([A-Za-z_][A-Za-z0-9_]*)\}/
            defined $ENV{$1} ? $ENV{$1} : "\${$1}"/ge;
    '
}

# ── Render + apply the plain Kubernetes objects (Requirements 1, 2, 3, 4) ─────
# BL111: re-render the eks manifests at DEPLOY time so the applied YAML reflects
# the CURRENT do/config (instance type, GPU count, model source, serve config),
# not values frozen at `mcc generate` time.
#
# The render SOURCE OF TRUTH is the EJS template (eks/*.yaml.ejs) shipped into
# the project, resolved against the current environment — NOT the generate-time
# eks/*.yaml (that frozen file is only the envsubst-fallback input).
#
# Two render paths, chosen by capability detection (Requirement 3 + 4):
#   • PREFERRED: node + ejs renders eks/*.yaml.ejs from source (full EJS
#     semantics), then envsubst resolves the ${VAR} shell placeholders.
#   • FALLBACK:  when the EJS renderer is unavailable, envsubst the frozen
#     eks/*.yaml and emit a clear WARNING (Requirement 4). The deploy continues.
#
# Both paths emit exactly {Deployment, Service, ConfigMap}; NO InferenceEndpointConfig.
echo "📄 Rendering Kubernetes manifests from eks/..."

# Export the generate-time-derived vars the EJS renderer maps onto its template
# variables (projectName/framework/namespace/replicas/modelName/GPU count). They
# come from do/config (already sourced) so the render reflects deploy-time values.
export PROJECT_NAME FRAMEWORK HP_NAMESPACE HP_REPLICAS MODEL_NAME HP_GPU_COUNT
# ADR-010: MODEL_SERVER selects the engine; EKS_TIER1_ENV_JSON carries the
# manifest-derived Tier-1 env pairs the ConfigMap loops (no hardcoded VLLM_*),
# EKS_TIER2_ENV_JSON the unbounded prefix pass-through.
export MODEL_SERVER EKS_TIER1_ENV_JSON EKS_TIER2_ENV_JSON
# Optional: node-local NVMe mount base for the model volume (hostPath). When set
# (e.g. HP_MODEL_HOSTPATH=/opt/dlami/nvme in do/config), the model lands on the
# node's instance-store NVMe instead of an emptyDir on the small EBS root —
# required for large models on nodes whose NVMe isn't the kubelet ephemeral root.
export HP_MODEL_HOSTPATH="${HP_MODEL_HOSTPATH:-}"

# ── Detect the EJS renderer (node + ejs) ──────────────────────────────────────
# The renderer is do/lib/render-eks-manifests.cjs; its --probe exits 0 only when
# node runs AND the ejs module loads. The EJS path is taken ONLY when BOTH the
# renderer is usable AND eks/*.yaml.ejs SOURCE files are actually present: a
# project generated for a non-eks default target ships only the frozen eks/*.yaml
# (the .ejs source is shipped only for a generate-time eks target), so without
# this check the EJS loop would match zero files and silently apply NOTHING while
# still reporting success. When no .ejs source exists we fall back to the frozen
# eks/*.yaml (envsubst), which is always present.
EKS_RENDERER="do/lib/render-eks-manifests.cjs"
USE_EJS_RENDERER=false
_eks_ejs_sources=$(ls eks/*.yaml.ejs 2>/dev/null || true)
if [ -n "${_eks_ejs_sources}" ] \
    && command -v node >/dev/null 2>&1 && [ -f "${EKS_RENDERER}" ] \
    && node "${EKS_RENDERER}" --probe >/dev/null 2>&1; then
    USE_EJS_RENDERER=true
fi

if [ "${USE_EJS_RENDERER}" = true ]; then
    echo "   Renderer: node + ejs (rendering from eks/*.yaml.ejs source)"
else
    echo "⚠️  EJS renderer (node + ejs) not available — rendering eks manifests with the envsubst fallback."
    echo "    Full EJS template semantics are not applied; \${VAR}/\${VAR:-default} substitution is used instead."
    echo "    Install node + ejs to render from the EJS source."
fi

APPLY_OUTPUT=""
APPLY_EXIT_CODE=0
# Count the manifest documents actually sent to kubectl. A render that produces
# zero applyable documents (e.g. no source files matched, or none contained a
# `kind:`) MUST fail loudly rather than report success — the silent no-op that
# left "✅ applied" printed while the deployment never existed.
APPLIED_COUNT=0

if [ "${USE_EJS_RENDERER}" = true ]; then
    # Preferred path: render each .ejs SOURCE with EJS semantics, then resolve the
    # remaining ${VAR} shell placeholders via the envsubst shim.
    _eks_manifests=$(ls eks/*.yaml.ejs 2>/dev/null || true)
    for manifest in ${_eks_manifests}; do
        [ -f "${manifest}" ] || continue
        EJS_OUT=$(node "${EKS_RENDERER}" "${manifest}") || {
            echo "❌ EJS render failed for ${manifest}"
            _update_config "DEPLOYMENT_TARGET_EKS_STATUS" "Failed"
            exit 1
        }
        RENDERED=$(printf '%s' "${EJS_OUT}" | envsubst)
        if echo "${RENDERED}" | grep -q '^kind:'; then
            FILE_OUTPUT=$(echo "${RENDERED}" | kubectl apply -n "${HP_NAMESPACE}" -f - 2>&1) || {
                APPLY_EXIT_CODE=$?
            }
            APPLY_OUTPUT="${APPLY_OUTPUT}${FILE_OUTPUT}"$'\n'
            APPLIED_COUNT=$(( APPLIED_COUNT + 1 ))
        fi
    done
else
    # Fallback path: envsubst over the generate-time-frozen eks/*.yaml.
    for manifest in eks/*.yaml; do
        [ -f "${manifest}" ] || continue
        RENDERED=$(envsubst < "${manifest}")
        if echo "${RENDERED}" | grep -q '^kind:'; then
            FILE_OUTPUT=$(echo "${RENDERED}" | kubectl apply -n "${HP_NAMESPACE}" -f - 2>&1) || {
                APPLY_EXIT_CODE=$?
            }
            APPLY_OUTPUT="${APPLY_OUTPUT}${FILE_OUTPUT}"$'\n'
            APPLIED_COUNT=$(( APPLIED_COUNT + 1 ))
        fi
    done
fi

# Fail loudly on a zero-apply: no manifest documents reached kubectl, so nothing
# was created even though individual kubectl calls (there were none) did not error.
if [ "${APPLIED_COUNT}" -eq 0 ]; then
    echo ""
    echo "❌ No Kubernetes manifests were applied — the render produced zero documents."
    echo "   Expected eks/*.yaml(.ejs) with a 'kind:' to apply, but found none."
    echo "   Debug:"
    echo "   • ls -la eks/        (are the manifest sources present?)"
    echo "   • Renderer in use:   $( [ "${USE_EJS_RENDERER}" = true ] && echo 'node+ejs (eks/*.yaml.ejs)' || echo 'envsubst (eks/*.yaml)' )"
    echo "   • Regenerate the project if eks/ is empty or stale."
    _update_config "DEPLOYMENT_TARGET_EKS_STATUS" "Failed"
    exit 1
fi

if [ "${APPLY_EXIT_CODE}" -ne 0 ]; then
    echo ""
    echo "❌ Failed to apply Kubernetes objects"
    echo ""
    echo "   Error details:"
    echo "   ${APPLY_OUTPUT}"
    echo ""
    echo "   Common issues:"
    echo "   • Insufficient node capacity — check available GPU nodes"
    echo "   • Resource requests exceed node capacity"
    echo "   • RBAC — ensure you can create resources in namespace '${HP_NAMESPACE}'"
    echo "   • Invalid manifest syntax"
    echo ""
    echo "   Debug commands:"
    echo "   kubectl get nodes -o wide"
    echo "   kubectl get events -n ${HP_NAMESPACE}"
    _update_config "DEPLOYMENT_TARGET_EKS_STATUS" "Failed"
    exit ${APPLY_EXIT_CODE}
fi

echo "✅ Deployment, Service, and ConfigMap applied"

# Record the K8s resources in the manifest (non-blocking)
./do/manifest add \
    --type k8s-deployment \
    --id "${HP_NAMESPACE}/${PROJECT_NAME}" \
    --project "${PROJECT_NAME}" \
    --meta "{\"namespace\":\"${HP_NAMESPACE}\",\"resourceName\":\"${PROJECT_NAME}\",\"clusterName\":\"${HP_CLUSTER_NAME:-}\",\"region\":\"${AWS_REGION}\"}" \
    2>/dev/null || true

# ── Readiness: wait for the Deployment rollout (no SageMaker endpoint) ─────────
DEPLOY_TIMEOUT=${DEPLOY_TIMEOUT:-900}
echo "⏳ Waiting for deployment/${PROJECT_NAME} to roll out (timeout: ${DEPLOY_TIMEOUT}s)..."
echo "   This may take several minutes for GPU workloads..."
if ! kubectl rollout status "deployment/${PROJECT_NAME}" \
    -n "${HP_NAMESPACE}" --timeout="${DEPLOY_TIMEOUT}s"; then
    echo ""
    echo "❌ Deployment did not become available within ${DEPLOY_TIMEOUT}s"
    echo ""
    echo "   Debug commands:"
    echo "   kubectl get pods -n ${HP_NAMESPACE} -l app=${PROJECT_NAME} -o wide"
    echo "   kubectl describe deployment ${PROJECT_NAME} -n ${HP_NAMESPACE}"
    echo "   kubectl logs -n ${HP_NAMESPACE} -l app=${PROJECT_NAME} --tail=100"
    _update_config "DEPLOYMENT_TARGET_EKS_STATUS" "Failed"
    exit 1
fi

echo "✅ Plain EKS deployment complete!"

# ── Persist config for downstream workflows ───────────────────────────────────
_update_config "HP_NAMESPACE" "${HP_NAMESPACE}"
[ -n "${HP_CLUSTER_NAME:-}" ] && _update_config "HP_CLUSTER_NAME" "${HP_CLUSTER_NAME}"
if [ -n "${KUBECONFIG:-}" ]; then
    _update_config "KUBECONFIG" "${KUBECONFIG}"
fi
_update_config "DEPLOYMENT_TARGET_EKS_STATUS" "Running"

echo ""
echo "📋 Deployment Details:"
echo "   Namespace: ${HP_NAMESPACE}"
echo "   Service:   ${PROJECT_NAME} (ClusterIP :8080)"
echo "   Replicas:  ${HP_REPLICAS}"
echo "   Image:     ${ECR_REPOSITORY}:${IMAGE_TAG}"
echo ""
echo "📋 What's next?"
echo "   • Test your deployment:  ./do/test"
echo "   • Check pod status:      kubectl get pods -n ${HP_NAMESPACE}"
echo "   • View pod logs:         kubectl logs -n ${HP_NAMESPACE} -l app=${PROJECT_NAME}"
<% if (typeof includeBenchmark !== 'undefined' && includeBenchmark) { %>
echo "   • Benchmark performance: ./do/benchmark"
<% } %>
echo "   • Clean up when done:    ./do/clean --target eks eks"
