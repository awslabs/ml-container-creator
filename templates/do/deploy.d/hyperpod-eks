set -e
set -u
set -o pipefail

# ── Trap: write Failed status on non-zero exit (FR-4.2) ───────────
_mark_hp_failed() {
    if type _update_config &>/dev/null; then
        _update_config "DEPLOYMENT_TARGET_HP_STATUS" "Failed"
    fi
}
# Only trap on rollout failure — not on secondary resource errors (configmap, PVC, etc.)
# The status is written explicitly as Running/Failed after the rollout status check.
# trap '_mark_hp_failed' ERR  — disabled: was writing Failed on partial manifest errors

# Parse flags
FORCE_NEW=false
FORCE_IC=false
IC_TARGET=""
while [ $# -gt 0 ]; do
    case "$1" in
        --force) FORCE_NEW=true; shift ;;
        --force-ic)
            FORCE_IC=true
            shift
            ;;
        --help|-h)
            echo "Usage: ./do/deploy [--force] [--force-ic]"
            echo ""
            echo "Options:"
            echo "  --force      Create a new endpoint, even if one already exists."
            echo "  --force-ic   Recreate the inference component on the existing endpoint."
            echo ""
            echo "Without flags, deploy resumes from the last run."
            exit 0
            ;;
        *)
            echo "❌ Unknown option: $1"
            echo "   Run ./do/deploy --help for usage."
            exit 1
            ;;
    esac
done

# Configuration is already sourced by the do/deploy dispatcher.
# Resolve SCRIPT_DIR to do/ (parent of deploy.d/) for lib/ access.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "${SCRIPT_DIR}/lib/profile.sh"
source "${SCRIPT_DIR}/lib/aws-preflight.sh"

# ── Profile-resolved variables (env var > profile > default) ──────────────────
export AWS_REGION="${AWS_REGION:-${_PROFILE_awsRegion:-us-east-1}}"
ECR_REPOSITORY_NAME="${ECR_REPOSITORY_NAME:-${_PROFILE_ecrRepositoryName:-ml-container-creator}}"

echo "🚀 Deploying to AWS"
echo "   Project: ${PROJECT_NAME}"
echo "   Deployment config: ${DEPLOYMENT_CONFIG}"
echo "   Region: ${AWS_REGION}"
echo "   Build target: ${BUILD_TARGET}"
echo "   Deployment target: ${DEPLOYMENT_TARGET}"
echo "   HyperPod cluster: ${HP_CLUSTER_NAME}"
echo "   Namespace: ${HP_NAMESPACE}"
echo "   Replicas: ${HP_REPLICAS}"

_aws_preflight --verbose

# Construct ECR repository URL
ECR_REPOSITORY="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_REPOSITORY_NAME}"

# ============================================================
# Shared: Verify ECR image exists
# ============================================================
echo "🔍 Verifying ECR image exists..."
if ! aws ecr describe-images \
    --repository-name "${ECR_REPOSITORY_NAME}" \
    --image-ids imageTag="${PROJECT_NAME}-latest" \
    --region "${AWS_REGION}" &> /dev/null; then
    
    echo "❌ ECR image not found: ${ECR_REPOSITORY}:${PROJECT_NAME}-latest"
    echo ""
    echo "Please build and push your image first:"
    echo "  ./do/submit"
    echo ""
    echo "After the build completes successfully, run this deploy script again."
    exit 4
fi

echo "✅ ECR image found: ${ECR_REPOSITORY}:${PROJECT_NAME}-latest"
IMAGE_TAG="${PROJECT_NAME}-latest"

# ============================================================
# HuggingFace token for the 'hf-token-secret' Kubernetes Secret
# ============================================================
# The token is resolved here only to populate the in-cluster K8s Secret below;
# pods read it via secretKeyRef / tokenSecretRef, never as a plain env value
# (BL212). Nothing in this target writes it into a SageMaker API payload.
# BL076: fall back to profile secrets when ARN is not explicitly set in do/config
HF_TOKEN_ARN="${HF_TOKEN_ARN:-${_PROFILE_secrets_hfToken:-}}"
RESOLVED_HF_TOKEN=""
if [ -n "${HF_TOKEN_ARN:-}" ]; then
    echo "🔐 Resolving HuggingFace token from Secrets Manager..."
    RESOLVED_HF_TOKEN=$(aws secretsmanager get-secret-value --secret-id "${HF_TOKEN_ARN}" --query SecretString --output text --region "${AWS_REGION}") || {
        echo "❌ Failed to resolve HuggingFace token from Secrets Manager"
        exit 3
    }
fi

# ============================================================
# HyperPod EKS Deployment
# ============================================================

# Guard: HP_CLUSTER_NAME must be set (written by do/deploy on first deploy; re-run with --reconfigure if missing)
if [ -z "${HP_CLUSTER_NAME:-}" ]; then
    echo "❌ HP_CLUSTER_NAME is not set in do/config"
    echo ""
    echo "   This is written automatically after the first successful deploy."
    echo "   If you regenerated the project, re-run do/deploy to repopulate it,"
    echo "   or manually add: export HP_CLUSTER_NAME="<your-cluster-name>" to do/config"
    exit 4
fi

# Get kubeconfig for HyperPod cluster
echo "🔑 Configuring kubectl for HyperPod cluster..."
KUBECONFIG_PATH="${HOME}/.kube/hyperpod-${HP_CLUSTER_NAME}"

# Step 1: Describe the HyperPod cluster to get the underlying EKS cluster ARN
EKS_CLUSTER_ARN=$(aws sagemaker describe-cluster \
    --cluster-name "${HP_CLUSTER_NAME}" \
    --region "${AWS_REGION}" \
    --query "Orchestrator.Eks.ClusterArn" \
    --output text 2>&1) || {
    echo "❌ Failed to describe HyperPod cluster: ${HP_CLUSTER_NAME}"
    echo ""
    echo "   Error details:"
    echo "   ${EKS_CLUSTER_ARN}"
    echo ""
    echo "   Check that:"
    echo "   • The cluster name is correct"
    echo "   • The cluster exists in region: ${AWS_REGION}"
    echo "   • Your IAM user/role has permission to access the cluster"
    echo ""
    echo "   Required IAM permissions:"
    echo "   • sagemaker:DescribeCluster"
    echo "   • eks:DescribeCluster"
    exit 4
}

# Step 2: Extract the EKS cluster name from the ARN
EKS_CLUSTER_NAME=$(echo "${EKS_CLUSTER_ARN}" | awk -F'/' '{print $NF}')
echo "   HyperPod cluster: ${HP_CLUSTER_NAME}"
echo "   EKS cluster: ${EKS_CLUSTER_NAME}"

# Step 3: Update kubeconfig using the EKS cluster
if ! aws eks update-kubeconfig \
    --name "${EKS_CLUSTER_NAME}" \
    --region "${AWS_REGION}" \
    --kubeconfig "${KUBECONFIG_PATH}" 2>&1; then
    echo "❌ Failed to configure kubectl for EKS cluster: ${EKS_CLUSTER_NAME}"
    echo ""
    echo "   Required IAM permissions:"
    echo "   • eks:DescribeCluster"
    echo "   • eks:AccessKubernetesApi"
    exit 4
fi

export KUBECONFIG="${KUBECONFIG_PATH}"
echo "✅ Kubeconfig saved to: ${KUBECONFIG_PATH}"

# Verify cluster connectivity
echo "🔍 Verifying cluster connectivity..."
if ! kubectl cluster-info &> /dev/null; then
    echo "❌ Cannot connect to HyperPod cluster"
    echo ""
    echo "   Check that:"
    echo "   • The cluster is in 'InService' status"
    echo "   • Your network can reach the cluster API server"
    echo "   • Your IAM credentials are valid"
    exit 4
fi
echo "✅ Connected to HyperPod cluster"

# Create namespace if it doesn't exist
echo "📁 Ensuring namespace exists: ${HP_NAMESPACE}"

# ── K8s Secret: HuggingFace token ──────────────────────────────────────────
# Create/update the 'hf-token' K8s Secret in the target namespace so the
# cluster can authenticate against HuggingFace for any operation that needs it
# (model pull at startup, tokenizer fetch for do/benchmark, etc.).
#
# Resolution order:
#   1. RESOLVED_HF_TOKEN resolved above (from Secrets Manager or HF_TOKEN env)
#   2. Neither → skip with warning
#
# Note: token is needed even when STAGED_MODEL_PATH is set — advanced operations
# like do/benchmark fetch the tokenizer from HuggingFace for gated models.
#
# The InferenceEndpointConfig references this Secret via
# spec.modelSourceConfig.huggingFaceModel.tokenSecretRef (name: hf-token-secret,
# key: token) for the Hugging Face model source. The token is only consumed
# during the operator's model download and is not exposed to the container.
# ─────────────────────────────────────────────────────────────────────────────

if [ -n "${RESOLVED_HF_TOKEN:-}" ]; then
    echo "🔑 Creating K8s Secret 'hf-token-secret' in namespace '${HP_NAMESPACE}'..."
    kubectl create secret generic hf-token-secret \
        --from-literal=token="${RESOLVED_HF_TOKEN}" \
        --namespace "${HP_NAMESPACE}" \
        --dry-run=client -o yaml | kubectl apply -f - 2>&1 || {
        echo "⚠️  Warning: Could not create hf-token-secret (will continue)"
        echo "   The pod may fail to pull gated models — set HF_TOKEN_ARN in do/config"
    }
    echo "✅ HuggingFace token secret ready"
else
    echo "   ⚠️  No HuggingFace token configured"
    echo "   Set HF_TOKEN_ARN in do/config or run: mcc bootstrap add-secret hfToken <arn>"
    echo "   (Continuing — token only required for gated HuggingFace models)"
fi

echo "📁 Ensuring namespace exists: ${HP_NAMESPACE}"
if ! kubectl create namespace "${HP_NAMESPACE}" --dry-run=client -o yaml | kubectl apply -f - 2>&1; then
    echo "⚠️  Warning: Could not create/verify namespace"
fi

# Apply the InferenceEndpointConfig custom resource
echo "📄 Rendering InferenceEndpointConfig from hyperpod/..."

# Substitute shell variables (e.g. ${AWS_ACCOUNT_ID}) in manifests before applying
export AWS_ACCOUNT_ID
export ECR_IMAGE="${ECR_REPOSITORY}:${IMAGE_TAG}"

# LoRA (ADR-010 Tier-1): HP_LORA_ENABLED in do/config toggles LoRA at deploy time
# without regeneration. The toggle is a boolean capability resolved per-engine
# through the capability_map below (NOT a hardcoded VLLM_ENABLE_LORA export): for
# vLLM a bare --enable-lora is valid, but for SGLang the resolver omits it unless
# its companion contract (max-lora-rank + lora-target-modules) is satisfied, so a
# server-crashing bare flag can never be emitted. Normalize the toggle here.
if [ "${HP_LORA_ENABLED:-false}" = "true" ]; then
    _HP_LORA_ON="true"
else
    _HP_LORA_ON="false"
fi

# Export speculative-decoding values for the CRD's two engine-specific env sets.
# The CRD always carries both sets; the container's selected serve wrapper reads
# only its own values. Keep worker.args empty because code/serve owns all flags.
export VLLM_SPECULATIVE_ALGORITHM=""
export VLLM_SPECULATIVE_MODEL=""
export VLLM_SPECULATIVE_NUM_TOKENS=""
export VLLM_SPECULATIVE_DRAFT_SAMPLE_METHOD=""
export VLLM_SPECULATIVE_REJECTION_SAMPLE_METHOD=""
export SGLANG_SPECULATIVE_ALGORITHM=""
export SGLANG_SPECULATIVE_DRAFT_MODEL_PATH=""
export SGLANG_SPECULATIVE_NUM_STEPS=""
export SGLANG_SPECULATIVE_EAGLE_TOPK=""

if [ -n "${HP_SPECULATIVE_ALGORITHM:-}" ]; then
    # BL129: gate the requested algorithm by the DEPLOYED engine version. do/draft
    # validated it at config time, but the base image may have changed since; this
    # re-checks against the effective supported_algorithms for the version resolved
    # from BASE_IMAGE (model-servers.json framework_version → tag parse). Fail-open:
    # an unresolvable version yields the full flat set, so we never block a deploy
    # over a version we cannot read. A gate failure here means the configured
    # algorithm needs a newer engine image than the one being deployed.
    _HP_ENGINE="${MODEL_SERVER:-vllm}"
    _HP_ENGINE_VERSION="$(python3 "${SCRIPT_DIR}/lib/python/serve_manifest.py" engine_version "${_HP_ENGINE}" "${BASE_IMAGE:-}" 2>/dev/null || echo "")"
    if [ -n "${_HP_ENGINE_VERSION}" ]; then
        _HP_EFFECTIVE="$(python3 "${SCRIPT_DIR}/lib/python/serve_manifest.py" effective_supported_algorithms "${_HP_ENGINE}" "${_HP_ENGINE_VERSION}" 2>/dev/null || echo '[]')"
        if ! printf '%s' "${_HP_EFFECTIVE}" | HP_ALG="${HP_SPECULATIVE_ALGORITHM}" python3 -c "import json,sys,os; sys.exit(0 if os.environ['HP_ALG'] in json.load(sys.stdin) else 1)" 2>/dev/null; then
            echo "❌ Speculative algorithm '${HP_SPECULATIVE_ALGORITHM}' is not available on ${_HP_ENGINE} ${_HP_ENGINE_VERSION} (the deployed base image)." >&2
            echo "   Upgrade the base image to a version that supports it, or reconfigure with ./do/draft." >&2
            _update_config "DEPLOYMENT_TARGET_HP_STATUS" "Failed"
            exit 1
        fi
    fi

    # BL107: the MLCC algorithm name → engine-specific enum translation is read
    # from each engine's serve-layer manifest (algorithm_map) rather than a
    # hardcoded case statement. The CRD carries both engine sets; each engine's
    # value comes from its own manifest so the mapping can never drift from the
    # engine's declared capabilities. The uppercase SGLang enums
    # (draft-model→STANDALONE, eagle/eagle2→EAGLE, eagle3→EAGLE3, mtp→MTP) and
    # the vLLM names (draft-model→draft_model, ngram→ngram, …) live in
    # serve.d/<engine>/manifest.json. Any algorithm reaching deploy has already
    # been validated against the active engine's supported_algorithms by
    # do/draft (version-aware, BL129), so an unmapped algorithm here is a
    # defense-in-depth error.
    _spec_enum() {
        # _spec_enum <engine> <mlcc-algorithm> → prints the engine-specific enum
        # (empty string if the engine does not map the algorithm).
        HP_ALG="$2" python3 - "${SCRIPT_DIR}" "$1" <<'_PYEOF'
import json, os, subprocess, sys
script_dir, engine = sys.argv[1], sys.argv[2]
alg = os.environ.get("HP_ALG", "")
reader = os.path.join(script_dir, "lib", "python", "serve_manifest.py")
try:
    out = subprocess.run(
        [sys.executable, reader, "algorithm_map", engine],
        capture_output=True, text=True, check=True,
    ).stdout
    print(json.loads(out).get(alg, ""))
except Exception:
    print("")
_PYEOF
    }

    VLLM_SPECULATIVE_ALGORITHM="$(_spec_enum vllm "${HP_SPECULATIVE_ALGORITHM}")"
    SGLANG_SPECULATIVE_ALGORITHM="$(_spec_enum sglang "${HP_SPECULATIVE_ALGORITHM}")"
    export VLLM_SPECULATIVE_ALGORITHM SGLANG_SPECULATIVE_ALGORITHM

    # The active engine must map the requested algorithm; if neither engine does,
    # the algorithm is invalid (do/draft normally rejects it upstream).
    if [ -z "${VLLM_SPECULATIVE_ALGORITHM}" ] && [ -z "${SGLANG_SPECULATIVE_ALGORITHM}" ]; then
        echo "❌ HP_SPECULATIVE_ALGORITHM='${HP_SPECULATIVE_ALGORITHM}' is not a supported speculative-decoding algorithm." >&2
        echo "   Supported algorithms are declared in serve.d/<engine>/manifest.json (see ./do/draft --help)." >&2
        exit 1
    fi

    # SGLang exposes EAGLE top-k only for the eagle/eagle3 MLCC algorithms
    # (matching the engine's discrete --speculative-eagle-topk flag). eagle2 also
    # maps to the EAGLE enum but does not carry top-k, so gate on the MLCC name.
    case "${HP_SPECULATIVE_ALGORITHM}" in
        eagle|eagle3)
            export SGLANG_SPECULATIVE_EAGLE_TOPK="${HP_SPECULATIVE_EAGLE_TOPK:-}"
            ;;
    esac

    export VLLM_SPECULATIVE_MODEL="${HP_SPECULATIVE_MODEL:-}"
    export VLLM_SPECULATIVE_NUM_TOKENS="${HP_SPECULATIVE_NUM_TOKENS:-5}"
    # DSpark (Kimi-K3) sample-method knobs flow from HP_SPECULATIVE_* → VLLM_*
    # (mirroring HP_SPECULATIVE_MODEL/NUM_TOKENS above). Empty for all other
    # algorithms; the serve wrapper omits empty keys from --speculative-config.
    export VLLM_SPECULATIVE_DRAFT_SAMPLE_METHOD="${HP_SPECULATIVE_DRAFT_SAMPLE_METHOD:-}"
    export VLLM_SPECULATIVE_REJECTION_SAMPLE_METHOD="${HP_SPECULATIVE_REJECTION_SAMPLE_METHOD:-}"
    export SGLANG_SPECULATIVE_DRAFT_MODEL_PATH="${HP_SPECULATIVE_MODEL:-}"
    export SGLANG_SPECULATIVE_NUM_STEPS="${HP_SPECULATIVE_NUM_STEPS:-${HP_SPECULATIVE_NUM_TOKENS:-5}}"
fi

# Instance type for the CRD: prefer explicit HP override, else the configured
# node selector, else INSTANCE_TYPE from do/config.
export HP_INSTANCE_TYPE="${HP_INSTANCE_TYPE:-${HP_NODE_SELECTOR:-${INSTANCE_TYPE:-}}}"

# ── BL096: auto-resolve GPU count / CPU / memory from the instance type ────────
# instanceType and the GPU-derived resource requests are resolved at DEPLOY time
# (not baked into the CRD at generation time). This keeps the CRD in sync when
# the user changes instance groups via --reconfigure / --force: a stale baked
# GPU count would otherwise cause wrong node affinity (scheduling failures) and
# a wrong tensor-parallel degree (OOM).
#
# derive-dont-hardcode (ADR-008): the GPU count is OWNED by the instance catalog,
# which the generator ships into the project at .mlcc/instances.json (the same
# source deploy-config-builder.js and the benchmark writer use). We read it here
# so new instance families (g7/g7e, p6-b200, ...) are picked up without editing
# this script. The hardcoded case below is ONLY a fallback for when the catalog
# is absent/unreadable; it is a small known subset, not the source of truth.
# Unknown types fall back to 1 GPU. CPU/memory scale with GPU count (cpu = gpu*4
# cores, memory = gpu*16 Gi), matching the CRD template defaults.
_hp_detect_gpu_count() {
    local itype="${1}"
    [ -n "${itype}" ] || { echo 1; return; }

    # 1) Authoritative source: .mlcc/instances.json (catalog[<ml.type>].gpus).
    #    ${SCRIPT_DIR:-} so an unset SCRIPT_DIR degrades to the fallback case
    #    (and does not trip `set -u`).
    local _catalog="${SCRIPT_DIR:-}/../.mlcc/instances.json"
    if [ -n "${SCRIPT_DIR:-}" ] && [ -f "${_catalog}" ] && command -v python3 >/dev/null 2>&1; then
        local _gpus
        _gpus="$(ITYPE="${itype}" CATALOG="${_catalog}" python3 -c '
import json, os
try:
    cat = json.load(open(os.environ["CATALOG"]))["catalog"]
    g = cat.get(os.environ["ITYPE"], {}).get("gpus")
    print(int(g) if g and int(g) > 0 else "")
except Exception:
    print("")
' 2>/dev/null)" || _gpus=""
        if [ -n "${_gpus}" ]; then
            echo "${_gpus}"
            return
        fi
    fi

    # 2) Fallback only when the catalog is unavailable or lacks the type.
    local suffix="${itype#ml.}"
    case "${suffix}" in
        g5.xlarge|g5.2xlarge|g5.4xlarge|g5.8xlarge|g5.16xlarge) echo 1 ;;
        g5.12xlarge|g5.24xlarge) echo 4 ;;
        g5.48xlarge) echo 8 ;;
        g6.xlarge|g6.2xlarge|g6.4xlarge|g6.8xlarge|g6.16xlarge) echo 1 ;;
        g6.12xlarge|g6.24xlarge) echo 4 ;;
        g6.48xlarge) echo 8 ;;
        g7.2xlarge|g7.4xlarge|g7.8xlarge) echo 1 ;;
        g7.12xlarge) echo 2 ;;
        g7.24xlarge) echo 4 ;;
        g7.48xlarge) echo 8 ;;
        g7e.2xlarge|g7e.4xlarge|g7e.8xlarge) echo 1 ;;
        g7e.12xlarge) echo 2 ;;
        g7e.24xlarge) echo 4 ;;
        g7e.48xlarge) echo 8 ;;
        p4d.24xlarge|p4de.24xlarge|p5.48xlarge) echo 8 ;;
        # B300 (Blackwell Ultra)
        p6-b300.48xlarge) echo 8 ;;
        *) echo 1 ;;
    esac
}

# Prefer an explicit HP_GPU_COUNT from do/config only when it is a positive
# integer; otherwise auto-detect from HP_INSTANCE_TYPE. Re-detection here means a
# changed instance group is always reflected, even if do/config still carries an
# old HP_GPU_COUNT (deploy-config-builder rewrites it, but re-detect defensively).
_HP_DETECTED_GPU_COUNT="$(_hp_detect_gpu_count "${HP_INSTANCE_TYPE}")"
if [ -n "${HP_INSTANCE_TYPE}" ]; then
    export HP_GPU_COUNT="${_HP_DETECTED_GPU_COUNT}"
else
    export HP_GPU_COUNT="${HP_GPU_COUNT:-1}"
fi

# Derive CPU cores and memory (Gi) from the resolved GPU count. envsubst expands
# ${HP_CPU_REQUEST} / ${HP_MEM_REQUEST} in the CRD; the template's :- defaults
# cover raw-template renders that skip the deploy driver.
export HP_CPU_REQUEST="$(( HP_GPU_COUNT * 4 ))"
export HP_MEM_REQUEST="$(( HP_GPU_COUNT * 16 ))Gi"

echo "   Instance type: ${HP_INSTANCE_TYPE:-<unset>}"
echo "   GPU count (auto-detected): ${HP_GPU_COUNT}"
echo "   CPU request: ${HP_CPU_REQUEST}  Memory request: ${HP_MEM_REQUEST}"

# Portable variable-substitution shim.
#
# GNU envsubst only expands bare ${VAR}/$VAR references and does NOT understand
# the ${VAR:-default} form — it would leave those placeholders verbatim, which
# produces invalid YAML for kubectl. The CRD template (BL096) uses ${VAR:-N}
# defaults for HP_INSTANCE_TYPE / HP_GPU_COUNT / HP_CPU_REQUEST / HP_MEM_REQUEST,
# so we always route substitution through a perl pass that resolves BOTH the
# ${VAR:-default} and the bare ${VAR} forms from the process environment. This is
# deterministic across macOS/Linux and independent of whether gettext is present.
envsubst() {
    perl -pe '
        # ${VAR:-default} → env value if set & non-empty, else the default.
        s/\$\{([A-Za-z_][A-Za-z0-9_]*):-([^}]*)\}/
            (defined $ENV{$1} && length $ENV{$1}) ? $ENV{$1} : $2/ge;
        # bare ${VAR} → env value if defined, else leave the placeholder intact
        # (so unrelated shell references are not silently dropped).
        s/\$\{([A-Za-z_][A-Za-z0-9_]*)\}/
            defined $ENV{$1} ? $ENV{$1} : "\${$1}"/ge;
    '
}

# ── Build spec.modelSourceConfig ──────────────────────────────────────────────
# When the model has been staged to S3 (STAGED_MODEL_PATH in do/config), use the
# S3 source. The CRD requires bucketName + region SEPARATELY (not a full s3://
# URI), so parse STAGED_MODEL_PATH (s3://<bucket>/<prefix>/) into its parts.
# modelLocation carries the key prefix within the bucket. Otherwise fall back to
# the Hugging Face source using MODEL_NAME and the hf-token-secret Secret.
build_model_source_config() {
    # SageMaker Inference Optimizer override: when do/optimize has recorded a
    # ModelPackageArn (OPTIMIZE_MODEL_PACKAGE_ARN), deploy the optimized model
    # package instead of the default HF/S3 source. The operator resolves the
    # weights from the model package, so no s3Storage/huggingFaceModel block is
    # emitted for this branch.
    if [ -n "${OPTIMIZE_MODEL_PACKAGE_ARN:-}" ]; then
        export HP_MODEL_SOURCE="model-package"
        cat <<EOF
modelSourceType: model-package
modelPackageArn: "${OPTIMIZE_MODEL_PACKAGE_ARN}"
EOF
    elif [ -n "${STAGED_MODEL_PATH:-}" ]; then
        # Strip the s3:// scheme, then split into bucket (first path segment) and
        # prefix (the remainder, trailing slash removed).
        local no_scheme="${STAGED_MODEL_PATH#s3://}"
        local bucket="${no_scheme%%/*}"
        local prefix=""
        if [[ "${no_scheme}" == */* ]]; then
            prefix="${no_scheme#*/}"
            prefix="${prefix%/}"
        fi
        export HP_MODEL_SOURCE="s3"
        cat <<EOF
modelSourceType: s3
s3Storage:
  bucketName: ${bucket}
  region: ${AWS_REGION}
modelLocation: ${prefix}
prefetchEnabled: true
EOF
    else
        export HP_MODEL_SOURCE="huggingface"
        export HP_HF_MODEL_ID="${MODEL_NAME}"
        if [ -n "${RESOLVED_HF_TOKEN:-}" ]; then
            cat <<EOF
modelSourceType: huggingface
prefetchEnabled: true
huggingFaceModel:
  modelId: "${MODEL_NAME}"
  tokenSecretRef:
    name: hf-token-secret
    key: token
EOF
        else
            cat <<EOF
modelSourceType: huggingface
prefetchEnabled: true
huggingFaceModel:
  modelId: "${MODEL_NAME}"
EOF
        fi
    fi
}

MODEL_SOURCE_CONFIG="$(build_model_source_config)"
# Re-export HP_MODEL_SOURCE in parent shell — the subshell export inside
# build_model_source_config() does not propagate to this scope, but envsubst
# needs it to expand $HP_MODEL_SOURCE in the CRD manifest.
#
# SageMaker Inference Optimizer: when OPTIMIZE_MODEL_PACKAGE_ARN is set, the
# model source is the optimized model package (takes precedence over any staged
# S3 path or the default HF source). MODEL_SOURCE_TYPE mirrors the emitted
# modelSourceType, and HP_MODEL_PACKAGE_ARN carries the ARN for traceability.
if [ -n "${OPTIMIZE_MODEL_PACKAGE_ARN:-}" ]; then
    export HP_MODEL_SOURCE="model-package"
    export MODEL_SOURCE_TYPE="model-package"
    export HP_MODEL_PACKAGE_ARN="${OPTIMIZE_MODEL_PACKAGE_ARN}"
elif [ -n "${STAGED_MODEL_PATH:-}" ]; then
    export HP_MODEL_SOURCE="s3"
    export MODEL_SOURCE_TYPE="s3"
else
    export HP_MODEL_SOURCE="huggingface"
    export MODEL_SOURCE_TYPE="huggingface"
fi

# When deploying an optimized model package, override spec.modelName with the
# inference specification name (OPTIMIZE_INFERENCE_SPEC) for traceability, if
# available. The CRD's modelName is baked in at generation time, so it is
# rewritten during the manifest splice below.
HP_MODEL_NAME_OVERRIDE=""
if [ -n "${OPTIMIZE_MODEL_PACKAGE_ARN:-}" ] && [ -n "${OPTIMIZE_INFERENCE_SPEC:-}" ]; then
    HP_MODEL_NAME_OVERRIDE="${OPTIMIZE_INFERENCE_SPEC}"
fi

APPLY_OUTPUT=""
APPLY_EXIT_CODE=0

# ── Auto-inject VLLM_* pass-through env vars ───────────────────────────────────
# Collect any pass-through engine env vars exported to the environment (e.g. set
# in do/config) that are NOT already explicitly managed in the CRD template. These
# are injected at the __VLLM_EXTRA_ENVVARS__ marker — same pattern as
# __MODEL_SOURCE_CONFIG__. The serve wrapper (code/serve.d/<engine>/<engine>.ejs)
# translates them to CLI flags via whitelist introspection, so any valid engine
# arg can be set this way.
#
# ── Tier-1 engine config: derive from the serve manifest (ADR-010) ────────────
# Same resolver as deploy.d/eks: MLCC computes only the Tier-1 VALUES (model id,
# tensor-parallel degree = GPU count, quantization pass-through, LoRA toggle); the
# per-engine env-var names, value shapes, and LoRA companion contract are OWNED by
# serve.d/<engine>/manifest.json (capability_map) and resolved here. The resolved
# pairs are spliced at the CRD's __TIER1_ENVVARS__ marker — carrying ONLY the
# active engine's keys (no VLLM_*/SGLANG_* cross-leak) and never a bare companion-
# gated flag. The HyperPod operator owns model download/mount, so the model value
# is the configured model name (or the optimized-package inference-spec override).
_HP_ENGINE="${MODEL_SERVER:-vllm}"
_HP_MODEL_FOR_ENV="${HP_MODEL_NAME_OVERRIDE:-${MODEL_NAME:-}}"
# The active engine's capability_map tells us WHICH LoRA companions it requires
# (ADR-010), so MLCC supplies pure-dynamic defaults without branching on engine.
_HP_CAP_MAP="$(python3 "${SCRIPT_DIR}/lib/python/serve_manifest.py" capability_map "${_HP_ENGINE}" 2>/dev/null || echo '{}')"
_HP_TIER1_VALUES=$(
    MODEL_ID="${_HP_MODEL_FOR_ENV}" \
    TP_DEGREE="${VLLM_TENSOR_PARALLEL_SIZE:-${HP_GPU_COUNT:-1}}" \
    QUANT="${VLLM_QUANTIZATION:-}" \
    LORA_ON="${_HP_LORA_ON:-false}" \
    LORA_MAX_RANK="${VLLM_MAX_LORA_RANK:-}" \
    LORA_MAX="${VLLM_MAX_LORAS:-}" \
    LORA_TARGET_MODULES="${VLLM_LORA_TARGET_MODULES:-}" \
    CAP_MAP="${_HP_CAP_MAP}" \
    python3 - <<'_PYEOF'
import json, os
v = {}
if os.environ.get("MODEL_ID"):
    v["model"] = os.environ["MODEL_ID"]
if os.environ.get("TP_DEGREE"):
    v["tensor_parallel_degree"] = os.environ["TP_DEGREE"]
if os.environ.get("QUANT"):
    v["quantization"] = os.environ["QUANT"]
if os.environ.get("LORA_ON") == "true":
    v["lora_enable"] = "true"
    # Explicit user-set companion values always win.
    user = {
        "lora_max_rank": os.environ.get("LORA_MAX_RANK") or "",
        "lora_max": os.environ.get("LORA_MAX") or "",
        "lora_target_modules": os.environ.get("LORA_TARGET_MODULES") or "",
    }
    for k, val in user.items():
        if val:
            v[k] = val
    # MLCC pure-dynamic LoRA defaults, keyed by CAPABILITY (not engine name).
    # lora_max=4 / lora_max_rank=16 are memory-safe sizing defaults: vLLM's own
    # defaults (max_loras=30, max_lora_rank=64) pre-allocate a large LoRA buffer
    # that OOMs big models on tight VRAM (validated remediation in the capability
    # matrix: "reduce max_loras 30→4, max_lora_rank 64→16"). 4 covers 2–3 adapters
    # plus hot-swap headroom; override via VLLM_MAX_LORAS / VLLM_MAX_LORA_RANK.
    MLCC_LORA_DEFAULTS = {"lora_max": "4", "lora_max_rank": "16", "lora_target_modules": "all"}
    try:
        caps = json.loads(os.environ.get("CAP_MAP") or "{}")
    except Exception:
        caps = {}
    lora_decl = caps.get("lora_enable") or {}
    # Fill a default for every sizing/companion capability the ACTIVE engine
    # DECLARES in its capability_map (not only ones gated as "required"): a plugin
    # that declares lora_max gets the memory-safe count; one that doesn't (e.g.
    # SGLang) silently skips it. This is the per-engine translation — each manifest
    # maps the capability to its own env suffix (vLLM lora_max→MAX_LORAS, etc.).
    declared = set(k for k in caps.keys())
    # requiresAnyOf/requires companions are always eligible too (they may not be
    # top-level capability keys on every engine).
    for group in (lora_decl.get("requiresAnyOf") or [lora_decl.get("requires") or []]):
        declared.update(group)
    for comp, default in MLCC_LORA_DEFAULTS.items():
        if comp in declared and not v.get(comp):
            v[comp] = default
print(json.dumps(v))
_PYEOF
)
_HP_TIER1_JSON="$(python3 "${SCRIPT_DIR}/lib/python/serve_manifest.py" \
    resolve_capability_vars "${_HP_ENGINE}" "${_HP_TIER1_VALUES}" 2>/dev/null || echo '')"

# Split the resolver output into (a) a YAML env block for the __TIER1_ENVVARS__
# marker and (b) the newline-separated key list the Tier-2 exclusion derives from.
HP_TIER1_ENVVARS=""
HP_TIER1_KEYS=""
if [ -n "${_HP_TIER1_JSON}" ]; then
    HP_TIER1_ENVVARS=$(printf '%s' "${_HP_TIER1_JSON}" | python3 -c '
import json, sys
try:
    data = json.load(sys.stdin)
except Exception:
    sys.exit(0)
lines = []
for e in data.get("resolved", []):
    lines.append("- name: %s" % e["key"])
    lines.append("  value: \"%s\"" % e["value"])
print("\n".join(lines))
' 2>/dev/null || echo '')
    HP_TIER1_KEYS=$(printf '%s' "${_HP_TIER1_JSON}" | python3 -c '
import json, sys
try:
    data = json.load(sys.stdin)
except Exception:
    sys.exit(0)
print("\n".join(e["key"] for e in data.get("resolved", [])))
' 2>/dev/null || echo '')
    # Surface companion-gated omissions (e.g. SGLang LoRA without rank/target).
    printf '%s' "${_HP_TIER1_JSON}" | python3 -c '
import json, sys
try:
    data = json.load(sys.stdin)
except Exception:
    sys.exit(0)
for s in data.get("skipped", []):
    print("   ⚠️  engine config: %s" % s.get("reason", s.get("capability", "")))
' 2>/dev/null || true
fi
export HP_TIER1_ENVVARS HP_TIER1_KEYS

# BL105 / ADR-010: the pass-through prefix is sourced from the active engine's
# serve-layer manifest (env_var_prefix), never the literal "VLLM_". For
# MODEL_SERVER=vllm this resolves to VLLM_; for sglang, SGLANG_; for a custom
# plugin, its own declared prefix.
ENGINE_ENV_PREFIX=$(python3 "${SCRIPT_DIR}/lib/python/serve_manifest.py" env_var_prefix "${MODEL_SERVER:-vllm}" 2>/dev/null || true)
[ -n "${ENGINE_ENV_PREFIX}" ] || ENGINE_ENV_PREFIX="VLLM_"

# ADR-010 derive-dont-hardcode: the Tier-2 "already-managed" exclusion set is
# DERIVED, not a hardcoded VLLM_* literal. It is the union of:
#   • the resolved Tier-1 keys the capability_map resolver placed (HP_TIER1_KEYS,
#     computed above) — the model / TP / LoRA-companion contract, and
#   • the per-engine speculative-decoding env vars, which the CRD's own
#     speculative block owns (matched by the "SPECULATIVE" substring, engine-
#     agnostic).
# Build-provenance / env-only image vars (VLLM_BUILD_, VLLM_USAGE_SOURCE,
# VLLM_IMAGE_TAG, VLLM_ENABLE_CUDA_COMPATIBILITY, VLLM_ALLOW_RUNTIME_LORA_UPDATING)
# belong to no engine config contract — they are vLLM image internals the serve
# wrapper already drops via --help introspection. They are listed as a small,
# cross-cutting NEVER-PASS-THROUGH set (the SHARED_RUNTIME_VARS analogue), not as
# a per-engine capability list.
VLLM_EXTRA_ENVVARS=$(
    ENGINE_ENV_PREFIX="${ENGINE_ENV_PREFIX}" \
    HP_TIER1_KEYS="${HP_TIER1_KEYS:-}" \
    python3 - <<'_PYEOF'
import os
prefix = os.environ.get("ENGINE_ENV_PREFIX", "VLLM_")
# Tier-1 keys the resolver already emitted into the CRD (newline-separated).
tier1_keys = {k for k in (os.environ.get("HP_TIER1_KEYS") or "").split("\n") if k}
# Cross-cutting env-only image vars that are never serve flags (belong to no
# engine config contract). Prefix-agnostic suffix match keeps this engine-neutral.
NEVER_SUFFIXES = (
    "USAGE_SOURCE", "BUILD_COMMIT", "BUILD_PIPELINE", "BUILD_URL",
    "IMAGE_TAG", "ENABLE_CUDA_COMPATIBILITY", "ALLOW_RUNTIME_LORA_UPDATING",
)
lines = []
for k, v in sorted(os.environ.items()):
    if k in ("ENGINE_ENV_PREFIX", "HP_TIER1_KEYS"):
        continue
    if not k.startswith(prefix) or not v:
        continue
    if k in tier1_keys:
        continue
    if "SPECULATIVE" in k:
        continue
    suffix = k[len(prefix):]
    if suffix in NEVER_SUFFIXES:
        continue
    lines.append(f"- name: {k}")
    lines.append(f'  value: "{v}"')
print("\n".join(lines))
_PYEOF
)
export VLLM_EXTRA_ENVVARS

for manifest in hyperpod/*.yaml; do
    # envsubst first (expands ${ECR_IMAGE}, ${HP_INSTANCE_TYPE}, ${HP_*} defaults),
    # then splice the multi-line modelSourceConfig block in place of the marker,
    # preserving the marker line's indentation for every replacement line so the
    # rendered YAML stays well-formed.
    RENDERED=$(envsubst < "${manifest}")
    RENDERED=$(MODEL_SOURCE_CONFIG="${MODEL_SOURCE_CONFIG}" \
        HP_MODEL_NAME_OVERRIDE="${HP_MODEL_NAME_OVERRIDE}" \
        HP_TIER1_ENVVARS="${HP_TIER1_ENVVARS}" \
        printf '%s' "${RENDERED}" | \
        MODEL_SOURCE_CONFIG="${MODEL_SOURCE_CONFIG}" \
        HP_MODEL_NAME_OVERRIDE="${HP_MODEL_NAME_OVERRIDE}" \
        HP_TIER1_ENVVARS="${HP_TIER1_ENVVARS}" \
        python3 -c '
import os, re, sys
repl = os.environ.get("MODEL_SOURCE_CONFIG", "")
extra_envvars = os.environ.get("VLLM_EXTRA_ENVVARS", "")
tier1_envvars = os.environ.get("HP_TIER1_ENVVARS", "")
name_override = os.environ.get("HP_MODEL_NAME_OVERRIDE", "")
marker = "__MODEL_SOURCE_CONFIG__"
envvars_marker = "__VLLM_EXTRA_ENVVARS__"
tier1_marker = "__TIER1_ENVVARS__"
# Rewrite the top-level spec.modelName only (2-space indent), leaving deeper
# keys such as huggingFaceModel.modelId untouched.
name_re = re.compile(r"^(  modelName:\s*).*$")
out = []
for line in sys.stdin.read().splitlines():
    pos = line.find(marker)
    epos = line.find(envvars_marker)
    tpos = line.find(tier1_marker)
    if pos >= 0:
        indent = line[:pos]
        for rl in repl.splitlines():
            out.append(indent + rl)
    elif tpos >= 0:
        # ADR-010: splice the manifest-DERIVED Tier-1 env block (model / TP /
        # LoRA-companion contract for the ACTIVE engine) at the marker indent.
        # When empty (resolver unavailable) drop the marker so the YAML list
        # stays well-formed.
        indent = line[:tpos]
        for rl in tier1_envvars.splitlines():
            if rl.strip():
                out.append(indent + rl)
    elif epos >= 0:
        # Splice Tier-2 prefix pass-through env vars at the marker indentation.
        # When there are none, drop the marker line entirely so the YAML list
        # stays well-formed.
        indent = line[:epos]
        for rl in extra_envvars.splitlines():
            if rl.strip():
                out.append(indent + rl)
    elif name_override and name_re.match(line):
        out.append("  modelName: \"%s\"" % name_override)
    else:
        out.append(line)
sys.stdout.write("\n".join(out) + "\n")
')
    if echo "${RENDERED}" | grep -q '^kind:'; then
        FILE_OUTPUT=$(echo "${RENDERED}" | kubectl apply -n "${HP_NAMESPACE}" -f - 2>&1) || {
            APPLY_EXIT_CODE=$?
        }
        APPLY_OUTPUT="${APPLY_OUTPUT}${FILE_OUTPUT}\n"
    fi
done

if [ "${APPLY_EXIT_CODE}" -ne 0 ]; then
    echo ""
    echo "❌ Failed to apply InferenceEndpointConfig"
    echo ""
    echo "   Error details:"
    echo "   ${APPLY_OUTPUT}"
    echo ""
    echo "   Common issues:"
    echo "   • Insufficient node capacity - check available GPU nodes"
    echo "   • Resource requests exceed node capacity"
    echo "   • RBAC permissions - ensure you have permission to create resources in namespace '${HP_NAMESPACE}'"
    echo "   • The amazon-sagemaker-hyperpod-inference operator is not installed"
    echo "     (run: mcc bootstrap add-module hyperpod-cluster)"
    echo "   • Invalid manifest syntax"
    echo ""
    echo "   Debug commands:"
    echo "   kubectl get nodes -o wide"
    echo "   kubectl describe nodes"
    echo "   kubectl get events -n ${HP_NAMESPACE}"
    _update_config "DEPLOYMENT_TARGET_HP_STATUS" "Failed"
    exit ${APPLY_EXIT_CODE}
fi

echo "✅ InferenceEndpointConfig applied"

# Record the InferenceEndpointConfig in the manifest (non-blocking)
./do/manifest add \
    --type k8s-inferenceendpointconfig \
    --id "${HP_NAMESPACE}/${PROJECT_NAME}" \
    --project "${PROJECT_NAME}" \
    --meta "{\"namespace\":\"${HP_NAMESPACE}\",\"resourceName\":\"${PROJECT_NAME}\",\"clusterName\":\"${HP_CLUSTER_NAME}\",\"region\":\"${AWS_REGION}\"}" \
    2>/dev/null || true

# ── Wait for operator reconciliation (AC-2, AC-3) ─────────────────────────────
# The amazon-sagemaker-hyperpod-inference operator reconciles the applied
# InferenceEndpointConfig: it creates the serving Deployment, Service, pods, and
# a SageMakerEndpointRegistration, then drives the CRD status.state through
# DeploymentPending → DeploymentInProgress → DeploymentComplete. We poll
# status.state (not the raw Deployment rollout) until DeploymentComplete, then
# confirm the SageMaker endpoint is InService.
#
# Max wait: 15 minutes (900s), overridable via DEPLOY_TIMEOUT.
DEPLOY_TIMEOUT=${DEPLOY_TIMEOUT:-900}
POLL_INTERVAL=15
ELAPSED=0
echo "⏳ Waiting for InferenceEndpointConfig to reconcile (timeout: ${DEPLOY_TIMEOUT}s)..."
echo "   This may take several minutes for GPU workloads..."
echo ""

CRD_STATE=""
while [ "${ELAPSED}" -lt "${DEPLOY_TIMEOUT}" ]; do
    CRD_STATE=$(kubectl get inferenceendpointconfig "${PROJECT_NAME}" \
        -n "${HP_NAMESPACE}" \
        -o jsonpath='{.status.state}' 2>/dev/null || echo "")

    case "${CRD_STATE}" in
        DeploymentComplete)
            echo "   ✅ $(date +%H:%M:%S) InferenceEndpointConfig state: DeploymentComplete"
            break
            ;;
        DeploymentFailed)
            echo ""
            echo "❌ InferenceEndpointConfig reported DeploymentFailed"
            echo ""
            echo "   Current pod state:"
            kubectl get pods -n "${HP_NAMESPACE}" -l app=${PROJECT_NAME} -o wide 2>/dev/null
            echo ""
            echo "   Debug commands:"
            echo "   kubectl describe inferenceendpointconfig ${PROJECT_NAME} -n ${HP_NAMESPACE}"
            echo "   kubectl describe pods -n ${HP_NAMESPACE} -l app=${PROJECT_NAME}"
            echo "   kubectl logs -n ${HP_NAMESPACE} -l app=${PROJECT_NAME} --tail=100"
            _update_config "DEPLOYMENT_TARGET_HP_STATUS" "Failed"
            exit 1
            ;;
        *)
            echo "   📊 $(date +%H:%M:%S) InferenceEndpointConfig state: ${CRD_STATE:-<pending>}"
            POD_STATUS=$(kubectl get pods -n "${HP_NAMESPACE}" -l app=${PROJECT_NAME} \
                --no-headers 2>/dev/null | head -5)
            if [ -n "${POD_STATUS}" ]; then
                echo "${POD_STATUS}" | while read -r line; do echo "      ${line}"; done
            fi
            ;;
    esac

    sleep "${POLL_INTERVAL}"
    ELAPSED=$((ELAPSED + POLL_INTERVAL))
done

if [ "${CRD_STATE}" != "DeploymentComplete" ]; then
    echo ""
    echo "❌ InferenceEndpointConfig did not reach DeploymentComplete within ${DEPLOY_TIMEOUT}s"
    echo "   Last observed state: ${CRD_STATE:-<none>}"
    echo ""
    echo "   Debug commands:"
    echo "   kubectl describe inferenceendpointconfig ${PROJECT_NAME} -n ${HP_NAMESPACE}"
    echo "   kubectl get pods -n ${HP_NAMESPACE} -l app=${PROJECT_NAME} -o wide"
    _update_config "DEPLOYMENT_TARGET_HP_STATUS" "Failed"
    exit 1
fi

# Endpoint ARN is surfaced on the CRD status once registered (informational).
ENDPOINT_ARN=$(kubectl get inferenceendpointconfig "${PROJECT_NAME}" \
    -n "${HP_NAMESPACE}" \
    -o jsonpath='{.status.endpoints.sagemaker.endpointArn}' 2>/dev/null || echo "")

# ── Poll the SageMaker endpoint until InService (AC-3) ────────────────────────
# ENDPOINT_NAME == metadata.name == PROJECT_NAME.
echo ""
echo "⏳ Waiting for SageMaker endpoint '${PROJECT_NAME}' to reach InService..."
ENDPOINT_STATUS=""
while [ "${ELAPSED}" -lt "${DEPLOY_TIMEOUT}" ]; do
    ENDPOINT_STATUS=$(aws sagemaker describe-endpoint \
        --endpoint-name "${PROJECT_NAME}" \
        --region "${AWS_REGION}" \
        --query 'EndpointStatus' \
        --output text 2>/dev/null || echo "")

    if [ "${ENDPOINT_STATUS}" = "InService" ]; then
        echo "   ✅ $(date +%H:%M:%S) Endpoint status: InService"
        break
    elif [ "${ENDPOINT_STATUS}" = "Failed" ]; then
        echo ""
        echo "❌ SageMaker endpoint '${PROJECT_NAME}' entered Failed state"
        echo "   aws sagemaker describe-endpoint --endpoint-name ${PROJECT_NAME} --region ${AWS_REGION}"
        _update_config "DEPLOYMENT_TARGET_HP_STATUS" "Failed"
        exit 1
    fi

    echo "   📊 $(date +%H:%M:%S) Endpoint status: ${ENDPOINT_STATUS:-<registering>}"
    sleep "${POLL_INTERVAL}"
    ELAPSED=$((ELAPSED + POLL_INTERVAL))
done

if [ "${ENDPOINT_STATUS}" != "InService" ]; then
    echo ""
    echo "❌ SageMaker endpoint '${PROJECT_NAME}' did not reach InService within ${DEPLOY_TIMEOUT}s"
    echo "   Last observed status: ${ENDPOINT_STATUS:-<none>}"
    _update_config "DEPLOYMENT_TARGET_HP_STATUS" "Failed"
    exit 1
fi

echo "✅ HyperPod EKS deployment complete!"

# ── Persist endpoint name for downstream workflows (AC-4) ─────────────────────
# do/benchmark, do/test, and do/register consume ENDPOINT_NAME from do/config.
_update_config "ENDPOINT_NAME" "${PROJECT_NAME}"
# BL101 R2: persist the normalized serving-config tokens so the benchmark
# query path (--compare-baseline) resolves the SAME Serving_Config_Key the
# write path used. Equality-based Athena matching requires `none` (not empty)
# for absent quantization and an integer tensor-parallel degree. Sourcing the
# canonical resolver produces those normalized tokens; wrap the persist so a
# failure here is non-fatal to the deploy.
if [ -f "${SCRIPT_DIR}/lib/resolve-serving-config.sh" ]; then
    # shellcheck disable=SC1091
    source "${SCRIPT_DIR}/lib/resolve-serving-config.sh" 2>/dev/null || true
    _update_config "VLLM_QUANTIZATION" "${SERVING_QUANTIZATION:-none}" 2>/dev/null || true
    _update_config "VLLM_TENSOR_PARALLEL_SIZE" "${SERVING_TENSOR_PARALLEL:-${HP_GPU_COUNT:-1}}" 2>/dev/null || true
fi
# Persist cluster name and namespace so do/clean and subsequent deploys don't
# require --reconfigure to re-run the interactive cluster picker prompts.
_update_config "HP_CLUSTER_NAME" "${HP_CLUSTER_NAME}"
_update_config "HP_NAMESPACE" "${HP_NAMESPACE}"

# ── Write per-target status (FR-4.2) — only after InService (AC-3) ────────────
_update_config "DEPLOYMENT_TARGET_HP_STATUS" "Running"
echo ""
echo "📋 Deployment Details:"
echo "   Cluster: ${HP_CLUSTER_NAME}"
echo "   Namespace: ${HP_NAMESPACE}"
echo "   Endpoint: ${PROJECT_NAME}"
<% if (true) { %>
echo "   Endpoint ARN: ${ENDPOINT_ARN:-<pending>}"
<% } %>
echo "   Replicas: ${HP_REPLICAS}"
echo "   Image: ${ECR_REPOSITORY}:${IMAGE_TAG}"
echo ""
echo "📋 What's next?"
echo "   • Test your deployment:       ./do/test"
echo "   • Check pod status:           kubectl get pods -n ${HP_NAMESPACE}"
echo "   • View pod logs:              kubectl logs -n ${HP_NAMESPACE} -l app=${PROJECT_NAME}"
<% if (typeof includeBenchmark !== 'undefined' && includeBenchmark) { %>
echo "   • Benchmark performance:      ./do/benchmark"
<% } %>
echo "   • Register this deployment:   ./do/register"
echo "   • View logs:                  ./do/logs"
echo "   • Clean up when done:         ./do/clean hyperpod"

# Write kubeconfig path to config so other scripts can use it (idempotent)
_update_config_var() {
    local var_name="$1" var_value="$2" config_file="${SCRIPT_DIR}/config"
    if grep -q "^export ${var_name}=" "${config_file}" 2>/dev/null; then
        sed -i.bak "s|^export ${var_name}=.*|export ${var_name}=\"${var_value}\"|" "${config_file}"
        rm -f "${config_file}.bak"
    else
        echo "" >> "${config_file}"
        echo "export ${var_name}=\"${var_value}\"" >> "${config_file}"
    fi
}

_update_config_var "KUBECONFIG" "${KUBECONFIG_PATH}"
