set -e
set -u
set -o pipefail

# ── Trap: write Failed status on non-zero exit (FR-4.2) ───────────
_mark_hp_failed() {
    if type _update_config &>/dev/null; then
        _update_config "DEPLOYMENT_TARGET_HP_STATUS" "Failed"
    fi
}
# Only trap on rollout failure — not on secondary resource errors (configmap, PVC, etc.)
# The status is written explicitly as Running/Failed after the rollout status check.
# trap '_mark_hp_failed' ERR  — disabled: was writing Failed on partial manifest errors

# Parse flags
FORCE_NEW=false
FORCE_IC=false
IC_TARGET=""
while [ $# -gt 0 ]; do
    case "$1" in
        --force) FORCE_NEW=true; shift ;;
        --force-ic)
            FORCE_IC=true
            shift
            ;;
        --help|-h)
            echo "Usage: ./do/deploy [--force] [--force-ic]"
            echo ""
            echo "Options:"
            echo "  --force      Create a new endpoint, even if one already exists."
            echo "  --force-ic   Recreate the inference component on the existing endpoint."
            echo ""
            echo "Without flags, deploy resumes from the last run."
            exit 0
            ;;
        *)
            echo "❌ Unknown option: $1"
            echo "   Run ./do/deploy --help for usage."
            exit 1
            ;;
    esac
done

# Configuration is already sourced by the do/deploy dispatcher.
# Resolve SCRIPT_DIR to do/ (parent of deploy.d/) for lib/ access.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "${SCRIPT_DIR}/lib/profile.sh"

# ── Profile-resolved variables (env var > profile > default) ──────────────────
export AWS_REGION="${AWS_REGION:-${_PROFILE_awsRegion:-us-east-1}}"
ECR_REPOSITORY_NAME="${ECR_REPOSITORY_NAME:-${_PROFILE_ecrRepositoryName:-ml-container-creator}}"

echo "🚀 Deploying to AWS"
echo "   Project: ${PROJECT_NAME}"
echo "   Deployment config: ${DEPLOYMENT_CONFIG}"
echo "   Region: ${AWS_REGION}"
echo "   Build target: ${BUILD_TARGET}"
echo "   Deployment target: ${DEPLOYMENT_TARGET}"
echo "   HyperPod cluster: ${HP_CLUSTER_NAME}"
echo "   Namespace: ${HP_NAMESPACE}"
echo "   Replicas: ${HP_REPLICAS}"

# Check AWS credentials
echo "🔍 Validating AWS credentials..."
if ! aws sts get-caller-identity &> /dev/null; then
    echo "❌ AWS credentials not configured"
    echo "   Run: aws configure"
    echo "   Or set AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY environment variables"
    exit 4
fi

AWS_ACCOUNT_ID=$(aws sts get-caller-identity --query Account --output text)
echo "✅ AWS credentials validated (Account: ${AWS_ACCOUNT_ID})"

# Construct ECR repository URL
ECR_REPOSITORY="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_REPOSITORY_NAME}"

# ============================================================
# Shared: Verify ECR image exists
# ============================================================
echo "🔍 Verifying ECR image exists..."
if ! aws ecr describe-images \
    --repository-name "${ECR_REPOSITORY_NAME}" \
    --image-ids imageTag="${PROJECT_NAME}-latest" \
    --region "${AWS_REGION}" &> /dev/null; then
    
    echo "❌ ECR image not found: ${ECR_REPOSITORY}:${PROJECT_NAME}-latest"
    echo ""
    echo "Please build and push your image first:"
    echo "  ./do/submit"
    echo ""
    echo "After the build completes successfully, run this deploy script again."
    exit 4
fi

echo "✅ ECR image found: ${ECR_REPOSITORY}:${PROJECT_NAME}-latest"
IMAGE_TAG="${PROJECT_NAME}-latest"

# ============================================================
# Shared: Resolve secrets for container environment
# ============================================================
CONTAINER_ENV_JSON=""

# BL076: fall back to profile secrets when ARN is not explicitly set in do/config
HF_TOKEN_ARN="${HF_TOKEN_ARN:-${_PROFILE_secrets_hfToken:-}}"
if [ -n "${HF_TOKEN_ARN:-}" ]; then
    echo "🔐 Resolving HuggingFace token from Secrets Manager..."
    RESOLVED_HF_TOKEN=$(aws secretsmanager get-secret-value --secret-id "${HF_TOKEN_ARN}" --query SecretString --output text --region "${AWS_REGION}") || {
        echo "❌ Failed to resolve HuggingFace token from Secrets Manager"
        exit 3
    }
    CONTAINER_ENV_JSON="\"HF_TOKEN\":\"${RESOLVED_HF_TOKEN}\""
elif [ -n "${HF_TOKEN:-}" ]; then
    CONTAINER_ENV_JSON="\"HF_TOKEN\":\"${HF_TOKEN}\""
fi

if [ -n "${NGC_API_KEY_ARN:-}" ]; then
    echo "🔐 Resolving NGC API key from Secrets Manager..."
    RESOLVED_NGC_KEY=$(aws secretsmanager get-secret-value --secret-id "${NGC_API_KEY_ARN}" --query SecretString --output text --region "${AWS_REGION}") || {
        echo "❌ Failed to resolve NGC API key from Secrets Manager"
        exit 3
    }
    if [ -n "${CONTAINER_ENV_JSON}" ]; then
        CONTAINER_ENV_JSON="${CONTAINER_ENV_JSON},\"NGC_API_KEY\":\"${RESOLVED_NGC_KEY}\""
    else
        CONTAINER_ENV_JSON="\"NGC_API_KEY\":\"${RESOLVED_NGC_KEY}\""
    fi
elif [ -n "${NGC_API_KEY:-}" ]; then
    if [ -n "${CONTAINER_ENV_JSON}" ]; then
        CONTAINER_ENV_JSON="${CONTAINER_ENV_JSON},\"NGC_API_KEY\":\"${NGC_API_KEY}\""
    else
        CONTAINER_ENV_JSON="\"NGC_API_KEY\":\"${NGC_API_KEY}\""
    fi
fi

# ============================================================
# HyperPod EKS Deployment
# ============================================================

# Get kubeconfig for HyperPod cluster
echo "🔑 Configuring kubectl for HyperPod cluster..."
KUBECONFIG_PATH="${HOME}/.kube/hyperpod-${HP_CLUSTER_NAME}"

# Step 1: Describe the HyperPod cluster to get the underlying EKS cluster ARN
EKS_CLUSTER_ARN=$(aws sagemaker describe-cluster \
    --cluster-name "${HP_CLUSTER_NAME}" \
    --region "${AWS_REGION}" \
    --query "Orchestrator.Eks.ClusterArn" \
    --output text 2>&1) || {
    echo "❌ Failed to describe HyperPod cluster: ${HP_CLUSTER_NAME}"
    echo ""
    echo "   Error details:"
    echo "   ${EKS_CLUSTER_ARN}"
    echo ""
    echo "   Check that:"
    echo "   • The cluster name is correct"
    echo "   • The cluster exists in region: ${AWS_REGION}"
    echo "   • Your IAM user/role has permission to access the cluster"
    echo ""
    echo "   Required IAM permissions:"
    echo "   • sagemaker:DescribeCluster"
    echo "   • eks:DescribeCluster"
    exit 4
}

# Step 2: Extract the EKS cluster name from the ARN
EKS_CLUSTER_NAME=$(echo "${EKS_CLUSTER_ARN}" | awk -F'/' '{print $NF}')
echo "   HyperPod cluster: ${HP_CLUSTER_NAME}"
echo "   EKS cluster: ${EKS_CLUSTER_NAME}"

# Step 3: Update kubeconfig using the EKS cluster
if ! aws eks update-kubeconfig \
    --name "${EKS_CLUSTER_NAME}" \
    --region "${AWS_REGION}" \
    --kubeconfig "${KUBECONFIG_PATH}" 2>&1; then
    echo "❌ Failed to configure kubectl for EKS cluster: ${EKS_CLUSTER_NAME}"
    echo ""
    echo "   Required IAM permissions:"
    echo "   • eks:DescribeCluster"
    echo "   • eks:AccessKubernetesApi"
    exit 4
fi

export KUBECONFIG="${KUBECONFIG_PATH}"
echo "✅ Kubeconfig saved to: ${KUBECONFIG_PATH}"

# Verify cluster connectivity
echo "🔍 Verifying cluster connectivity..."
if ! kubectl cluster-info &> /dev/null; then
    echo "❌ Cannot connect to HyperPod cluster"
    echo ""
    echo "   Check that:"
    echo "   • The cluster is in 'InService' status"
    echo "   • Your network can reach the cluster API server"
    echo "   • Your IAM credentials are valid"
    exit 4
fi
echo "✅ Connected to HyperPod cluster"

# Create namespace if it doesn't exist
echo "📁 Ensuring namespace exists: ${HP_NAMESPACE}"

# ── K8s Secret: HuggingFace token ──────────────────────────────────────────
# Create/update the 'hf-token' K8s Secret in the target namespace so the
# cluster can authenticate against HuggingFace for any operation that needs it
# (model pull at startup, tokenizer fetch for do/benchmark, etc.).
#
# Resolution order:
#   1. RESOLVED_HF_TOKEN resolved above (from Secrets Manager or HF_TOKEN env)
#   2. Neither → skip with warning
#
# Note: token is needed even when STAGED_MODEL_PATH is set — advanced operations
# like do/benchmark fetch the tokenizer from HuggingFace for gated models.
#
# The InferenceEndpointConfig references this Secret via
# spec.modelSourceConfig.huggingFaceModel.tokenSecretRef (name: hf-token-secret,
# key: token) for the Hugging Face model source. The token is only consumed
# during the operator's model download and is not exposed to the container.
# ─────────────────────────────────────────────────────────────────────────────

if [ -n "${RESOLVED_HF_TOKEN:-}" ]; then
    echo "🔑 Creating K8s Secret 'hf-token-secret' in namespace '${HP_NAMESPACE}'..."
    kubectl create secret generic hf-token-secret \
        --from-literal=token="${RESOLVED_HF_TOKEN}" \
        --namespace "${HP_NAMESPACE}" \
        --dry-run=client -o yaml | kubectl apply -f - 2>&1 || {
        echo "⚠️  Warning: Could not create hf-token-secret (will continue)"
        echo "   The pod may fail to pull gated models — set HF_TOKEN_ARN in do/config"
    }
    echo "✅ HuggingFace token secret ready"
else
    echo "   ⚠️  No HuggingFace token configured"
    echo "   Set HF_TOKEN_ARN in do/config or run: mcc bootstrap add-secret hfToken <arn>"
    echo "   (Continuing — token only required for gated HuggingFace models)"
fi

echo "📁 Ensuring namespace exists: ${HP_NAMESPACE}"
if ! kubectl create namespace "${HP_NAMESPACE}" --dry-run=client -o yaml | kubectl apply -f - 2>&1; then
    echo "⚠️  Warning: Could not create/verify namespace"
fi

# Apply the InferenceEndpointConfig custom resource
echo "📄 Rendering InferenceEndpointConfig from hyperpod/..."

# Substitute shell variables (e.g. ${AWS_ACCOUNT_ID}) in manifests before applying
export AWS_ACCOUNT_ID
export ECR_IMAGE="${ECR_REPOSITORY}:${IMAGE_TAG}"

# Export VLLM_ENABLE_LORA for envsubst — allows HP_LORA_ENABLED in do/config
# to dynamically control LoRA at deploy time without regeneration (BL065)
if [ "${HP_LORA_ENABLED:-false}" = "true" ]; then
    export VLLM_ENABLE_LORA="true"
else
    export VLLM_ENABLE_LORA=""
fi

# Instance type for the CRD: prefer explicit HP override, else the configured
# node selector, else INSTANCE_TYPE from do/config.
export HP_INSTANCE_TYPE="${HP_INSTANCE_TYPE:-${HP_NODE_SELECTOR:-${INSTANCE_TYPE:-}}}"

# Portable envsubst shim — works on macOS without gettext installed
# Falls back to perl (always available on macOS/Linux) if envsubst is not found
if ! command -v envsubst &>/dev/null; then
    envsubst() { perl -pe 's/\$\{([^}]+)\}/defined $ENV{$1} ? $ENV{$1} : "\${$1}"/ge'; }
fi

# ── Build spec.modelSourceConfig ──────────────────────────────────────────────
# When the model has been staged to S3 (STAGED_MODEL_PATH in do/config), use the
# S3 source. The CRD requires bucketName + region SEPARATELY (not a full s3://
# URI), so parse STAGED_MODEL_PATH (s3://<bucket>/<prefix>/) into its parts.
# modelLocation carries the key prefix within the bucket. Otherwise fall back to
# the Hugging Face source using MODEL_NAME and the hf-token-secret Secret.
build_model_source_config() {
    if [ -n "${STAGED_MODEL_PATH:-}" ]; then
        # Strip the s3:// scheme, then split into bucket (first path segment) and
        # prefix (the remainder, trailing slash removed).
        local no_scheme="${STAGED_MODEL_PATH#s3://}"
        local bucket="${no_scheme%%/*}"
        local prefix=""
        if [[ "${no_scheme}" == */* ]]; then
            prefix="${no_scheme#*/}"
            prefix="${prefix%/}"
        fi
        export HP_MODEL_SOURCE="s3"
        cat <<EOF
modelSourceType: s3
s3Storage:
  bucketName: ${bucket}
  region: ${AWS_REGION}
modelLocation: ${prefix}
prefetchEnabled: true
EOF
    else
        export HP_MODEL_SOURCE="huggingface"
        export HP_HF_MODEL_ID="${MODEL_NAME}"
        if [ -n "${RESOLVED_HF_TOKEN:-}" ]; then
            cat <<EOF
modelSourceType: huggingface
prefetchEnabled: true
huggingFaceModel:
  modelId: "${MODEL_NAME}"
  tokenSecretRef:
    name: hf-token-secret
    key: token
EOF
        else
            cat <<EOF
modelSourceType: huggingface
prefetchEnabled: true
huggingFaceModel:
  modelId: "${MODEL_NAME}"
EOF
        fi
    fi
}

MODEL_SOURCE_CONFIG="$(build_model_source_config)"
# Re-export HP_MODEL_SOURCE in parent shell — the subshell export inside
# build_model_source_config() does not propagate to this scope, but envsubst
# needs it to expand $HP_MODEL_SOURCE in the CRD manifest.
if [ -n "${STAGED_MODEL_PATH:-}" ]; then
    export HP_MODEL_SOURCE="s3"
else
    export HP_MODEL_SOURCE="huggingface"
fi

APPLY_OUTPUT=""
APPLY_EXIT_CODE=0
for manifest in hyperpod/*.yaml; do
    # envsubst first (expands ${ECR_IMAGE}, ${HP_INSTANCE_TYPE}, ${HP_*} defaults),
    # then splice the multi-line modelSourceConfig block in place of the marker,
    # preserving the marker line's indentation for every replacement line so the
    # rendered YAML stays well-formed.
    RENDERED=$(envsubst < "${manifest}")
    RENDERED=$(MODEL_SOURCE_CONFIG="${MODEL_SOURCE_CONFIG}" printf '%s' "${RENDERED}" | \
        MODEL_SOURCE_CONFIG="${MODEL_SOURCE_CONFIG}" python3 -c '
import os, sys
repl = os.environ.get("MODEL_SOURCE_CONFIG", "")
marker = "__MODEL_SOURCE_CONFIG__"
out = []
for line in sys.stdin.read().splitlines():
    pos = line.find(marker)
    if pos >= 0:
        indent = line[:pos]
        for rl in repl.splitlines():
            out.append(indent + rl)
    else:
        out.append(line)
sys.stdout.write("\n".join(out) + "\n")
')
    if echo "${RENDERED}" | grep -q '^kind:'; then
        FILE_OUTPUT=$(echo "${RENDERED}" | kubectl apply -n "${HP_NAMESPACE}" -f - 2>&1) || {
            APPLY_EXIT_CODE=$?
        }
        APPLY_OUTPUT="${APPLY_OUTPUT}${FILE_OUTPUT}\n"
    fi
done

if [ "${APPLY_EXIT_CODE}" -ne 0 ]; then
    echo ""
    echo "❌ Failed to apply InferenceEndpointConfig"
    echo ""
    echo "   Error details:"
    echo "   ${APPLY_OUTPUT}"
    echo ""
    echo "   Common issues:"
    echo "   • Insufficient node capacity - check available GPU nodes"
    echo "   • Resource requests exceed node capacity"
    echo "   • RBAC permissions - ensure you have permission to create resources in namespace '${HP_NAMESPACE}'"
    echo "   • The amazon-sagemaker-hyperpod-inference operator is not installed"
    echo "     (run: mcc bootstrap add-module hyperpod-cluster)"
    echo "   • Invalid manifest syntax"
    echo ""
    echo "   Debug commands:"
    echo "   kubectl get nodes -o wide"
    echo "   kubectl describe nodes"
    echo "   kubectl get events -n ${HP_NAMESPACE}"
    _update_config "DEPLOYMENT_TARGET_HP_STATUS" "Failed"
    exit ${APPLY_EXIT_CODE}
fi

echo "✅ InferenceEndpointConfig applied"

# Record the InferenceEndpointConfig in the manifest (non-blocking)
./do/manifest add \
    --type k8s-inferenceendpointconfig \
    --id "${HP_NAMESPACE}/${PROJECT_NAME}" \
    --project "${PROJECT_NAME}" \
    --meta "{\"namespace\":\"${HP_NAMESPACE}\",\"resourceName\":\"${PROJECT_NAME}\",\"clusterName\":\"${HP_CLUSTER_NAME}\",\"region\":\"${AWS_REGION}\"}" \
    2>/dev/null || true

# ── Wait for operator reconciliation (AC-2, AC-3) ─────────────────────────────
# The amazon-sagemaker-hyperpod-inference operator reconciles the applied
# InferenceEndpointConfig: it creates the serving Deployment, Service, pods, and
# a SageMakerEndpointRegistration, then drives the CRD status.state through
# DeploymentPending → DeploymentInProgress → DeploymentComplete. We poll
# status.state (not the raw Deployment rollout) until DeploymentComplete, then
# confirm the SageMaker endpoint is InService.
#
# Max wait: 15 minutes (900s), overridable via DEPLOY_TIMEOUT.
DEPLOY_TIMEOUT=${DEPLOY_TIMEOUT:-900}
POLL_INTERVAL=15
ELAPSED=0
echo "⏳ Waiting for InferenceEndpointConfig to reconcile (timeout: ${DEPLOY_TIMEOUT}s)..."
echo "   This may take several minutes for GPU workloads..."
echo ""

CRD_STATE=""
while [ "${ELAPSED}" -lt "${DEPLOY_TIMEOUT}" ]; do
    CRD_STATE=$(kubectl get inferenceendpointconfig "${PROJECT_NAME}" \
        -n "${HP_NAMESPACE}" \
        -o jsonpath='{.status.state}' 2>/dev/null || echo "")

    case "${CRD_STATE}" in
        DeploymentComplete)
            echo "   ✅ $(date +%H:%M:%S) InferenceEndpointConfig state: DeploymentComplete"
            break
            ;;
        DeploymentFailed)
            echo ""
            echo "❌ InferenceEndpointConfig reported DeploymentFailed"
            echo ""
            echo "   Current pod state:"
            kubectl get pods -n "${HP_NAMESPACE}" -l app=${PROJECT_NAME} -o wide 2>/dev/null
            echo ""
            echo "   Debug commands:"
            echo "   kubectl describe inferenceendpointconfig ${PROJECT_NAME} -n ${HP_NAMESPACE}"
            echo "   kubectl describe pods -n ${HP_NAMESPACE} -l app=${PROJECT_NAME}"
            echo "   kubectl logs -n ${HP_NAMESPACE} -l app=${PROJECT_NAME} --tail=100"
            _update_config "DEPLOYMENT_TARGET_HP_STATUS" "Failed"
            exit 1
            ;;
        *)
            echo "   📊 $(date +%H:%M:%S) InferenceEndpointConfig state: ${CRD_STATE:-<pending>}"
            POD_STATUS=$(kubectl get pods -n "${HP_NAMESPACE}" -l app=${PROJECT_NAME} \
                --no-headers 2>/dev/null | head -5)
            if [ -n "${POD_STATUS}" ]; then
                echo "${POD_STATUS}" | while read -r line; do echo "      ${line}"; done
            fi
            ;;
    esac

    sleep "${POLL_INTERVAL}"
    ELAPSED=$((ELAPSED + POLL_INTERVAL))
done

if [ "${CRD_STATE}" != "DeploymentComplete" ]; then
    echo ""
    echo "❌ InferenceEndpointConfig did not reach DeploymentComplete within ${DEPLOY_TIMEOUT}s"
    echo "   Last observed state: ${CRD_STATE:-<none>}"
    echo ""
    echo "   Debug commands:"
    echo "   kubectl describe inferenceendpointconfig ${PROJECT_NAME} -n ${HP_NAMESPACE}"
    echo "   kubectl get pods -n ${HP_NAMESPACE} -l app=${PROJECT_NAME} -o wide"
    _update_config "DEPLOYMENT_TARGET_HP_STATUS" "Failed"
    exit 1
fi

# Endpoint ARN is surfaced on the CRD status once registered (informational).
ENDPOINT_ARN=$(kubectl get inferenceendpointconfig "${PROJECT_NAME}" \
    -n "${HP_NAMESPACE}" \
    -o jsonpath='{.status.endpoints.sagemaker.endpointArn}' 2>/dev/null || echo "")

# ── Poll the SageMaker endpoint until InService (AC-3) ────────────────────────
# ENDPOINT_NAME == metadata.name == PROJECT_NAME.
echo ""
echo "⏳ Waiting for SageMaker endpoint '${PROJECT_NAME}' to reach InService..."
ENDPOINT_STATUS=""
while [ "${ELAPSED}" -lt "${DEPLOY_TIMEOUT}" ]; do
    ENDPOINT_STATUS=$(aws sagemaker describe-endpoint \
        --endpoint-name "${PROJECT_NAME}" \
        --region "${AWS_REGION}" \
        --query 'EndpointStatus' \
        --output text 2>/dev/null || echo "")

    if [ "${ENDPOINT_STATUS}" = "InService" ]; then
        echo "   ✅ $(date +%H:%M:%S) Endpoint status: InService"
        break
    elif [ "${ENDPOINT_STATUS}" = "Failed" ]; then
        echo ""
        echo "❌ SageMaker endpoint '${PROJECT_NAME}' entered Failed state"
        echo "   aws sagemaker describe-endpoint --endpoint-name ${PROJECT_NAME} --region ${AWS_REGION}"
        _update_config "DEPLOYMENT_TARGET_HP_STATUS" "Failed"
        exit 1
    fi

    echo "   📊 $(date +%H:%M:%S) Endpoint status: ${ENDPOINT_STATUS:-<registering>}"
    sleep "${POLL_INTERVAL}"
    ELAPSED=$((ELAPSED + POLL_INTERVAL))
done

if [ "${ENDPOINT_STATUS}" != "InService" ]; then
    echo ""
    echo "❌ SageMaker endpoint '${PROJECT_NAME}' did not reach InService within ${DEPLOY_TIMEOUT}s"
    echo "   Last observed status: ${ENDPOINT_STATUS:-<none>}"
    _update_config "DEPLOYMENT_TARGET_HP_STATUS" "Failed"
    exit 1
fi

echo "✅ HyperPod EKS deployment complete!"

# ── Persist endpoint name for downstream workflows (AC-4) ─────────────────────
# do/benchmark, do/test, and do/register consume ENDPOINT_NAME from do/config.
_update_config "ENDPOINT_NAME" "${PROJECT_NAME}"
# Persist cluster name and namespace so do/clean and subsequent deploys don't
# require --reconfigure to re-run the interactive cluster picker prompts.
_update_config "HP_CLUSTER_NAME" "${HP_CLUSTER_NAME}"
_update_config "HP_NAMESPACE" "${HP_NAMESPACE}"

# ── Write per-target status (FR-4.2) — only after InService (AC-3) ────────────
_update_config "DEPLOYMENT_TARGET_HP_STATUS" "Running"
echo ""
echo "📋 Deployment Details:"
echo "   Cluster: ${HP_CLUSTER_NAME}"
echo "   Namespace: ${HP_NAMESPACE}"
echo "   Endpoint: ${PROJECT_NAME}"
<% if (true) { %>
echo "   Endpoint ARN: ${ENDPOINT_ARN:-<pending>}"
<% } %>
echo "   Replicas: ${HP_REPLICAS}"
echo "   Image: ${ECR_REPOSITORY}:${IMAGE_TAG}"
echo ""
echo "📋 What's next?"
echo "   • Test your deployment:       ./do/test"
echo "   • Check pod status:           kubectl get pods -n ${HP_NAMESPACE}"
echo "   • View pod logs:              kubectl logs -n ${HP_NAMESPACE} -l app=${PROJECT_NAME}"
<% if (typeof includeBenchmark !== 'undefined' && includeBenchmark) { %>
echo "   • Benchmark performance:      ./do/benchmark"
<% } %>
echo "   • Register this deployment:   ./do/register"
echo "   • View logs:                  ./do/logs"
echo "   • Clean up when done:         ./do/clean hyperpod"

# Write kubeconfig path to config so other scripts can use it (idempotent)
_update_config_var() {
    local var_name="$1" var_value="$2" config_file="${SCRIPT_DIR}/config"
    if grep -q "^export ${var_name}=" "${config_file}" 2>/dev/null; then
        sed -i.bak "s|^export ${var_name}=.*|export ${var_name}=\"${var_value}\"|" "${config_file}"
        rm -f "${config_file}.bak"
    else
        echo "" >> "${config_file}"
        echo "export ${var_name}=\"${var_value}\"" >> "${config_file}"
    fi
}

_update_config_var "KUBECONFIG" "${KUBECONFIG_PATH}"
