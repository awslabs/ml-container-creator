#
# do/export — Export the CURRENT do/config as a generator --config object, the
# equivalent CLI command, or a Jupyter notebook.
#
# Reads do/config at RUNTIME (edits made after generation are exported). The data
# work lives in do/lib/python/export_config.py, which maps do/config vars to schema
# parameters through do/lib/python/export_map.json (generated from
# config/parameter-schema-v2.json `doConfigVar`) — there is no per-target table here.
# A --target flag overrides DEPLOYMENT_TARGET for a single run, mirroring
# do/deploy --target.
#
# @mlcc-script
# type: model-centric
# guard: none
# lifecycle: metadata
# targets: all

# Usage: ./do/export [--json | --notebook] [--target <target>]

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

_export_usage() {
    cat <<'EOF'
Usage: ./do/export [--json | --notebook] [--target <target>]

Export this project's CURRENT configuration (do/config, read at run time).

Modes:
  (default)          Print the ml-container-creator command that reproduces the
                     project (shell-quoted, built from the same data as --json).
  --json             Print the canonical generator --config object: schema
                     parameter keys (e.g. region, hyperpodCluster, asyncMaxConcurrent),
                     typed values. Save it and run:
                       ml-container-creator --config=<file> --skip-prompts
  --notebook         Generate a Jupyter deployment notebook (unchanged; not part
                     of the --config round-trip guarantee).

Options:
  --target <target>  Export for this deployment target instead of DEPLOYMENT_TARGET
                     (aliases such as realtime / hyperpod / async / batch accepted).
  -h, --help         Show this help.

What is exported:
  Only parameters that apply to the effective target and differ from their
  schema default. Secrets (HF_TOKEN, NGC_API_KEY) are written as $VAR references,
  never values. Runtime-owned vars (deploy status, endpoint names, speculative
  decoding, benchmark job state) and derived vars are not exported.
  Upgrade note: --json keys are the --config parameter names since Wave 8
  (previously awsRegion, hyperPodCluster, asyncMaxConcurrentInvocations,
  endpointConfig/icConfig/modelEnvVars/serverEnvVars, ...).
EOF
}

# ── Parse flags ───────────────────────────────────────────────────────────────
MODE="cli"
FLAG_TARGET=""
while [ $# -gt 0 ]; do
    case "$1" in
        -h|--help)
            _export_usage
            exit 0
            ;;
        --json|--notebook)
            _want="${1#--}"
            if [ "${MODE}" != "cli" ] && [ "${MODE}" != "${_want}" ]; then
                echo "Error: --notebook and --json are mutually exclusive" >&2
                exit 1
            fi
            MODE="${_want}"
            shift
            ;;
        --target)
            shift
            if [ $# -eq 0 ]; then
            # >>> GENERATED: target-list (scripts/codegen-target-guard.js; ADR-008) — DO NOT EDIT
                echo "Error: --target requires a value (realtime-inference, async-inference, batch-transform, hyperpod-eks, eks)" >&2
            # <<< END GENERATED target-list
                exit 1
            fi
            FLAG_TARGET="$1"
            shift
            ;;
        --target=*)
            FLAG_TARGET="${1#--target=}"
            shift
            ;;
        *)
            echo "Error: unknown option '$1'" >&2
            _export_usage >&2
            exit 1
            ;;
    esac
done

# Source configuration at run time. The summary banner is suppressed so stdout
# carries only the export (script-contract.sh sources do/config too).
export _MLCC_CONFIG_PRINTED=1
source "${SCRIPT_DIR}/lib/script-contract.sh"
source "${SCRIPT_DIR}/config" > /dev/null 2>&1

# ── Notebook output mode (unchanged) ──────────────────────────────────────────
if [ "${MODE}" = "notebook" ]; then
    _require_python_env
    python3 "${SCRIPT_DIR}/../deploy_notebook_generator.py"
    exit $?
fi

# Effective target: --target flag wins, else DEPLOYMENT_TARGET from do/config,
# else realtime-inference. Aliases are resolved by the helper from targets.d.
EFFECTIVE_TARGET="${FLAG_TARGET:-${DEPLOYMENT_TARGET:-realtime-inference}}"

# The helper is stdlib-only, so --json / CLI mode need no project venv. All
# do/config values are passed through the environment (do/config was sourced).
_export_format="cli"
[ "${MODE}" = "json" ] && _export_format="json"
python3 "${SCRIPT_DIR}/lib/python/export_config.py" \
    --format "${_export_format}" \
    --target "${EFFECTIVE_TARGET}" \
    --config "${SCRIPT_DIR}/config"
exit $?
