#
# do/optimize — Run SageMaker AI Inference Recommendations.
#
# @mlcc-script
# type: deployment-centric
# guard: deployment-active
# lifecycle: post-deploy
# targets: realtime-inference, hyperpod-eks

# Wraps CreateAIRecommendationJob / DescribeAIRecommendationJob.

set -e
set -u
set -o pipefail

# ── Source project configuration ──────────────────────────────────────────────
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${SCRIPT_DIR}/lib/script-contract.sh"
_require_python_env
source "${SCRIPT_DIR}/config"
source "${SCRIPT_DIR}/lib/wait.sh"

# ── Target guard: AI Recommendations requires a real-time IC endpoint ─────────
# Note: hyperpod-eks IS supported — CreateAIRecommendationJob uses --model-source
# (S3 URI from STAGED_MODEL_PATH), not a live endpoint. No SageMakerEndpointRegistration
# required. Blocked targets are async-inference and batch-transform only.
if [ "${DEPLOYMENT_TARGET:-}" = "async-inference" ] || [ "${DEPLOYMENT_TARGET:-}" = "batch-transform" ]; then
    echo "❌ do/optimize (AI Recommendations) is not supported on ${DEPLOYMENT_TARGET}."
    echo "   AI Recommendations requires a real-time or HyperPod EKS deployment."
    echo ""
    echo "   For config recommendations without a live endpoint, use:"
    echo "   ./do/benchmark --recommend"
    exit 1
fi

# ── Parse flags ───────────────────────────────────────────────────────────────
GOAL=""
INSTANCES_ARG=""
DATASET_URI=""
FORCE=false
APPLY_ARN=""
LIST_ONLY=false
while [ $# -gt 0 ]; do
    case "$1" in
        --goal) shift; GOAL="${1:-}"; shift ;;
        --instances) shift; INSTANCES_ARG="${1:-}"; shift ;;
        --dataset-uri) shift; DATASET_URI="${1:-}"; shift ;;
        --force) FORCE=true; shift ;;
        --apply) shift; APPLY_ARN="${1:-}"; shift ;;
        --list) LIST_ONLY=true; shift ;;
        --help|-h)
            echo "Usage: ./do/optimize --goal <cost|latency|throughput> [--instances type1,type2] [--dataset-uri s3://...] [--force]"
            echo "       ./do/optimize --list"
            echo "       ./do/optimize --apply <package-arn|top>"
            echo ""
            echo "Run SageMaker AI Inference Recommendations to find optimal instance types"
            echo "and model configurations for your workload."
            echo ""
            echo "Options:"
            echo "  --goal <goal>       (Required for new jobs) Optimization goal: cost, latency, or throughput"
            echo "  --instances <list>  Comma-separated instance types to evaluate (max 3)"
            echo "  --dataset-uri <s3>  JSONL dataset for throughput speculator training"
            echo "                      Supports ShareGPT, OpenAI Chat Completions, and OpenAI Completions records"
            echo "  --force             Create a new recommendation job even if one exists"
            echo "  --list              Display results from the last completed recommendation job"
            echo "  --apply <arn|top>   Apply a recommendation to do/config"
            echo "                      Speculative details map to HP_SPECULATIVE_MODEL,"
            echo "                      HP_SPECULATIVE_NUM_TOKENS, and HP_SPECULATIVE_ALGORITHM"
            echo "                      Use 'top' to apply the #1 result from the last job"
            echo ""
            echo "Examples:"
            echo "  ./do/optimize --goal throughput"
            echo "  ./do/optimize --goal throughput --dataset-uri s3://my-bucket/calibration.jsonl"
            echo "  ./do/optimize --goal cost --instances ml.g6e.48xlarge,ml.p5.48xlarge"
            echo "  ./do/optimize --goal latency --force"
            echo ""
            echo "Idempotency:"
            echo "  If OPTIMIZE_JOB_NAME is set in do/config and the job is still running,"
            echo "  re-running without --force will resume waiting for the existing job."
            echo ""
            echo "Prerequisites:"
            echo "  • MODEL_NAME must be set in do/config (HuggingFace model ID or S3 path)"
            echo "  • AWS credentials must be configured"
            echo ""
            echo "After completion, an interactive menu lets you apply results to do/config."
            echo ""
            echo "For Athena-backed config recommendations (no live API needed), use:"
            echo "  ./do/benchmark --recommend"
            exit 0
            ;;
        *) shift ;;
    esac
done

# ── Validate goal (required for new jobs) ─────────────────────────────────────
if [ -z "${GOAL}" ] && [ -z "${APPLY_ARN}" ]; then
    echo "❌ --goal is required"
    echo ""
    echo "   Usage: ./do/optimize --goal <cost|latency|throughput>"
    echo ""
    echo "   For Athena-backed config recommendations (no live API needed), use:"
    echo "   ./do/benchmark --recommend"
    exit 1
fi

case "${GOAL}" in
    ""|cost|latency|throughput) ;;
    *)
        echo "❌ Invalid goal: ${GOAL}"
        echo "   Valid goals: cost, latency, throughput"
        exit 1
        ;;
esac

if [ -n "${DATASET_URI}" ] && [ "${GOAL}" != "throughput" ]; then
    echo "❌ --dataset-uri is supported only with --goal throughput"
    exit 1
fi
if [ -n "${DATASET_URI}" ] && [[ "${DATASET_URI}" != s3://* ]]; then
    echo "❌ --dataset-uri must be an s3:// URI"
    exit 1
fi

# ── Verify AWS CLI v2 ─────────────────────────────────────────────────────────
if ! aws --version 2>&1 | grep -q "aws-cli/2"; then
    echo "❌ AWS CLI v2 is required for inference recommendations."
    echo "   Detected: $(aws --version 2>&1 | head -1)"
    echo ""
    echo "   Install CLI v2: https://docs.aws.amazon.com/cli/latest/userguide/getting-started-install.html"
    exit 1
fi

# ── Resolve model name ────────────────────────────────────────────────────────
if [ -z "${MODEL_NAME:-}" ] && [ -z "${APPLY_ARN}" ]; then
    echo "❌ MODEL_NAME is not set in do/config"
    echo "   Set MODEL_NAME to a HuggingFace model ID or S3 model path."
    exit 1
fi

echo "🔍 Inference Recommendations"
echo "   Project: ${PROJECT_NAME}"
echo "   Model: ${MODEL_NAME:-}"
echo "   Goal: ${GOAL}"

# ── Resolve instance types ────────────────────────────────────────────────────
# Applying an existing recommendation does not need a new workload instance list.
if [ -z "${APPLY_ARN}" ]; then
# Priority: --instances flag > INSTANCE_POOLS > INSTANCE_TYPE
INSTANCE_TYPES=""

if [ -n "${INSTANCES_ARG}" ]; then
    # From --instances flag (comma-separated)
    INSTANCE_TYPES="${INSTANCES_ARG}"
    echo "   Instances (from --instances): ${INSTANCE_TYPES}"
elif [ -n "${INSTANCE_POOLS:-}" ]; then
    # Extract instance types from INSTANCE_POOLS JSON
    INSTANCE_TYPES=$(echo "${INSTANCE_POOLS}" | grep -oE '"InstanceType"\s*:\s*"[^"]+"' | sed 's/"InstanceType"\s*:\s*"//;s/"$//' | paste -sd ',' - || true)
    echo "   Instances (from INSTANCE_POOLS): ${INSTANCE_TYPES}"
elif [ -n "${INSTANCE_TYPE:-}" ]; then
    INSTANCE_TYPES="${INSTANCE_TYPE}"
    echo "   Instances (from INSTANCE_TYPE): ${INSTANCE_TYPES}"
elif [ "${ENDPOINT_EXTERNAL:-}" = "true" ] && [ -n "${ENDPOINT_NAME:-}" ]; then
    # External endpoint — query the live endpoint config for instance type
    echo "   Discovering instance type from external endpoint: ${ENDPOINT_NAME}"
    ENDPOINT_CONFIG_NAME=$(aws sagemaker describe-endpoint \
        --endpoint-name "${ENDPOINT_NAME}" \
        --region "${AWS_REGION}" \
        --query 'EndpointConfigName' \
        --output text 2>/dev/null) || ENDPOINT_CONFIG_NAME=""

    if [ -n "${ENDPOINT_CONFIG_NAME}" ]; then
        INSTANCE_TYPES=$(aws sagemaker describe-endpoint-config \
            --endpoint-config-name "${ENDPOINT_CONFIG_NAME}" \
            --region "${AWS_REGION}" \
            --query 'ProductionVariants[0].InstanceType' \
            --output text 2>/dev/null) || INSTANCE_TYPES=""
    fi

    if [ -n "${INSTANCE_TYPES}" ] && [ "${INSTANCE_TYPES}" != "None" ]; then
        echo "   Instances (from endpoint): ${INSTANCE_TYPES}"
    else
        echo "❌ Could not discover instance type from endpoint: ${ENDPOINT_NAME}"
        echo "   Provide --instances flag, or set INSTANCE_TYPE in do/config."
        exit 1
    fi
else
    echo "❌ No instance types available."
    echo "   Provide --instances flag, or set INSTANCE_POOLS or INSTANCE_TYPE in do/config."
    exit 1
fi
fi  # end apply-only instance-resolution guard

# ── Resolve workload parameters from benchmark config (if available) ──────────
CONCURRENCY="${BENCHMARK_CONCURRENCY:-1}"
INPUT_TOKENS="${BENCHMARK_INPUT_TOKENS_MEAN:-256}"
OUTPUT_TOKENS="${BENCHMARK_OUTPUT_TOKENS_MEAN:-256}"

echo "   Concurrency: ${CONCURRENCY}"
echo "   Input tokens: ${INPUT_TOKENS}"
echo "   Output tokens: ${OUTPUT_TOKENS}"
echo ""

# ── Helper: update a variable in do/config ────────────────────────────────────
_update_optimize_var() {
    local variable_name="$1"
    local variable_value="$2"

    python3 - "${SCRIPT_DIR}/config" "${variable_name}" "${variable_value}" <<'PY'
import os
import re
import sys
import tempfile

path, name, value = sys.argv[1:]
escaped_value = value.replace('\\', '\\\\').replace('"', '\\"').replace('$', '\\$').replace('`', '\\`')
new_line = f'export {name}="{escaped_value}"'
with open(path) as source:
    content = source.read()
pattern = re.compile(rf'^export {re.escape(name)}=.*$', re.MULTILINE)
if pattern.search(content):
    content = pattern.sub(new_line, content)
else:
    if not content.endswith('\n'):
        content += '\n'
    content += new_line + '\n'
directory = os.path.dirname(path)
with tempfile.NamedTemporaryFile('w', dir=directory, delete=False) as temporary:
    temporary.write(content)
    temporary_path = temporary.name
os.replace(temporary_path, path)
PY
}

# ── Apply a recommendation to do/config ──────────────────────────────────────
_apply_recommendation() {
    local recommendation_json="$1"
    local apply_values

    apply_values=$(printf '%s' "${recommendation_json}" | python3 -c '
import json
import re
import sys

rec = json.load(sys.stdin)
model_details = rec.get("ModelDetails", {})


def text(value):
    return str(value or "").replace("\t", " ").replace("\n", " ")


def draft_model_id(value):
    """Prefer a HF model ID (org/name) embedded in a URL/ARN; otherwise keep the value."""
    value = text(value)
    match = re.search(r"huggingface\.co/([^/?#\s]+/[^/?#\s]+)", value)
    if match:
        return match.group(1)
    return value

speculative = None
for detail in rec.get("OptimizationDetails") or []:
    config = detail.get("SpeculativeDecodingConfig")
    if isinstance(config, dict):
        name = text(detail.get("OptimizationName", "")).lower()
        if "eagle3" in name:
            algorithm = "eagle3"
        elif "eagle" in name:
            algorithm = "eagle"
        elif "draft-model" in name or "draft_model" in name:
            algorithm = "draft-model"
        else:
            algorithm = "draft-model"
        speculative = (
            draft_model_id(config.get("DraftModelArn")),
            text(config.get("NumSpeculativeTokens")),
            algorithm,
        )
        break

instances = model_details.get("InstanceDetails") or []
instance_type = instances[0].get("InstanceType", "") if instances else ""
values = [
    text(model_details.get("ModelPackageArn", "")),
    text(model_details.get("InferenceSpecificationName", "")),
    text(instance_type),
]
if speculative:
    values.extend([*speculative, "true"])
else:
    values.extend(["", "", "", "false"])
print("\t".join(values))
') || {
        echo "❌ Failed to parse recommendation details"
        return 1
    }

    local model_package_arn inference_spec instance_type
    local speculative_model speculative_tokens speculative_algorithm has_speculative
    IFS=$'\t' read -r model_package_arn inference_spec instance_type speculative_model speculative_tokens speculative_algorithm has_speculative <<< "${apply_values}"

    if [ -n "${model_package_arn}" ]; then
        _update_optimize_var "OPTIMIZE_MODEL_PACKAGE_ARN" "${model_package_arn}"
        echo "   ✅ OPTIMIZE_MODEL_PACKAGE_ARN set in do/config"
    fi
    if [ -n "${inference_spec}" ]; then
        _update_optimize_var "OPTIMIZE_INFERENCE_SPEC" "${inference_spec}"
        echo "   ✅ OPTIMIZE_INFERENCE_SPEC set in do/config"
    fi
    if [ -n "${instance_type}" ]; then
        _update_optimize_var "INSTANCE_TYPE" "${instance_type}"
        echo "   ✅ INSTANCE_TYPE updated to: ${instance_type}"
    fi
    if [ "${has_speculative}" = "true" ]; then
        if [ -n "${speculative_model}" ]; then
            _update_optimize_var "HP_SPECULATIVE_MODEL" "${speculative_model}"
        fi
        if [ -n "${speculative_tokens}" ]; then
            _update_optimize_var "HP_SPECULATIVE_NUM_TOKENS" "${speculative_tokens}"
        fi
        _update_optimize_var "HP_SPECULATIVE_ALGORITHM" "${speculative_algorithm}"
        echo "   ✅ Speculative decoding applied: ${speculative_algorithm} (${speculative_tokens} tokens)"
    fi
}

# --apply is intentionally independent of --goal: it uses the last completed job.
if [ -n "${APPLY_ARN}" ]; then
    if [ -z "${OPTIMIZE_JOB_NAME:-}" ]; then
        echo "❌ OPTIMIZE_JOB_NAME is not set in do/config"
        echo "   Run ./do/optimize --goal <goal> first."
        exit 1
    fi

    JOB_DESCRIPTION=$(aws sagemaker describe-ai-recommendation-job \
        --ai-recommendation-job-name "${OPTIMIZE_JOB_NAME}" \
        --region "${AWS_REGION}" \
        --output json 2>/dev/null) || {
        echo "❌ Failed to fetch recommendation results for: ${OPTIMIZE_JOB_NAME}"
        exit 1
    }

    SELECTED_RECOMMENDATION=$(printf '%s' "${JOB_DESCRIPTION}" | python3 -c '
import json
import sys

requested = sys.argv[1]
data = json.load(sys.stdin)
results = data.get("Recommendations") or []
if requested == "top":
    if results:
        print(json.dumps(results[0]))
    sys.exit(0)

for rec in results:
    details = rec.get("ModelDetails", {})
    identifiers = (
        rec.get("RecommendationArn"),
        rec.get("ModelPackageArn"),
        details.get("ModelPackageArn"),
    )
    if requested in identifiers:
        print(json.dumps(rec))
        break
' "${APPLY_ARN}") || {
        echo "❌ Failed to resolve recommendation: ${APPLY_ARN}"
        exit 1
    }

    if [ -z "${SELECTED_RECOMMENDATION}" ]; then
        echo "❌ Recommendation not found: ${APPLY_ARN}"
        exit 1
    fi

    echo "📦 Applying recommendation: ${APPLY_ARN}"
    _apply_recommendation "${SELECTED_RECOMMENDATION}"
    echo "✅ Recommendation applied to do/config"
    exit 0
fi

# ── Idempotency: Check for existing recommendation job ────────────────────────
RESUME_EXISTING=false

if [ "${FORCE}" = false ] && [ -n "${OPTIMIZE_JOB_NAME:-}" ]; then
    EXISTING_STATUS=$(aws sagemaker describe-ai-recommendation-job \
        --ai-recommendation-job-name "${OPTIMIZE_JOB_NAME}" \
        --region "${AWS_REGION}" \
        --query 'AIRecommendationJobStatus' \
        --output text 2>/dev/null) || EXISTING_STATUS=""

    case "${EXISTING_STATUS}" in
        IN_PROGRESS|PENDING|STARTING)
            echo "📊 Resuming existing recommendation job: ${OPTIMIZE_JOB_NAME}"
            echo "   Status: ${EXISTING_STATUS}"
            echo "   (use --force to start a new job instead)"
            echo ""
            RESUME_EXISTING=true
            ;;
        COMPLETED)
            echo "📊 Previous recommendation job already completed: ${OPTIMIZE_JOB_NAME}"
            echo "   (use --force to start a new job)"
            echo ""
            RESUME_EXISTING=true
            JOB_STATUS="COMPLETED"
            ;;
        FAILED|STOPPED)
            FAILURE_REASON=$(aws sagemaker describe-ai-recommendation-job \
                --ai-recommendation-job-name "${OPTIMIZE_JOB_NAME}" \
                --region "${AWS_REGION}" \
                --query 'FailureReason' \
                --output text 2>/dev/null) || FAILURE_REASON="unknown"
            echo "⚠️  Previous recommendation job ${EXISTING_STATUS}: ${OPTIMIZE_JOB_NAME}"
            if [ -n "${FAILURE_REASON}" ] && [ "${FAILURE_REASON}" != "None" ]; then
                echo "   Reason: ${FAILURE_REASON}"
            fi
            echo "   Use --force to start a new job."
            exit 1
            ;;
        *)
            # Job doesn't exist or can't be described — proceed with new job
            ;;
    esac
fi

# ── Create recommendation job ─────────────────────────────────────────────────
if [ "${RESUME_EXISTING}" = false ]; then
    OPTIMIZE_JOB_NAME="${PROJECT_NAME}-optimize-$(date +%Y%m%d-%H%M%S)"
    WORKLOAD_CONFIG_NAME="${OPTIMIZE_JOB_NAME}-workload"

    echo "🚀 Creating AI Recommendation Job: ${OPTIMIZE_JOB_NAME}"

    # Step 1: Create workload config
    echo "   Creating workload config: ${WORKLOAD_CONFIG_NAME}"

    WORKLOAD_SPEC_INNER="{\"benchmark\": {\"type\": \"aiperf\"}, \"parameters\": {\"prompt_input_tokens_mean\": ${INPUT_TOKENS}, \"prompt_input_tokens_stddev\": 150, \"output_tokens_mean\": ${OUTPUT_TOKENS}, \"output_tokens_stddev\": 50, \"concurrency\": ${CONCURRENCY}, \"streaming\": true}}"
    WORKLOAD_SPEC_OUTER="{\"WorkloadSpec\": {\"Inline\": $(python3 -c "import json; print(json.dumps('${WORKLOAD_SPEC_INNER}'))")}}"

    WORKLOAD_CONFIG_CMD=(
        aws sagemaker create-ai-workload-config
        --ai-workload-config-name "${WORKLOAD_CONFIG_NAME}"
        --ai-workload-configs "${WORKLOAD_SPEC_OUTER}"
        --region "${AWS_REGION}"
    )
    if [ -n "${DATASET_URI}" ]; then
        DATASET_CONFIG=$(python3 -c '
import json
import sys
print(json.dumps({"InputDataConfig": [{"ChannelName": "dataset", "DataSource": {"S3DataSource": {"S3Uri": sys.argv[1]}}}]}))
' "${DATASET_URI}")
        WORKLOAD_CONFIG_CMD+=(--dataset-config "${DATASET_CONFIG}")
        echo "   Dataset: ${DATASET_URI}"
    fi

    if ! "${WORKLOAD_CONFIG_CMD[@]}" 2>&1 | grep -q "AIWorkloadConfigArn"; then
        echo "❌ Failed to create workload config: ${WORKLOAD_CONFIG_NAME}"
        echo "   Check that the execution role has sagemaker:CreateAIWorkloadConfig permission."
        # Show actual error
        "${WORKLOAD_CONFIG_CMD[@]}" 2>&1 || true
        exit 1
    fi
    echo "   ✅ Workload config created"

    # Step 2: Build compute spec (instance types, max 3)
    COMPUTE_SPEC_JSON=""
    IFS=',' read -ra TYPES <<< "${INSTANCE_TYPES}"
    INSTANCE_LIST=""
    COUNT=0
    for itype in "${TYPES[@]}"; do
        itype=$(echo "${itype}" | xargs)  # trim whitespace
        if [ ${COUNT} -ge 3 ]; then
            echo "   ⚠️  Max 3 instance types supported — truncating"
            break
        fi
        if [ -n "${INSTANCE_LIST}" ]; then
            INSTANCE_LIST="${INSTANCE_LIST},\"${itype}\""
        else
            INSTANCE_LIST="\"${itype}\""
        fi
        COUNT=$((COUNT + 1))
    done
    COMPUTE_SPEC_JSON="InstanceTypes=[${INSTANCE_LIST}]"

    # Step 3: Map goal to performance target metric
    case "${GOAL}" in
        latency) PERF_METRIC="ttft-ms" ;;
        throughput) PERF_METRIC="throughput" ;;
        cost) PERF_METRIC="cost" ;;
    esac

    # The cost metric does not allow ComputeSpec.InstanceTypes — SageMaker selects instances.
    if [ "${PERF_METRIC}" = "cost" ]; then
        COMPUTE_SPEC_JSON=""
    fi

    # Step 4: Determine model source
    # Resolution order:
    #   1. STAGED_MODEL_PATH (s3://) — set by do/stage; points to flat model files on S3
    #   2. MODEL_NAME if s3:// URI — explicit SageMaker model artifact path
    #   3. Otherwise — fail with guidance to use do/benchmark --recommend
    # Note: S3Uri must point to a directory with model files (config.json + weights).
    # Raw HF cache trees (.cache/huggingface/) are rejected; flat uploads are valid.
    MODEL_SOURCE_ARG=""
    _MODEL_S3_URI="${STAGED_MODEL_PATH:-${MODEL_NAME:-}}"
    if [[ "${_MODEL_S3_URI}" == s3://* ]]; then
        MODEL_SOURCE_ARG="S3={S3Uri=${_MODEL_S3_URI}}"
    else
        echo "❌ do/optimize requires an S3 model artifact."
        echo "   MODEL_NAME='${MODEL_NAME:-}' is a HuggingFace model ID, not an S3 path."
        echo "   STAGED_MODEL_PATH is also not set."
        echo ""
        echo "   Options:"
        echo "   1. Run './do/stage' first to upload model weights to S3, then retry"
        echo "   2. Use './do/benchmark --recommend' for config recommendations (no S3 artifact needed)"
        exit 1
    fi
    # Step 5: Create the recommendation job
    S3_OUTPUT="s3://${TUNE_S3_BUCKET:-mlcc-tune-$(aws sts get-caller-identity --query Account --output text 2>/dev/null)-${AWS_REGION}}/${PROJECT_NAME}/optimize/"

    RECOMMEND_CMD=(
        aws sagemaker create-ai-recommendation-job
        --ai-recommendation-job-name "${OPTIMIZE_JOB_NAME}"
        --model-source "${MODEL_SOURCE_ARG}"
        --output-config "S3OutputLocation=${S3_OUTPUT}"
        --ai-workload-config-identifier "${WORKLOAD_CONFIG_NAME}"
        --performance-target "Constraints=[{Metric=${PERF_METRIC}}]"
        --role-arn "${ROLE_ARN:-}"
        --inference-specification "Framework=VLLM"
        --region "${AWS_REGION}"
    )
    # Throughput optimization needs a DatasetConfig to train a speculator. Without
    # one, preserve the existing recommendation-only behavior.
    if [ "${PERF_METRIC}" = "throughput" ] && [ -z "${DATASET_URI}" ]; then
        RECOMMEND_CMD+=(--no-optimize-model)
    fi

    if [ -n "${COMPUTE_SPEC_JSON}" ]; then
        RECOMMEND_CMD+=(--compute-spec "${COMPUTE_SPEC_JSON}")
    fi
    if ! "${RECOMMEND_CMD[@]}" 2>&1; then
        echo ""
        echo "❌ Failed to create AI Recommendation Job"
        echo "   Check that:"
        echo "   • The execution role has sagemaker:CreateAIRecommendationJob permission"
        echo "   • The model name or S3 path is valid: ${MODEL_NAME}"
        echo "   • The instance types are valid: ${INSTANCE_TYPES}"
        echo "   • The API is available in region: ${AWS_REGION}"
        exit 1
    fi

    echo "✅ Recommendation job created: ${OPTIMIZE_JOB_NAME}"

    # Save job name to do/config for idempotency on re-run
    _update_optimize_var "OPTIMIZE_JOB_NAME" "${OPTIMIZE_JOB_NAME}"
    echo ""
fi

# ── Poll for completion ───────────────────────────────────────────────────────
POLL_INTERVAL=30
MAX_POLL_ATTEMPTS=120  # 60 minutes max (120 * 30s)

if [ "${JOB_STATUS:-}" != "COMPLETED" ] && [ "${JOB_STATUS:-}" != "FAILED" ] && [ "${JOB_STATUS:-}" != "STOPPED" ] && [ "${JOB_STATUS:-}" != "Completed" ] && [ "${JOB_STATUS:-}" != "Failed" ] && [ "${JOB_STATUS:-}" != "Stopped" ]; then

echo "⏳ Waiting for recommendation job to complete..."
echo "   Polling every ${POLL_INTERVAL}s (max ${MAX_POLL_ATTEMPTS} attempts = 60 min)"
echo ""

POLL_COUNT=0
JOB_STATUS=""

while [ ${POLL_COUNT} -lt ${MAX_POLL_ATTEMPTS} ]; do
    JOB_STATUS=$(aws sagemaker describe-ai-recommendation-job \
        --ai-recommendation-job-name "${OPTIMIZE_JOB_NAME}" \
        --region "${AWS_REGION}" \
        --query 'AIRecommendationJobStatus' \
        --output text 2>/dev/null) || {
        echo "⚠️  Failed to describe recommendation job (credentials may have expired)"
        echo "   Re-run to check status:"
        echo "   aws sagemaker describe-ai-recommendation-job --ai-recommendation-job-name ${OPTIMIZE_JOB_NAME} --region ${AWS_REGION}"
        exit 1
    }

    case "${JOB_STATUS}" in
        COMPLETED|Completed)
            echo "✅ Recommendation job completed!"
            JOB_STATUS="COMPLETED"
            break
            ;;
        FAILED|Failed)
            echo "❌ Recommendation job failed"
            JOB_STATUS="FAILED"
            break
            ;;
        STOPPED|Stopped)
            echo "⚠️  Recommendation job was stopped"
            JOB_STATUS="STOPPED"
            break
            ;;
        *)
            POLL_COUNT=$((POLL_COUNT + 1))
            ELAPSED=$((POLL_COUNT * POLL_INTERVAL))
            echo "   $(date +%H:%M:%S) Status: ${JOB_STATUS} (${ELAPSED}s elapsed)"
            sleep ${POLL_INTERVAL}
            ;;
    esac
done

if [ ${POLL_COUNT} -ge ${MAX_POLL_ATTEMPTS} ]; then
    echo ""
    echo "⚠️  Recommendation job timed out after 60 minutes (status: ${JOB_STATUS})"
    echo "   The job may still be running. Re-run ./do/optimize to resume waiting."
    exit 1
fi

fi  # end of polling conditional

echo ""

# ── Display results ───────────────────────────────────────────────────────────
if [ "${JOB_STATUS}" = "COMPLETED" ]; then
    echo "📊 Fetching recommendation results..."

    # Get the full job description with results
    JOB_DESCRIPTION=$(aws sagemaker describe-ai-recommendation-job \
        --ai-recommendation-job-name "${OPTIMIZE_JOB_NAME}" \
        --region "${AWS_REGION}" \
        --output json 2>/dev/null) || {
        echo "❌ Failed to fetch recommendation results"
        exit 1
    }

    # Display results using python for JSON parsing
    if command -v python3 &>/dev/null; then
        echo "${JOB_DESCRIPTION}" | python3 -c "
import json, sys

data = json.load(sys.stdin)
results = data.get('Recommendations', [])

if not results:
    print('   No recommendations returned.')
    sys.exit(0)

print('╔══════════════════════════════════════════════════════════════════════════╗')
print('║              SageMaker AI Inference Recommendations                     ║')
print('╠══════════════════════════════════════════════════════════════════════════╣')
print(f'║  Job: ${OPTIMIZE_JOB_NAME}')
print(f'║  Goal: ${GOAL}')
print(f'║  Model: ${MODEL_NAME}')
print('╠══════════════════════════════════════════════════════════════════════════╣')

for i, rec in enumerate(results, 1):
    model_details = rec.get('ModelDetails', {})
    instance_details = model_details.get('InstanceDetails', [{}])
    instance_type = instance_details[0].get('InstanceType', 'N/A') if instance_details else 'N/A'
    instance_count = instance_details[0].get('InstanceCount', 1) if instance_details else 1
    spec_name = model_details.get('InferenceSpecificationName', 'N/A')
    model_package_arn = model_details.get('ModelPackageArn', 'N/A')
    optimizations = rec.get('OptimizationDetails', [])

    rank_marker = ' ← TOP' if i == 1 else ''
    print(f'║')
    print(f'║  #{i}{rank_marker}')
    print(f'║  Instance:  {instance_type} × {instance_count}')
    print(f'║  Spec:      {spec_name}')
    if model_package_arn and model_package_arn != 'N/A':
        print(f'║  Package:   {model_package_arn}')
    if optimizations:
        opt_names = ', '.join([o.get('OptimizationName', o.get('Type', str(o))) for o in optimizations])
        print('║  Opts:      ' + opt_names)

print('║')
print('╚══════════════════════════════════════════════════════════════════════════╝')
"
    else
        echo "   (python3 not available — showing raw JSON)"
        echo "${JOB_DESCRIPTION}" | head -100
    fi

    echo ""

    # ── Interactive choices ───────────────────────────────────────────────────
    RESULTS_FILE="${SCRIPT_DIR}/.optimize-results.json"

    # Save Recommendations array to RESULTS_FILE for the interactive menu
    echo "${JOB_DESCRIPTION}" | python3 -c "
import json, sys
data = json.load(sys.stdin)
results = data.get('Recommendations', [])
with open('${RESULTS_FILE}', 'w') as f:
    json.dump(results, f)
" 2>/dev/null || true

    if [ -f "${RESULTS_FILE}" ]; then
        echo "What would you like to do with these results?"
        echo ""
        echo "  1) Deploy now — apply top recommendation and run do/deploy"
        echo "  2) Save for later — store ModelPackageArn in do/config"
        echo ""
        printf "Choose [1/2]: "
        read -r CHOICE
        CHOICE="${CHOICE%%$'\r'}"  # strip CR (Windows/terminal safety)

        case "${CHOICE}" in
            1)
                echo ""
                echo "📦 Deploying top recommendation..."
                TOP_MODEL_PACKAGE_ARN=$(python3 -c "
import json
with open('${RESULTS_FILE}') as f:
    results = json.load(f)
if results:
    md = results[0].get('ModelDetails', {})
    print(md.get('ModelPackageArn', ''))
" 2>/dev/null) || TOP_MODEL_PACKAGE_ARN=""

                TOP_INFERENCE_SPEC=$(python3 -c "
import json
with open('${RESULTS_FILE}') as f:
    results = json.load(f)
if results:
    md = results[0].get('ModelDetails', {})
    print(md.get('InferenceSpecificationName', ''))
" 2>/dev/null) || TOP_INFERENCE_SPEC=""

                TOP_INSTANCE_TYPE=$(python3 -c "
import json
with open('${RESULTS_FILE}') as f:
    results = json.load(f)
if results:
    inst = results[0].get('ModelDetails', {}).get('InstanceDetails', [{}])
    print(inst[0].get('InstanceType', '') if inst else '')
" 2>/dev/null) || TOP_INSTANCE_TYPE=""

                if [ -n "${TOP_MODEL_PACKAGE_ARN}" ]; then
                    _update_optimize_var "OPTIMIZE_MODEL_PACKAGE_ARN" "${TOP_MODEL_PACKAGE_ARN}"
                    echo "   ✅ OPTIMIZE_MODEL_PACKAGE_ARN set in do/config"
                fi
                if [ -n "${TOP_INFERENCE_SPEC}" ]; then
                    _update_optimize_var "OPTIMIZE_INFERENCE_SPEC" "${TOP_INFERENCE_SPEC}"
                    echo "   ✅ OPTIMIZE_INFERENCE_SPEC set in do/config"
                fi
                if [ -n "${TOP_INSTANCE_TYPE}" ]; then
                    _update_optimize_var "INSTANCE_TYPE" "${TOP_INSTANCE_TYPE}"
                    echo "   ✅ INSTANCE_TYPE updated to: ${TOP_INSTANCE_TYPE}"
                fi
                echo ""
                echo "✅ Top recommendation applied to do/config"
                echo ""
                echo "🚀 Deploying with optimized configuration..."
                # Re-source do/config so the just-written OPTIMIZE_MODEL_PACKAGE_ARN
                # (and OPTIMIZE_INFERENCE_SPEC / INSTANCE_TYPE) are visible in this
                # shell before calling do/deploy. _update_optimize_var only writes
                # to the file; without re-sourcing, the values set above would not
                # propagate to the deploy invocation's environment.
                source "${SCRIPT_DIR}/config"
                "${SCRIPT_DIR}/deploy" --target "${DEPLOYMENT_TARGET:-realtime-inference}"
                ;;
            2)

                echo ""
                echo "📦 Saving results for later..."
                SAVE_MODEL_PACKAGE_ARN=$(python3 -c "
import json
with open('${RESULTS_FILE}') as f:
    results = json.load(f)
if results:
    md = results[0].get('ModelDetails', {})
    print(md.get('ModelPackageArn', ''))
" 2>/dev/null) || SAVE_MODEL_PACKAGE_ARN=""

                if [ -n "${SAVE_MODEL_PACKAGE_ARN}" ]; then
                    _update_optimize_var "OPTIMIZE_MODEL_PACKAGE_ARN" "${SAVE_MODEL_PACKAGE_ARN}"
                fi
                echo ""
                echo "✅ Results saved to do/config:"
                echo ""
                echo "   OPTIMIZE_MODEL_PACKAGE_ARN=${SAVE_MODEL_PACKAGE_ARN}"
                echo "   OPTIMIZE_JOB_NAME=${OPTIMIZE_JOB_NAME}"
                echo ""
                echo "To apply this recommendation later, run either:"
                echo "   ./do/optimize --apply top      # apply top result from this job"
                echo "   ./do/optimize --apply ${SAVE_MODEL_PACKAGE_ARN}"
                ;;
            *)
                echo "   No action taken. Run: ./do/optimize --apply top  to apply the top result later."
                ;;
        esac

        # Clean up temp results file
        rm -f "${RESULTS_FILE}"
    fi

elif [ "${JOB_STATUS}" = "FAILED" ]; then
    FAILURE_REASON=$(echo "${JOB_DESCRIPTION:-}" | python3 -c "
import json, sys
try:
    data = json.load(sys.stdin)
    print(data.get('FailureReason', 'unknown'))
except:
    print('unknown')
" 2>/dev/null) || FAILURE_REASON="unknown"

    if [ "${FAILURE_REASON}" = "unknown" ]; then
        FAILURE_REASON=$(aws sagemaker describe-ai-recommendation-job \
            --ai-recommendation-job-name "${OPTIMIZE_JOB_NAME}" \
            --region "${AWS_REGION}" \
            --query 'FailureReason' \
            --output text 2>/dev/null) || FAILURE_REASON="unknown"
    fi

    echo "❌ Recommendation job failed"
    echo "   Reason: ${FAILURE_REASON}"
    echo ""
    echo "   Debug:"
    echo "   aws sagemaker describe-ai-recommendation-job --ai-recommendation-job-name ${OPTIMIZE_JOB_NAME} --region ${AWS_REGION}"

elif [ "${JOB_STATUS}" = "STOPPED" ]; then
    echo "⚠️  Recommendation job was stopped before completion"
    echo "   No results available."
fi

echo ""
echo "📋 Summary:"
echo "   Recommendation Job: ${OPTIMIZE_JOB_NAME}"
echo "   Status:             ${JOB_STATUS}"
echo "   Goal:               ${GOAL}"
echo ""
