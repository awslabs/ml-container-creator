    echo "                      registered."
    echo "  --hf-id <org/name>  HuggingFace dataset ID. Staged to the canonical location via"
    echo "                      the same stage-hf Processing Job used by do/tune, then"
    echo "                      registered."
    echo ""
    echo "  Shared options:"
    echo "  <name>              Dataset name (required, positional)"
