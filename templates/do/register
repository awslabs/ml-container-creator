    echo "  --column-map <map>  (--hf-id only) Rename columns (e.g., prompt=question,completion=answer)"
    echo "  --force             Overwrite / register a new version even if already registered"
    echo ""
    echo "  Dataset management (no source required):"
    echo "  --list [--source local|remote|all]"
    echo "                           List registered datasets (default: all). --json for scripting."
    echo "  --list-versions <name>   List all registered versions of a dataset from the S3"
    echo "                           sidecar (human-readable; add --json for scripting)."
    echo "  --discover <org/name>    Browse a HuggingFace dataset (splits, files, row counts,"
    echo "                           schema preview) and print a recommended register command."
    echo "                           Add --hf-split to focus a split; --json for raw output."
    echo "  --delete <name> [@v<N>]  Remove a dataset's registry entry (whole sidecar, or a"
