<% } %>
<% if (icMemorySize != null) { %>
    "memorySize": ${IC_MEMORY_SIZE}<%= (icGpuCount != null || icCopyCount != null || icModelWeight != null) ? ',' : '' %>
<% } %>
<% if (icGpuCount != null) { %>
