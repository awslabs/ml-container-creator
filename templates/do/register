# ============================================================
# Handle --benchmark-status mode (Stage 2 failure isolation)
# This mode ONLY writes benchmark fields to DynamoDB.
# It uses an UpdateExpression that sets ONLY:
#   lastBenchmarkRunId, lastBenchmarkTimestamp, lastBenchmarkStatus
# It does NOT touch testStatus, configJson, or any other fields.
# This ensures Stage 2 failure does not change the CI gate result.
# Requirements: 1.4, 7.3
# ============================================================

if [ -n "${BENCHMARK_STATUS}" ]; then
    # Validate benchmark status
    case "${BENCHMARK_STATUS}" in
        completed|failed|in-progress) ;;
        *)
            echo "❌ Invalid benchmark status: ${BENCHMARK_STATUS}"
            echo "   Valid values: completed, failed, in-progress"
            exit 1
            ;;
    esac

    if [ -z "${BENCHMARK_RUN_ID}" ]; then
        echo "❌ --benchmark-run-id is required when using --benchmark-status"
        exit 1
    fi

    # Compute configId (same hash logic used by write_ci_record below)
    _benchmark_input="${DEPLOYMENT_CONFIG}:${MODEL_NAME:-none}:${INSTANCE_TYPE}:${AWS_REGION}:${DEPLOYMENT_TARGET}:ic${IC_COUNT:-1}:adapt${ADAPTER_COUNT:-0}"
    if command -v sha256sum &> /dev/null; then
        CONFIG_ID=$(echo -n "$_benchmark_input" | sha256sum | cut -c1-16)
    else
        CONFIG_ID=$(echo -n "$_benchmark_input" | shasum -a 256 | cut -c1-16)
    fi
    BENCHMARK_TIMESTAMP=$(date -u +%Y-%m-%dT%H:%M:%SZ)

    echo "📊 Recording benchmark status for configId: ${CONFIG_ID}"
    echo "   Benchmark run ID:  ${BENCHMARK_RUN_ID}"
    echo "   Benchmark status:  ${BENCHMARK_STATUS}"
    echo "   Timestamp:         ${BENCHMARK_TIMESTAMP}"
    echo ""

    # Check if CI_Table exists
    if ! aws dynamodb describe-table --table-name "${CI_TABLE_NAME}" --region "${AWS_REGION}" &>/dev/null; then
        echo "⚠️  CI infrastructure not provisioned. Run 'ml-container-creator bootstrap' with CI enabled."
        echo "   Skipping benchmark status write."
        exit 0
    fi

    # UpdateExpression ONLY sets the 3 benchmark fields.
    # This is a SET operation — it does NOT overwrite the entire record (PutItem).
    # testStatus, configJson, and all other fields remain unchanged.
    if aws dynamodb update-item \
        --region "${AWS_REGION}" \
        --table-name "${CI_TABLE_NAME}" \
        --key "{\"configId\": {\"S\": \"${CONFIG_ID}\"}}" \
        --update-expression "SET lastBenchmarkRunId = :rid, lastBenchmarkTimestamp = :ts, lastBenchmarkStatus = :bs" \
        --expression-attribute-values "{
            \":rid\": {\"S\": \"${BENCHMARK_RUN_ID}\"},
            \":ts\": {\"S\": \"${BENCHMARK_TIMESTAMP}\"},
            \":bs\": {\"S\": \"${BENCHMARK_STATUS}\"}
        }" 2>/dev/null; then
        echo "✅ Benchmark status recorded: ${BENCHMARK_STATUS}"
    else
        echo "❌ Failed to write benchmark status for configId: ${CONFIG_ID}"
        exit 1
    fi

    exit 0
fi

# ============================================================
# Handle dataset mode — move a dataset to the canonical MLCC
# datasets location and register the resulting URI.
#
#   Canonical destination: s3://<CORE_BUCKET>/datasets/<name>/
#
# Input source is exactly one of:
#   --s3-uri <s3://...>  Copy an existing S3 dataset (cp for a single object,
#                        sync for a directory/prefix).
#   --hf-id <org/name>   Stage a HuggingFace dataset via the stage-hf Processing
#                        Job (same mechanism as do/tune --dataset hf://org/name).
# ============================================================

if [ "${SUBCOMMAND}" = "dataset" ]; then
    if [ -z "${DATASET_NAME}" ]; then
        echo "❌ Dataset name is required"
        echo "   Usage: ./do/register dataset <name> (--s3-uri <s3://...> | --hf-id <org/name>)"
        exit 1
    fi

    # Exactly one of --s3-uri / --hf-id must be provided.
    if [ -n "${DATASET_S3_URI}" ] && [ -n "${DATASET_HF_ID}" ]; then
        echo "❌ --s3-uri and --hf-id are mutually exclusive — provide only one"
        exit 1
    fi
    if [ -z "${DATASET_S3_URI}" ] && [ -z "${DATASET_HF_ID}" ]; then
        echo "❌ Provide a dataset source: --s3-uri <s3://...> or --hf-id <org/name>"
        echo "   Usage: ./do/register dataset <name> (--s3-uri <s3://...> | --hf-id <org/name>)"
        exit 1
    fi

    # Validate technique
    case "${DATASET_TECHNIQUE}" in
        sft|dpo|rlaif|rlvr) ;;
        *)
            echo "❌ Invalid technique: ${DATASET_TECHNIQUE}"
            echo "   Valid values: sft, dpo, rlaif, rlvr"
            exit 1
            ;;
    esac

    # Resolve CORE_BUCKET (mlcc-core) — required for the canonical location.
    if [ -z "${CORE_BUCKET}" ]; then
        echo "❌ No mlcc-core bucket recorded in profile (codebuildSourceS3Bucket is empty)."
        echo "   Run 'ml-container-creator bootstrap' to provision the mlcc-core bucket,"
        echo "   or set CORE_BUCKET explicitly."
        exit 1
    fi

    # Canonical destination for this dataset.
    CANONICAL_S3_URI="s3://${CORE_BUCKET}/datasets/${DATASET_NAME}/"

    echo "📋 Registering dataset: ${DATASET_NAME}"
    echo "   Destination: ${CANONICAL_S3_URI}"
    echo "   Technique:   ${DATASET_TECHNIQUE}"
    echo ""

    # ── Resolve the canonical URI depending on the input source ───────────────
    REGISTERED_S3_URI=""
    RESOLVED_ROW_COUNT="${DATASET_ROW_COUNT}"

    if [ -n "${DATASET_S3_URI}" ]; then
        # ── S3 source: copy to the canonical location ────────────────────────
        if [[ "${DATASET_S3_URI}" != s3://* ]]; then
            echo "❌ --s3-uri must be an s3:// URI (got: ${DATASET_S3_URI})"
            exit 1
        fi

        echo "📦 Copying S3 dataset to canonical location"
        echo "   Source: ${DATASET_S3_URI}"
        echo "   Target: ${CANONICAL_S3_URI}"

        # Decide cp vs sync: a trailing slash (or no object suffix) denotes a
        # directory/prefix, which requires 'aws s3 sync'; a single object uses 'cp'.
        if [[ "${DATASET_S3_URI}" == */ ]]; then
            _s3_cmd=(aws s3 sync "${DATASET_S3_URI}" "${CANONICAL_S3_URI}")
        else
            _s3_cmd=(aws s3 cp "${DATASET_S3_URI}" "${CANONICAL_S3_URI}")
        fi
        [ -n "${AWS_REGION:-}" ] && _s3_cmd+=(--region "${AWS_REGION}")

        if ! "${_s3_cmd[@]}"; then
            echo "❌ Failed to copy dataset to ${CANONICAL_S3_URI}"
            exit 1
        fi
        echo "   ✅ Copied to ${CANONICAL_S3_URI}"
        echo ""

        REGISTERED_S3_URI="${CANONICAL_S3_URI}"

    else
        # ── HuggingFace source: stage via the stage-hf Processing Job ────────
        # Mirror do/tune's stage-hf invocation. org/name (and optional split) are
        # parsed from --hf-id (org/name) plus --hf-split.
        _hf_id="${DATASET_HF_ID}"
        _hf_org="${_hf_id%%/*}"
        _hf_name="${_hf_id#*/}"

        if [ -z "${_hf_org}" ] || [ -z "${_hf_name}" ] || [ "${_hf_org}" = "${_hf_id}" ]; then
            echo "❌ Invalid --hf-id: ${DATASET_HF_ID}"
            echo "   Expected format: org/name (e.g., timdettmers/openassistant-guanaco)"
            exit 1
        fi

        echo "📦 Staging HuggingFace dataset: ${_hf_org}/${_hf_name}"
        if [ -n "${DATASET_HF_SPLIT}" ]; then
            echo "   Split: ${DATASET_HF_SPLIT}"
        else
            echo "   Split: train (default)"
        fi

        # Build stage-hf arguments (same helper + flags as do/tune).
        # BL099: pin the staged output to the canonical, project-independent
        # location on the mlcc-core bucket:
        #   s3://<CORE_BUCKET>/datasets/<name>/
        # --output-bucket is CORE_BUCKET (mlcc-core), NOT the CI source bucket, and
        # --output-prefix omits the project-name prefix so the dataset is a shared,
        # cross-project cache keyed by the registered dataset <name> (not org/name).
        # This matches the sidecar location datasets/<name>/_dataset.json.
        stage_args=(
            --hf-org "${_hf_org}"
            --hf-name "${_hf_name}"
            --output-bucket "${CORE_BUCKET}"
            --output-prefix "datasets/${DATASET_NAME}"
            --project-name "${PROJECT_NAME}"
            --region "${AWS_REGION}"
            --technique "${DATASET_TECHNIQUE}"
        )
        if [ -n "${DATASET_HF_SPLIT}" ]; then
            stage_args+=(--hf-split "${DATASET_HF_SPLIT}")
        fi
        if [ -n "${HF_TOKEN_ARN:-${_PROFILE_secrets_hfToken:-}}" ]; then
            stage_args+=(--hf-secret-name "${HF_TOKEN_ARN:-${_PROFILE_secrets_hfToken:-}}")
        fi
        if [ -n "${DATASET_COLUMN_MAP}" ]; then
            stage_args+=(--column-map "${DATASET_COLUMN_MAP}")
        fi
        # --row-count is passed to staging as --take (number of records to keep).
        if [ -n "${DATASET_ROW_COUNT}" ]; then
            stage_args+=(--take "${DATASET_ROW_COUNT}")
        fi

        stage_stderr="$(mktemp)"
        # Capture stdout (JSON) and stderr (tracebacks) separately so a helper
        # crash surfaces the real cause instead of a generic message.
        if ! stage_result=$(python3 "${HELPER_SCRIPT}" stage-hf "${stage_args[@]}" 2>"${stage_stderr}"); then
            error_msg=$(echo "${stage_result}" | python3 -c "import sys,json; print(json.load(sys.stdin).get('error','Failed to stage dataset'))" 2>/dev/null) || error_msg="Failed to stage HF dataset"
            echo "❌ ${error_msg}"
            if [ -s "${stage_stderr}" ]; then
                echo "   ── helper error output ──────────────────────────────"
                sed 's/^/   /' "${stage_stderr}"
                echo "   ─────────────────────────────────────────────────────"
            fi
            rm -f "${stage_stderr}"
            exit 1
        fi
        rm -f "${stage_stderr}"

        # Check for error in response
        has_error=$(echo "${stage_result}" | python3 -c "import sys,json; d=json.load(sys.stdin); print('yes' if 'error' in d else 'no')" 2>/dev/null) || has_error="yes"
        if [ "${has_error}" = "yes" ]; then
            error_msg=$(echo "${stage_result}" | python3 -c "import sys,json; print(json.load(sys.stdin).get('error','Unknown error'))" 2>/dev/null) || error_msg="Unknown error"
            echo "❌ ${error_msg}"
            exit 1
        fi

        REGISTERED_S3_URI=$(echo "${stage_result}" | python3 -c "import sys,json; print(json.load(sys.stdin)['s3_uri'])" 2>/dev/null)
        _staged_rows=$(echo "${stage_result}" | python3 -c "import sys,json; print(json.load(sys.stdin).get('num_records',0))" 2>/dev/null) || _staged_rows=""
        [ -z "${RESOLVED_ROW_COUNT}" ] && RESOLVED_ROW_COUNT="${_staged_rows}"

        if [ -z "${REGISTERED_S3_URI}" ]; then
            echo "❌ Staging returned no S3 URI"
            exit 1
        fi

        echo "   ✅ Staged to: ${REGISTERED_S3_URI}"
        [ -n "${_staged_rows}" ] && echo "   Records: ${_staged_rows}"
        echo ""
    fi

    # ── Register the canonical URI in the dataset registry ────────────────────
    echo "📝 Registering canonical dataset URI"
    echo "   URI:       ${REGISTERED_S3_URI}"
    echo "   Format:    ${DATASET_FORMAT}"
    echo "   Technique: ${DATASET_TECHNIQUE}"
    echo ""

    # Build register-dataset args
    DS_ARGS=(
        "register-dataset"
        "--name" "${DATASET_NAME}"
        "--s3-uri" "${REGISTERED_S3_URI}"
        "--format" "${DATASET_FORMAT}"
        "--technique" "${DATASET_TECHNIQUE}"
    )

    if [ -n "${RESOLVED_ROW_COUNT}" ]; then
        DS_ARGS+=("--row-count" "${RESOLVED_ROW_COUNT}")
    fi

    if [ -n "${DATASET_COLUMN_SCHEMA}" ]; then
        DS_ARGS+=("--column-schema" "${DATASET_COLUMN_SCHEMA}")
    fi

    DS_ARGS+=("--project-name" "${PROJECT_NAME}")
    DS_ARGS+=("--region" "${AWS_REGION}")
    DS_ARGS+=("--core-bucket" "${CORE_BUCKET}")

    if [ -n "${DATASET_ATTRIBUTION}" ]; then
        DS_ARGS+=("--attribution" "${DATASET_ATTRIBUTION}")
    fi
    if [ -n "${DATASET_LINEAGE}" ]; then
        DS_ARGS+=("--lineage" "${DATASET_LINEAGE}")
    fi
    if [ -n "${DATASET_ORIGINATION}" ]; then
        DS_ARGS+=("--origination" "${DATASET_ORIGINATION}")
    fi
    if [ -n "${DATASET_APPLICATION}" ]; then
        DS_ARGS+=("--application" "${DATASET_APPLICATION}")
    fi

    if [ "${DATASET_FORCE}" = true ]; then
        DS_ARGS+=("--force")
    fi

    # Call .register_helper.py register-dataset
    if ds_output=$(python3 "${SCRIPT_DIR}/.register_helper.py" "${DS_ARGS[@]}" 2>/dev/null); then
        ds_json=$(echo "${ds_output}" | grep -E '^\{' | tail -1)
        if [ -n "${ds_json}" ]; then
            echo "✅ Dataset registered successfully"
            echo "${ds_json}" | python3 -c "import sys,json; print(json.dumps(json.load(sys.stdin), indent=2))" 2>/dev/null || echo "${ds_json}"
        else
            echo "⚠️  Dataset registration returned no JSON output"
        fi
    else
        echo "❌ Dataset registration failed"
        exit 1
    fi

    exit 0
fi

# ============================================================
# Handle --evaluator mode (register evaluator, AC-2c.1)
# ============================================================

if [ "${SUBCOMMAND}" = "evaluator" ]; then
    if [ -z "${EVALUATOR_NAME}" ]; then
        echo "❌ Evaluator name is required"
        echo "   Usage: ./do/register evaluator <name> --type <lambda|model> --arn <arn> --technique <rlvr|rlaif>"
