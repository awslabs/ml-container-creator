    echo ""
    echo "Evaluator options (code-based reward function — RLVR / MTRL):"
    echo "  <name>              Evaluator name (required, positional)"
    echo "  --arn <lambda-arn>  ARN of an existing reward-function Lambda (primary path)"
    echo "  --from-sample [<id>] Materialize an editable reward-function sample to edit, then"
    echo "                      register it with --finalize (managed-Lambda path; needs the"
    echo "                      dual-trust reward-Lambda role via MLCC_REWARD_LAMBDA_ROLE_ARN)"
    echo "  --description <d>   Optional description shown in Studio Assets"
    echo "  Note: --technique is accepted but IGNORED (deprecated — the evaluator TYPE carries"
