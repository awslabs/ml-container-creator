        --benchmark-run-id)
            BENCHMARK_RUN_ID="$2"
            shift 2
            ;;
        --benchmark-run-id=*)
            BENCHMARK_RUN_ID="${1#*=}"
            shift
            ;;
        --exclude)
            EXCLUDE_ADAPTERS="${EXCLUDE_ADAPTERS:+${EXCLUDE_ADAPTERS},}$2"
            shift 2
            ;;
        --exclude=*)
            EXCLUDE_ADAPTERS="${EXCLUDE_ADAPTERS:+${EXCLUDE_ADAPTERS},}${1#*=}"
