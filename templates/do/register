    echo "  <name>              Prompt evaluator name (required, positional)"
    echo "  --prompt <s3-uri>   S3 URI of the reward prompt file (required)"
    echo "  --description <d>   Optional description shown in Studio Assets"
    echo ""
    echo "Model options:"
    echo "  --notes \"text\"      Optional deployment notes"
    echo "  --status <s>        Deployment status: success|partial|failed (default: success)"
    echo "  --json              Output JSON"
    echo "  --ci                CI mode (writes to DynamoDB)"
    echo ""
    echo "Prerequisites:"
    echo "  • AWS credentials configured"
    echo "  • Bootstrap provisioned (provides mlcc-core S3 bucket for dataset canonical location)"
    echo "  • For --hf-id: HF_TOKEN_ARN set in do/config (required for gated models)"
    echo ""
    echo "Typical dataset workflow:"
    echo "  ./do/register dataset --discover timdettmers/openassistant-guanaco  # Browse first"
    echo "  ./do/register dataset guanaco --hf-id timdettmers/openassistant-guanaco --technique sft"
