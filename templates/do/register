    echo "  ./do/register prompt pairwise-judge --prompt-file ./judge-prompt.txt"
    echo "  # ...or from an already-staged S3 file:"
    echo "  ./do/register prompt pairwise-judge --prompt s3://my-bucket/judge-prompt.txt"
    echo "  # List what's registered:"
    echo "  ./do/register evaluator --list      # reward functions (RLVR/MTRL)"
    echo "  ./do/register prompt --list         # reward prompts (RLAIF)"
}

# Detect subcommand or legacy flags
SUBCOMMAND="model"
case "${1:-}" in
    dataset)   SUBCOMMAND="dataset"; shift ;;
    evaluator) SUBCOMMAND="evaluator"; shift ;;
    prompt)    SUBCOMMAND="prompt"; shift ;;
    model)     SUBCOMMAND="model"; shift ;;
    --help|-h) _show_usage; exit 0 ;;
    --dataset) SUBCOMMAND="dataset"; shift ;;  # backward compat
    --evaluator) SUBCOMMAND="evaluator"; shift ;;  # backward compat
esac

# ── Parse remaining arguments per subcommand ──────────────────────────────────

NOTES=""
STATUS="success"
PROJECT_FLAG=""
JSON_OUTPUT=false
CI_MODE=false
CI_TABLE_NAME="${CI_TABLE_NAME:-mlcc-ci-table}"
CI_BUILD_STRATEGY="codebuild-submit"
BENCHMARK_STATUS=""
BENCHMARK_RUN_ID=""
DATASET_NAME=""
DATASET_S3_URI=""
DATASET_HF_ID=""
DATASET_HF_SPLIT=""
DATASET_COLUMN_MAP=""
DATASET_FORMAT="jsonl"
DATASET_TECHNIQUE="benchmark"
DATASET_DESCRIPTION=""
DATASET_ROW_COUNT=""
DATASET_COLUMN_SCHEMA=""
DATASET_HF_FILES=""
