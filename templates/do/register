<% } %>
  "parameters": ${PARAMETERS}
}
DJEOF
)

    # Output JSON to stdout. Pretty-print only; the raw JSON is echoed on a
    # parse failure, so stdout stays machine-readable either way (safe).
    echo "${DEPLOYMENT_JSON}" | python3 -c "import sys,json; print(json.dumps(json.load(sys.stdin), indent=2))" 2>/dev/null || echo "${DEPLOYMENT_JSON}"

    if [ "${CI_MODE}" = true ]; then
        # Strip capacity reservation ARN for CI — force on-demand deployment
        # CI projects must never use reserved capacity (reservations are account-specific
        # and time-bound; CI replay should always target on-demand instances)
        # (`unset` of an absent var is harmless — swallow is safe.)
        unset CAPACITY_RESERVATION_ARN 2>/dev/null || true

        echo ""
        echo "⚠️  CI Integration is experimental and currently only tested for"
        echo "   SageMaker Real-Time Inference endpoints."
        echo ""

        # Compute configId
        CONFIG_ID=$(compute_config_id)
        echo ""
        echo "🔑 configId: ${CONFIG_ID}"

        # Check if CI_Table exists before writing
        if ! aws dynamodb describe-table --table-name "${CI_TABLE_NAME}" --region "${AWS_REGION}" &>/dev/null; then
            echo ""
            echo "⚠️  CI infrastructure not provisioned. Run 'ml-container-creator bootstrap' with CI enabled."
            echo "   Skipping CI table write."
        else
            echo "📝 Writing to CI table (${CI_TABLE_NAME})..."
            write_ci_record "${CONFIG_ID}"
        fi
    fi

    exit 0
fi

# ============================================================
# Register to SageMaker Model Package Group (non-fatal, AC-1.6)
# ============================================================

# Container image URI for the deployed model
# Build full ECR URI from profile (accountId + region + repoName + tag)
_ACCOUNT_ID="${_PROFILE_accountId:-}"
_REGION="${AWS_DEFAULT_REGION:-${_PROFILE_awsRegion:-us-east-1}}"
if [ -n "${_ACCOUNT_ID}" ] && [ -n "${ECR_REPOSITORY_NAME}" ]; then
    CONTAINER_IMAGE_URI="${_ACCOUNT_ID}.dkr.ecr.${_REGION}.amazonaws.com/${ECR_REPOSITORY_NAME}:${PROJECT_NAME}-latest"
else
    # No ECR info available — MPG will be registered without InferenceSpecification
    CONTAINER_IMAGE_URI=""
fi

# Model data S3 URI (from do/config if set)
MODEL_S3_URI="${MODEL_DATA_URL:-${MODEL_S3_URI:-}}"

# Build register-model args
REG_ARGS=(
    "register-model"
    "--project-name" "${PROJECT_NAME}"
    "--deployment-config" "${DEPLOYMENT_CONFIG}"
    "--container-image" "${CONTAINER_IMAGE_URI}"
    "--instance-type" "${INSTANCE_TYPE}"
    "--architecture" "${ARCHITECTURE}"
    "--backend" "${BACKEND}"
)

if [ -n "${MODEL_NAME:-}" ]; then
    REG_ARGS+=("--model-name" "${MODEL_NAME}")
fi

if [ -n "${MODEL_S3_URI:-}" ]; then
    REG_ARGS+=("--model-data-url" "${MODEL_S3_URI}")
fi

if [ -n "${BASE_IMAGE:-}" ]; then
    REG_ARGS+=("--base-image" "${BASE_IMAGE}")
fi

if [ -n "${MODEL_FORMAT:-}" ]; then
    REG_ARGS+=("--model-format" "${MODEL_FORMAT}")
fi

if [ -n "${GENERATOR_VERSION}" ]; then
    REG_ARGS+=("--generator-version" "${GENERATOR_VERSION}")
fi

if [ -n "${AWS_REGION:-}" ]; then
    REG_ARGS+=("--region" "${AWS_REGION}")
fi

if [ -n "${ROLE_ARN:-}" ]; then
    REG_ARGS+=("--role-arn" "${ROLE_ARN}")
fi

echo ""
echo "📦 Registering to SageMaker Model Package Group..."

# Call .register_helper.py — non-fatal on failure (AC-1.6)
# Use robust JSON extraction pattern (design lesson #4)
# BL165: still non-fatal (AC-1.6), but the helper's stderr is captured and the
# structured error + real cause are surfaced instead of a bare "failed".
_reg_stderr="$(mktemp)"
if helper_output=$(python3 "${SCRIPT_DIR}/.register_helper.py" "${REG_ARGS[@]}" 2>"${_reg_stderr}"); then
    rm -f "${_reg_stderr}"
    json_line=$(echo "${helper_output}" | grep -E '^\{' | tail -1)
    if [ -n "${json_line}" ]; then
        # Extract fields from JSON response (parse-only; an unparseable field
        # yields "" and is reported as "incomplete data" just below — safe).
        MPG_ARN=$(echo "${json_line}" | python3 -c "import sys,json; print(json.load(sys.stdin).get('mpg_arn',''))" 2>/dev/null || echo "")
        MODEL_PKG_ARN=$(echo "${json_line}" | python3 -c "import sys,json; print(json.load(sys.stdin).get('model_package_arn',''))" 2>/dev/null || echo "")
        MPG_VERSION=$(echo "${json_line}" | python3 -c "import sys,json; print(json.load(sys.stdin).get('version',0))" 2>/dev/null || echo "0")

        if [ -n "${MODEL_PKG_ARN}" ] && [ "${MODEL_PKG_ARN}" != "" ]; then
            echo "✅ Model registered: version ${MPG_VERSION}"
            echo "   MPG ARN: ${MPG_ARN}"
            echo "   Package ARN: ${MODEL_PKG_ARN}"
        else
            echo "⚠️  MPG registration returned incomplete data (non-fatal)"
        fi
    else
        echo "⚠️  MPG registration returned no JSON output (non-fatal)"
    fi
else
    _surface_helper_failure "MPG registration failed (non-fatal) — SageMaker Model Package Groups are the deployment record" \
        "${helper_output:-}" "${_reg_stderr}" \
        "Fix the cause above and re-run ./do/register." "⚠️ "
fi

# ============================================================
# Register adapter into same MPG if detected (AC-2.1, AC-2.4)
# ============================================================
# Adapter presence: TUNE_OUTPUT_PATH_LATEST set (from do/tune)
# OR adapter conf files exist in do/adapters/
# SFTTrainer may auto-register — do/register supplements with deployment metadata.
# Registration failure is non-fatal (warning only, AC-1.6 applies).

# ── Register ALL adapters into MPG ────────────────────────────────────────────
# Loop over do/adapters/*.conf and register each one as a linked ModelPackage version.
# Use --exclude to skip specific adapters (comma-separated or repeated flag).
# Use --base-only to skip all adapter registration.

_is_excluded() {
    local name="$1"
    IFS=',' read -ra _excl_list <<< "${EXCLUDE_ADAPTERS}"
    for _excl in "${_excl_list[@]}"; do
        [ "${_excl}" = "${name}" ] && return 0
    done
    return 1
}

if [ "${BASE_ONLY}" = true ]; then
    echo ""
    echo "ℹ️  --base-only: skipping adapter registration"
elif [ -n "${MODEL_PKG_ARN:-}" ] && [ -d "${SCRIPT_DIR}/adapters" ]; then
    ADAPTERS_REGISTERED=0
    ADAPTERS_SKIPPED=0

    for conf in "${SCRIPT_DIR}"/adapters/*.conf; do
        [ -f "${conf}" ] || continue
        [[ "$(basename "${conf}")" == ".gitkeep" ]] && continue

        _ADAPTER_NAME=$(basename "${conf}" .conf)

        # Check exclude list
        if _is_excluded "${_ADAPTER_NAME}"; then
            echo "   ⏭️  Skipping excluded adapter: ${_ADAPTER_NAME}"
            ADAPTERS_SKIPPED=$((ADAPTERS_SKIPPED + 1))
            continue
        fi

        # Read adapter config
        ADAPTER_WEIGHTS_URI=""
        ADAPTER_TECHNIQUE=""
        ADAPTER_BASE_ID=""
        # Optional-key probes: a key absent from the conf is normal and falls back
        # to the defaults below, so discarding grep/eval noise is safe.
        eval "$(grep '^export ADAPTER_WEIGHTS_URI=' "${conf}" 2>/dev/null)" 2>/dev/null || true
        eval "$(grep '^export ADAPTER_TECHNIQUE=' "${conf}" 2>/dev/null)" 2>/dev/null || true
        eval "$(grep '^export ADAPTER_TUNE_TECHNIQUE=' "${conf}" 2>/dev/null)" 2>/dev/null || true
        eval "$(grep '^export ADAPTER_BASE_ID=' "${conf}" 2>/dev/null)" 2>/dev/null || true

        _ADAPTER_DATA_URL="${ADAPTER_WEIGHTS_URI:-}"
        _ADAPTER_TECHNIQUE="${ADAPTER_TECHNIQUE:-${ADAPTER_TUNE_TECHNIQUE:-${TUNE_TECHNIQUE:-}}}"
        # BL176: the adapter's base model → --base-id → mlcc.family → base→adapter
        # linkage in the console. Prefer the conf's ADAPTER_BASE_ID (do/tune records
        # it); fall back to the project's tune model id for older confs.
        _ADAPTER_BASE_ID="${ADAPTER_BASE_ID:-${TUNE_MODEL_ID:-}}"

        echo ""
        echo "📦 Registering adapter: ${_ADAPTER_NAME}"

        # Build register-adapter args
        ADAPTER_REG_ARGS=(
            "register-adapter"
            "--project-name" "${PROJECT_NAME}"
            "--parent-version-arn" "${MODEL_PKG_ARN}"
            "--deployment-config" "${DEPLOYMENT_CONFIG}"
            "--container-image" "${CONTAINER_IMAGE_URI}"
            "--instance-type" "${INSTANCE_TYPE}"
            "--architecture" "${ARCHITECTURE}"
            "--backend" "${BACKEND}"
        )

        [ -n "${_ADAPTER_TECHNIQUE}" ] && ADAPTER_REG_ARGS+=("--tune-technique" "${_ADAPTER_TECHNIQUE}")
        [ -n "${_ADAPTER_BASE_ID}" ] && ADAPTER_REG_ARGS+=("--base-id" "${_ADAPTER_BASE_ID}")
        [ -n "${_ADAPTER_DATA_URL}" ] && ADAPTER_REG_ARGS+=("--model-data-url" "${_ADAPTER_DATA_URL}")
        [ -n "${MODEL_NAME:-}" ] && ADAPTER_REG_ARGS+=("--model-name" "${MODEL_NAME}")
        [ -n "${BASE_IMAGE:-}" ] && ADAPTER_REG_ARGS+=("--base-image" "${BASE_IMAGE}")
        [ -n "${MODEL_FORMAT:-}" ] && ADAPTER_REG_ARGS+=("--model-format" "${MODEL_FORMAT}")
        [ -n "${GENERATOR_VERSION:-}" ] && ADAPTER_REG_ARGS+=("--generator-version" "${GENERATOR_VERSION}")
        [ -n "${AWS_REGION:-}" ] && ADAPTER_REG_ARGS+=("--region" "${AWS_REGION}")
        [ -n "${ROLE_ARN:-}" ] && ADAPTER_REG_ARGS+=("--role-arn" "${ROLE_ARN}")

        # Include dataset lineage from tune state (AC-2.7: version reference for reproducibility)
        if [ -n "${TUNE_DATASET_S3_URI:-}" ]; then
            ADAPTER_REG_ARGS+=("--dataset-s3-uri" "${TUNE_DATASET_S3_URI}")
        fi
        # Resolve dataset version from technique-specific or generic config var
        _ds_version=""
        if [ -n "${_ADAPTER_TECHNIQUE}" ]; then
            _ds_ver_var="TUNE_DATASET_VERSION_$(echo "${_ADAPTER_TECHNIQUE}" | tr '[:lower:]' '[:upper:]')"
            _ds_version="${!_ds_ver_var:-}"
        fi
        [ -z "${_ds_version}" ] && _ds_version="${TUNE_DATASET_VERSION:-}"
        if [ -n "${_ds_version}" ]; then
            ADAPTER_REG_ARGS+=("--dataset-version" "${_ds_version}")
        fi

        # Call .register_helper.py register-adapter — non-fatal on failure.
        # BL165: stderr captured and surfaced on failure (was discarded).
        _ad_stderr="$(mktemp)"
        if adapter_output=$(python3 "${SCRIPT_DIR}/.register_helper.py" "${ADAPTER_REG_ARGS[@]}" 2>"${_ad_stderr}"); then
            rm -f "${_ad_stderr}"
            adapter_json=$(echo "${adapter_output}" | grep -E '^\{' | tail -1)
            if [ -n "${adapter_json}" ]; then
                # Parse-only field reads; "" is reported as incomplete below (safe).
                _PKG_ARN=$(echo "${adapter_json}" | python3 -c "import sys,json; print(json.load(sys.stdin).get('model_package_arn',''))" 2>/dev/null || echo "")
                _VERSION=$(echo "${adapter_json}" | python3 -c "import sys,json; print(json.load(sys.stdin).get('version',0))" 2>/dev/null || echo "0")

                if [ -n "${_PKG_ARN}" ] && [ "${_PKG_ARN}" != "" ]; then
                    echo "   ✅ Registered: version ${_VERSION} (${_PKG_ARN})"
                    ADAPTERS_REGISTERED=$((ADAPTERS_REGISTERED + 1))
                else
                    echo "   ⚠️  Registration returned incomplete data (non-fatal)"
                fi
            else
                echo "   ⚠️  Registration returned no JSON output (non-fatal)"
            fi
        else
            _surface_helper_failure "Registration failed for ${_ADAPTER_NAME} (non-fatal)" \
                "${adapter_output:-}" "${_ad_stderr}" "" "   ⚠️ "
        fi

        unset ADAPTER_WEIGHTS_URI ADAPTER_TECHNIQUE
    done

    echo ""
    echo "📋 Adapter registration summary: ${ADAPTERS_REGISTERED} registered, ${ADAPTERS_SKIPPED} skipped"

elif [ -z "${MODEL_PKG_ARN:-}" ] && [ -d "${SCRIPT_DIR}/adapters" ]; then
    echo ""
    echo "⚠️  Adapters detected but no parent model version ARN — skipping adapter registration"
fi
