# ── BL165: capture-and-surface for PRIMARY operation failures ─────────────────
# A `2>/dev/null` on the primary operation (a .register_helper.py subcommand, a
# DynamoDB write) turned real failures — tracebacks, AWS AccessDenied, a
# NameError in a helper (BL172) — into a generic message or a silent no-op.
# Primary calls now capture stderr to a temp file and, on failure, call this to
# surface the helper's structured {"error","code"} JSON (if any) PLUS the real
# stderr. `2>/dev/null` remains only on genuinely optional probes / pretty-print
# fallbacks, each commented with why it is safe.
#   _surface_helper_failure <what-failed> <captured-stdout> <stderr-file> [guidance] [icon]
# [icon] defaults to "❌"; non-fatal callers pass "⚠️ ".
_surface_helper_failure() {
    local _what="$1" _out="$2" _errf="$3" _hint="${4:-}" _icon="${5:-❌}"
    local _json _msg="" _code=""
    _json=$(printf '%s\n' "${_out}" | grep -E '^\{' | tail -1 || true)
    if [ -n "${_json}" ]; then
        # Parse-only: a malformed JSON line just leaves the fields empty — safe
        # because the raw stderr below still carries the real cause.
        _msg=$(printf '%s' "${_json}" | python3 -c "import sys,json; print(json.load(sys.stdin).get('error',''))" 2>/dev/null) || _msg=""
        _code=$(printf '%s' "${_json}" | python3 -c "import sys,json; print(json.load(sys.stdin).get('code',''))" 2>/dev/null) || _code=""
    fi
    echo "${_icon} ${_what}${_msg:+: ${_msg}}"
    [ -n "${_code}" ] && echo "   code: ${_code}"
    if [ -n "${_errf}" ] && [ -s "${_errf}" ]; then
        echo "   ── error output ─────────────────────────────────────" >&2
        sed 's/^/   /' "${_errf}" >&2
        echo "   ─────────────────────────────────────────────────────" >&2
    fi
    [ -n "${_errf}" ] && rm -f "${_errf}"
    [ -n "${_hint}" ] && echo "   ${_hint}"
    return 0
}

