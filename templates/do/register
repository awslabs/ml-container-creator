#
# do/register — Register deployment to the deployment registry.
#
# @mlcc-script
# type: hybrid
# guard: none
# lifecycle: publish
# targets: all

set -e
set -u
set -o pipefail

# Source configuration
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${SCRIPT_DIR}/lib/script-contract.sh"
_require_python_env
source "${SCRIPT_DIR}/config"
source "${SCRIPT_DIR}/lib/profile.sh"
source "${SCRIPT_DIR}/lib/resolve-instance.sh"

# ── Profile-resolved variables (env var > profile > default) ──────────────────
ROLE_ARN="${ROLE_ARN:-${_PROFILE_roleArn:-}}"
ECR_REPOSITORY_NAME="${ECR_REPOSITORY_NAME:-${_PROFILE_ecrRepositoryName:-ml-container-creator}}"

# Helper script that owns the HuggingFace staging Processing Job (stage-hf).
# Mirror do/tune's resolution so `./do/register dataset --hf-id` uses the exact
# same staging mechanism as `./do/tune --dataset hf://...`.
HELPER_SCRIPT="${SCRIPT_DIR}/.tune_helper.py"

# CORE_BUCKET is the mlcc-core bucket (e.g. mlcc-core-<account>-<region>). It is
# recorded in the active profile as codebuildSourceS3Bucket. Datasets registered
# via do/register are moved to the canonical location:
#   s3://<CORE_BUCKET>/datasets/<name>/
CORE_BUCKET="${CORE_BUCKET:-${CODEBUILD_SOURCE_S3_BUCKET:-${_PROFILE_codebuildSourceS3Bucket:-}}}"

# Resolve INSTANCE_TYPE for heterogeneous pool endpoints (may be empty from config,
# filled by do/deploy after InService resolution)
INSTANCE_TYPE="${INSTANCE_TYPE:-${DEPLOYED_INSTANCE_TYPE:-${BENCHMARK_INSTANCE_TYPE:-}}}"

# ============================================================
# Register deployment to the deployment registry
# ============================================================

# ── Subcommand routing ────────────────────────────────────────────────────────
# Supports: model (default), dataset, evaluator
# Backward-compat: --dataset and --evaluator flags still work

_show_usage() {
    echo "Usage: ./do/register [model] [options]        Register the deployed model to MPG"
    echo "       ./do/register dataset <name> [options] Register a dataset to the registry"
    echo "       ./do/register evaluator <name> [options] Register an evaluator to the registry"
    echo "       ./do/register --benchmark-status <completed|failed|in-progress> --benchmark-run-id <run-id>"
    echo ""
    echo "Subcommands:"
    echo "  model       (default) Register the current deployment as a Model Package version"
    echo "  dataset     Move a dataset to the canonical MLCC datasets location and register it"
    echo "  evaluator   Register a reward function or preference model for RL tuning"
    echo ""
    echo "Dataset:"
    echo "  Moves a dataset into the canonical MLCC datasets location on the mlcc-core"
    echo "  bucket and registers the resulting URI so it can be reused across tuning jobs:"
    echo "      s3://<CORE_BUCKET>/datasets/<name>/"
    echo "  (CORE_BUCKET is the mlcc-core bucket recorded in your profile, e.g."
    echo "   mlcc-core-<account>-<region>.)"
    echo ""
    echo "  Provide exactly one input source:"
    echo "  --s3-uri <s3://...> Existing S3 dataset. Copied to the canonical location with"
    echo "                      'aws s3 cp' (or 'aws s3 sync' for a directory/prefix), then"
    echo "                      registered."
    echo "  --hf-id <org/name>  HuggingFace dataset ID. Staged to the canonical location via"
    echo "                      the same stage-hf Processing Job used by do/tune, then"
    echo "                      registered."
    echo ""
    echo "  Shared options:"
    echo "  <name>              Dataset name (required, positional)"
    echo "  --technique <tech>  Technique: sft, dpo, rlaif, rlvr (default: sft)"
    echo "  --row-count <n>     Number of records (with --hf-id, passed to staging as --take)"
    echo "  --format <fmt>      Format: jsonl, parquet, csv (default: jsonl)"
    echo "  --column-schema <j> Column schema as JSON string"
    echo "  --hf-split <split>  (--hf-id only) Dataset split to stage (default: train)"
    echo "  --column-map <map>  (--hf-id only) Rename columns (e.g., prompt=question,completion=answer)"
    echo "  --force             Overwrite / register a new version even if already registered"
    echo ""
    echo "  Dataset management (no source required):"
    echo "  --list [--source local|remote|all]"
    echo "                           List registered datasets (default: all). --json for scripting."
    echo "  --list-versions <name>   List all registered versions of a dataset from the S3"
    echo "                           sidecar (human-readable; add --json for scripting)."
    echo "  --discover <org/name>    Browse a HuggingFace dataset (splits, files, row counts,"
    echo "                           schema preview) and print a recommended register command."
    echo "                           Add --hf-split to focus a split; --json for raw output."
    echo "  --delete <name> [@v<N>]  Remove a dataset's registry entry (whole sidecar, or a"
    echo "                           single version with @v<N>). Prompts unless --force."
    echo "                           NEVER deletes the dataset data bytes in S3 — only the"
    echo "                           metadata sidecar (datasets/<name>/_dataset.json)."
    echo "  --json                   Emit JSON for --list-versions / --discover / --delete."
    echo ""
    echo "Evaluator options:"
    echo "  <name>              Evaluator name (required, positional)"
    echo "  --type <type>       Type: lambda or model (required)"
    echo "  --arn <arn>         Lambda ARN or model S3 URI (required)"
    echo "  --technique <tech>  Technique: rlvr or rlaif (required)"
    echo "  --description <d>   Optional description"
    echo ""
    echo "Model options:"
    echo "  --notes \"text\"      Optional deployment notes"
    echo "  --status <s>        Deployment status: success|partial|failed (default: success)"
    echo "  --json              Output JSON"
    echo "  --ci                CI mode (writes to DynamoDB)"
    echo ""
    echo "Prerequisites:"
    echo "  • AWS credentials configured"
    echo "  • Bootstrap provisioned (provides mlcc-core S3 bucket for dataset canonical location)"
    echo "  • For --hf-id: HF_TOKEN_ARN set in do/config (required for gated models)"
    echo ""
    echo "Typical dataset workflow:"
    echo "  ./do/register dataset --discover timdettmers/openassistant-guanaco  # Browse first"
    echo "  ./do/register dataset guanaco --hf-id timdettmers/openassistant-guanaco --technique sft"
    echo "  ./do/register dataset --list                                          # Confirm registered"
    echo "  ./do/tune --technique sft --dataset guanaco                           # Use in tuning"
    echo "  ./do/optimize --goal throughput --dataset guanaco                     # Use in optimization"
    echo ""
    echo "Examples:"
    echo "  ./do/register                              # Register model (default)"
    echo "  # Move an existing S3 dataset into the canonical location and register it:"
    echo "  ./do/register dataset alpaca-sft-1k --s3-uri s3://my-bucket/data.jsonl --technique sft --row-count 1000"
    echo "  # Stage a HuggingFace dataset to the canonical location and register it:"
    echo "  ./do/register dataset guanaco --hf-id timdettmers/openassistant-guanaco --technique sft --row-count 500"
    echo "  # List all versions of a registered dataset:"
    echo "  ./do/register dataset --list-versions guanaco"
    echo "  # Browse a HuggingFace dataset before registering:"
    echo "  ./do/register dataset --discover timdettmers/openassistant-guanaco"
    echo "  # Deregister a dataset (metadata only; data bytes preserved):"
    echo "  ./do/register dataset --delete guanaco            # whole registry entry"
    echo "  ./do/register dataset --delete guanaco @v2 --force # a single version, no prompt"
    echo "  ./do/register evaluator my-reward --type lambda --arn arn:aws:lambda:... --technique rlvr"
}

# Detect subcommand or legacy flags
SUBCOMMAND="model"
case "${1:-}" in
    dataset)   SUBCOMMAND="dataset"; shift ;;
    evaluator) SUBCOMMAND="evaluator"; shift ;;
    model)     SUBCOMMAND="model"; shift ;;
    --help|-h) _show_usage; exit 0 ;;
    --dataset) SUBCOMMAND="dataset"; shift ;;  # backward compat
    --evaluator) SUBCOMMAND="evaluator"; shift ;;  # backward compat
esac

# ── Parse remaining arguments per subcommand ──────────────────────────────────

NOTES=""
STATUS="success"
PROJECT_FLAG=""
JSON_OUTPUT=false
CI_MODE=false
CI_TABLE_NAME="${CI_TABLE_NAME:-mlcc-ci-table}"
CI_BUILD_STRATEGY="codebuild-submit"
BENCHMARK_STATUS=""
BENCHMARK_RUN_ID=""
DATASET_NAME=""
DATASET_S3_URI=""
DATASET_HF_ID=""
DATASET_HF_SPLIT=""
DATASET_COLUMN_MAP=""
DATASET_FORMAT="jsonl"
DATASET_TECHNIQUE="sft"
DATASET_ROW_COUNT=""
DATASET_COLUMN_SCHEMA=""
DATASET_FORCE=false
DATASET_ATTRIBUTION=""
DATASET_LINEAGE=""
DATASET_ORIGINATION=""
DATASET_APPLICATION=""
DATASET_LIST=false
DATASET_LIST_VERSIONS=""
DATASET_DISCOVER=""
DATASET_DELETE=""
DATASET_DELETE_VERSION=""
DATASET_JSON=false
EVALUATOR_NAME=""
EVALUATOR_TYPE=""
EVALUATOR_ARN_OR_URI=""
EVALUATOR_TECHNIQUE=""
EVALUATOR_DESCRIPTION=""
EXCLUDE_ADAPTERS=""
BASE_ONLY=false
WITH_ENDPOINT=false
WITH_METRICS=false

# ── Dataset subcommand arg parsing ────────────────────────────────────────────
if [ "${SUBCOMMAND}" = "dataset" ]; then
    FROM_TUNE_FLAG=""
    FROM_TUNE_TECHNIQUE=""
    # First positional arg is the dataset name
    if [ $# -gt 0 ] && [[ "${1}" != -* ]]; then
        DATASET_NAME="$1"; shift
    fi
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --from-tune)
                FROM_TUNE_FLAG="true"
                # Check if next arg is a technique (not another flag)
                if [ -n "${2:-}" ] && [[ "${2}" != -* ]]; then
                    FROM_TUNE_TECHNIQUE="$2"; shift 2
                else
                    shift
                fi
                ;;
            --s3-uri)       DATASET_S3_URI="$2"; shift 2 ;;
            --s3-uri=*)     DATASET_S3_URI="${1#*=}"; shift ;;
            --hf-id)        DATASET_HF_ID="$2"; shift 2 ;;
            --hf-id=*)      DATASET_HF_ID="${1#*=}"; shift ;;
            --hf-split)     DATASET_HF_SPLIT="$2"; shift 2 ;;
            --hf-split=*)   DATASET_HF_SPLIT="${1#*=}"; shift ;;
            --column-map)   DATASET_COLUMN_MAP="$2"; shift 2 ;;
            --column-map=*) DATASET_COLUMN_MAP="${1#*=}"; shift ;;
            --format)       DATASET_FORMAT="$2"; shift 2 ;;
            --format=*)     DATASET_FORMAT="${1#*=}"; shift ;;
            --technique)    DATASET_TECHNIQUE="$2"; shift 2 ;;
            --technique=*)  DATASET_TECHNIQUE="${1#*=}"; shift ;;
            --row-count)    DATASET_ROW_COUNT="$2"; shift 2 ;;
            --row-count=*)  DATASET_ROW_COUNT="${1#*=}"; shift ;;
            --column-schema) DATASET_COLUMN_SCHEMA="$2"; shift 2 ;;
            --column-schema=*) DATASET_COLUMN_SCHEMA="${1#*=}"; shift ;;
            --name)         DATASET_NAME="$2"; shift 2 ;;  # alternate to positional
            --name=*)       DATASET_NAME="${1#*=}"; shift ;;
            # Legacy compat: --dataset-* prefixed args
            --dataset-name) DATASET_NAME="$2"; shift 2 ;;
            --dataset-s3-uri) DATASET_S3_URI="$2"; shift 2 ;;
            --dataset-format) DATASET_FORMAT="$2"; shift 2 ;;
            --dataset-technique) DATASET_TECHNIQUE="$2"; shift 2 ;;
            --dataset-row-count) DATASET_ROW_COUNT="$2"; shift 2 ;;
            --dataset-column-schema) DATASET_COLUMN_SCHEMA="$2"; shift 2 ;;
            --force)        DATASET_FORCE=true; shift ;;
            --list|--list-datasets) DATASET_LIST=true; shift ;;
            --json)         DATASET_JSON=true; shift ;;
            --list-versions)
                DATASET_LIST_VERSIONS="$2"; shift 2 ;;
            --list-versions=*)
                DATASET_LIST_VERSIONS="${1#*=}"; shift ;;
            --discover)
                DATASET_DISCOVER="$2"; shift 2 ;;
            --discover=*)
                DATASET_DISCOVER="${1#*=}"; shift ;;
            --delete)
                DATASET_DELETE="$2"; shift 2
                # Optional trailing @v<N> version reference.
                if [ -n "${1:-}" ] && [[ "${1}" == @v* ]]; then
                    DATASET_DELETE_VERSION="$1"; shift
                fi
                ;;
            --delete=*)
                DATASET_DELETE="${1#*=}"; shift
                if [ -n "${1:-}" ] && [[ "${1}" == @v* ]]; then
                    DATASET_DELETE_VERSION="$1"; shift
                fi
                ;;
            --attribution)  DATASET_ATTRIBUTION="$2"; shift 2 ;;
            --attribution=*) DATASET_ATTRIBUTION="${1#*=}"; shift ;;
            --lineage)      DATASET_LINEAGE="$2"; shift 2 ;;
            --lineage=*)    DATASET_LINEAGE="${1#*=}"; shift ;;
            --origination)  DATASET_ORIGINATION="$2"; shift 2 ;;
            --origination=*) DATASET_ORIGINATION="${1#*=}"; shift ;;
            --application)  DATASET_APPLICATION="$2"; shift 2 ;;
            --application=*) DATASET_APPLICATION="${1#*=}"; shift ;;
            --help|-h) _show_usage; exit 0 ;;
            *) echo "⚠️  Unknown dataset option: $1"; _show_usage; exit 1 ;;
        esac
    done

    # ── Handle --list-versions: list all versions from the S3 sidecar ──────────
    if [ -n "${DATASET_LIST_VERSIONS}" ]; then
        lv_args=(list-dataset-versions --name "${DATASET_LIST_VERSIONS}" \
                 --core-bucket "${CORE_BUCKET}" --region "${AWS_REGION}")
        lv_stderr="$(mktemp)"
        if ! lv_output=$(python3 "${SCRIPT_DIR}/.register_helper.py" "${lv_args[@]}" 2>"${lv_stderr}"); then
            lv_json=$(echo "${lv_output}" | grep -E '^\{' | tail -1)
            err_msg=$(echo "${lv_json}" | python3 -c "import sys,json; print(json.load(sys.stdin).get('error','Dataset not found'))" 2>/dev/null) || err_msg="Dataset not found: ${DATASET_LIST_VERSIONS}"
            echo "❌ ${err_msg}"
            rm -f "${lv_stderr}"
            exit 1
        fi
        rm -f "${lv_stderr}"
        lv_json=$(echo "${lv_output}" | grep -E '^\{' | tail -1)

        if [ "${DATASET_JSON}" = true ]; then
            echo "${lv_json}" | python3 -c "import sys,json; print(json.dumps(json.load(sys.stdin), indent=2))" 2>/dev/null || echo "${lv_json}"
            exit 0
        fi

        echo ""
        echo "📦 Versions for dataset: ${DATASET_LIST_VERSIONS}"
        echo ""
        echo "${lv_json}" | python3 -c "
import sys, json
data = json.load(sys.stdin)
versions = data.get('versions', [])
if not versions:
    print('  (no versions recorded)')
else:
    print(f\"  {'VERSION':<10} {'ROWS':<10} {'HASH':<18} {'DATE':<22} S3 URI\")
    print(f\"  {'-------':<10} {'----':<10} {'----':<18} {'----':<22} ------\")
    for i, v in enumerate(versions, start=1):
        ver = str(v.get('version','') or '')[:10]
        rows = str(v.get('rows','') if v.get('rows') is not None else '')[:10]
        h = str(v.get('hash','') or '')[:18]
        d = str(v.get('date','') or '')[:22]
        uri = v.get('s3_uri','')
        print(f'  {ver:<10} {rows:<10} {h:<18} {d:<22} {uri}')
" 2>/dev/null || echo "  (could not render versions)"
        echo ""
        echo "  Pin a version: ./do/tune --dataset ${DATASET_LIST_VERSIONS}@v<N>"
        echo ""
        exit 0
    fi

    # ── Handle --discover: browse a HuggingFace dataset before registering ─────
    if [ -n "${DATASET_DISCOVER}" ]; then
        disc_args=(discover-dataset --hf-id "${DATASET_DISCOVER}" --region "${AWS_REGION}")
        [ -n "${DATASET_HF_SPLIT}" ] && disc_args+=(--hf-split "${DATASET_HF_SPLIT}")
        [ -n "${DATASET_NAME}" ] && disc_args+=(--name "${DATASET_NAME}")
        if [ -n "${HF_TOKEN_ARN:-${_PROFILE_secrets_hfToken:-}}" ]; then
            disc_args+=(--hf-secret-name "${HF_TOKEN_ARN:-${_PROFILE_secrets_hfToken:-}}")
        fi

        disc_stderr="$(mktemp)"
        if ! disc_output=$(python3 "${SCRIPT_DIR}/.register_helper.py" "${disc_args[@]}" 2>"${disc_stderr}"); then
            disc_json=$(echo "${disc_output}" | grep -E '^\{' | tail -1)
            err_msg=$(echo "${disc_json}" | python3 -c "import sys,json; print(json.load(sys.stdin).get('error','Discovery failed'))" 2>/dev/null) || err_msg="Discovery failed for ${DATASET_DISCOVER}"
            echo "❌ ${err_msg}"
            rm -f "${disc_stderr}"
            exit 1
        fi
        rm -f "${disc_stderr}"
        disc_json=$(echo "${disc_output}" | grep -E '^\{' | tail -1)

        if [ "${DATASET_JSON}" = true ]; then
            echo "${disc_json}" | python3 -c "import sys,json; print(json.dumps(json.load(sys.stdin), indent=2))" 2>/dev/null || echo "${disc_json}"
            exit 0
        fi

        echo ""
        echo "🔎 Discovering HuggingFace dataset: ${DATASET_DISCOVER}"
        echo ""
        echo "${disc_json}" | python3 -c "
import sys, json
d = json.load(sys.stdin)
splits = d.get('splits', [])
files_by_split = d.get('files_by_split', {})
row_counts = d.get('row_counts', {})
if not splits:
    print('  (no data files detected)')
else:
    for s in splits:
        rc = row_counts.get(s)
        rc_str = f'{rc} rows' if rc is not None else 'rows unknown'
        print(f'  Split: {s}  ({rc_str})')
        for f in files_by_split.get(s, []):
            print(f'    • {f}')
schema = d.get('schema')
if schema:
    src = d.get('schema_source') or ''
    print()
    print(f\"  Detected columns ({src}):\")
    print(f\"    {', '.join(schema)}\")
print()
rec = d.get('recommended_register')
if rec:
    print('  💡 Recommended:')
    print(f'      {rec}')
" 2>/dev/null || echo "  (could not render discovery)"
        echo ""
        exit 0
    fi

    # ── Handle --delete: remove a sidecar entry (never data bytes) ─────────────
    if [ -n "${DATASET_DELETE}" ]; then
        _del_target="${DATASET_DELETE}"
        _del_scope="dataset '${_del_target}' (all versions)"
        if [ -n "${DATASET_DELETE_VERSION}" ]; then
            _del_scope="version ${DATASET_DELETE_VERSION} of dataset '${_del_target}'"
        fi

        if [ "${DATASET_FORCE}" != true ]; then
            echo ""
            echo "⚠️  About to deregister ${_del_scope}."
            echo "   This removes ONLY the registry entry (S3 sidecar metadata)."
            echo "   The dataset data bytes under s3://${CORE_BUCKET}/datasets/${_del_target}/ are NOT deleted."
            echo ""
            printf "   Proceed? [y/N] "
            read -r _confirm
            case "${_confirm}" in
                y|Y|yes|YES) ;;
                *) echo "Aborted."; exit 0 ;;
            esac
        fi

        del_args=(delete-dataset --name "${_del_target}" \
                  --core-bucket "${CORE_BUCKET}" --region "${AWS_REGION}")
        [ -n "${DATASET_DELETE_VERSION}" ] && del_args+=(--version "${DATASET_DELETE_VERSION}")

        del_stderr="$(mktemp)"
        if ! del_output=$(python3 "${SCRIPT_DIR}/.register_helper.py" "${del_args[@]}" 2>"${del_stderr}"); then
            del_json=$(echo "${del_output}" | grep -E '^\{' | tail -1)
            err_msg=$(echo "${del_json}" | python3 -c "import sys,json; print(json.load(sys.stdin).get('error','Delete failed'))" 2>/dev/null) || err_msg="Delete failed for ${_del_target}"
            echo "❌ ${err_msg}"
            rm -f "${del_stderr}"
            exit 1
        fi
        rm -f "${del_stderr}"
        del_json=$(echo "${del_output}" | grep -E '^\{' | tail -1)

        if [ "${DATASET_JSON}" = true ]; then
            echo "${del_json}" | python3 -c "import sys,json; print(json.dumps(json.load(sys.stdin), indent=2))" 2>/dev/null || echo "${del_json}"
        else
            echo "✅ Deregistered ${_del_scope} (data bytes untouched)"
        fi
        exit 0
    fi

    # ── Handle --list: enumerate datasets from the S3 sidecars ─────────────────
    if [ "${DATASET_LIST}" = true ]; then
        echo ""
        echo "📦 Registered datasets:"
        echo ""
        _ds_output=$(python3 "${SCRIPT_DIR}/.register_helper.py" list-datasets \
            --core-bucket "${CORE_BUCKET}" --region "${AWS_REGION}" 2>/dev/null) || _ds_output=""
        _ds_json=$(echo "${_ds_output}" | grep -E '^\{' | tail -1)
        if [ -n "${_ds_json}" ]; then
            printf "  %-24s %-10s %-10s %-8s %s\n" "NAME" "TECHNIQUE" "LATEST" "ROWS" "S3 URI"
            printf "  %-24s %-10s %-10s %-8s %s\n" "----" "---------" "------" "----" "------"
            _count=$(echo "${_ds_json}" | python3 -c "
import sys, json
data = json.load(sys.stdin)
rows = data.get('local', [])
for ds in rows:
    name = ds.get('name','')[:24]
    tech = ds.get('technique','')[:10]
    latest = str(ds.get('latest_version','') or '')[:10]
    ver_count = ds.get('version_count', 1)
    if ver_count and ver_count > 1:
        latest = f'{latest} ({ver_count}v)'
    r = str(ds.get('row_count','') or '')[:8]
    uri = ds.get('s3_uri','')
    print(f'  {name:<24} {tech:<10} {latest:<10} {r:<8} {uri}')
print(len(rows), file=sys.stderr)
" 2>/dev/null) || _count=0
            _local_count=$(echo "${_ds_json}" | python3 -c "import sys,json; print(len(json.load(sys.stdin).get('local',[])))" 2>/dev/null) || _local_count=0
            if [ "${_local_count}" = "0" ]; then
                echo "  (none)"
            fi
        else
            echo "  (none)"
        fi
        echo ""
        echo "  Register: ./do/register dataset <name> --s3-uri <uri> --technique <sft|dpo>"
        echo "  Versions: python3 .register_helper.py list-dataset-versions --name <name> --core-bucket ${CORE_BUCKET}"
        echo ""
        exit 0
    fi

    # ── Resolve --from-tune: populate vars from do/config ──────────────────────
    if [ "${FROM_TUNE_FLAG}" = "true" ]; then
        # Resolve technique-specific or latest vars
        _resolve_technique="${FROM_TUNE_TECHNIQUE:-${TUNE_TECHNIQUE:-}}"
        _resolve_technique_upper=""
        if [ -n "${_resolve_technique}" ]; then
            _resolve_technique_upper=$(echo "${_resolve_technique}" | tr '[:lower:]' '[:upper:]')
        fi

        # Try technique-specific vars first, then fall back to latest
        _resolve_s3_uri=""
        _resolve_row_count=""
        _resolve_source=""
        if [ -n "${_resolve_technique_upper}" ]; then
            _var_s3="TUNE_DATASET_S3_URI_${_resolve_technique_upper}"
            _var_rows="TUNE_DATASET_ROW_COUNT_${_resolve_technique_upper}"
            _var_src="TUNE_DATASET_SOURCE_${_resolve_technique_upper}"
            _resolve_s3_uri="${!_var_s3:-}"
            _resolve_row_count="${!_var_rows:-}"
            _resolve_source="${!_var_src:-}"
        fi
        # Fall back to latest (non-technique-specific)
        [ -z "${_resolve_s3_uri}" ] && _resolve_s3_uri="${TUNE_DATASET_S3_URI:-}"
        [ -z "${_resolve_row_count}" ] && _resolve_row_count="${TUNE_DATASET_ROW_COUNT:-}"
        [ -z "${_resolve_source}" ] && _resolve_source="${TUNE_DATASET_SOURCE:-}"

        if [ -z "${_resolve_s3_uri}" ]; then
            echo "❌ No staged dataset found in do/config"
            echo "   Run ./do/tune --dataset <uri> first to stage a dataset."
            exit 1
        fi

        # Fill in from persisted tune state (don't override explicit flags)
        [ -z "${DATASET_S3_URI}" ] && DATASET_S3_URI="${_resolve_s3_uri}"
        [ "${DATASET_TECHNIQUE}" = "sft" ] && DATASET_TECHNIQUE="${_resolve_technique:-sft}"
        [ -z "${DATASET_ROW_COUNT}" ] && DATASET_ROW_COUNT="${_resolve_row_count}"

        # Derive name from source if not provided
        if [ -z "${DATASET_NAME}" ]; then
            _source="${_resolve_source}"
            _slug=""
            if [[ "${_source}" == hf://* ]]; then
                # Strip hf:// and take the repo name part
                _slug="${_source#hf://}"
                _slug="${_slug%%\?*}"       # remove ?file= params
                _slug="${_slug%%/*}"         # take org (if org/name, take org)
                # Actually take the name part after /
                if [[ "${TUNE_DATASET_SOURCE}" == */* ]]; then
                    _slug="${TUNE_DATASET_SOURCE#hf://*/}"
                    _slug="${_slug%%\?*}"
                    _slug="${_slug%%/*}"
                fi
            elif [[ "${_source}" == s3://* ]]; then
                _slug=$(basename "${_source}" .jsonl)
            fi
            _slug=$(echo "${_slug}" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9]/-/g' | sed 's/--*/-/g' | sed 's/^-//' | sed 's/-$//')
            # Salt with 4-char hash of S3 URI to prevent slug conflicts for
            # same repo with different preprocessing/split/technique
            _salt=$(echo "${DATASET_S3_URI}" | shasum | cut -c1-4)
            DATASET_NAME="${_slug:-dataset}-${_salt}"
        fi
    fi

# ── Evaluator subcommand arg parsing ──────────────────────────────────────────
elif [ "${SUBCOMMAND}" = "evaluator" ]; then
    # First positional arg is the evaluator name
    if [ $# -gt 0 ] && [[ "${1}" != -* ]]; then
        EVALUATOR_NAME="$1"; shift
