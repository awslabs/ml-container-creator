# ── Dataset subcommand arg parsing ────────────────────────────────────────────
if [ "${SUBCOMMAND}" = "dataset" ]; then
    FROM_TUNE_FLAG=""
    FROM_TUNE_TECHNIQUE=""
    # First positional arg is the dataset name
    if [ $# -gt 0 ] && [[ "${1}" != -* ]]; then
        DATASET_NAME="$1"; shift
    fi
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --from-tune)
                FROM_TUNE_FLAG="true"
                # Check if next arg is a technique (not another flag)
                if [ -n "${2:-}" ] && [[ "${2}" != -* ]]; then
                    FROM_TUNE_TECHNIQUE="$2"; shift 2
                else
                    shift
                fi
                ;;
            --s3-uri)       DATASET_S3_URI="$2"; shift 2 ;;
            --s3-uri=*)     DATASET_S3_URI="${1#*=}"; shift ;;
            --hf-id)        DATASET_HF_ID="$2"; shift 2 ;;
            --hf-id=*)      DATASET_HF_ID="${1#*=}"; shift ;;
            --hf-split)     DATASET_HF_SPLIT="$2"; shift 2 ;;
            --hf-split=*)   DATASET_HF_SPLIT="${1#*=}"; shift ;;
            --hf-files)     DATASET_HF_FILES="$2"; shift 2 ;;
            --hf-files=*)   DATASET_HF_FILES="${1#*=}"; shift ;;
            --column-map)   DATASET_COLUMN_MAP="$2"; shift 2 ;;
            --column-map=*) DATASET_COLUMN_MAP="${1#*=}"; shift ;;
            --format)       DATASET_FORMAT="$2"; shift 2 ;;
            --format=*)     DATASET_FORMAT="${1#*=}"; shift ;;
            --technique)    DATASET_TECHNIQUE="$2"; shift 2 ;;
            --technique=*)  DATASET_TECHNIQUE="${1#*=}"; shift ;;
            --description)  DATASET_DESCRIPTION="$2"; shift 2 ;;
            --description=*) DATASET_DESCRIPTION="${1#*=}"; shift ;;
            --row-count)    DATASET_ROW_COUNT="$2"; shift 2 ;;
            --row-count=*)  DATASET_ROW_COUNT="${1#*=}"; shift ;;
            --column-schema) DATASET_COLUMN_SCHEMA="$2"; shift 2 ;;
            --column-schema=*) DATASET_COLUMN_SCHEMA="${1#*=}"; shift ;;
            --name)         DATASET_NAME="$2"; shift 2 ;;  # alternate to positional
            --name=*)       DATASET_NAME="${1#*=}"; shift ;;
            # Legacy compat: --dataset-* prefixed args
            --dataset-name) DATASET_NAME="$2"; shift 2 ;;
            --dataset-s3-uri) DATASET_S3_URI="$2"; shift 2 ;;
            --dataset-format) DATASET_FORMAT="$2"; shift 2 ;;
            --dataset-technique) DATASET_TECHNIQUE="$2"; shift 2 ;;
            --dataset-row-count) DATASET_ROW_COUNT="$2"; shift 2 ;;
            --dataset-column-schema) DATASET_COLUMN_SCHEMA="$2"; shift 2 ;;
            --force)        DATASET_FORCE=true; shift ;;
            --list|--list-datasets) DATASET_LIST=true; shift ;;
            --all)          DATASET_LIST_ALL=true; shift ;;  # BL163: list/resolve across every project
            --json)         DATASET_JSON=true; shift ;;
            --list-versions)
                DATASET_LIST_VERSIONS="$2"; shift 2 ;;
            --list-versions=*)
                DATASET_LIST_VERSIONS="${1#*=}"; shift ;;
            --discover)
                DATASET_DISCOVER="$2"; shift 2 ;;
            --discover=*)
                DATASET_DISCOVER="${1#*=}"; shift ;;
            --delete)
                DATASET_DELETE="$2"; shift 2
                # Optional trailing @v<N> version reference.
                if [ -n "${1:-}" ] && [[ "${1}" == @v* ]]; then
                    DATASET_DELETE_VERSION="$1"; shift
                fi
                ;;
            --delete=*)
                DATASET_DELETE="${1#*=}"; shift
                if [ -n "${1:-}" ] && [[ "${1}" == @v* ]]; then
                    DATASET_DELETE_VERSION="$1"; shift
                fi
                ;;
            --attribution)  DATASET_ATTRIBUTION="$2"; shift 2 ;;
            --attribution=*) DATASET_ATTRIBUTION="${1#*=}"; shift ;;
            --lineage)      DATASET_LINEAGE="$2"; shift 2 ;;
            --lineage=*)    DATASET_LINEAGE="${1#*=}"; shift ;;
            --origination)  DATASET_ORIGINATION="$2"; shift 2 ;;
            --origination=*) DATASET_ORIGINATION="${1#*=}"; shift ;;
            --application)  DATASET_APPLICATION="$2"; shift 2 ;;
            --application=*) DATASET_APPLICATION="${1#*=}"; shift ;;
            --help|-h) _show_usage; exit 0 ;;
            *) echo "⚠️  Unknown dataset option: $1"; _show_usage; exit 1 ;;
        esac
    done

    # ── Handle --list-versions: list all versions from the S3 sidecar ──────────
    if [ -n "${DATASET_LIST_VERSIONS}" ]; then
        lv_args=(list-dataset-versions --name "${DATASET_LIST_VERSIONS}" \
                 --core-bucket "${CORE_BUCKET}" --region "${AWS_REGION}")
        lv_stderr="$(mktemp)"
        if ! lv_output=$(python3 "${SCRIPT_DIR}/.register_helper.py" "${lv_args[@]}" 2>"${lv_stderr}"); then
            # BL165: the stderr was previously captured then discarded, so a
            # helper crash read as "Dataset not found". Surface it.
            _surface_helper_failure "Could not list versions for dataset '${DATASET_LIST_VERSIONS}'" \
                "${lv_output}" "${lv_stderr}" \
                "List datasets: ./do/register dataset --list"
            exit 1
        fi
        rm -f "${lv_stderr}"
        lv_json=$(echo "${lv_output}" | grep -E '^\{' | tail -1)

        if [ "${DATASET_JSON}" = true ]; then
            # Pretty-print only; on a parse failure the raw JSON is echoed instead,
            # so nothing is lost by discarding python's stderr here.
            echo "${lv_json}" | python3 -c "import sys,json; print(json.dumps(json.load(sys.stdin), indent=2))" 2>/dev/null || echo "${lv_json}"
            exit 0
        fi

        echo ""
        echo "📦 Versions for dataset: ${DATASET_LIST_VERSIONS}"
        echo ""
        echo "${lv_json}" | python3 -c "
import sys, json
data = json.load(sys.stdin)
versions = data.get('versions', [])
if not versions:
    print('  (no versions recorded)')
else:
    print(f\"  {'VERSION':<10} {'ROWS':<10} {'HASH':<18} {'DATE':<22} S3 URI\")
    print(f\"  {'-------':<10} {'----':<10} {'----':<18} {'----':<22} ------\")
    for i, v in enumerate(versions, start=1):
        ver = str(v.get('version','') or '')[:10]
        rows = str(v.get('rows','') if v.get('rows') is not None else '')[:10]
        h = str(v.get('hash','') or '')[:18]
        d = str(v.get('date','') or '')[:22]
        uri = v.get('s3_uri','')
        print(f'  {ver:<10} {rows:<10} {h:<18} {d:<22} {uri}')
" || echo "  (could not render versions — see error above; raw: ./do/register dataset --list-versions ${DATASET_LIST_VERSIONS} --json)"
        echo ""
        echo "  Pin a version: ./do/tune --dataset ${DATASET_LIST_VERSIONS}@v<N>"
        echo ""
        exit 0
    fi

    # ── Handle --discover: browse a HuggingFace dataset before registering ─────
    if [ -n "${DATASET_DISCOVER}" ]; then
        disc_args=(discover-dataset --hf-id "${DATASET_DISCOVER}" --region "${AWS_REGION}")
        [ -n "${DATASET_HF_SPLIT}" ] && disc_args+=(--hf-split "${DATASET_HF_SPLIT}")
        [ -n "${DATASET_NAME}" ] && disc_args+=(--name "${DATASET_NAME}")
        if [ -n "${HF_TOKEN_ARN:-${_PROFILE_secrets_hfToken:-}}" ]; then
            disc_args+=(--hf-secret-name "${HF_TOKEN_ARN:-${_PROFILE_secrets_hfToken:-}}")
        fi

        disc_stderr="$(mktemp)"
        if ! disc_output=$(python3 "${SCRIPT_DIR}/.register_helper.py" "${disc_args[@]}" 2>"${disc_stderr}"); then
            # BL165: surface the helper's real stderr (was captured then discarded).
            _surface_helper_failure "Discovery failed for ${DATASET_DISCOVER}" \
                "${disc_output}" "${disc_stderr}" \
                "Check the HF dataset id and (for gated datasets) your HF token secret."
            exit 1
        fi
        rm -f "${disc_stderr}"
        disc_json=$(echo "${disc_output}" | grep -E '^\{' | tail -1)

        if [ "${DATASET_JSON}" = true ]; then
            # Pretty-print only; raw JSON is echoed on a parse failure (safe).
            echo "${disc_json}" | python3 -c "import sys,json; print(json.dumps(json.load(sys.stdin), indent=2))" 2>/dev/null || echo "${disc_json}"
            exit 0
        fi

        echo ""
        echo "🔎 Discovering HuggingFace dataset: ${DATASET_DISCOVER}"
        echo ""
        echo "${disc_json}" | python3 -c "
import sys, json
d = json.load(sys.stdin)
splits = d.get('splits', [])
files_by_split = d.get('files_by_split', {})
row_counts = d.get('row_counts', {})
if not splits:
    print('  (no data files detected)')
else:
    for s in splits:
        rc = row_counts.get(s)
        rc_str = f'{rc} rows' if rc is not None else 'rows unknown'
        print(f'  Split: {s}  ({rc_str})')
        for f in files_by_split.get(s, []):
            print(f'    • {f}')
schema = d.get('schema')
if schema:
    src = d.get('schema_source') or ''
    print()
    print(f\"  Detected columns ({src}):\")
    print(f\"    {', '.join(schema)}\")
print()
rec = d.get('recommended_register')
if rec:
    print('  💡 Recommended:')
    print(f'      {rec}')
" || echo "  (could not render discovery — see error above; raw: ./do/register dataset --discover ${DATASET_DISCOVER} --json)"
        echo ""
        exit 0
    fi

    # ── Handle --delete: remove a sidecar entry (never data bytes) ─────────────
    if [ -n "${DATASET_DELETE}" ]; then
        _del_target="${DATASET_DELETE}"
        _del_scope="dataset '${_del_target}' (all versions)"
        if [ -n "${DATASET_DELETE_VERSION}" ]; then
            _del_scope="version ${DATASET_DELETE_VERSION} of dataset '${_del_target}'"
        fi

        if [ "${DATASET_FORCE}" != true ]; then
            echo ""
            echo "⚠️  About to deregister ${_del_scope}."
            echo "   This removes ONLY the registry entry (S3 sidecar metadata)."
            echo "   The dataset data bytes under s3://${CORE_BUCKET}/datasets/${_del_target}/ are NOT deleted."
            echo ""
            printf "   Proceed? [y/N] "
            read -r _confirm
            case "${_confirm}" in
                y|Y|yes|YES) ;;
                *) echo "Aborted."; exit 0 ;;
            esac
        fi

        del_args=(delete-dataset --name "${_del_target}" \
                  --core-bucket "${CORE_BUCKET}" --region "${AWS_REGION}" \
                  --project-name "${PROJECT_NAME}")
        [ -n "${DATASET_DELETE_VERSION}" ] && del_args+=(--version "${DATASET_DELETE_VERSION}")

        del_stderr="$(mktemp)"
        if ! del_output=$(python3 "${SCRIPT_DIR}/.register_helper.py" "${del_args[@]}" 2>"${del_stderr}"); then
            # BL165/BL172: surface the helper's real stderr — a swallowed error on
            # this path is how the MLflow soft-delete stayed a silent no-op.
            _surface_helper_failure "Delete failed for ${_del_target}" \
                "${del_output}" "${del_stderr}" \
                "Inspect the registry: ./do/register dataset --list-versions ${_del_target}"
            exit 1
        fi
        # On success the helper's stderr carries only progress / best-effort
        # warnings (e.g. MLflow soft-delete skipped) — show them, don't drop them.
        if [ -s "${del_stderr}" ]; then
            sed 's/^/   /' "${del_stderr}" >&2
        fi
        rm -f "${del_stderr}"
        del_json=$(echo "${del_output}" | grep -E '^\{' | tail -1)

        if [ "${DATASET_JSON}" = true ]; then
            # Pretty-print only; raw JSON is echoed on a parse failure (safe).
            echo "${del_json}" | python3 -c "import sys,json; print(json.dumps(json.load(sys.stdin), indent=2))" 2>/dev/null || echo "${del_json}"
        else
            echo "✅ Deregistered ${_del_scope} (data bytes untouched)"
        fi
        exit 0
    fi

    # ── Handle --list: enumerate datasets from the S3 sidecars ─────────────────
    if [ "${DATASET_LIST}" = true ]; then
        echo ""
        echo "📦 Registered datasets:"
        echo ""
        _ls_args=(list-datasets --core-bucket "${CORE_BUCKET}" --region "${AWS_REGION}" \
                  --project-name "${PROJECT_NAME}")
        [ "${DATASET_LIST_ALL}" = true ] && _ls_args+=(--all)
        # BL165: a failed list-datasets used to read as "(none)" — a silent
        # no-op that hid AccessDenied / helper crashes. Surface and exit non-zero.
        _ls_stderr="$(mktemp)"
        if ! _ds_output=$(python3 "${SCRIPT_DIR}/.register_helper.py" "${_ls_args[@]}" 2>"${_ls_stderr}"); then
            _surface_helper_failure "Could not list registered datasets" \
                "${_ds_output}" "${_ls_stderr}" \
                "Check AWS credentials and the core bucket (${CORE_BUCKET:-unset})."
            exit 1
        fi
        rm -f "${_ls_stderr}"
        _ds_json=$(echo "${_ds_output}" | grep -E '^\{' | tail -1)
        if [ -n "${_ds_json}" ]; then
            printf "  %-24s %-10s %-10s %-8s %s\n" "NAME" "TECHNIQUE" "LATEST" "ROWS" "S3 URI"
            printf "  %-24s %-10s %-10s %-8s %s\n" "----" "---------" "------" "----" "------"
            echo "${_ds_json}" | python3 -c "
import sys, json
data = json.load(sys.stdin)
rows = data.get('local', [])
for ds in rows:
    name = ds.get('name','')[:24]
    tech = ds.get('technique','')[:10]
    latest = str(ds.get('latest_version','') or '')[:10]
    ver_count = ds.get('version_count', 1)
    if ver_count and ver_count > 1:
        latest = f'{latest} ({ver_count}v)'
    r = str(ds.get('row_count','') or '')[:8]
    uri = ds.get('s3_uri','')
    print(f'  {name:<24} {tech:<10} {latest:<10} {r:<8} {uri}')
" || echo "  (could not render dataset list — see error above)"
            # Count-only probe on the same JSON the renderer just consumed; a parse
            # failure was already surfaced by the renderer above, so 0 is safe here.
            _local_count=$(echo "${_ds_json}" | python3 -c "import sys,json; print(len(json.load(sys.stdin).get('local',[])))" 2>/dev/null) || _local_count=0
            if [ "${_local_count}" = "0" ]; then
                echo "  (none)"
            fi
        else
            echo "  (none)"
        fi
        echo ""
        echo "  Register: ./do/register dataset <name> --s3-uri <uri> --technique <sft|dpo>"
        echo "  Versions: python3 .register_helper.py list-dataset-versions --name <name> --core-bucket ${CORE_BUCKET}"
        echo ""
        exit 0
    fi

    # ── Resolve --from-tune: populate vars from do/config ──────────────────────
    if [ "${FROM_TUNE_FLAG}" = "true" ]; then
        # Resolve technique-specific or latest vars
        _resolve_technique="${FROM_TUNE_TECHNIQUE:-${TUNE_TECHNIQUE:-}}"
        _resolve_technique_upper=""
        if [ -n "${_resolve_technique}" ]; then
            _resolve_technique_upper=$(echo "${_resolve_technique}" | tr '[:lower:]' '[:upper:]')
        fi

        # Try technique-specific vars first, then fall back to latest
        _resolve_s3_uri=""
        _resolve_row_count=""
        _resolve_source=""
        if [ -n "${_resolve_technique_upper}" ]; then
            _var_s3="TUNE_DATASET_S3_URI_${_resolve_technique_upper}"
            _var_rows="TUNE_DATASET_ROW_COUNT_${_resolve_technique_upper}"
            _var_src="TUNE_DATASET_SOURCE_${_resolve_technique_upper}"
            _resolve_s3_uri="${!_var_s3:-}"
            _resolve_row_count="${!_var_rows:-}"
            _resolve_source="${!_var_src:-}"
        fi
        # Fall back to latest (non-technique-specific)
        [ -z "${_resolve_s3_uri}" ] && _resolve_s3_uri="${TUNE_DATASET_S3_URI:-}"
        [ -z "${_resolve_row_count}" ] && _resolve_row_count="${TUNE_DATASET_ROW_COUNT:-}"
        [ -z "${_resolve_source}" ] && _resolve_source="${TUNE_DATASET_SOURCE:-}"

        if [ -z "${_resolve_s3_uri}" ]; then
            echo "❌ No staged dataset found in do/config"
            echo "   Run ./do/tune --dataset <uri> first to stage a dataset."
            exit 1
        fi

        # Fill in from persisted tune state (don't override explicit flags)
        [ -z "${DATASET_S3_URI}" ] && DATASET_S3_URI="${_resolve_s3_uri}"
        [ "${DATASET_TECHNIQUE}" = "benchmark" ] && DATASET_TECHNIQUE="${_resolve_technique:-sft}"
        [ -z "${DATASET_ROW_COUNT}" ] && DATASET_ROW_COUNT="${_resolve_row_count}"

        # Derive name from source if not provided
        if [ -z "${DATASET_NAME}" ]; then
            _source="${_resolve_source}"
            _slug=""
            if [[ "${_source}" == hf://* ]]; then
                # Strip hf:// and take the repo name part
                _slug="${_source#hf://}"
                _slug="${_slug%%\?*}"       # remove ?file= params
                _slug="${_slug%%/*}"         # take org (if org/name, take org)
                # Actually take the name part after /
                if [[ "${TUNE_DATASET_SOURCE}" == */* ]]; then
                    _slug="${TUNE_DATASET_SOURCE#hf://*/}"
                    _slug="${_slug%%\?*}"
                    _slug="${_slug%%/*}"
                fi
            elif [[ "${_source}" == s3://* ]]; then
                _slug=$(basename "${_source}" .jsonl)
            fi
            _slug=$(echo "${_slug}" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9]/-/g' | sed 's/--*/-/g' | sed 's/^-//' | sed 's/-$//')
            # Salt with 4-char hash of S3 URI to prevent slug conflicts for
            # same repo with different preprocessing/split/technique
            _salt=$(echo "${DATASET_S3_URI}" | shasum | cut -c1-4)
            DATASET_NAME="${_slug:-dataset}-${_salt}"
        fi
    fi

# ── Evaluator subcommand arg parsing ──────────────────────────────────────────
elif [ "${SUBCOMMAND}" = "evaluator" ]; then
    # First positional arg is the evaluator name
    if [ $# -gt 0 ] && [[ "${1}" != -* ]]; then
        EVALUATOR_NAME="$1"; shift
    fi
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --type)         EVALUATOR_TYPE="$2"; shift 2 ;;
            --type=*)       EVALUATOR_TYPE="${1#*=}"; shift ;;
            --arn)          EVALUATOR_ARN_OR_URI="$2"; shift 2 ;;
            --arn=*)        EVALUATOR_ARN_OR_URI="${1#*=}"; shift ;;
            --arn-or-uri)   EVALUATOR_ARN_OR_URI="$2"; shift 2 ;;
            --arn-or-uri=*) EVALUATOR_ARN_OR_URI="${1#*=}"; shift ;;
            --technique)    EVALUATOR_TECHNIQUE="$2"; shift 2 ;;
            --technique=*)  EVALUATOR_TECHNIQUE="${1#*=}"; shift ;;
            --from-sample)  EVALUATOR_FROM_SAMPLE=true
                            # Optional sample id if the next arg isn't a flag.
                            if [ -n "${2:-}" ] && [[ "${2}" != -* ]]; then
                                EVALUATOR_SAMPLE_ID="$2"; shift 2
                            else
                                shift
                            fi ;;
            --sample-id)    EVALUATOR_SAMPLE_ID="$2"; shift 2 ;;
            --sample-id=*)  EVALUATOR_SAMPLE_ID="${1#*=}"; shift ;;
            --finalize)     EVALUATOR_FINALIZE=true; shift ;;
            --force)        EVALUATOR_FORCE=true; shift ;;
            --list)         EVALUATOR_LIST=true; shift ;;
            --description)  EVALUATOR_DESCRIPTION="$2"; shift 2 ;;
            --description=*) EVALUATOR_DESCRIPTION="${1#*=}"; shift ;;
            --name)         EVALUATOR_NAME="$2"; shift 2 ;;  # alternate to positional
            --name=*)       EVALUATOR_NAME="${1#*=}"; shift ;;
            # Legacy compat
            --evaluator-name) EVALUATOR_NAME="$2"; shift 2 ;;
            --evaluator-type) EVALUATOR_TYPE="$2"; shift 2 ;;
            --evaluator-arn-or-uri) EVALUATOR_ARN_OR_URI="$2"; shift 2 ;;
            --evaluator-technique) EVALUATOR_TECHNIQUE="$2"; shift 2 ;;
            --evaluator-description) EVALUATOR_DESCRIPTION="$2"; shift 2 ;;
            --help|-h) _show_usage; exit 0 ;;
            *) echo "⚠️  Unknown evaluator option: $1"; _show_usage; exit 1 ;;
        esac
    done

# ── Prompt subcommand arg parsing (REWARD_PROMPT / RLAIF) ──────────────────────
elif [ "${SUBCOMMAND}" = "prompt" ]; then
    # First positional arg is the prompt evaluator name
    if [ $# -gt 0 ] && [[ "${1}" != -* ]]; then
        PROMPT_NAME="$1"; shift
    fi
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --prompt)       PROMPT_URI="$2"; shift 2 ;;
            --prompt=*)     PROMPT_URI="${1#*=}"; shift ;;
            --prompt-file)  PROMPT_FILE="$2"; shift 2 ;;
            --prompt-file=*) PROMPT_FILE="${1#*=}"; shift ;;
            --list)         PROMPT_LIST=true; shift ;;
            --name)         PROMPT_NAME="$2"; shift 2 ;;  # alternate to positional
            --name=*)       PROMPT_NAME="${1#*=}"; shift ;;
            --description)  PROMPT_DESCRIPTION="$2"; shift 2 ;;
            --description=*) PROMPT_DESCRIPTION="${1#*=}"; shift ;;
            --help|-h) _show_usage; exit 0 ;;
            *) echo "⚠️  Unknown prompt option: $1"; _show_usage; exit 1 ;;
        esac
    done

# ── Model subcommand arg parsing (default) ────────────────────────────────────
else
    while [[ $# -gt 0 ]]; do
        case "$1" in
        --notes)
            NOTES="$2"
            shift 2
            ;;
        --notes=*)
            NOTES="${1#*=}"
            shift
            ;;
        --status)
            STATUS="$2"
            shift 2
            ;;
        --status=*)
            STATUS="${1#*=}"
            shift
            ;;
        --project)
            PROJECT_FLAG="--project"
            shift
            ;;
        --json)
            JSON_OUTPUT=true
            shift
            ;;
        --ci)
            CI_MODE=true
            JSON_OUTPUT=true
            shift
            ;;
        --ci-table)
            CI_TABLE_NAME="$2"
            shift 2
            ;;
        --ci-table=*)
            CI_TABLE_NAME="${1#*=}"
            shift
            ;;
        --build-strategy)
            CI_BUILD_STRATEGY="$2"
            shift 2
            ;;
        --build-strategy=*)
            CI_BUILD_STRATEGY="${1#*=}"
            shift
            ;;
        --benchmark-status)
            BENCHMARK_STATUS="$2"
            shift 2
            ;;
        --benchmark-status=*)
            BENCHMARK_STATUS="${1#*=}"
            shift
            ;;
        --benchmark-run-id)
            BENCHMARK_RUN_ID="$2"
            shift 2
            ;;
        --benchmark-run-id=*)
            BENCHMARK_RUN_ID="${1#*=}"
            shift
            ;;
        --exclude)
            EXCLUDE_ADAPTERS="${EXCLUDE_ADAPTERS:+${EXCLUDE_ADAPTERS},}$2"
            shift 2
            ;;
        --exclude=*)
            EXCLUDE_ADAPTERS="${EXCLUDE_ADAPTERS:+${EXCLUDE_ADAPTERS},}${1#*=}"
            shift
            ;;
        --base-only)
            BASE_ONLY=true
            shift
            ;;
        --with-endpoint)
            _require_guard deployment-active
            WITH_ENDPOINT=true
            shift
            ;;
        --with-metrics)
            _require_guard deployment-active
            WITH_METRICS=true
            shift
            ;;
        --ic)
            echo "⚠️  '--ic' is deprecated — use '--with-endpoint'" >&2
            _require_guard deployment-active
            WITH_ENDPOINT=true
            shift
            ;;
        *)
            echo "⚠️  Unknown option: $1"
            _show_usage
            exit 1
            ;;
    esac
done
fi

# ============================================================
# Handle --benchmark-status mode (Stage 2 failure isolation)
# This mode ONLY writes benchmark fields to DynamoDB.
# It uses an UpdateExpression that sets ONLY:
#   lastBenchmarkRunId, lastBenchmarkTimestamp, lastBenchmarkStatus
# It does NOT touch testStatus, configJson, or any other fields.
# This ensures Stage 2 failure does not change the CI gate result.
# Requirements: 1.4, 7.3
# ============================================================

if [ -n "${BENCHMARK_STATUS}" ]; then
    # Validate benchmark status
    case "${BENCHMARK_STATUS}" in
        completed|failed|in-progress) ;;
        *)
            echo "❌ Invalid benchmark status: ${BENCHMARK_STATUS}"
            echo "   Valid values: completed, failed, in-progress"
            exit 1
            ;;
    esac

    if [ -z "${BENCHMARK_RUN_ID}" ]; then
        echo "❌ --benchmark-run-id is required when using --benchmark-status"
        exit 1
    fi

    # Compute configId (same hash logic used by write_ci_record below)
    _benchmark_input="${DEPLOYMENT_CONFIG}:${MODEL_NAME:-none}:${INSTANCE_TYPE}:${AWS_REGION}:${DEPLOYMENT_TARGET}:ic${IC_COUNT:-1}:adapt${ADAPTER_COUNT:-0}"
    if command -v sha256sum &> /dev/null; then
        CONFIG_ID=$(echo -n "$_benchmark_input" | sha256sum | cut -c1-16)
    else
        CONFIG_ID=$(echo -n "$_benchmark_input" | shasum -a 256 | cut -c1-16)
    fi
    BENCHMARK_TIMESTAMP=$(date -u +%Y-%m-%dT%H:%M:%SZ)

    echo "📊 Recording benchmark status for configId: ${CONFIG_ID}"
    echo "   Benchmark run ID:  ${BENCHMARK_RUN_ID}"
    echo "   Benchmark status:  ${BENCHMARK_STATUS}"
    echo "   Timestamp:         ${BENCHMARK_TIMESTAMP}"
    echo ""

    # Check if CI_Table exists
    if ! aws dynamodb describe-table --table-name "${CI_TABLE_NAME}" --region "${AWS_REGION}" &>/dev/null; then
        echo "⚠️  CI infrastructure not provisioned. Run 'ml-container-creator bootstrap' with CI enabled."
        echo "   Skipping benchmark status write."
        exit 0
    fi

    # UpdateExpression ONLY sets the 3 benchmark fields.
    # This is a SET operation — it does NOT overwrite the entire record (PutItem).
    # testStatus, configJson, and all other fields remain unchanged.
    _bs_stderr="$(mktemp)"
    if aws dynamodb update-item \
        --region "${AWS_REGION}" \
        --table-name "${CI_TABLE_NAME}" \
        --key "{\"configId\": {\"S\": \"${CONFIG_ID}\"}}" \
        --update-expression "SET lastBenchmarkRunId = :rid, lastBenchmarkTimestamp = :ts, lastBenchmarkStatus = :bs" \
        --expression-attribute-values "{
            \":rid\": {\"S\": \"${BENCHMARK_RUN_ID}\"},
            \":ts\": {\"S\": \"${BENCHMARK_TIMESTAMP}\"},
            \":bs\": {\"S\": \"${BENCHMARK_STATUS}\"}
        }" 2>"${_bs_stderr}"; then
        rm -f "${_bs_stderr}"
        echo "✅ Benchmark status recorded: ${BENCHMARK_STATUS}"
    else
        # BL165: surface the DynamoDB error (AccessDenied, validation) instead of
        # discarding it.
        _surface_helper_failure "Failed to write benchmark status for configId: ${CONFIG_ID}" \
            "" "${_bs_stderr}" \
            "Check DynamoDB permissions on table ${CI_TABLE_NAME} (region ${AWS_REGION})."
        exit 1
    fi

    exit 0
fi

# ============================================================
# Handle dataset mode — move a dataset to the canonical MLCC
# datasets location and register the resulting URI.
#
#   Canonical destination: s3://<CORE_BUCKET>/datasets/<name>/
#
# Input source is exactly one of:
#   --s3-uri <s3://...>  Copy an existing S3 dataset (cp for a single object,
#                        sync for a directory/prefix).
#   --hf-id <org/name>   Stage a HuggingFace dataset via the stage-hf Processing
#                        Job (same mechanism as do/tune --dataset hf://org/name).
# ============================================================

if [ "${SUBCOMMAND}" = "dataset" ]; then
    if [ -z "${DATASET_NAME}" ]; then
        echo "❌ Dataset name is required"
        echo "   Usage: ./do/register dataset <name> (--s3-uri <s3://...> | --hf-id <org/name>)"
        exit 1
    fi

    # Exactly one of --s3-uri / --hf-id must be provided.
    if [ -n "${DATASET_S3_URI}" ] && [ -n "${DATASET_HF_ID}" ]; then
        echo "❌ --s3-uri and --hf-id are mutually exclusive — provide only one"
        exit 1
    fi
    if [ -z "${DATASET_S3_URI}" ] && [ -z "${DATASET_HF_ID}" ]; then
        echo "❌ Provide a dataset source: --s3-uri <s3://...> or --hf-id <org/name>"
        echo "   Usage: ./do/register dataset <name> (--s3-uri <s3://...> | --hf-id <org/name>)"
        exit 1
    fi

    # Validate technique. Each label maps to a native AI Registry
    # CustomizationTechnique member: sft→SFT, dpo→DPO, and rlvr/rlaif/mtrl all land
    # on the RLVR member (their training input is a prompt corpus of the same
    # shape; the intended technique is recorded in the sidecar). benchmark is
    # sidecar-only (an AIPerf BYOD corpus, not a customization input).
    case "${DATASET_TECHNIQUE}" in
        sft|dpo|rlvr|rlaif|mtrl|benchmark) ;;
        *)
            echo "❌ Invalid technique: ${DATASET_TECHNIQUE}"
            echo "   Valid values: sft, dpo, rlvr, rlaif, mtrl, benchmark"
            exit 1
            ;;
    esac

    # Resolve CORE_BUCKET (mlcc-core) — required for the canonical location.
    if [ -z "${CORE_BUCKET}" ]; then
        _require_bucket CORE_S3_BUCKET || true
        echo "   (or set CORE_BUCKET explicitly.)"
        exit 1
    fi

    # Canonical destination for this dataset.
    CANONICAL_S3_URI="s3://${CORE_BUCKET}/datasets/${DATASET_NAME}/"

    echo "📋 Registering dataset: ${DATASET_NAME}"
    echo "   Destination: ${CANONICAL_S3_URI}"
    echo "   Technique:   ${DATASET_TECHNIQUE}"
    echo ""

    # ── Resolve the canonical URI depending on the input source ───────────────
    REGISTERED_S3_URI=""
    RESOLVED_ROW_COUNT="${DATASET_ROW_COUNT}"

    if [ -n "${DATASET_S3_URI}" ]; then
        # ── S3 source: copy to the canonical location ────────────────────────
        if [[ "${DATASET_S3_URI}" != s3://* ]]; then
            echo "❌ --s3-uri must be an s3:// URI (got: ${DATASET_S3_URI})"
            exit 1
        fi

        echo "📦 Copying S3 dataset to canonical location"
        echo "   Source: ${DATASET_S3_URI}"
        echo "   Target: ${CANONICAL_S3_URI}"

        # Decide cp vs sync: a trailing slash (or no object suffix) denotes a
        # directory/prefix, which requires 'aws s3 sync'; a single object uses 'cp'.
        if [[ "${DATASET_S3_URI}" == */ ]]; then
            _s3_cmd=(aws s3 sync "${DATASET_S3_URI}" "${CANONICAL_S3_URI}")
        else
            _s3_cmd=(aws s3 cp "${DATASET_S3_URI}" "${CANONICAL_S3_URI}")
        fi
        [ -n "${AWS_REGION:-}" ] && _s3_cmd+=(--region "${AWS_REGION}")

        if ! "${_s3_cmd[@]}"; then
            echo "❌ Failed to copy dataset to ${CANONICAL_S3_URI}"
            exit 1
        fi
        echo "   ✅ Copied to ${CANONICAL_S3_URI}"
        echo ""

        REGISTERED_S3_URI="${CANONICAL_S3_URI}"

    else
        # ── HuggingFace source: stage via the stage-hf Processing Job ────────
        # Mirror do/tune's stage-hf invocation. org/name (and optional split) are
        # parsed from --hf-id (org/name) plus --hf-split.
        _hf_id="${DATASET_HF_ID}"
        _hf_org="${_hf_id%%/*}"
        _hf_name="${_hf_id#*/}"

        if [ -z "${_hf_org}" ] || [ -z "${_hf_name}" ] || [ "${_hf_org}" = "${_hf_id}" ]; then
            echo "❌ Invalid --hf-id: ${DATASET_HF_ID}"
            echo "   Expected format: org/name (e.g., timdettmers/openassistant-guanaco)"
            exit 1
        fi

        echo "📦 Staging HuggingFace dataset: ${_hf_org}/${_hf_name}"
        if [ -n "${DATASET_HF_SPLIT}" ]; then
            echo "   Split: ${DATASET_HF_SPLIT}"
        else
            echo "   Split: train (default)"
        fi

        # Build stage-hf arguments (same helper + flags as do/tune).
        # BL099: pin the staged output to the canonical, project-independent
        # location on the mlcc-core bucket:
        #   s3://<CORE_BUCKET>/datasets/<name>/
        # --output-bucket is CORE_BUCKET (mlcc-core), NOT the CI source bucket, and
        # --output-prefix omits the project-name prefix so the dataset is a shared,
        # cross-project cache keyed by the registered dataset <name> (not org/name).
        # This matches the sidecar location datasets/<name>/_dataset.json.
        stage_args=(
            --hf-org "${_hf_org}"
            --hf-name "${_hf_name}"
            --output-bucket "${CORE_BUCKET}"
            --output-prefix "datasets/${DATASET_NAME}"
            --project-name "${PROJECT_NAME}"
            --region "${AWS_REGION}"
            --technique "${DATASET_TECHNIQUE}"
        )
        if [ -n "${DATASET_HF_SPLIT}" ]; then
            stage_args+=(--hf-split "${DATASET_HF_SPLIT}")
        fi
        # BL121: --hf-files selects specific files within the HF repo. Passed to
        # the stage-hf helper as --hf-file (glob or substring pattern), which
        # feeds load_dataset(data_files=pattern).
        if [ -n "${DATASET_HF_FILES}" ]; then
            stage_args+=(--hf-file "${DATASET_HF_FILES}")
        fi
        if [ -n "${HF_TOKEN_ARN:-${_PROFILE_secrets_hfToken:-}}" ]; then
            stage_args+=(--hf-secret-name "${HF_TOKEN_ARN:-${_PROFILE_secrets_hfToken:-}}")
        fi
        if [ -n "${DATASET_COLUMN_MAP}" ]; then
            stage_args+=(--column-map "${DATASET_COLUMN_MAP}")
        fi
        # --row-count is passed to staging as --take (number of records to keep).
        if [ -n "${DATASET_ROW_COUNT}" ]; then
            stage_args+=(--take "${DATASET_ROW_COUNT}")
        fi

        stage_stderr="$(mktemp)"
        # Capture stdout (JSON) and stderr (tracebacks) separately so a helper
        # crash surfaces the real cause instead of a generic message.
        if ! stage_result=$(python3 "${HELPER_SCRIPT}" stage-hf "${stage_args[@]}" 2>"${stage_stderr}"); then
            # Parse-only fallback: the real cause is printed from stage_stderr below.
            error_msg=$(echo "${stage_result}" | python3 -c "import sys,json; print(json.load(sys.stdin).get('error','Failed to stage dataset'))" 2>/dev/null) || error_msg="Failed to stage HF dataset"
            echo "❌ ${error_msg}"
            if [ -s "${stage_stderr}" ]; then
                echo "   ── helper error output ──────────────────────────────"
                sed 's/^/   /' "${stage_stderr}"
                echo "   ─────────────────────────────────────────────────────"
            fi
            rm -f "${stage_stderr}"
            exit 1
        fi
        rm -f "${stage_stderr}"

        # Check for error in response. These JSON field reads are parse-only and
        # fail CLOSED (unparseable → treated as an error / empty URI → explicit
        # "❌" below), so discarding python's stderr cannot hide a failure.
        has_error=$(echo "${stage_result}" | python3 -c "import sys,json; d=json.load(sys.stdin); print('yes' if 'error' in d else 'no')" 2>/dev/null) || has_error="yes"
        if [ "${has_error}" = "yes" ]; then
            error_msg=$(echo "${stage_result}" | python3 -c "import sys,json; print(json.load(sys.stdin).get('error','Unknown error'))" 2>/dev/null) || error_msg="Unknown error"
            echo "❌ ${error_msg}"
            if [ "${error_msg}" = "Unknown error" ]; then
                echo "   Raw staging output: ${stage_result:-<empty>}"
            fi
            exit 1
        fi

        REGISTERED_S3_URI=$(echo "${stage_result}" | python3 -c "import sys,json; print(json.load(sys.stdin)['s3_uri'])" 2>/dev/null) || REGISTERED_S3_URI=""
        _staged_rows=$(echo "${stage_result}" | python3 -c "import sys,json; print(json.load(sys.stdin).get('num_records',0))" 2>/dev/null) || _staged_rows=""
        [ -z "${RESOLVED_ROW_COUNT}" ] && RESOLVED_ROW_COUNT="${_staged_rows}"

        if [ -z "${REGISTERED_S3_URI}" ]; then
            echo "❌ Staging returned no S3 URI"
            exit 1
        fi

        echo "   ✅ Staged to: ${REGISTERED_S3_URI}"
        [ -n "${_staged_rows}" ] && echo "   Records: ${_staged_rows}"
        echo ""
    fi

    # ── Register the canonical URI in the dataset registry ────────────────────
    echo "📝 Registering canonical dataset URI"
    echo "   URI:       ${REGISTERED_S3_URI}"
    echo "   Format:    ${DATASET_FORMAT}"
    echo "   Technique: ${DATASET_TECHNIQUE}"
    echo ""

    # Build register-dataset args
    DS_ARGS=(
        "register-dataset"
        "--name" "${DATASET_NAME}"
        "--s3-uri" "${REGISTERED_S3_URI}"
        "--format" "${DATASET_FORMAT}"
        "--technique" "${DATASET_TECHNIQUE}"
    )

    if [ -n "${RESOLVED_ROW_COUNT}" ]; then
        DS_ARGS+=("--row-count" "${RESOLVED_ROW_COUNT}")
    fi

    if [ -n "${DATASET_COLUMN_SCHEMA}" ]; then
        DS_ARGS+=("--column-schema" "${DATASET_COLUMN_SCHEMA}")
    fi

    if [ -n "${DATASET_DESCRIPTION}" ]; then
        DS_ARGS+=("--description" "${DATASET_DESCRIPTION}")
    fi

    DS_ARGS+=("--project-name" "${PROJECT_NAME}")
    DS_ARGS+=("--region" "${AWS_REGION}")
    DS_ARGS+=("--core-bucket" "${CORE_BUCKET}")

    if [ -n "${DATASET_ATTRIBUTION}" ]; then
        DS_ARGS+=("--attribution" "${DATASET_ATTRIBUTION}")
    fi
    if [ -n "${DATASET_LINEAGE}" ]; then
        DS_ARGS+=("--lineage" "${DATASET_LINEAGE}")
    fi
    if [ -n "${DATASET_ORIGINATION}" ]; then
        DS_ARGS+=("--origination" "${DATASET_ORIGINATION}")
    fi
    if [ -n "${DATASET_APPLICATION}" ]; then
        DS_ARGS+=("--application" "${DATASET_APPLICATION}")
    fi

    if [ "${DATASET_FORCE}" = true ]; then
        DS_ARGS+=("--force")
    fi

    # Call .register_helper.py register-dataset.
    # BL165/BL171: stderr is captured, not discarded — it carries the helper's
    # best-effort warnings (e.g. native AI Registry registration failed because of
    # an illegal hub-content name) and, on failure, the real cause.
    ds_stderr="$(mktemp)"
    if ds_output=$(python3 "${SCRIPT_DIR}/.register_helper.py" "${DS_ARGS[@]}" 2>"${ds_stderr}"); then
        if [ -s "${ds_stderr}" ]; then
            sed 's/^/   /' "${ds_stderr}" >&2
        fi
        rm -f "${ds_stderr}"
        ds_json=$(echo "${ds_output}" | grep -E '^\{' | tail -1)
        if [ -n "${ds_json}" ]; then
            echo "✅ Dataset registered successfully"
            # Pretty-print only; raw JSON is echoed on a parse failure (safe).
            echo "${ds_json}" | python3 -c "import sys,json; print(json.dumps(json.load(sys.stdin), indent=2))" 2>/dev/null || echo "${ds_json}"
        else
            echo "⚠️  Dataset registration returned no JSON output"
        fi
    else
        _surface_helper_failure "Dataset registration failed" \
            "${ds_output}" "${ds_stderr}" \
            "Check the error above, AWS credentials, and the core bucket (${CORE_BUCKET:-unset})."
        exit 1
    fi

    exit 0
fi

# ============================================================
# Handle --evaluator mode (register evaluator, AC-2c.1)
# ============================================================

if [ "${SUBCOMMAND}" = "evaluator" ]; then
    # Back-compat: the old form was `--type lambda|model`. `lambda`/`function`
    # stay on this code-based reward-function path; `model`/`prompt` reroute to
    # the `prompt` verb (REWARD_PROMPT). Map the ARN alias to the prompt URI.
    case "${EVALUATOR_TYPE}" in
        model|prompt)
            echo "ℹ️  --type ${EVALUATOR_TYPE} is deprecated; routing to \`do/register prompt\`."
            SUBCOMMAND="prompt"
            PROMPT_NAME="${EVALUATOR_NAME}"
            PROMPT_URI="${EVALUATOR_ARN_OR_URI}"
            PROMPT_DESCRIPTION="${EVALUATOR_DESCRIPTION}"
            ;;
    esac
fi

if [ "${SUBCOMMAND}" = "evaluator" ]; then
    # ── --list: enumerate registered REWARD_FUNCTION evaluators (B) ───────────
    if [ "${EVALUATOR_LIST}" = true ]; then
        if le_output=$(python3 "${SCRIPT_DIR}/.register_helper.py" list-evaluators \
            --evaluator-type reward_function --region "${AWS_REGION}"); then
            echo "${le_output}"
        else
            echo "❌ Could not list reward-function evaluators"
            exit 1
        fi
        exit 0
    fi

    if [ -z "${EVALUATOR_NAME}" ]; then
        echo "❌ Evaluator name is required"
        echo "   Usage: ./do/register evaluator <name> --arn <lambda-arn>   (or --from-sample [<id>])"
        exit 1
    fi

    # Default technique is rlvr; mtrl also uses a code-based reward function.
    [ -z "${EVALUATOR_TECHNIQUE}" ] && EVALUATOR_TECHNIQUE="rlvr"

    EV_ARGS=(
        "register-evaluator"
        "--name" "${EVALUATOR_NAME}"
        "--technique" "${EVALUATOR_TECHNIQUE}"
        "--region" "${AWS_REGION}"
    )

    if [ "${EVALUATOR_FROM_SAMPLE}" = true ]; then
        # Editable-sample on-ramp (Req 1A). Without --finalize this materializes
        # an editable reward function and stops so the user edits it first.
        if [ "${EVALUATOR_FINALIZE}" = true ]; then
            echo "📋 Finalizing reward-function sample: ${EVALUATOR_NAME}"
        else
            echo "📋 Materializing reward-function sample: ${EVALUATOR_NAME}"
        fi
        EV_ARGS+=("--from-sample")
        [ -n "${EVALUATOR_SAMPLE_ID}" ] && EV_ARGS+=("--sample-id" "${EVALUATOR_SAMPLE_ID}")
        [ "${EVALUATOR_FINALIZE}" = true ] && EV_ARGS+=("--finalize")
        [ "${EVALUATOR_FORCE}" = true ] && EV_ARGS+=("--force")
    else
        # Bring-your-own-Lambda (ARN) — the primary path.
        if [ -z "${EVALUATOR_ARN_OR_URI}" ]; then
            echo "❌ --arn is required (ARN of an existing reward-function Lambda)."
            echo "   No Lambda yet? Seed an editable one:"
            echo "     ./do/register evaluator ${EVALUATOR_NAME} --from-sample"
            exit 1
        fi
        echo "📋 Registering reward-function evaluator: ${EVALUATOR_NAME}"
        echo "   Lambda ARN:  ${EVALUATOR_ARN_OR_URI}"
        echo "   Technique:   ${EVALUATOR_TECHNIQUE}"
        EV_ARGS+=("--arn" "${EVALUATOR_ARN_OR_URI}")
    fi
    [ -n "${EVALUATOR_DESCRIPTION}" ] && EV_ARGS+=("--description" "${EVALUATOR_DESCRIPTION}")
    EV_ARGS+=("--project-name" "${PROJECT_NAME}")
    echo ""

    # stderr is shown so the user sees skip/guidance messages from the helper.
    # Reward-code backups go to the core bucket's evaluators/<name>/ (bucket
    # consolidation R3.9; key composed by s3_layout.py) — passed explicitly.
    if ev_output=$(CORE_S3_BUCKET="${CORE_BUCKET:-}" python3 "${SCRIPT_DIR}/.register_helper.py" "${EV_ARGS[@]}"); then
        ev_json=$(echo "${ev_output}" | grep -E '^\{' | tail -1)
        if [ -n "${ev_json}" ]; then
            echo "✅ Evaluator registered"
            # Pretty-print only; raw JSON is echoed on a parse failure (safe).
            echo "${ev_json}" | python3 -c "import sys,json; print(json.dumps(json.load(sys.stdin), indent=2))" 2>/dev/null || echo "${ev_json}"
        else
            echo "⚠️  Evaluator registration returned no JSON output"
        fi
    else
        echo "❌ Evaluator registration failed"
        exit 1
    fi

    exit 0
fi

# ============================================================
# Handle prompt mode (register a reward prompt — REWARD_PROMPT / RLAIF)
# ============================================================

if [ "${SUBCOMMAND}" = "prompt" ]; then
    # ── --list: enumerate registered REWARD_PROMPT evaluators (B) ─────────────
    if [ "${PROMPT_LIST}" = true ]; then
        if lp_output=$(python3 "${SCRIPT_DIR}/.register_helper.py" list-evaluators \
            --evaluator-type reward_prompt --region "${AWS_REGION}"); then
            echo "${lp_output}"
        else
            echo "❌ Could not list reward prompts"
            exit 1
        fi
        exit 0
    fi

    if [ -z "${PROMPT_NAME}" ]; then
        echo "❌ Prompt name is required"
        echo "   Usage: ./do/register prompt <name> (--prompt-file <local.txt> | --prompt <s3-uri>)"
        exit 1
    fi
    if [ -n "${PROMPT_URI}" ] && [ -n "${PROMPT_FILE}" ]; then
        echo "❌ --prompt and --prompt-file are mutually exclusive — provide only one"
        exit 1
    fi
    if [ -z "${PROMPT_URI}" ] && [ -z "${PROMPT_FILE}" ]; then
        echo "❌ Provide the reward prompt: --prompt-file <local file> (auto-uploaded) or --prompt <s3-uri>"
        exit 1
    fi

    # ── --prompt-file: auto-upload a LOCAL file to the canonical core-bucket
    #    location, then register that URI (A). Mirrors the dataset path's
    #    canonicalization (s3://<CORE_BUCKET>/datasets/<name>/) so users don't
    #    hand-run `aws s3 cp`. Destination: s3://<CORE_BUCKET>/reward-prompts/<name><ext>.
    if [ -n "${PROMPT_FILE}" ]; then
        if [ ! -f "${PROMPT_FILE}" ]; then
            echo "❌ --prompt-file not found: ${PROMPT_FILE}"
            exit 1
        fi
        if [ -z "${CORE_BUCKET}" ]; then
            echo "❌ No mlcc-core bucket recorded in profile (codebuildSourceS3Bucket is empty)."
            echo "   Run 'ml-container-creator bootstrap' to provision it, or set CORE_BUCKET,"
            echo "   or pass an already-staged file via --prompt <s3-uri>."
            exit 1
        fi
        _pf_ext="${PROMPT_FILE##*.}"
        if [ "${_pf_ext}" = "${PROMPT_FILE}" ]; then _pf_ext="txt"; fi  # no extension → .txt
        PROMPT_URI="s3://${CORE_BUCKET}/reward-prompts/${PROMPT_NAME}.${_pf_ext}"
        echo "📦 Uploading reward prompt to canonical location"
        echo "   Source: ${PROMPT_FILE}"
        echo "   Target: ${PROMPT_URI}"
        _pf_cmd=(aws s3 cp "${PROMPT_FILE}" "${PROMPT_URI}")
        [ -n "${AWS_REGION:-}" ] && _pf_cmd+=(--region "${AWS_REGION}")
        if ! "${_pf_cmd[@]}"; then
            echo "❌ Failed to upload reward prompt to ${PROMPT_URI}"
            exit 1
        fi
        echo "   ✅ Uploaded"
        echo ""
    elif [[ "${PROMPT_URI}" != s3://* ]]; then
        echo "❌ --prompt must be an s3:// URI (got: ${PROMPT_URI}). For a local file use --prompt-file."
        exit 1
    fi

    echo "📋 Registering reward prompt: ${PROMPT_NAME}"
    echo "   Prompt S3 URI: ${PROMPT_URI}"
    if [ -n "${PROMPT_DESCRIPTION}" ]; then
        echo "   Description:   ${PROMPT_DESCRIPTION}"
    fi
    echo ""

    PR_ARGS=(
        "register-prompt"
        "--name" "${PROMPT_NAME}"
        "--prompt" "${PROMPT_URI}"
        "--region" "${AWS_REGION}"
    )
    [ -n "${PROMPT_DESCRIPTION}" ] && PR_ARGS+=("--description" "${PROMPT_DESCRIPTION}")
    PR_ARGS+=("--project-name" "${PROJECT_NAME}")

    if pr_output=$(python3 "${SCRIPT_DIR}/.register_helper.py" "${PR_ARGS[@]}"); then
        pr_json=$(echo "${pr_output}" | grep -E '^\{' | tail -1)
        if [ -n "${pr_json}" ]; then
            echo "✅ Reward prompt registered"
            # Pretty-print only; raw JSON is echoed on a parse failure (safe).
            echo "${pr_json}" | python3 -c "import sys,json; print(json.dumps(json.load(sys.stdin), indent=2))" 2>/dev/null || echo "${pr_json}"
        else
            echo "⚠️  Prompt registration returned no JSON output"
        fi
    else
        echo "❌ Prompt registration failed"
        exit 1
    fi

    exit 0
fi

# Validate status
case "${STATUS}" in
    success|partial|failed) ;;
    *)
        echo "❌ Invalid status: ${STATUS}"
        echo "   Valid values: success, partial, failed"
        exit 1
        ;;
esac

# ============================================================
# Build IC list from do/ic/ directory (multi-IC support)
# ============================================================

<% if (deploymentTarget === 'realtime-inference') { %>
IC_LIST_JSON="[]"
if [ -d "${SCRIPT_DIR}/ic" ]; then
    # Build IC list from all conf files (alphabetical order)
    IC_ENTRIES=""
    IC_COUNT=0
    for conf in "${SCRIPT_DIR}"/ic/*.conf; do
        [ -f "${conf}" ] || continue

        # Source the IC config to get its variables.
        # Optional-read swallows (kept): an IC conf is a user-editable shell
        # fragment; a malformed one degrades to the documented defaults
        # (gpu=1, copy=1) for this informational registry record rather than
        # aborting registration. `cat ... || echo "|||"` is the same fallback.
        (
            # Subshell to avoid polluting current environment
            source "${conf}" 2>/dev/null
            echo "${IC_DEPLOYED_NAME:-}|${IC_IMAGE_TAG:-}|${IC_GPU_COUNT:-1}|${IC_COPY_COUNT:-1}"
        ) > /tmp/ic_entry_$$ 2>/dev/null

        IC_ENTRY=$(cat /tmp/ic_entry_$$ 2>/dev/null || echo "|||")
        rm -f /tmp/ic_entry_$$

        IC_BASENAME=$(basename "${conf}" .conf)
        IC_ENTRY_IMAGE=$(echo "${IC_ENTRY}" | cut -d'|' -f2)
        IC_ENTRY_GPU=$(echo "${IC_ENTRY}" | cut -d'|' -f3)
        IC_ENTRY_COPY=$(echo "${IC_ENTRY}" | cut -d'|' -f4)

        if [ -n "${IC_ENTRIES}" ]; then
            IC_ENTRIES="${IC_ENTRIES},"
        fi
        IC_ENTRIES="${IC_ENTRIES}{\"name\":\"${IC_BASENAME}\",\"image\":\"${IC_ENTRY_IMAGE}\",\"gpuCount\":${IC_ENTRY_GPU:-1},\"copyCount\":${IC_ENTRY_COPY:-1}}"
        IC_COUNT=$((IC_COUNT + 1))
    done

    if [ "${CI_MODE}" = true ] && [ ${IC_COUNT} -gt 1 ]; then
        # CI mode: only include the first IC (alphabetically) to keep CI costs down
        # Existence probe (no conf → empty, handled below); same optional
        # IC-conf read semantics as the loop above.
        FIRST_CONF=$(ls "${SCRIPT_DIR}"/ic/*.conf 2>/dev/null | head -1)
        if [ -n "${FIRST_CONF}" ]; then
            (
                source "${FIRST_CONF}" 2>/dev/null
                echo "${IC_DEPLOYED_NAME:-}|${IC_IMAGE_TAG:-}|${IC_GPU_COUNT:-1}|${IC_COPY_COUNT:-1}"
            ) > /tmp/ic_first_$$ 2>/dev/null

            FIRST_ENTRY=$(cat /tmp/ic_first_$$ 2>/dev/null || echo "|||")
            rm -f /tmp/ic_first_$$

            FIRST_BASENAME=$(basename "${FIRST_CONF}" .conf)
            FIRST_IMAGE=$(echo "${FIRST_ENTRY}" | cut -d'|' -f2)
            FIRST_GPU=$(echo "${FIRST_ENTRY}" | cut -d'|' -f3)
            FIRST_COPY=$(echo "${FIRST_ENTRY}" | cut -d'|' -f4)

            IC_LIST_JSON="[{\"name\":\"${FIRST_BASENAME}\",\"image\":\"${FIRST_IMAGE}\",\"gpuCount\":${FIRST_GPU:-1},\"copyCount\":${FIRST_COPY:-1}}]"
        fi
    else
        IC_LIST_JSON="[${IC_ENTRIES}]"
    fi
else
    # Legacy: single IC from do/config
    IC_LIST_JSON="[{\"name\":\"default\",\"image\":\"${PROJECT_NAME}-latest\",\"gpuCount\":${IC_GPU_COUNT:-1},\"copyCount\":${IC_COPY_COUNT:-1}}]"
fi

# Append adapter entries from do/adapters/*.conf
ADAPTER_COUNT=0
if [ -d "${SCRIPT_DIR}/adapters" ]; then
    ADAPTER_ENTRIES=""
    for conf in "${SCRIPT_DIR}"/adapters/*.conf; do
        [ -f "${conf}" ] || continue
        [[ "$(basename "${conf}")" == ".gitkeep" ]] && continue

        ADAPTER_NAME_VAL=""
        ADAPTER_WEIGHTS_VAL=""
        ADAPTER_IC_VAL=""
        # Optional-key probes: a key absent from the conf is normal (grep exits 1,
        # eval of "" is a no-op) and falls back to the defaults just below.
        eval "$(grep '^export ADAPTER_NAME=' "${conf}" 2>/dev/null)"
        eval "$(grep '^export ADAPTER_WEIGHTS_URI=' "${conf}" 2>/dev/null)"
        eval "$(grep '^export ADAPTER_IC_NAME=' "${conf}" 2>/dev/null)"
        ADAPTER_NAME_VAL="${ADAPTER_NAME:-$(basename "${conf}" .conf)}"
        ADAPTER_WEIGHTS_VAL="${ADAPTER_WEIGHTS_URI:-}"
        ADAPTER_IC_VAL="${ADAPTER_IC_NAME:-}"

        if [ -n "${ADAPTER_ENTRIES}" ]; then
            ADAPTER_ENTRIES="${ADAPTER_ENTRIES},"
        fi
        ADAPTER_ENTRIES="${ADAPTER_ENTRIES}{\"name\":\"${ADAPTER_NAME_VAL}\",\"isAdapter\":true,\"baseIcName\":\"${ADAPTER_IC_VAL}\",\"artifactUrl\":\"${ADAPTER_WEIGHTS_VAL}\",\"gpuCount\":0,\"copyCount\":1}"
        ADAPTER_COUNT=$((ADAPTER_COUNT + 1))
        unset ADAPTER_NAME ADAPTER_WEIGHTS_URI ADAPTER_IC_NAME
    done

    if [ -n "${ADAPTER_ENTRIES}" ] && [ "${IC_LIST_JSON}" != "[]" ]; then
        # Append adapters to existing IC list
        IC_LIST_JSON="${IC_LIST_JSON%]},${ADAPTER_ENTRIES}]"
    elif [ -n "${ADAPTER_ENTRIES}" ]; then
        IC_LIST_JSON="[${ADAPTER_ENTRIES}]"
    fi
fi
<% } %>

