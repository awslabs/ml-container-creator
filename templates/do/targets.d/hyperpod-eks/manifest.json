{
  "target": "hyperpod-eks",
  "aliases": ["hyperpod"],
  "status_var": "DEPLOYMENT_TARGET_HP_STATUS",
  "answer_key": "deploymentTargetHpStatus",
  "success_status": "Running",
  "family": "kubernetes",
  "deploy_script": "deploy.d/hyperpod-eks",
  "clean_script": "clean.d/hyperpod-eks",
  "required_vars": ["INSTANCE_TYPE", "HP_CLUSTER_NAME"],
  "optional_vars": {
    "HP_GPU_COUNT": "auto",
    "HP_NAMESPACE": "default",
    "HP_REPLICAS": "1",
    "HP_QUEUE": "",
    "HP_INSTANCE_GROUP_NAME": ""
  },
  "runtime_owned_vars": [
    "DEPLOYMENT_TARGET_HP_STATUS",
    "HP_CLUSTER_NAME",
    "HP_NAMESPACE",
    "HP_INSTANCE_TYPE",
    "HP_GPU_COUNT",
    "HP_CPU_REQUEST",
    "HP_MEM_REQUEST",
    "KUBECONFIG",
    "HP_BENCHMARK_METRICS_ENABLED",
    "TRAIN_HP_INSTANCE_GROUP",
    "TRAIN_HP_NAMESPACE"
  ],
  "serving_config_source": "kubernetes",
  "cluster_contract": { "script": "lib/python/hyperpod_ops.py", "entry": "preflight-env" },
  "adapter_delivery": { "strategy": "model-prefix", "mount_path": "/opt/ml/model", "subdir": ".mlcc-adapters" },
  "pricing": { "service": "AmazonSageMaker", "component": "Cluster", "instance_count": { "basis": "replicas", "replicas_var": "HP_REPLICAS", "gpus_per_replica_var": "HP_GPU_COUNT" } },
  "compute_backends": ["smtj", "hp-eks"],
  "scale_to_zero": { "support": "pod-only", "mechanism": "hyperpod-autoscalingspec", "wake_signal": null, "requests_at_zero": "unknown", "idle_billing": "nodes-still-billed", "enabled": false, "reason": "scaling pods to zero on fixed HyperPod instance groups saves no node cost; scaling nodes to zero needs Karpenter NodePools, which is cluster provisioning MLCC does not do (ADR-012, ADR-014)" },
  "verbs": {
    "optimize": true,
    "add-ic": false,
    "add-pod": true,
    "ci": false,
    "adapter": true,
    "draft": true,
    "metrics": true
  },
  "observability": {
    "store": "amp",
    "histogram_form": "classic",
    "selector": { "deployment": "resource_name", "namespace": "namespace" },
    "gpu_selector": { "deployment": "container", "namespace": "namespace" },
    "fallback": "engine-scrape",
    "dashboard": "hyperpod-amg",
    "amp_discovery": {
      "addon": "amazon-sagemaker-hyperpod-observability",
      "endpoint_key": "ampWorkspace.prometheusEndpoint",
      "amg_name_key": "amgWorkspace.workspaceName"
    }
  },
  "answer_params": [
    { "answerKey": "target", "configVar": "DEPLOYMENT_TARGET", "flag": "--target", "roles": ["flag-input", "prompt-core"] },
    { "answerKey": "instance_type", "configVar": "INSTANCE_TYPE", "flag": "--instance-type", "roles": ["flag-input", "prompt-core"] },
    { "answerKey": "cluster_name", "configVar": "HP_CLUSTER_NAME", "flag": "--cluster-name", "roles": ["flag-input"] },
    { "answerKey": "namespace", "configVar": "HP_NAMESPACE", "flag": "--namespace", "roles": ["flag-input"] },
    { "answerKey": "replicas", "configVar": "HP_REPLICAS", "flag": "--replicas", "roles": ["flag-input"] },
    { "answerKey": "queue", "configVar": "HP_QUEUE", "flag": "--queue", "roles": ["flag-input"] },
    { "answerKey": "gpu_count", "configVar": "IC_GPU_COUNT", "flag": "--gpu-count", "roles": ["flag-input"] },
    { "answerKey": "hp_gpu_count", "configVar": "HP_GPU_COUNT", "roles": ["internal"] },
    { "answerKey": "hp_instance_group_name", "configVar": "HP_INSTANCE_GROUP_NAME", "roles": ["internal", "input-only"] },
    { "answerKey": "hp_instance_type", "configVar": "HP_INSTANCE_TYPE", "roles": ["builder-output"] }
  ]
}
