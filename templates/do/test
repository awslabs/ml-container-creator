                if echo "${RESPONSE_BODY}" | python3 -c "
import sys, json, base64
resp = json.load(sys.stdin)
img_data = base64.b64decode(resp['data'][0]['b64_json'])
with open('${OUTPUT_IMAGE}', 'wb') as f:
