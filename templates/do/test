import sys, json
resp = json.load(sys.stdin)
assert 'data' in resp, 'Missing data array'
assert len(resp['data']) > 0, 'Empty data array'
assert 'b64_json' in resp['data'][0], 'Missing b64_json in data entry'
" 2>/dev/null; then
