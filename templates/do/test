    echo "  • Deploy to SageMaker: ./do/deploy"
else
    echo "Async endpoint is ready for production use!"
    echo "  • Endpoint name: ${ENDPOINT_NAME}"
    echo "  • Region: ${AWS_REGION}"
    echo "  • S3 output: ${ASYNC_S3_OUTPUT_PATH}"
    echo ""
    echo "📝 Register this deployment:"
    echo "  ./do/register"
fi

