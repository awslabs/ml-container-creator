# ── SIGINT Trap ───────────────────────────────────────────────────────────────
trap '_handle_interrupt' INT

_handle_interrupt() {
    echo ""
    echo ""
    echo "⚠️  Interrupted — training job continues in background."
    if [ "${TRAIN_BACKEND_RESOLVED:-}" = "hp-eks" ]; then
        echo "   The HyperPodPyTorchJob keeps running (and holding its GPUs) until --status sees it finish."
    else
        echo "   The job will keep running in SageMaker."
    fi
    echo "   Re-run ./do/train to resume polling, or ./do/train --status to check progress."
    exit 130
}

# ── _parse_args() ─────────────────────────────────────────────────────────────
# Parse CLI flags into variables.
_parse_args() {
    while [ $# -gt 0 ]; do
        case "$1" in
            --force) ARG_FORCE=true; shift ;;
            --status) ARG_STATUS=true; shift ;;
            --stop) ARG_STOP=true; shift ;;
            --backend|--instance-group|--instance-type|--gpus|--startup-timeout|--stall-timeout|--scratch-size|--storage-class)
                if [ -z "${2:-}" ] || [[ "${2}" == -* ]]; then
                    echo "❌ $1 requires a value"
                    exit 2
                fi
                case "$1" in
                    --backend) ARG_BACKEND="$2" ;;
                    --instance-group) ARG_INSTANCE_GROUP="$2" ;;
                    --instance-type) ARG_INSTANCE_TYPE="$2" ;;
                    --gpus) ARG_GPUS="$2" ;;
                    --startup-timeout) ARG_STARTUP_TIMEOUT="$2" ;;
                    --stall-timeout) ARG_STALL_TIMEOUT="$2" ;;
                    --scratch-size) ARG_SCRATCH_SIZE="$2" ;;
                    --storage-class) ARG_STORAGE_CLASS="$2" ;;
                esac
                shift 2 ;;
            --dry-run) ARG_DRY_RUN=true; shift ;;
            --no-wait) ARG_NO_WAIT=true; shift ;;
            --technique)
                if [ -z "${2:-}" ]; then
                    echo "❌ --technique requires a value"
                    echo "   Available: $(_list_techniques)"
                    exit 1
                fi
                ARG_TECHNIQUE="$2"; shift 2 ;;
            --dataset)
                if [ -z "${2:-}" ]; then
                    echo "❌ --dataset requires a value (s3://..., hf://..., or registry name)"
                    exit 1
                fi
                ARG_DATASET="$2"; shift 2 ;;
            --column-map)
                if [ -z "${2:-}" ]; then
                    echo "❌ --column-map requires a value (e.g., prompt=question,completion=answer)"
                    exit 1
                fi
                ARG_COLUMN_MAP="$2"; shift 2 ;;
            --list-datasets) ARG_LIST_DATASETS=true; shift ;;
            --no-register) ARG_NO_REGISTER=true; shift ;;
            --interactive|-i) ARG_INTERACTIVE=true; shift ;;
            # BL154: generic per-knob setter, repeatable. Keyed by the knob name train.py
            # reads. Validated against the technique's manifest.json when it has one.
            --set)
                if [ -z "${2:-}" ] || [[ "$2" != *=* ]] || [[ "$2" == =* ]]; then
                    echo "❌ --set requires KNOB=VALUE (e.g., --set learning_rate=1e-4)"
                    exit 1
                fi
                SET_KNOBS+=("$2"); shift 2 ;;
            --advanced) ARG_ADVANCED=true; shift ;;
            --allow-unknown) ARG_ALLOW_UNKNOWN=true; shift ;;
            # Legacy hyperparameter flags: kept as aliases that populate the SAME
            # SET_KNOBS map as --set <canonical_key>=VALUE (R5).
            --learning-rate)
                if [ -z "${2:-}" ]; then echo "❌ --learning-rate requires a value"; exit 1; fi
                ARG_LEARNING_RATE="$2"; SET_KNOBS+=("learning_rate=$2"); shift 2 ;;
            --epochs)
                if [ -z "${2:-}" ]; then echo "❌ --epochs requires a value"; exit 1; fi
                ARG_EPOCHS="$2"; SET_KNOBS+=("epochs=$2"); shift 2 ;;
            --batch-size)
                if [ -z "${2:-}" ]; then echo "❌ --batch-size requires a value"; exit 1; fi
                ARG_BATCH_SIZE="$2"; SET_KNOBS+=("batch_size=$2"); shift 2 ;;
            --lora-r)
                if [ -z "${2:-}" ]; then echo "❌ --lora-r requires a value"; exit 1; fi
                ARG_LORA_R="$2"; SET_KNOBS+=("lora_r=$2"); shift 2 ;;
            --beta)
                if [ -z "${2:-}" ]; then echo "❌ --beta requires a value"; exit 1; fi
                ARG_BETA="$2"; SET_KNOBS+=("beta=$2"); shift 2 ;;
            --resume)
                ARG_RESUME=true
                # Optional: next arg is a job name (not another flag)
                if [ -n "${2:-}" ] && [[ "${2}" != -* ]]; then
                    ARG_RESUME_JOB="$2"; shift 2
                else
                    shift
                fi
                ;;
            --help|-h) ARG_HELP=true; shift ;;
            *)
                echo "❌ Unknown option: $1"
                echo "   Run ./do/train --help for usage."
                exit 1
                ;;
        esac
    done
}

