{
  "$schema": "../manifest.schema.json",
  "schema_version": 1,
  "technique": "sft",
  "display_name": "Supervised Fine-Tuning (SFT)",
  "description": "SFT-specific settings: TRL SFTTrainer + PEFT LoRA on a text/instruction dataset.",
  "hyperparameters": {
    "learning_rate": {
      "type": "number",
      "required": false,
      "tier": "primary",
      "display_name": "Learning rate",
      "description": "optimizer learning rate"
    },
    "epochs": {
      "type": "integer",
      "required": false,
      "min": 1,
      "tier": "primary",
      "display_name": "Epochs",
      "description": "number of passes over the dataset"
    },
    "batch_size": {
      "type": "integer",
      "required": false,
      "min": 1,
      "tier": "primary",
      "display_name": "Batch size",
      "description": "per-device batch size"
    },
    "lora_r": {
      "type": "integer",
      "required": false,
      "min": 1,
      "tier": "primary",
      "display_name": "LoRA rank (r)",
      "description": "LoRA adapter rank"
    },
    "max_seq_length": {
      "type": "integer",
      "required": false,
      "min": 1,
      "tier": "primary",
      "display_name": "Max sequence length",
      "description": "longest tokenized sample kept"
    },
    "dataset_text_field": {
      "type": "string",
      "required": false,
      "tier": "primary",
      "display_name": "Text/instruction column name",
      "description": "dataset column holding the training text"
    },
    "lora_alpha": {
      "type": "integer",
      "required": false,
      "min": 1,
      "tier": "advanced",
      "display_name": "LoRA alpha",
      "description": "LoRA scaling factor"
    },
    "lora_dropout": {
      "type": "number",
      "required": false,
      "min": 0,
      "max": 1,
      "tier": "advanced",
      "display_name": "LoRA dropout",
      "description": "dropout on the LoRA layers, 0-1"
    },
    "gradient_accumulation_steps": {
      "type": "integer",
      "required": false,
      "min": 1,
      "tier": "advanced",
      "display_name": "Gradient accumulation steps",
      "description": "steps to accumulate before an optimizer update"
    },
    "warmup_ratio": {
      "type": "number",
      "required": false,
      "min": 0,
      "max": 1,
      "tier": "advanced",
      "display_name": "Warmup ratio",
      "description": "fraction of training steps used for LR warmup, 0-1"
    },
    "model_id": {
      "type": "string",
      "required": false,
      "tier": "tertiary",
      "display_name": "Base model ID",
      "description": "HuggingFace model ID; normally taken from HF_MODEL_ID"
    }
  }
}
