# ── CLI Variables (set by _parse_args) ────────────────────────────────────────
ARG_TECHNIQUE=""
ARG_DATASET=""
ARG_TRAINING_TYPE="lora"
# Wave 11 (R1.2, R9–R11): compute backend + the hp-eks (HyperPodPyTorchJob) knobs.
ARG_BACKEND=""
ARG_ADAPT_SHAPE=false
ARG_RENDER_ONLY=false
ARG_INSTANCE_GROUP=""
ARG_STARTUP_TIMEOUT=""
ARG_STALL_TIMEOUT=""
TUNE_BACKEND_RESOLVED=""
ARG_MODEL=""
# BL128: technique-aware hyperparameter knobs are collected into SET_KNOBS as plain
# "KNOB=VALUE" strings (an INDEXED array — NOT `declare -A`, which needs bash 4+; do/tune
# must run under macOS's default bash 3.2). Both --set KNOB=VALUE and the five legacy flags
# (--epochs/--learning-rate/--max-seq-length/--lora-rank/--batch-size) append to it, keyed
# by the descriptor's canonical knob name; the config builder resolves + validates the pairs
# against the selected technique's tune descriptor.
SET_KNOBS=()
ARG_ADVANCED=false
ARG_NON_INTERACTIVE=false
ARG_REWARD_FUNCTION=""
ARG_REWARD_PROMPT=""
ARG_OUTPUT_BUCKET=""
ARG_ROLE=""
ARG_FORCE=false
ARG_NO_WAIT=false
ARG_STATUS=false
ARG_HELP=false
ARG_DRY_RUN=false
ARG_LIST_MODELS=false
ARG_NO_STALE_WARNING=false
ARG_DISCOVER=false
ARG_LIST_DATASETS=false
ARG_DISCOVER_FILTER=""
ARG_COLUMN_MAP=""
