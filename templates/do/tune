    # Call helper script discover subcommand
    local discover_result
    discover_result=$(python3 "${HELPER_SCRIPT}" discover "${discover_args[@]}" 2>&1) || {
        echo "❌ Discovery failed"
        echo "   ${discover_result}"
        echo ""
