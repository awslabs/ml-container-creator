# ── _check_idempotency() ──────────────────────────────────────────────────────
# Check TUNE_JOB_NAME_<TECHNIQUE> in config, query status if exists.
# Returns 0 if a new job should be created, 1 if existing job was handled.
_check_idempotency() {
    local technique_upper
    technique_upper=$(echo "${ARG_TECHNIQUE}" | tr '[:lower:]' '[:upper:]')
    local var_name="TUNE_JOB_NAME_${technique_upper}"
    local existing_job="${!var_name:-}"

    if [ -z "${existing_job}" ] || [ "${ARG_FORCE}" = true ]; then
        return 0  # No existing job or --force: proceed with new job
    fi

    echo "🔍 Found existing $(echo "${ARG_TECHNIQUE}" | tr "[:lower:]" "[:upper:]") job: ${existing_job}"

    # Query status via Python helper
    local status_json
    status_json=$(python3 "${HELPER_SCRIPT}" status \
        --job-name "${existing_job}" \
        --region "${AWS_REGION}" 2>/dev/null) || {
        echo "   ⚠️  Could not query job status — proceeding with new job"
        return 0
    }

    # Check for error response
    local has_error
    has_error=$(echo "${status_json}" | python3 -c "import sys,json; d=json.load(sys.stdin); print('yes' if 'error' in d else 'no')" 2>/dev/null) || has_error="no"

    if [ "${has_error}" = "yes" ]; then
        echo "   ⚠️  Could not query job status — proceeding with new job"
        return 0
    fi

    local status
    status=$(echo "${status_json}" | python3 -c "import sys,json; print(json.load(sys.stdin)['status'])" 2>/dev/null) || status="Unknown"

    case "${status}" in
        InProgress|Starting)
            echo "   Status: ${status}"
            echo "   (use --force to start a new job instead)"
            echo ""
            # Resume polling
            _poll_job "${existing_job}"
            _handle_completion "${existing_job}"
            return 1
            ;;
        Completed)
            echo "   Status: Completed"
            echo "   (use --force to start a new job)"
            echo ""
            _handle_completion "${existing_job}"
            return 1
            ;;
        Failed)
            local failure_reason
            failure_reason=$(echo "${status_json}" | python3 -c "import sys,json; print(json.load(sys.stdin).get('failure_reason','') or 'Unknown')" 2>/dev/null) || failure_reason="Unknown"
            echo "   Status: Failed"
            echo "   Reason: ${failure_reason}"
            echo ""
            echo "   Re-run with --force to start a new job."
            exit 2
            ;;
        Stopped)
            echo "   Status: Stopped"
            echo "   Re-run with --force to start a new job."
            exit 2
            ;;
        *)
            echo "   Status: ${status}"
            echo "   Proceeding with new job..."
            return 0
            ;;
    esac
}

# ── _submit_job() ─────────────────────────────────────────────────────────────
# Invoke Python helper with all args to submit the customization job.
# ── _preflight_rft_inputs() ───────────────────────────────────────────────────
# Req 3A: a managed RFT technique (rlvr/rlaif/mtrl) needs BOTH a prompt dataset
# AND an evaluator. Resolve both and fail BEFORE submission if either is missing,
# naming WHICH input is absent and its register verb — not a partial submission
# that errors server-side. Also resolves a registered --evaluator-name into the
# right reward flag so the resolved reference is threaded in. SFT/DPO are
# dataset-only and skip this entirely (no behavior change).
#
# On success for an RFT technique, sets ARG_REWARD_FUNCTION or ARG_REWARD_PROMPT.
_preflight_rft_inputs() {
    case "${ARG_TECHNIQUE}" in
        rlvr|rlaif|mtrl) ;;
        *) return 0 ;;  # sft/dpo: dataset only, nothing to check
    esac
    # Uppercase via tr, not the bash-4-only uppercase expansion: do/ scripts must
    # run on macOS /bin/bash 3.2, where that expansion is a "bad substitution"
    # that kills the echo before the guard's exit 1.
    local tech_upper
    tech_upper=$(printf '%s' "${ARG_TECHNIQUE}" | tr '[:lower:]' '[:upper:]')

    # (1) Dataset input — already resolved by the dataset-resolution step. If it
    #     is empty, the prompt dataset could not be resolved.
    if [ -z "${RESOLVED_DATASET_S3_URI:-}" ]; then
        echo "❌ ${tech_upper} requires a prompt dataset, but none could be resolved."
        echo "   Register one first:  ./do/register dataset <name> --s3-uri <uri> --technique ${ARG_TECHNIQUE}"
        echo "   then:                ./do/tune --technique ${ARG_TECHNIQUE} --dataset <name> ..."
        exit 1
    fi

    # (2a) MTRL is agent-based, NOT reward-evaluator-based. MultiTurnRLTrainer
    #      requires an agent_env (a CustomAgentLambda): the agent runs the rollout,
    #      calls the policy model, takes actions/tools, and computes the reward
    #      itself — there is no custom_reward_function/reward_prompt. So mtrl needs
    #      --agent-env, and does NOT resolve a reward evaluator.
    if [ "${ARG_TECHNIQUE}" = "mtrl" ]; then
        if [ -z "${ARG_AGENT_ENV}" ]; then
            echo "❌ MTRL requires an agent environment, but none was provided."
            echo "   MTRL's reward lives inside your agent (a CustomAgentLambda), not a"
            echo "   reward function/prompt. Provide its ARN:"
            echo "     ./do/tune --technique mtrl --dataset <name> --agent-env <custom-agent-lambda-arn>"
            exit 1
        fi
        echo "   MTRL agent env: ${ARG_AGENT_ENV}"
        return 0
    fi

    # (2b) RLVR/RLAIF evaluator input — the technique's reward artifact. Determine
    #      the expected kind + its register verb for clear messaging.
    local reward_kind reward_verb
    if [ "${ARG_TECHNIQUE}" = "rlaif" ]; then
        reward_kind="reward prompt"
        reward_verb="./do/register prompt <name> --prompt <s3-uri>"
    else
        reward_kind="reward function"
        reward_verb="./do/register evaluator <name> --arn <lambda-arn>"
    fi

    # An explicit --reward-function / --reward-prompt already satisfies it.
    if [ -n "${ARG_REWARD_FUNCTION}" ] || [ -n "${ARG_REWARD_PROMPT}" ]; then
        return 0
    fi

    # Otherwise an evaluator MUST be named and resolvable from the registry.
    if [ -z "${ARG_EVALUATOR_NAME}" ]; then
        echo "❌ ${tech_upper} requires a ${reward_kind} evaluator, but none was provided."
        echo "   Register it first:   ${reward_verb}"
        echo "   then pass it with:   --evaluator-name <name>  (or --reward-function/--reward-prompt directly)"
        exit 1
    fi

    echo "🔍 Resolving evaluator '${ARG_EVALUATOR_NAME}' from the AI Registry..."
    local ev_resolve_result ev_type ev_reference ev_arn
    ev_resolve_result=$(python3 "${SCRIPT_DIR}/.register_helper.py" resolve-evaluator \
        --name "${ARG_EVALUATOR_NAME}" --region "${AWS_REGION}" 2>/dev/null) || ev_resolve_result=""

    if [ -z "${ev_resolve_result}" ]; then
        echo "❌ ${tech_upper}: evaluator '${ARG_EVALUATOR_NAME}' is not registered."
        echo "   Register the ${reward_kind} first:  ${reward_verb}"
        exit 1
    fi

    ev_type=$(echo "${ev_resolve_result}" | python3 -c "import sys,json; print(json.load(sys.stdin).get('type',''))" 2>/dev/null) || ev_type=""
    ev_reference=$(echo "${ev_resolve_result}" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('reference') or d.get('arn_or_uri') or '')" 2>/dev/null) || ev_reference=""
    ev_arn=$(echo "${ev_resolve_result}" | python3 -c "import sys,json; print(json.load(sys.stdin).get('arn') or '')" 2>/dev/null) || ev_arn=""

    if [ -z "${ev_reference}" ] && [ -z "${ev_arn}" ]; then
        echo "❌ ${tech_upper}: evaluator '${ARG_EVALUATOR_NAME}' resolved but has no source reference."
        echo "   Re-register the ${reward_kind}:  ${reward_verb}"
        exit 1
    fi

    echo "   Resolved evaluator: ${ev_type} → ${ev_arn:-${ev_reference}}"
    # Both RFT trainers want the HUB-CONTENT evaluator ARN, NOT the Lambda ref:
    #   • RLVR custom_reward_function: if given a *Lambda* ARN, RLVRTrainer.train()
    #     internally calls Evaluator.create() to wrap it — and that create path
    #     resolves a role with get_role(role=None), defaulting to the CALLER
    #     identity (role/<you>), which SageMaker cannot assume → "IAM role
    #     '.../role/<you>' cannot be used for 'training'". Passing the already-
    #     registered hub-content ARN takes the trainer's else-branch (no
    #     Evaluator.create, no role-less resolution). So prefer ev_arn.
    #   • RLAIF reward_prompt: validated against
    #     ^arn:aws:sagemaker:...:hub-content/<hub>/JsonDoc/<name>/<ver>$ — also the
    #     hub-content ARN. A bare NAME fails default-hub DescribeHubContent and an
    #     S3 URI fails the hubContentName regex.
    # Fall back to ev_reference only when no hub-content ARN resolved (e.g. a raw
    # Lambda ARN passed via --reward-function with no registry entry).
    case "${ev_type}" in
        reward_function|lambda) ARG_REWARD_FUNCTION="${ev_arn:-${ev_reference}}" ;;
        reward_prompt|model)    ARG_REWARD_PROMPT="${ev_arn:-${ev_reference}}" ;;
        *)                      ARG_REWARD_FUNCTION="${ev_arn:-${ev_reference}}" ;;
    esac
    return 0
}

# ── _resolve_hyperparameters() (BL128) ────────────────────────────────────────
# Resolve the technique-aware knob values via the config builder: descriptor defaults
# overlaid with the SET_KNOBS map (--set + legacy-flag aliases), validated against the
# selected technique's tune descriptor. Prints the resolved {knob: value} JSON on
# success; on any validation error prints the errors and returns 1 (caller exits).
# Interactive unless --non-interactive / no TTY (the builder prompts primary knobs, and
# advanced knobs when --advanced).
_resolve_hyperparameters() {
    # Build the --supplied JSON object from SET_KNOBS ("KNOB=VALUE" strings → JSON). Each
    # pair is a positional arg to python (robust to values containing '='/spaces); a later
    # pair for the same knob wins (last --set / flag). Guard the empty-array case under
    # `set -u` with "${SET_KNOBS[@]+"${SET_KNOBS[@]}"}".
    local supplied_json
    supplied_json=$(python3 -c "
import json, sys
vals = {}
for pair in sys.argv[1:]:
    if '=' in pair:
        k, v = pair.split('=', 1)
        vals[k] = v
print(json.dumps(vals))
" ${SET_KNOBS[@]+"${SET_KNOBS[@]}"} 2>/dev/null) || supplied_json="{}"

    local bc_args=(
        --technique "${ARG_TECHNIQUE}"
        --variant "${ARG_TRAINING_TYPE:-lora}"
        --supplied "${supplied_json}"
    )
    # BL180 Option 1: pass the resolved model so build-config reads the AUTHORITATIVE
    # per-model hyperparameter specs live from the SMTJ SDK (not the stale, per-technique
    # synced descriptor). build-config falls back to the descriptor if the model/SDK
    # can't be resolved.
    [ -n "${RESOLVED_MODEL_ID:-}" ] && bc_args+=(--model "${RESOLVED_MODEL_ID}")
    [ "${ARG_ADVANCED}" = true ] && bc_args+=(--advanced)
    [ "${ARG_NON_INTERACTIVE}" = true ] && bc_args+=(--non-interactive)
    # RLAIF: when the judge template was already chosen via --reward-prompt (resolved
    # into ARG_REWARD_PROMPT by _preflight_rft_inputs), drop judge_prompt_template from
    # the HP prompts so the user is not asked to pick the same template a second time.
    # The SDK sets judge_prompt_template from reward_prompt, so this knob is redundant
    # here. (Only meaningful for rlaif; harmless for other techniques that lack it.)
    if [ "${ARG_TECHNIQUE}" = "rlaif" ] && [ -n "${ARG_REWARD_PROMPT}" ]; then
        bc_args+=(--skip-knob judge_prompt_template)
    fi

    # BL178: do NOT swallow build-config's stderr. The interactive questionary
    # prompt UI renders to stderr (so it stays out of the captured stdout JSON) —
    # discarding stderr (2>/dev/null) made the prompt INVISIBLE and the CLI appeared
    # to hang. Let stderr flow to the terminal so prompts show and a real error
    # (e.g. a missing-dependency ImportError) is visible instead of the generic
    # message (also addresses the BL165 error-swallowing class on this path).
    local bc_result
    bc_result=$(python3 "${HELPER_SCRIPT}" build-config "${bc_args[@]}") || {
        echo "❌ Failed to resolve hyperparameters for ${ARG_TECHNIQUE}." >&2
        return 1
    }

    # Surface validation errors (fail-fast).
    local errors
    errors=$(echo "${bc_result}" | python3 -c "import sys,json; print('\n'.join(json.load(sys.stdin).get('errors',[])))" 2>/dev/null) || errors=""
    if [ -n "${errors}" ]; then
        echo "❌ Hyperparameter validation failed for ${ARG_TECHNIQUE}:" >&2
        echo "${errors}" | sed 's/^/   • /' >&2
        return 1
    fi

    # Surface informational notes (e.g. an auto-adjusted default length pair) so the
    # user SEES what the builder changed on their behalf. Non-fatal; stderr only.
    local notes
    notes=$(echo "${bc_result}" | python3 -c "import sys,json; print('\n'.join(json.load(sys.stdin).get('notes',[])))" 2>/dev/null) || notes=""
    if [ -n "${notes}" ]; then
        echo "${notes}" | sed 's/^/ℹ  /' >&2
    fi

    # Option-A transparency: show EVERY knob the job will receive and where each
    # value came from, so knobs that land in SageMaker at their SDK default (advanced/
    # tertiary knobs the UX never prompts, e.g. lr_scheduler, weight_decay) are visible
    # here — not a surprise in the console. Defaults carry a hint that --set overrides
    # them. Rendered to STDERR so the captured stdout stays clean JSON (BL178).
    echo "${bc_result}" | python3 -c "
import sys, json
data = json.load(sys.stdin)
resolved = data.get('resolved', {}) or {}
sources = data.get('sources', {}) or {}
if not resolved:
    sys.exit(0)
LABEL = {'supplied': 'set by you', 'prompt': 'entered', 'default': 'SDK default'}
has_default = any(sources.get(k) == 'default' for k in resolved)
print('', file=sys.stderr)
print('\u2699\ufe0f  Hyperparameters this job will use:', file=sys.stderr)
width = max((len(k) for k in resolved), default=0)
for k in sorted(resolved):
    src = sources.get(k, 'default')
    print('   {name:<{w}}  {val:<16}  ({lbl})'.format(
        name=k, w=width, val=str(resolved[k]), lbl=LABEL.get(src, src)), file=sys.stderr)
if has_default:
    print('', file=sys.stderr)
    print('   \u2139\ufe0f  Values marked \"SDK default\" were not prompted. Override any with', file=sys.stderr)
    print('      --set <knob>=<value> (or --advanced to be prompted for more).', file=sys.stderr)
print('', file=sys.stderr)
" 2>/dev/null || true

    # Echo the resolved {knob: value} JSON for the caller to pass to submit.
    echo "${bc_result}" | python3 -c "import sys,json; print(json.dumps(json.load(sys.stdin).get('resolved',{})))" 2>/dev/null || echo "{}"
    return 0
}

# Sets JOB_NAME on success.
_submit_job() {
    # Req 3A two-input pre-flight: RFT techniques need BOTH dataset + evaluator.
    _preflight_rft_inputs

    local output_bucket
    output_bucket=$(_resolve_output_bucket) || exit 1

    local role_arn
    if [ -n "${ARG_ROLE}" ]; then
        role_arn="${ARG_ROLE}"
    elif [ -n "${ROLE_ARN:-}" ]; then
        role_arn="${ROLE_ARN}"
    else
        # Try to resolve from SageMaker execution role
        role_arn="${SAGEMAKER_ROLE_ARN:-}"
        if [ -z "${role_arn}" ]; then
            echo "❌ No execution role configured"
            echo "   Set ROLE_ARN in do/config or use --role <arn>"
            echo "   (Is the bootstrap profile sourced? ROLE_ARN comes from"
            echo "    _PROFILE_roleArn — an unsourced profile leaves it empty.)"
            exit 1
        fi
    fi

    # Fail LOUD if the resolved role is NOT a usable SageMaker training role.
    # When role_arn is empty or is the CALLER's own identity, the SDK silently
    # falls back to the caller principal, and the training job is rejected with
    # "IAM role '.../role/<you>' cannot be used for 'training' workloads ... its
    # trust policy does not allow sagemaker.amazonaws.com". Catch it here, before
    # submit, with an actionable message instead of a cryptic SDK failure.
    if [ -z "${role_arn}" ] || [[ "${role_arn}" != arn:aws:iam::*:role/* ]]; then
        echo "❌ Invalid execution role: '${role_arn:-<empty>}'"
        echo "   Expected a SageMaker execution role ARN (arn:aws:iam::<acct>:role/<name>)."
        echo "   Set ROLE_ARN in do/config, pass --role <arn>, or ensure the bootstrap"
        echo "   profile is sourced (ROLE_ARN derives from _PROFILE_roleArn)."
        exit 1
    fi
    local _caller_arn
    _caller_arn=$(aws sts get-caller-identity --query Arn --output text --region "${AWS_REGION}" 2>/dev/null) || _caller_arn=""
    # STS caller ARN for an assumed role looks like
    # arn:aws:sts::<acct>:assumed-role/<role-name>/<session>; extract <role-name>
    # and refuse if the resolved training role IS the caller's own identity.
    if [ -n "${_caller_arn}" ]; then
        local _caller_role_name="${_caller_arn##*assumed-role/}"
        _caller_role_name="${_caller_role_name%%/*}"
        local _resolved_role_name="${role_arn##*role/}"
        if [ -n "${_caller_role_name}" ] && [ "${_caller_role_name}" = "${_resolved_role_name}" ]; then
            echo "❌ Execution role resolves to YOUR caller identity ('${_resolved_role_name}'),"
            echo "   not a SageMaker execution role. SageMaker cannot assume your user/caller"
            echo "   role for training (its trust policy excludes sagemaker.amazonaws.com)."
            echo "   Set ROLE_ARN to the mlcc-sagemaker-execution-role in do/config, pass"
            echo "   --role <arn>, or re-source the bootstrap profile."
            exit 1
        fi
    fi

    # Generate unique job name
    local timestamp
    timestamp=$(date +%Y%m%d-%H%M%S)
    JOB_NAME="${PROJECT_NAME}-tune-${ARG_TECHNIQUE}-${timestamp}"

    # Check if model requires EULA acceptance (gated models from Meta, etc.)
    if [ "${ARG_ACCEPT_EULA}" != true ]; then
        local model_provider
        model_provider=$(python3 -c "
import json
with open('${CATALOG_FILE}') as f:
    catalog = json.load(f)
entry = catalog.get('models', {}).get('${RESOLVED_MODEL_ID}', {})
print(entry.get('provider', ''))
" 2>/dev/null) || model_provider=""
        if [ "${model_provider}" = "meta" ]; then
            echo "⚠️  ${RESOLVED_MODEL_ID} is a gated model that requires EULA acceptance."
            echo "   Add --accept-eula to proceed:"
            echo "   ./do/tune --technique ${ARG_TECHNIQUE} --dataset ${ARG_DATASET} --accept-eula"
            echo ""
            exit 1
        fi
    fi

    echo "🚀 Submitting $(echo "${ARG_TECHNIQUE}" | tr "[:lower:]" "[:upper:]") customization job"
    echo "   Job name: ${JOB_NAME}"
    echo "   Model: ${RESOLVED_MODEL_ID}"
    echo "   Technique: ${ARG_TECHNIQUE}"
    echo "   Training type: ${ARG_TRAINING_TYPE}"
    echo "   Dataset: ${RESOLVED_DATASET_S3_URI}"
    echo "   Output bucket: ${output_bucket}"
    echo ""

    # Build submit arguments
    local submit_args=(
        --model-id "${RESOLVED_MODEL_ID}"
        --region "${AWS_REGION}"
        --technique "${ARG_TECHNIQUE}"
        --training-type "${ARG_TRAINING_TYPE}"
        --dataset-s3-uri "${RESOLVED_DATASET_S3_URI}"
        --output-bucket "${output_bucket}"
        --role-arn "${role_arn}"
        --job-name "${JOB_NAME}"
        --project-name "${PROJECT_NAME}"
    )

    # Add model package group (BL164: the PROJECT group, not -tune-models, so the
    # tune output shares one catalog with do/register's bridge registrations).
    submit_args+=(--model-package-group "${PROJECT_NAME}")

    # BL128: resolve the technique-aware hyperparameter knobs from the tune descriptor
    # (defaults + --set/legacy-flag overrides), validating each against the selected
    # technique's descriptor BEFORE submission. The resolved {knob: value} map is passed
    # to submit as a single --hyperparameters JSON blob (tune_submit merges it — the old
    # per-flag map is gone). An unknown knob, an out-of-range value, or a required knob
    # with no value fails fast HERE, not deep in the job.
    local resolved_hp
    resolved_hp=$(_resolve_hyperparameters) || exit 1
    if [ -n "${resolved_hp}" ] && [ "${resolved_hp}" != "{}" ]; then
        submit_args+=(--hyperparameters "${resolved_hp}")
    fi
    if [ -n "${ARG_REWARD_FUNCTION}" ]; then
        submit_args+=(--reward-function "${ARG_REWARD_FUNCTION}")
    fi
    if [ -n "${ARG_REWARD_PROMPT}" ]; then
        submit_args+=(--reward-prompt "${ARG_REWARD_PROMPT}")
    fi
    if [ -n "${ARG_AGENT_ENV}" ]; then
        submit_args+=(--agent-env "${ARG_AGENT_ENV}")
    fi

    # Evaluator inputs for RFT techniques are resolved + threaded by
    # _preflight_rft_inputs() (Req 3A), which runs at the top of _submit_job and
    # sets ARG_REWARD_FUNCTION / ARG_REWARD_PROMPT — already appended above.
    if [ "${ARG_ACCEPT_EULA}" = true ]; then
        submit_args+=(--accept-eula)
    fi

    # BL166 (R3): ensure the per-project MLflow experiment exists BEFORE submit so
    # the tune job's first logged step has a project home (the trainer's
    # mlflow_experiment_name pin, set in tune_submit, names an existing experiment).
    # Idempotent + non-fatal (no-op when MLflow unconfigured).
    python3 -c "
import sys
sys.path.insert(0, '${SCRIPT_DIR}/lib/python')
try:
    import mlcc_mlflow as m
    m.ensure_project_experiment('${PROJECT_NAME}')
except Exception:
    pass
" 2>/dev/null || true

    # Invoke Python helper (stderr visible to user for diagnostics)
    local submit_result
    local submit_stderr
    submit_stderr=$(mktemp)
    submit_result=$(python3 "${HELPER_SCRIPT}" submit "${submit_args[@]}" 2>"${submit_stderr}") || {
        echo "❌ Failed to submit customization job"
        echo "   Model ID used: ${RESOLVED_MODEL_ID}"
        echo ""
        # Show stderr from helper script
        if [ -s "${submit_stderr}" ]; then
            echo "   Error output:"
            sed 's/^/   /' "${submit_stderr}"
            echo ""
            # Check for ResourceNotFound and suggest verification
            if grep -qi "ResourceNotFound\|ResourceNotFoundException\|not found" "${submit_stderr}"; then
                echo "   💡 The model ID may not exist in the JumpStart Hub."
                echo "      Verify with: aws sagemaker list-hub-contents --hub-name SageMakerPublicHub \\"
                echo "        --hub-content-type Model --name-contains \"${RESOLVED_MODEL_ID}\" --region ${AWS_REGION}"
                echo ""
            fi
        fi
        # Show stdout error JSON if available
        if [ -n "${submit_result:-}" ]; then
            local err_msg
            err_msg=$(echo "${submit_result}" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('error',''))" 2>/dev/null) || err_msg=""
            if [ -n "${err_msg}" ]; then
                echo "   SDK error: ${err_msg}"
                echo ""
            fi
        fi
        rm -f "${submit_stderr}"
        exit 1
    }

    # Show any stderr warnings from helper script (non-fatal)
    if [ -s "${submit_stderr}" ]; then
        sed 's/^/   ⚠️  /' "${submit_stderr}"
    fi
    rm -f "${submit_stderr}"

    # SDK may print status lines to stdout before our JSON (e.g., "Training Job Name: ...")
    # Extract only the JSON line (last line starting with '{')
    submit_result=$(echo "${submit_result}" | grep '^{' | tail -1)

    # Check for error in response
    local has_error
    has_error=$(echo "${submit_result}" | python3 -c "import sys,json; d=json.load(sys.stdin); print('yes' if 'error' in d else 'no')" 2>/dev/null) || has_error="yes"

    if [ "${has_error}" = "yes" ]; then
        local error_msg
        error_msg=$(echo "${submit_result}" | python3 -c "import sys,json; print(json.load(sys.stdin).get('error','Unknown error'))" 2>/dev/null) || error_msg="Unknown error"
        echo "❌ ${error_msg}"
        echo "   Model ID used: ${RESOLVED_MODEL_ID}"
        # Check for ResourceNotFound in the error message
        if echo "${error_msg}" | grep -qi "ResourceNotFound\|ResourceNotFoundException\|not found"; then
            echo ""
            echo "   💡 The model ID may not exist in the JumpStart Hub."
            echo "      Verify with: aws sagemaker list-hub-contents --hub-name SageMakerPublicHub \\"
            echo "        --hub-content-type Model --name-contains \"${RESOLVED_MODEL_ID}\" --region ${AWS_REGION}"
        fi
        exit 1
    fi

    # Extract job name from response (may differ from our generated name)
    local returned_job_name
    returned_job_name=$(echo "${submit_result}" | python3 -c "import sys,json; print(json.load(sys.stdin).get('job_name',''))" 2>/dev/null) || returned_job_name=""
    if [ -n "${returned_job_name}" ]; then
        JOB_NAME="${returned_job_name}"
    fi

    # Display MLflow URL if available
    local mlflow_url
    mlflow_url=$(echo "${submit_result}" | python3 -c "import sys,json; print(json.load(sys.stdin).get('mlflow_url','') or '')" 2>/dev/null) || mlflow_url=""
    if [ -n "${mlflow_url}" ]; then
        echo "   📈 MLflow tracking: ${mlflow_url}"
    fi

    echo "✅ Job submitted: ${JOB_NAME}"
    echo ""

    # Store state in do/config
    local technique_upper
    technique_upper=$(echo "${ARG_TECHNIQUE}" | tr '[:lower:]' '[:upper:]')
    _update_config_var "TUNE_JOB_NAME_${technique_upper}" "${JOB_NAME}"
    # Wave 6.1 R2.2 (BL188): record the rank this technique will PRODUCE (the
    # resolved lora_rank knob — the per-model SDK recipe default or the user's
    # --set/--lora-rank) so deploy derives max_lora_rank from it without the SDK.
    # Never blocks or lowers the technique's rank (R2.5).
    local _tune_lora_rank=""
    _tune_lora_rank=$(printf '%s' "${resolved_hp:-}" | python3 -c 'import json,sys
try:
    v = json.load(sys.stdin).get("lora_rank")
except (ValueError, AttributeError):
    v = None
print(v if isinstance(v, int) and v > 0 else "")' 2>/dev/null || echo "")
    if [ -n "${_tune_lora_rank}" ]; then
        _update_config_var "TUNE_LORA_RANK_${technique_upper}" "${_tune_lora_rank}"
    fi
    _update_config_var "TUNE_TECHNIQUE" "${ARG_TECHNIQUE}"
    _update_config_var "TUNE_TRAINING_TYPE" "${ARG_TRAINING_TYPE}"
    _update_config_var "TUNE_DATASET_PATH" "${ARG_DATASET}"
    _update_config_var "TUNE_DATASET_S3_URI" "${RESOLVED_DATASET_S3_URI:-}"
    _update_config_var "TUNE_DATASET_ROW_COUNT" "${RESOLVED_DATASET_ROW_COUNT:-0}"
    _update_config_var "TUNE_DATASET_SOURCE" "${ARG_DATASET}"
    _update_config_var "TUNE_LAST_JOB_NAME" "${JOB_NAME}"
    # Technique-specific dataset vars (allows --from-tune <technique> resolution)
    _update_config_var "TUNE_DATASET_S3_URI_${technique_upper}" "${RESOLVED_DATASET_S3_URI:-}"
    _update_config_var "TUNE_DATASET_ROW_COUNT_${technique_upper}" "${RESOLVED_DATASET_ROW_COUNT:-0}"
    _update_config_var "TUNE_DATASET_SOURCE_${technique_upper}" "${ARG_DATASET}"
    # Store dataset version ordinal if pinned (AC-2.6)
    if [ -n "${ARG_DATASET_VERSION}" ]; then
        _update_config_var "TUNE_DATASET_VERSION_${technique_upper}" "${ARG_DATASET_VERSION}"
    fi
}


# ── _poll_job() ───────────────────────────────────────────────────────────────
# Poll every 60s, display status/elapsed/step, handle Ctrl+C gracefully.
# Exits cleanly on interrupt without stopping the remote job.
_poll_job() {
    local job_name="${1:-${JOB_NAME}}"

    echo "⏳ Polling job status every ${POLL_INTERVAL}s..."
    echo "   (Ctrl+C to exit — job continues in background)"
    echo ""

    # Trap SIGINT for graceful exit
    trap '_handle_interrupt "${job_name}"' INT

    while true; do
        local status_json
        status_json=$(python3 "${HELPER_SCRIPT}" status \
            --job-name "${job_name}" \
            --region "${AWS_REGION}" 2>/dev/null) || {
            echo "   ⚠️  Failed to query status (will retry)"
            sleep "${POLL_INTERVAL}"
            continue
        }

        local status
        status=$(echo "${status_json}" | python3 -c "import sys,json; print(json.load(sys.stdin).get('status','Unknown'))" 2>/dev/null) || status="Unknown"

        local elapsed
        elapsed=$(echo "${status_json}" | python3 -c "import sys,json; print(json.load(sys.stdin).get('elapsed_seconds',0))" 2>/dev/null) || elapsed="0"

        local mins=$((elapsed / 60))
        local secs=$((elapsed % 60))

        case "${status}" in
            Completed)
                echo "   ✅ $(date +%H:%M:%S) Status: Completed (${mins}m ${secs}s)"
                # Restore default signal handling
                trap - INT
                return 0
                ;;
            Failed)
                local failure_reason
                failure_reason=$(echo "${status_json}" | python3 -c "import sys,json; print(json.load(sys.stdin).get('failure_reason','') or 'Unknown')" 2>/dev/null) || failure_reason="Unknown"
                echo "   ❌ $(date +%H:%M:%S) Status: Failed (${mins}m ${secs}s)"
                echo "      Reason: ${failure_reason}"
                trap - INT
                exit 2
                ;;
            Stopped)
                echo "   ⚠️  $(date +%H:%M:%S) Status: Stopped (${mins}m ${secs}s)"
                trap - INT
                exit 2
                ;;
            *)
                echo "   $(date +%H:%M:%S) Status: ${status} (${mins}m ${secs}s)"
                sleep "${POLL_INTERVAL}"
                ;;
        esac
    done
}

# ── _handle_interrupt() ───────────────────────────────────────────────────────
# Handle Ctrl+C during polling — exit cleanly without stopping the remote job.
_handle_interrupt() {
    local job_name="${1:-}"
    echo ""
    echo ""
    echo "⚠️  Interrupted — job continues running in background"
    echo "   Job: ${job_name}"
    echo "   Check status: ./do/tune --status"
    exit 130
}

# ── _derive_dataset_slug() ────────────────────────────────────────────────────
# Derive a short slug from the dataset argument for config variable naming.
# Rules: lowercase, strip non-alphanumeric (keep hyphens), truncate to 20 chars,
# collapse consecutive hyphens, strip leading/trailing hyphens.
#
# Examples:
#   hf://tatsu-lab/alpaca           → alpaca
#   hf://Open-Orca/OpenOrca         → openorca
#   s3://bucket/path/train.jsonl    → train
#   s3://bucket/path/file.parquet   → file
_derive_dataset_slug() {
    local dataset="${1:-}"
    local slug=""

    if [ -z "${dataset}" ]; then
        echo ""
        return
    fi

    if [[ "${dataset}" == hf://* ]]; then
        # HuggingFace format: hf://org/name or hf://org/name?file=...
        # Strip query params
        local hf_path="${dataset#hf://}"
        hf_path="${hf_path%%\?*}"
        # Take the last component (dataset name, not org)
        slug="${hf_path##*/}"
    elif [[ "${dataset}" == s3://* ]]; then
        # S3 format: s3://bucket/path/file.ext → slug from filename without extension
        local filename="${dataset##*/}"
        slug="${filename%.*}"
    else
        # Fallback: use the last path component without extension
        local filename="${dataset##*/}"
        slug="${filename%.*}"
    fi

    # Slugification: lowercase, strip non-alphanumeric (keep hyphens)
    slug=$(echo "${slug}" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9-]//g')
    # Collapse consecutive hyphens
    slug=$(echo "${slug}" | sed 's/-\{2,\}/-/g')
    # Strip leading/trailing hyphens
    slug=$(echo "${slug}" | sed 's/^-//;s/-$//')
    # Truncate to 20 chars
    slug="${slug:0:20}"
    # Strip trailing hyphen after truncation
    slug=$(echo "${slug}" | sed 's/-$//')

    echo "${slug}"
}

# ── _handle_completion() ──────────────────────────────────────────────────────
# Store output paths, detect output type, print next-step commands.
_handle_completion() {
    local job_name="${1:-${JOB_NAME}}"
    local technique_upper
    technique_upper=$(echo "${ARG_TECHNIQUE}" | tr '[:lower:]' '[:upper:]')

    # Wave 11 (R5.3): an hp-eks run hands in the artifact it resolved from the
    # job's S3 output (<artifact> <adapter|model>); the promotion + config writes
    # below are then exactly the SMTJ ones.
    local artifact_path="${2:-}" output_type="${3:-}" model_package_arn=""
    if [ -z "${artifact_path}" ]; then
        # Resolve artifact path via Python helper
        local resolve_args=(
            --job-name "${job_name}"
            --region "${AWS_REGION}"
            --training-type "${ARG_TRAINING_TYPE}"
        )
        resolve_args+=(--model-package-group "${PROJECT_NAME}")

        local resolve_result
        resolve_result=$(python3 "${HELPER_SCRIPT}" resolve "${resolve_args[@]}" 2>/dev/null) || {
            echo "⚠️  Could not resolve output artifacts"
            echo "   Check job output manually:"
            echo "   python3 ${HELPER_SCRIPT} resolve --job-name ${job_name} --region ${AWS_REGION} --training-type ${ARG_TRAINING_TYPE}"
            return 0
        }

        # Check for error
        local has_error
        has_error=$(echo "${resolve_result}" | python3 -c "import sys,json; d=json.load(sys.stdin); print('yes' if 'error' in d else 'no')" 2>/dev/null) || has_error="yes"

        if [ "${has_error}" = "yes" ]; then
            local error_msg
            error_msg=$(echo "${resolve_result}" | python3 -c "import sys,json; print(json.load(sys.stdin).get('error',''))" 2>/dev/null) || error_msg=""
            if [ -n "${error_msg}" ]; then
                echo "   ⚠️  ${error_msg}"
            fi
            return 0
        fi

        # Extract results
        artifact_path=$(echo "${resolve_result}" | python3 -c "import sys,json; print(json.load(sys.stdin).get('artifact_path',''))" 2>/dev/null) || artifact_path=""

        output_type=$(echo "${resolve_result}" | python3 -c "import sys,json; print(json.load(sys.stdin).get('output_type',''))" 2>/dev/null) || output_type=""

        model_package_arn=$(echo "${resolve_result}" | python3 -c "import sys,json; print(json.load(sys.stdin).get('model_package_arn','') or '')" 2>/dev/null) || model_package_arn=""
    fi
    # Display results
    echo "🎉 Customization complete!"
    echo ""
    echo "   Output type: ${output_type}"
    echo "   Artifact: ${artifact_path}"
    if [ -n "${model_package_arn}" ]; then
        echo "   Model Package: ${model_package_arn}"
    fi

    # ── BL164 R5: post-tune deploy-fit handoff (LoRA adapters only) ───────────
    # Surface the adapter's effective rank/alpha from its adapter_config.json
    # (fall back to the submitted values), and WARN — never block (OQ-5) — when
    # the rank exceeds the serving engine's buffer (VLLM_MAX_LORA_RANK). Degrade
    # to the plain output (with a note) when the config can't be read.
    if [ "${output_type}" = "adapter" ] && [ -n "${artifact_path}" ]; then
        local _acfg_json _lora_r _lora_alpha
        _acfg_json=$(aws s3 cp "${artifact_path%/}/adapter_config.json" - --region "${AWS_REGION}" 2>/dev/null || echo "")
        if [ -n "${_acfg_json}" ]; then
            _lora_r=$(echo "${_acfg_json}" | python3 -c "import sys,json; print(json.load(sys.stdin).get('r',''))" 2>/dev/null || echo "")
            _lora_alpha=$(echo "${_acfg_json}" | python3 -c "import sys,json; print(json.load(sys.stdin).get('lora_alpha',''))" 2>/dev/null || echo "")
        else
            # Fall back to submitted hyperparameters recorded in do/config.
            _lora_r="${LORA_RANK:-}"
            _lora_alpha="${LORA_ALPHA:-}"
        fi
        if [ -n "${_lora_r}" ]; then
            echo "   LoRA rank: ${_lora_r}${_lora_alpha:+  | alpha: ${_lora_alpha}}"
            # Rank-fit (BL164 R5, Wave 6.1 R2.5): compare against the EFFECTIVE
            # serving limit — what the next deploy applies (explicit
            # <engine>_MAX_LORA_RANK, else derived from the recorded adapters +
            # engine default) — so the note is no longer silent when no explicit
            # VLLM_MAX_LORA_RANK is set. Informational only: never blocks the
            # tune and never lowers the technique's rank.
            # "Current" = the limit WITHOUT this technique's own records (what the
            # deployment was sized for before this tune); the next deploy derives
            # the limit WITH them.
            local _eff_json _eff_rank _eff_explicit _technique_lc
            _technique_lc=$(echo "${ARG_TECHNIQUE}" | tr '[:upper:]' '[:lower:]')
            _eff_json=$(python3 "${SCRIPT_DIR}/lib/python/right_sizing.py" effective-lora-rank --rank-only \
                --exclude-technique "${_technique_lc}" 2>/dev/null || echo "")
            _eff_rank=$(printf '%s' "${_eff_json}" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("rank") or "")' 2>/dev/null || echo "")
            _eff_explicit=$(printf '%s' "${_eff_json}" | python3 -c 'import json,sys; v=json.load(sys.stdin).get("explicit"); print("" if v is None else v)' 2>/dev/null || echo "")
            if [ -n "${_eff_rank}" ] && [ "${_lora_r}" -gt "${_eff_rank}" ] 2>/dev/null; then
                echo ""
                echo "   ℹ️  Adapter rank ${_lora_r} is above the current serving max_lora_rank (${_eff_rank})."
                if [ -n "${_eff_explicit}" ]; then
                    echo "      Your explicit max_lora_rank=${_eff_explicit} in do/config wins: raise it to at least"
                    echo "      ${_lora_r} (or unset it so deploy derives it) and redeploy before hot-loading."
                else
                    echo "      The next ./do/deploy raises it automatically (derived from the recorded"
                    echo "      tune adapters) — redeploy before hot-loading this adapter"
                    echo "      (./do/adapter add refuses it until then)."
                fi
            fi
        else
            echo "   (adapter rank/alpha unavailable — adapter_config.json not readable)"
        fi
    fi
    echo ""

    # ── Promotion (bucket consolidation R3.3) ─────────────────────────────
    # The raw job output stays in the artifacts bucket (TUNE_OUTPUT_PATH_<T> /
    # TUNE_OUTPUT_PATH_LATEST); the canonical core URI is what TUNE_ADAPTER_PATH_*
    # / TUNE_MODEL_PATH_* record. Name = the auto-registered adapter name.
    local _promo_slug _promo_name
    _promo_slug=$(_derive_dataset_slug "${ARG_DATASET:-}")
    _promo_name="tuned-$(echo "${ARG_TECHNIQUE}" | tr '[:upper:]' '[:lower:]')${_promo_slug:+-${_promo_slug}}"
    _promote_tune_output "${artifact_path}" "${output_type}" "${_promo_name}" \
        "$(echo "${ARG_TECHNIQUE}" | tr '[:upper:]' '[:lower:]')" "${job_name}" \
        "${RESOLVED_MODEL_ID:-${TUNE_MODEL_ID:-${MODEL_NAME:-}}}"
    local servable_path="${PROMOTED_URI:-${artifact_path}}"
    _update_config_var "TUNE_OUTPUT_PATH_${technique_upper}" "${artifact_path}"

    # Store output paths in config
    if [ "${output_type}" = "adapter" ]; then
        _update_config_var "TUNE_ADAPTER_PATH_${technique_upper}" "${servable_path}"
        # Write dataset-specific adapter path if dataset slug is available
        local dataset_slug
        dataset_slug=$(_derive_dataset_slug "${ARG_DATASET:-}")
        if [ -n "${dataset_slug}" ]; then
            local slug_upper
            slug_upper=$(echo "${dataset_slug}" | tr '[:lower:]' '[:upper:]' | sed 's/-/_/g')
            _update_config_var "TUNE_ADAPTER_PATH_${technique_upper}_${slug_upper}" "${servable_path}"
        fi
    else
        _update_config_var "TUNE_MODEL_PATH_${technique_upper}" "${servable_path}"
    fi
    _update_config_var "TUNE_OUTPUT_PATH_LATEST" "${artifact_path}"
    _update_config_var "TUNE_OUTPUT_TYPE_LATEST" "${output_type}"

    # Auto-register or print next-step commands
    if [ "${output_type}" = "adapter" ] && [ "${ARG_NO_REGISTER}" != true ]; then
        # Auto-register: stage adapter and register in deployment MPG
        local dataset_slug
        dataset_slug=$(_derive_dataset_slug "${ARG_DATASET:-}")
        local adapter_name="tuned-${ARG_TECHNIQUE}-${dataset_slug}"
        if [ -z "${dataset_slug}" ]; then
            adapter_name="tuned-${ARG_TECHNIQUE}"
        fi

        echo "🔄 Auto-registering adapter: ${adapter_name}"
        echo ""

        # Write adapter conf file with weights URI for later deployment.
        # Does NOT deploy the adapter IC to the live endpoint — the user
        # should explicitly run do/adapter add when ready to deploy.
        local _adapter_conf_dir="${SCRIPT_DIR}/adapters"
        mkdir -p "${_adapter_conf_dir}"
        local _adapter_conf="${_adapter_conf_dir}/${adapter_name}.conf"
        cat > "${_adapter_conf}" <<ADAPTER_CONF
# Auto-registered by do/tune (${ARG_TECHNIQUE})
# Generated: $(date -u +%Y-%m-%dT%H:%M:%SZ)
export ADAPTER_NAME="${adapter_name}"
export ADAPTER_WEIGHTS_URI="${servable_path}"
export ADAPTER_TECHNIQUE="${ARG_TECHNIQUE}"
export ADAPTER_SOURCE="tune"
# BL176: record the base model this adapter was tuned FROM, so do/register can
# pass --base-id to the bridge and set mlcc.family → the base→adapter linkage the
# SageMaker console renders (without it the family tag is empty and the derivation
# panel is missing). RESOLVED_MODEL_ID is the tune's base (TUNE_MODEL_ID / --model).
export ADAPTER_BASE_ID="${RESOLVED_MODEL_ID}"
ADAPTER_CONF
        echo "   ✅ Adapter registered: ${adapter_name}"
        echo "      Weights: ${servable_path}"
        echo ""

        # ── BL174: consolidate the tune output into the MLflow bridge catalog ─────
        # The SMTJ managed trainer SELF-REGISTERS this adapter into a verbatim
        # project-named Model Package Group it creates server-side (BL164 Task 11
        # live finding) — that group carries NO artifact_kind tag and is NOT the
        # bridge's unified catalog. `do/register` ALREADY registers the base model +
        # loops over do/adapters/*.conf to bridge-register each adapter LINKED to the
        # base (parent-version-arn = the base's bridge package), with the lora_adapter
        # artifact_kind + base→adapter MLflow lineage. The adapter conf we just wrote
        # is exactly what that loop consumes. So the correct consolidation is to run
        # `do/register` (which resolves the base parent the bridge adapter requires) —
        # NOT a standalone adapter bridge-register (which cannot resolve its parent).
        echo "   📦 Register this adapter into the project's bridge catalog (base + adapter,"
        echo "      with artifact_kind + lineage) — run:"
        echo "        ./do/register"
        echo "      (the SMTJ trainer already self-registered a plain '${PROJECT_NAME}' Model"
        echo "       Package Group; do/register adds the unified bridge catalog entry. BL174.)"
        echo ""
        echo "   Deploy to live endpoint:"
        echo "     ./do/adapter add ${adapter_name} --from-tune ${ARG_TECHNIQUE}"
        echo ""
    elif [ "${output_type}" = "adapter" ]; then
        # --no-register: print next steps as before
        local dataset_slug
        dataset_slug=$(_derive_dataset_slug "${ARG_DATASET:-}")
        echo "📋 Next steps:"
        echo ""
        echo "   Deploy as LoRA adapter:"
        echo "     ./do/adapter add tuned-${ARG_TECHNIQUE} --from-tune"
        echo "     ./do/adapter add tuned-${ARG_TECHNIQUE} --from-tune ${ARG_TECHNIQUE}"
        if [ -n "${dataset_slug}" ]; then
            echo "     ./do/adapter add tuned-${ARG_TECHNIQUE}-${dataset_slug} --from-tune ${ARG_TECHNIQUE}-${dataset_slug}"
        fi
        echo "     ./do/adapter add tuned-${ARG_TECHNIQUE} --from-weights ${servable_path}"
        echo ""
    else
        echo "📋 Next steps:"
        echo ""
        echo "   Deploy as new inference component:"
        echo "     ./do/add-ic tuned-v1 --from-tune"
        echo "     ./do/add-ic tuned-v1 --from-weights ${servable_path}"
        echo "     ./do/add-ic default --update --from-weights ${servable_path}   # swap the base IC in place"
        echo ""
    fi
}


# ══ Wave 11: do/tune --backend hp-eks (R9–R12; F4) ════════════════════════════
# Runs AWS's own HP-EKS recipe (the Hub `HpEksPayloadTemplateS3Uri`, recorded per
# model / technique / PEFT in the tune catalog) as a single-node HyperPodPyTorchJob,
# rendered and patched by lib/python/hp_payload.py and watched by the shared
# lib/python/hp_job.py substrate. The backend comes from the target descriptor's
# compute_backends (smtj is the default everywhere, OQ-11.5).

# _tune_variant — the descriptor / catalog variant key for --training-type.
_tune_variant() {
    case "${ARG_TRAINING_TYPE}" in
        full*|fft) echo "full" ;;
        *) echo "lora" ;;
    esac
}

# _tune_resolve_backend — --backend > compute_backends[0]; refuses (exit 3) a
# backend the target does not offer, naming the allowed set.
_tune_resolve_backend() {
    local _allowed _req
    _allowed=$(python3 "${SCRIPT_DIR}/lib/python/target_manifest.py" compute_backends "${DEPLOYMENT_TARGET:-}" 2>/dev/null \
        | tr -d '[]",') || _allowed=""
    _allowed=$(echo ${_allowed})
    _allowed="${_allowed:-smtj}"
    _req="${ARG_BACKEND:-${_allowed%% *}}"
    case " ${_allowed} " in
        *" ${_req} "*) ;;
        *)
            _contract_violation "backend" \
                "--backend ${_req} is not available for do/tune on ${DEPLOYMENT_TARGET:-<unset>}." \
                "Allowed backends here: $(echo "${_allowed}" | sed 's/ /, /g') (default: ${_allowed%% *})."
            ;;
    esac
    TUNE_BACKEND_RESOLVED="${_req}"
    if [ "${_req}" != "hp-eks" ]; then
        if [ "${ARG_ADAPT_SHAPE}" = true ] || [ "${ARG_RENDER_ONLY}" = true ] || [ -n "${ARG_INSTANCE_GROUP}" ]; then
            echo "❌ --adapt-shape / --render-only / --instance-group need --backend hp-eks"
            exit 2
        fi
    fi
}

# _hp_tune_gate — R9.1 / R9.2: only HyperPodPyTorchJob recipes run on hp-eks.
_hp_tune_gate() {
    local _kind
    _kind=$(python3 "${SCRIPT_DIR}/lib/python/tune_manifest.py" hp_eks_workload_kind \
        "${ARG_TECHNIQUE}" "$(_tune_variant)" 2>/dev/null) || _kind="unknown"
    case "${_kind}" in
        HyperPodPyTorchJob) return 0 ;;
        RayJob)
            _contract_violation "backend" \
                "${ARG_TECHNIQUE} on --backend hp-eks is post-2.0: AWS's HP-EKS recipe for it is a RayJob, which needs KubeRay installed by the cluster owner (MLCC never installs it; ADR-012)." \
                "Run it as a SageMaker training job: ./do/tune --technique ${ARG_TECHNIQUE} --dataset ... (no --backend hp-eks)."
            ;;
        "")
            _contract_violation "backend" \
                "AWS publishes no HP-EKS payload for ${ARG_TECHNIQUE} (${ARG_TRAINING_TYPE})." \
                "Run it as a SageMaker training job: drop --backend hp-eks."
            ;;
        *)
            _contract_violation "backend" \
                "the ${ARG_TECHNIQUE} tune descriptor has no synced hp-eks workload kind." \
                "Regenerate the project with a current ml-container-creator (its descriptors carry the kind)."
            ;;
    esac
}

# _hp_tune_json <json> <key> — one top-level / resolved.* field.
_hp_tune_json() {
    printf '%s' "$1" | python3 -c "
import json, sys
try:
    d = json.load(sys.stdin)
except ValueError:
    d = {}
v = d.get(sys.argv[1], (d.get('resolved') or {}).get(sys.argv[1], ''))
print('' if v is None else v)
" "$2" 2>/dev/null || true
}

# _hp_tune_watch <sub> <job> — the shared watcher (main container: AWS's `pytorch`).
_hp_tune_watch() {
    python3 "${SCRIPT_DIR}/lib/python/hp_job.py" "$1" --job "$2" --namespace "${HP_NAMESPACE:-default}" \
        --artifacts-bucket "${ARTIFACTS_S3_BUCKET:-}" --project "${PROJECT_NAME}" --kind tune \
        --main-container pytorch --startup-timeout "${ARG_STARTUP_TIMEOUT:-1200}" \
        --stall-timeout "${ARG_STALL_TIMEOUT:-1800}" --poll 60
}

# _hp_tune_complete <job> <watch-json> — resolve the adapter / model under the job's
# S3 output and run the SAME promotion + TUNE_* writes as an SMTJ completion.
_hp_tune_complete() {
    local _job="$1" _out="$2" _prefix _bucket _keys _hit _type
    _prefix=$(_hp_tune_json "${_out}" artifact_prefix)
    _bucket="${_prefix#s3://}"
    _bucket="${_bucket%%/*}"
    _keys=$(aws s3 ls --recursive "${_prefix%/}/" --region "${AWS_REGION}" 2>/dev/null | awk '{print $4}') || _keys=""
    _hit=$(printf '%s\n' "${_keys}" | grep '/adapter_config\.json$' | sort | tail -1 || true)
    _type="adapter"
    if [ -z "${_hit}" ]; then
        _hit=$(printf '%s\n' "${_keys}" | grep '/config\.json$' | sort | tail -1 || true)
        _type="model"
    fi
    if [ -z "${_hit}" ]; then
        echo "⚠  No adapter_config.json / config.json under ${_prefix}; nothing to promote."
        echo "   Inspect: aws s3 ls --recursive ${_prefix%/}/"
        return 1
    fi
    JOB_NAME="${_job}"
    _handle_completion "${_job}" "s3://${_bucket}/${_hit%/*}/" "${_type}"
}

# _hp_tune_after_watch <rc> <json> <job>
_hp_tune_after_watch() {
    local _state
    _state=$(_hp_tune_json "$2" state)
    case "${_state}" in
        Succeeded) echo "✅ Tune job completed: $3"; _hp_tune_complete "$3" "$2" ;;
        Running|Pending) echo "   🔄 ${_state}: $(_hp_tune_json "$2" reason)" ;;
        *)
            echo "❌ Tune job failed: $3"
            echo "   Reason: $(_hp_tune_json "$2" reason)"
            [ -n "$(_hp_tune_json "$2" precondition)" ] && echo "   $(_hp_tune_json "$2" precondition)"
            echo "   Durable log: $(_hp_tune_json "$2" logs_uri)"
            exit 2
            ;;
    esac
}

# _hp_tune_status — --status for an hp-eks tune job (one classify + act pass; a
# finished job is deleted, a success not yet recorded is completed).
_hp_tune_status() {
    local _t_u _job _out _rc=0
    _t_u=$(echo "${ARG_TECHNIQUE}" | tr '[:lower:]' '[:upper:]')
    _job=$(eval echo "\${TUNE_JOB_NAME_${_t_u}:-}")
    if [ -z "${_job}" ]; then
        echo "📊 No ${ARG_TECHNIQUE} tune job tracked."
        exit 0
    fi
    echo "📊 ${_job} (hp-eks, ${HP_NAMESPACE:-default})"
    _out=$(_hp_tune_watch status "${_job}") || _rc=$?
    _hp_tune_after_watch "${_rc}" "${_out}" "${_job}"
    exit 0
}

_hp_tune_run() {
    local _peft _ns _job _tmp _ptr _tmpl_uri _op_uri _shape _kind _t _e _input _crc=0 _cjson
    _peft=$(_tune_variant)
    _ns="${HP_NAMESPACE:-default}"
    if [ -z "${HP_CLUSTER_NAME:-}" ]; then
        echo "❌ HP_CLUSTER_NAME is not set (hp-eks runs on the project's HyperPod cluster)"
        exit 1
    fi
    if [ -z "${ARTIFACTS_S3_BUCKET:-}" ]; then
        echo "❌ The profile has no artifacts bucket (ARTIFACTS_S3_BUCKET): ml-container-creator bootstrap update --module training"
        exit 1
    fi
    case "${STAGED_MODEL_PATH:-}" in
        s3://*) ;;
        *)
            echo "❌ hp-eks tunes the base model from S3 and it is not staged: run ./do/stage first"
            exit 3
            ;;
    esac
    _ptr=$(python3 -c "
import json, sys
cat = json.load(open(sys.argv[1]))
p = (((cat.get('models') or {}).get(sys.argv[2]) or {}).get('techniques') or {}).get(sys.argv[3], {}).get('hpEks', {}).get(sys.argv[4]) or {}
if not p.get('payloadTemplate') or not p.get('overrideParams'):
    sys.exit(3)
print(p['payloadTemplate'], p['overrideParams'])
" "${CATALOG_FILE}" "${RESOLVED_MODEL_ID}" "${ARG_TECHNIQUE}" "${_peft}" 2>/dev/null) || {
        echo "❌ The tune catalog has no HP-EKS payload for ${RESOLVED_MODEL_ID} / ${ARG_TECHNIQUE} / ${_peft}"
        echo "   Regenerate the project with a current ml-container-creator (the catalog records the pointers)."
        exit 3
    }
    _tmpl_uri="${_ptr%% *}"
    _op_uri="${_ptr##* }"
    _job="$(echo "${PROJECT_NAME}" | tr '[:upper:]_' '[:lower:]-')-tune-${ARG_TECHNIQUE}-$(date +%Y%m%d-%H%M%S)"
    _tmp="$(mktemp -d)"
    if ! aws s3 cp --only-show-errors "${_tmpl_uri}" "${_tmp}/payload.yaml" --region "${AWS_REGION}" \
        || ! aws s3 cp --only-show-errors "${_op_uri}" "${_tmp}/override.json" --region "${AWS_REGION}"; then
        rm -rf "${_tmp}"
        echo "❌ Could not fetch the HP-EKS recipe (${_tmpl_uri})"
        exit 3
    fi
    _shape=$(python3 "${SCRIPT_DIR}/lib/python/hp_payload.py" shape --template "${_tmp}/payload.yaml") || {
        rm -rf "${_tmp}"
        exit 3
    }
    _kind=$(_hp_tune_json "${_shape}" kind)
    if [ "${_kind}" != "HyperPodPyTorchJob" ]; then
        rm -rf "${_tmp}"
        echo "❌ The fetched recipe's workload is '${_kind}', not HyperPodPyTorchJob; refusing."
        exit 3
    fi
    _t=$(_hp_tune_json "${_shape}" gpus)
    _e=$(_hp_tune_json "${_shape}" efa)
    # R10.2: the recipe's dataset format (SFT: messages; DPO: prompt/chosen/rejected).
    if ! aws s3 cp --only-show-errors "${RESOLVED_DATASET_S3_URI}" "${_tmp}/in.jsonl" --region "${AWS_REGION}" \
        || ! python3 "${SCRIPT_DIR}/lib/python/hp_payload.py" prepare-data --technique "${ARG_TECHNIQUE}" \
            --in "${_tmp}/in.jsonl" --out "${_tmp}/train.jsonl" >/dev/null; then
        rm -rf "${_tmp}"
        echo "❌ The dataset could not be prepared for the HP-EKS recipe (see above)"
        exit 3
    fi
    _input="s3://${ARTIFACTS_S3_BUCKET}/${PROJECT_NAME}/tune/${_job}/input/"

    echo ""
    echo "🔎 Cluster contract (hp-eks tune, read-only):"
    local _contract_script _adapt=""
    [ "${ARG_ADAPT_SHAPE}" = true ] && _adapt="--adapt-shape"
    _contract_script=$(python3 "${SCRIPT_DIR}/lib/python/target_manifest.py" cluster_contract "${DEPLOYMENT_TARGET}" \
        | python3 -c "import json,sys; print(json.load(sys.stdin).get('script',''))")
    _cjson=$(python3 "${SCRIPT_DIR}/${_contract_script}" contract --verb tune --namespace "${_ns}" \
        --project "${PROJECT_NAME}" --group "${ARG_INSTANCE_GROUP:-${TUNE_HP_INSTANCE_GROUP:-}}" \
        --dataset "${_input}train.jsonl" --job "${_job}" --template-gpus "${_t}" --template-efa "${_e}" ${_adapt}) || _crc=$?
    if [ "${_crc}" -eq 4 ] && [ "${ARG_DRY_RUN}" != true ]; then
        rm -rf "${_tmp}"
        echo "❌ The cluster contract has blocking findings (above); nothing was submitted."
        exit 4
    elif [ "${_crc}" -ne 0 ] && [ "${_crc}" -ne 4 ]; then
        rm -rf "${_tmp}"
        echo "❌ The cluster contract could not run (exit ${_crc})"
        exit 1
    fi
    local _group _alloc _gefa _itype _vram _bytes _hp_args=()
    _group=$(_hp_tune_json "${_cjson}" group)
    _alloc=$(_hp_tune_json "${_cjson}" allocatable)
    _gefa=$(_hp_tune_json "${_cjson}" efa)
    _itype=$(_hp_tune_json "${_cjson}" instance_type)
    if [ -z "${_group}" ] || [ -z "${_alloc}" ]; then
        rm -rf "${_tmp}"
        echo "❌ No GPU node could be chosen (see free-gpus above)."
        exit 4
    fi
    _vram=$(python3 -c "
import sys; sys.path.insert(0, sys.argv[1])
import right_sizing
print(right_sizing.gpu_memory_gib_for(sys.argv[2]) or '')" "${SCRIPT_DIR}/lib/python" "${_itype}" 2>/dev/null || true)
    _bytes=$(python3 -c "
import sys; sys.path.insert(0, sys.argv[1])
import hp_job
print(hp_job.s3_prefix_bytes(sys.argv[2]) or '')" "${SCRIPT_DIR}/lib/python" "${STAGED_MODEL_PATH}" 2>/dev/null || true)
    [ -n "${_vram}" ] && _hp_args+=(--gpu-vram-gib "${_vram}")
    [ -n "${_bytes}" ] && _hp_args+=(--model-bytes "${_bytes}")
    [ "${ARG_ADAPT_SHAPE}" = true ] && _hp_args+=(--adapt-shape)
    local _kv
    for _kv in ${SET_KNOBS[@]+"${SET_KNOBS[@]}"}; do
        _hp_args+=(--set "${_kv}")
    done
    local _values='{}'
    [ -n "${MLFLOW_APP_ARN:-}" ] && _values="{\"mlflow_tracking_uri\": \"${MLFLOW_APP_ARN}\"}"
    local _manifest="${_tmp}/manifest.json"
    if ! python3 "${SCRIPT_DIR}/lib/python/hp_payload.py" render --template "${_tmp}/payload.yaml" \
        --override-params "${_tmp}/override.json" --values-json "${_values}" --group "${_group}" \
        --group-gpus "${_alloc}" --group-efa "${_gefa:-0}" --project "${PROJECT_NAME}" --job "${_job}" \
        --namespace "${_ns}" --artifacts-bucket "${ARTIFACTS_S3_BUCKET}" --region "${AWS_REGION}" \
        --max-runtime "${TUNE_MAX_RUNTIME:-86400}" --dataset-uri "${_input}" --model-uri "${STAGED_MODEL_PATH}" \
        --technique "${ARG_TECHNIQUE}" --out "${_manifest}" ${_hp_args[@]+"${_hp_args[@]}"} >/dev/null; then
        local _rr=$?
        rm -rf "${_tmp}"
        exit "${_rr}"
    fi
    echo ""
    echo "📋 HyperPodPyTorchJob: ${_ns}/${_job}  (group ${_group}, recipe ${_tmpl_uri##*/})"
    if [ "${ARG_DRY_RUN}" = true ]; then
        echo ""
        echo "🔍 Dry run — patched HP-EKS manifest (nothing uploaded or applied):"
        cat "${_manifest}"
        rm -rf "${_tmp}"
        exit 0
    fi
    if ! aws s3 cp --only-show-errors "${_tmp}/train.jsonl" "${_input}train.jsonl" --region "${AWS_REGION}"; then
        rm -rf "${_tmp}"
        echo "❌ Could not upload the prepared dataset to ${_input}"
        exit 1
    fi
    if [ "${ARG_RENDER_ONLY}" = true ]; then
        local _keep="${SCRIPT_DIR}/.hp-tune-${_job}.json"
        cp "${_manifest}" "${_keep}"
        rm -rf "${_tmp}"
        echo ""
        echo "📝 Render only — data staged at ${_input}; manifest: ${_keep}"
        echo "   Apply (cluster owner / attended run):"
        echo "     kubectl create serviceaccount mlcc-train-sa -n ${_ns} --dry-run=client -o yaml | kubectl apply -f -"
        echo "     kubectl apply -f ${_keep}"
        echo "   Watch (deletes the job on any terminal state):"
        echo "     python3 do/lib/python/hp_job.py watch --job ${_job} --namespace ${_ns} --artifacts-bucket ${ARTIFACTS_S3_BUCKET} --project ${PROJECT_NAME} --kind tune --main-container pytorch"
        exit 0
    fi
    echo "🚀 Submitting to HyperPod EKS (${HP_CLUSTER_NAME})..."
    if ! python3 "${SCRIPT_DIR}/lib/python/hp_job.py" submit --manifest "${_manifest}" --namespace "${_ns}" >/dev/null; then
        rm -rf "${_tmp}"
        echo "❌ kubectl apply failed (see above)"
        exit 1
    fi
    rm -rf "${_tmp}"
    local _t_u
    _t_u=$(echo "${ARG_TECHNIQUE}" | tr '[:lower:]' '[:upper:]')
    _update_config_var "TUNE_JOB_NAME_${_t_u}" "${_job}"
    _update_config_var "TUNE_BACKEND_${_t_u}" "hp-eks"
    if [ "${ARG_NO_WAIT}" = true ]; then
        echo "   --no-wait: ./do/tune --technique ${ARG_TECHNIQUE} --status checks it (and releases the GPUs when done)."
        exit 0
    fi
    local _out _rc=0
    _out=$(_hp_tune_watch watch "${_job}") || _rc=$?
    _hp_tune_after_watch "${_rc}" "${_out}" "${_job}"
}

# ── _dry_run() ────────────────────────────────────────────────────────────────
# Validate all inputs and show what would be submitted without creating a job.
_dry_run() {
    # Req 3A: validate the two-input contract (dataset + evaluator) for RFT
    # techniques up front so --dry-run surfaces a missing input before submission.
    _preflight_rft_inputs

    local output_bucket
    output_bucket=$(_resolve_output_bucket) || exit 1

    local role_arn
    if [ -n "${ARG_ROLE}" ]; then
        role_arn="${ARG_ROLE}"
    elif [ -n "${ROLE_ARN:-}" ]; then
        role_arn="${ROLE_ARN}"
    else
        role_arn="${SAGEMAKER_ROLE_ARN:-<not configured>}"
    fi

    local timestamp
    timestamp=$(date +%Y%m%d-%H%M%S)
    local job_name="${PROJECT_NAME}-tune-${ARG_TECHNIQUE}-${timestamp}"

    echo "🔍 Dry run — validation passed, would submit:"
    echo ""
    echo "   Job name:      ${job_name}"
    echo "   Model:         ${RESOLVED_MODEL_ID}"
    echo "   Technique:     ${ARG_TECHNIQUE}"
    echo "   Training type: ${ARG_TRAINING_TYPE}"
    echo "   Dataset:       ${RESOLVED_DATASET_S3_URI}"
    echo "   Output bucket: ${output_bucket}"
    echo "   Role:          ${role_arn}"
    echo "   Package group: ${PROJECT_NAME}"

    # BL128: show the technique-aware knobs the user set (--set / legacy aliases), keyed
    # by the descriptor's canonical knob name. Defaults the builder fills in are NOT shown
    # here (they are the descriptor's, not user-supplied); the builder validates them.
    if [ "${#SET_KNOBS[@]}" -gt 0 ]; then
        echo "   Hyperparameters (overrides):"
        local _pair
        for _pair in ${SET_KNOBS[@]+"${SET_KNOBS[@]}"}; do
            echo "      ${_pair%%=*} = ${_pair#*=}"
        done
    fi
    if [ -n "${ARG_REWARD_FUNCTION}" ]; then
        echo "   Reward fn:     ${ARG_REWARD_FUNCTION}"
    fi
    if [ -n "${ARG_REWARD_PROMPT}" ]; then
        echo "   Reward prompt: ${ARG_REWARD_PROMPT}"
    fi
    if [ -n "${ARG_AGENT_ENV}" ]; then
        echo "   Agent env:     ${ARG_AGENT_ENV}"
    fi

    echo ""
    echo "   ✅ All validations passed. Remove --dry-run to submit."
    exit 0
}

# ══════════════════════════════════════════════════════════════════════════════
# MAIN
# ══════════════════════════════════════════════════════════════════════════════

_parse_args "$@"

# Handle informational flags first
if [ "${ARG_HELP}" = true ]; then
    _show_help
fi

if [ "${ARG_LIST_MODELS}" = true ]; then
    _list_models
fi

if [ "${ARG_STATUS}" = true ]; then
    # Wave 11 (R6.3): an hp-eks job is watched by the shared HPPJ watcher.
    if [ -n "${ARG_TECHNIQUE}" ]; then
        _ST_T_U=$(echo "${ARG_TECHNIQUE}" | tr '[:lower:]' '[:upper:]')
        if [ "$(eval echo "\${TUNE_BACKEND_${_ST_T_U}:-}")" = "hp-eks" ]; then
            _hp_tune_status
        fi
    fi
    _show_status
fi

# Handle --discover flag (before requiring --technique and --dataset)
if [ "${ARG_DISCOVER}" = true ]; then
    _run_discover "${ARG_DISCOVER_FILTER}"
    exit 0
fi

# Handle --list-datasets (deprecated — dataset management moved to do/register)
# BL092: dataset management is centralized under `do/register dataset`. This is
# a soft deprecation — print guidance and exit 0 (do not list here).
if [ "${ARG_LIST_DATASETS}" = true ]; then
    echo ""
    echo "⚠️  \`./do/tune --list-datasets\` is deprecated."
    echo "   Dataset management now lives under \`./do/register dataset\`."
    echo ""
    echo "   💡 Manage datasets with: ./do/register dataset"
    echo "      Register: ./do/register dataset <name> --s3-uri <uri> --technique <sft|dpo>"
    echo "      Use:      ./do/tune --technique sft --dataset <name>"
    echo ""
    exit 0
fi

# Validate required arguments for job submission
if [ -z "${ARG_TECHNIQUE}" ]; then
    echo "❌ --technique is required"
    echo "   Usage: ./do/tune --technique <sft|dpo|rlaif|rlvr> --dataset <source>"
    echo "   Run ./do/tune --help for full usage."
    exit 1
fi

if [ -z "${ARG_DATASET}" ]; then
    echo "❌ --dataset is required"
    echo "   Usage: ./do/tune --technique ${ARG_TECHNIQUE} --dataset <s3://... or hf://...>"
    echo "   Run ./do/tune --help for full usage."
    exit 1
fi

# Golden-path gating — check TUNE_SUPPORTED before any model resolution
if [ "${TUNE_SUPPORTED:-}" != "true" ]; then
    echo ""
    echo "❌ Managed fine-tuning is not available for this model family."
    echo ""
    echo "   Use ./do/train for custom fine-tuning."
    echo ""
    exit 1
fi

# Validate Python availability
if ! command -v python3 &>/dev/null; then
    echo "❌ python3 is required but not found"
    echo "   Install Python 3 to use managed model customization."
    exit 1
fi

# Run validations
echo "🔧 SageMaker AI Managed Model Customization"
echo ""

_check_catalog_staleness
_resolve_tune_model
_validate_technique
_validate_training_type
# Wave 11 (R1.2, R9): resolve the compute backend from the target descriptor and
# gate the hp-eks workload kind BEFORE the dataset preflight touches anything.
_tune_resolve_backend
[ "${TUNE_BACKEND_RESOLVED}" = "hp-eks" ] && _hp_tune_gate
_validate_dataset
if [ "${TUNE_BACKEND_RESOLVED}" = "hp-eks" ]; then
    _hp_tune_run
    exit $?
fi

# Check idempotency (may exit early if existing job is handled)
if _check_idempotency; then
    # No existing job or --force: proceed with submission

    if [ "${ARG_DRY_RUN}" = true ]; then
        _dry_run
    fi

    _submit_job

    if [ "${ARG_NO_WAIT}" = true ]; then
        echo "   --no-wait specified. Job running in background."
        echo "   Check status: ./do/tune --status"
        exit 0
    fi

    _poll_job
    _handle_completion
fi
