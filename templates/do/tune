# ── _resolve_output_bucket() ──────────────────────────────────────────────────
# Resolve the S3 output bucket: --output-bucket, else the profile's artifacts
# bucket (ARTIFACTS_S3_BUCKET; TUNE_S3_BUCKET override alias). No fallback name —
# a missing profile key is a hard error naming the bootstrap module to add.
_resolve_output_bucket() {
    if [ -n "${ARG_OUTPUT_BUCKET}" ]; then
        echo "${ARG_OUTPUT_BUCKET}"
        return 0
    fi
    _require_bucket ARTIFACTS_S3_BUCKET || return 1
