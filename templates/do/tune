ARG_DATASET_NAME=""
ARG_DATASET_VERSION=""
ARG_EVALUATOR_NAME=""
ARG_AGENT_ENV=""
ARG_NO_REGISTER=false


# ── _parse_args() ─────────────────────────────────────────────────────────────
# Parse all CLI flags into variables.
_parse_args() {
    while [ $# -gt 0 ]; do
        case "$1" in
            --technique)
                if [ -z "${2:-}" ]; then
                    echo "❌ --technique requires a value (sft, dpo, rlaif, rlvr, mtrl)"
                    exit 1
                fi
                ARG_TECHNIQUE="$2"; shift 2 ;;
            --dataset)
                if [ -z "${2:-}" ]; then
                    echo "❌ --dataset requires a value (s3://... or hf://...)"
                    exit 1
                fi
                ARG_DATASET="$2"; shift 2 ;;
            --training-type)
                if [ -z "${2:-}" ]; then
                    echo "❌ --training-type requires a value (lora, full-rank)"
                    exit 1
                fi
                ARG_TRAINING_TYPE="$2"; shift 2 ;;
            --model)
                if [ -z "${2:-}" ]; then
                    echo "❌ --model requires a model ID"
                    exit 1
                fi
                ARG_MODEL="$2"; shift 2 ;;
            # BL128: generic per-knob setter. --set KNOB=VALUE (repeatable), keyed by the
            # descriptor's canonical knob name. The config builder validates each against
            # the selected technique's descriptor (an unknown knob is rejected there).
            --set)
                if [ -z "${2:-}" ] || [[ "$2" != *=* ]]; then
                    echo "❌ --set requires KNOB=VALUE (e.g., --set learning_rate=1e-5)"
                    exit 1
                fi
                SET_KNOBS+=("$2"); shift 2 ;;
            --advanced) ARG_ADVANCED=true; shift ;;
            --non-interactive) ARG_NON_INTERACTIVE=true; shift ;;
            # BL128: the five legacy hyperparameter flags are KEPT as aliases that populate
            # the SAME SET_KNOBS map under the descriptor's canonical knob name, so existing
            # scripts/docs keep working and get the same technique-aware validation.
            --epochs)
                if [ -z "${2:-}" ]; then
                    echo "❌ --epochs requires an integer value"
                    exit 1
                fi
                SET_KNOBS+=("max_epochs=$2"); shift 2 ;;
            --learning-rate)
                if [ -z "${2:-}" ]; then
                    echo "❌ --learning-rate requires a float value"
                    exit 1
                fi
                SET_KNOBS+=("learning_rate=$2"); shift 2 ;;
            --max-seq-length)
                if [ -z "${2:-}" ]; then
                    echo "❌ --max-seq-length requires an integer value"
                    exit 1
                fi
                SET_KNOBS+=("dataset_max_len=$2"); shift 2 ;;
            --lora-rank)
                if [ -z "${2:-}" ]; then
                    echo "❌ --lora-rank requires an integer value"
                    exit 1
                fi
                SET_KNOBS+=("lora_rank=$2"); shift 2 ;;
            --lora-alpha)
                if [ -z "${2:-}" ]; then
                    echo "❌ --lora-alpha requires an integer value"
                    exit 1
                fi
                SET_KNOBS+=("lora_alpha=$2"); shift 2 ;;
            --batch-size)
                if [ -z "${2:-}" ]; then
                    echo "❌ --batch-size requires an integer value"
                    exit 1
                fi
                SET_KNOBS+=("global_batch_size=$2"); shift 2 ;;
            --reward-function)
                if [ -z "${2:-}" ]; then
                    echo "❌ --reward-function requires a Lambda ARN"
                    exit 1
                fi
                ARG_REWARD_FUNCTION="$2"; shift 2 ;;
            --reward-prompt)
                if [ -z "${2:-}" ]; then
                    echo "❌ --reward-prompt requires a hub-content evaluator ARN (or use --evaluator-name)"
                    exit 1
                fi
                ARG_REWARD_PROMPT="$2"; shift 2 ;;
            --output-bucket)
                if [ -z "${2:-}" ]; then
                    echo "❌ --output-bucket requires a bucket name"
                    exit 1
                fi
                ARG_OUTPUT_BUCKET="$2"; shift 2 ;;
            --role)
                if [ -z "${2:-}" ]; then
                    echo "❌ --role requires an IAM role ARN"
                    exit 1
                fi
                ARG_ROLE="$2"; shift 2 ;;
            --force) ARG_FORCE=true; shift ;;
            --accept-eula) ARG_ACCEPT_EULA=true; shift ;;
            --no-wait) ARG_NO_WAIT=true; shift ;;
            --no-register) ARG_NO_REGISTER=true; shift ;;
            --status) ARG_STATUS=true; shift ;;
            --help|-h) ARG_HELP=true; shift ;;
            --dry-run) ARG_DRY_RUN=true; shift ;;
            --adapt-shape) ARG_ADAPT_SHAPE=true; shift ;;
            --render-only) ARG_RENDER_ONLY=true; shift ;;
            --backend|--instance-group|--startup-timeout|--stall-timeout)
                if [ -z "${2:-}" ] || [[ "${2}" == -* ]]; then
                    echo "❌ $1 requires a value"
                    exit 2
                fi
                case "$1" in
                    --backend) ARG_BACKEND="$2" ;;
                    --instance-group) ARG_INSTANCE_GROUP="$2" ;;
                    --startup-timeout) ARG_STARTUP_TIMEOUT="$2" ;;
                    --stall-timeout) ARG_STALL_TIMEOUT="$2" ;;
                esac
                shift 2 ;;
            --list-models) ARG_LIST_MODELS=true; shift ;;
            --list-datasets) ARG_LIST_DATASETS=true; shift ;;
            --source)
                if [ -z "${2:-}" ]; then
                    echo "❌ --source requires a value: remote, local, or all"
                    exit 1
                fi
                ARG_DATASET_SOURCE="$2"; shift 2 ;;
            --no-stale-warning) ARG_NO_STALE_WARNING=true; shift ;;
            --column-map)
                if [ -z "${2:-}" ]; then
                    echo "❌ --column-map requires a value (e.g., prompt=question,completion=answer)"
                    exit 1
                fi
                ARG_COLUMN_MAP="$2"; shift 2 ;;
            --discover)
                ARG_DISCOVER=true
                shift
                if [ $# -gt 0 ] && [[ ! "$1" == --* ]]; then
                    ARG_DISCOVER_FILTER="$1"
                    shift
                fi
                ;;
            --take)
                if [ -z "${2:-}" ]; then
                    echo "❌ --take requires an integer value"
                    exit 1
                fi
                ARG_TAKE="$2"; shift 2 ;;
            --dataset-name)
                if [ -z "${2:-}" ]; then
                    echo "❌ --dataset-name requires a registered dataset name"
                    exit 1
                fi
                ARG_DATASET_NAME="$2"; shift 2 ;;
            --evaluator-name)
                if [ -z "${2:-}" ]; then
                    echo "❌ --evaluator-name requires a registered evaluator name"
                    exit 1
                fi
                ARG_EVALUATOR_NAME="$2"; shift 2 ;;
            --agent-env)
                if [ -z "${2:-}" ]; then
                    echo "❌ --agent-env requires a CustomAgentLambda ARN (MTRL)"
                    exit 1
                fi
                ARG_AGENT_ENV="$2"; shift 2 ;;
            *)
                echo "❌ Unknown option: $1"
                echo "   Run ./do/tune --help for usage."
                exit 1
                ;;
        esac
    done
}


