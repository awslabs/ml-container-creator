# ── _validate_dataset() ───────────────────────────────────────────────────────
# Check S3 existence or delegate HF staging to Python helper.
# Sets RESOLVED_DATASET_S3_URI on success.
_validate_dataset() {
    local dataset="${ARG_DATASET}"

    # ── Parse @v<version> suffix (AC-2.1, AC-2.3) ───────────────────────────
    # Syntax: dataset-name@v2 → name="dataset-name", version ordinal=2
    #         dataset-name@v1.0.0 → name="dataset-name", version="1.0.0" (semver)
    if [[ "${dataset}" =~ ^(.+)@v([0-9]+\.[0-9]+\.[0-9]+)$ ]]; then
        # Semver syntax: @v1.0.0
        ARG_DATASET_NAME="${BASH_REMATCH[1]}"
        ARG_DATASET_VERSION="${BASH_REMATCH[2]}"
        dataset=""  # Clear so name-based resolution takes over
    elif [[ "${dataset}" =~ ^(.+)@v([0-9]+)$ ]]; then
        # Ordinal syntax: @v1, @v2
        ARG_DATASET_NAME="${BASH_REMATCH[1]}"
        ARG_DATASET_VERSION="${BASH_REMATCH[2]}"
        dataset=""  # Clear so name-based resolution takes over
    fi

    # If --dataset-name is set, resolve from registry (AC-2b.4)
    # --dataset-name takes precedence over --dataset for named registry lookup
    if [ -n "${ARG_DATASET_NAME}" ]; then
        echo "🔍 Resolving dataset '${ARG_DATASET_NAME}' from registry..."
        local resolve_args=("--name" "${ARG_DATASET_NAME}")
        # Scope resolution to THIS project's MLflow experiment. Without it, name
        # resolution reads a different experiment set and either misses the dataset
        # or (with multiple content-versions logged) resolves to a stale URI — the
        # cause of do/tune resolving a dead `.json` after a re-register. `--list`
        # (via do/register) already scopes by project; mirror it here.
        [ -n "${PROJECT_NAME:-}" ] && resolve_args+=("--project-name" "${PROJECT_NAME}")
        if [ -n "${ARG_DATASET_VERSION}" ]; then
            resolve_args+=("--version" "${ARG_DATASET_VERSION}")
            echo "   Version: v${ARG_DATASET_VERSION}"
        fi
        local resolve_result
        resolve_result=$(python3 "${SCRIPT_DIR}/.register_helper.py" resolve-dataset \
            "${resolve_args[@]}" 2>/dev/null) || resolve_result=""

        if [ -n "${resolve_result}" ]; then
            local resolved_uri
            resolved_uri=$(echo "${resolve_result}" | python3 -c "import sys,json; print(json.load(sys.stdin).get('s3_uri',''))" 2>/dev/null) || resolved_uri=""
            if [ -n "${resolved_uri}" ]; then
                echo "   Resolved to: ${resolved_uri}"
                dataset="${resolved_uri}"
                ARG_DATASET="${resolved_uri}"
                RESOLVED_DATASET_S3_URI="${resolved_uri}"
                return 0
            else
                echo "❌ Dataset '${ARG_DATASET_NAME}' not found in registry"
                echo "   Register it first: ./do/register --dataset --dataset-name ${ARG_DATASET_NAME} --dataset-s3-uri s3://..."
                exit 1
            fi
        else
            echo "❌ Failed to resolve dataset '${ARG_DATASET_NAME}' from registry"
            echo "   Register it first: ./do/register --dataset --dataset-name ${ARG_DATASET_NAME} --dataset-s3-uri s3://..."
            exit 1
        fi
    fi

    # If --dataset value is not an S3 URI or HF reference, treat as a registry name
    if [ -z "${ARG_DATASET_NAME}" ] && [ -n "${dataset}" ] && \
       [[ "${dataset}" != s3://* ]] && [[ "${dataset}" != hf://* ]]; then
        # Looks like a name — resolve from registry
        ARG_DATASET_NAME="${dataset}"
        dataset=""
    fi

    if [ -z "${dataset}" ]; then
        if [ -n "${ARG_DATASET_NAME}" ]; then
            # Name-based resolution happens below via resolve-dataset
            echo "🔍 Resolving dataset '${ARG_DATASET_NAME}' from registry..."
            local resolve_args=("--name" "${ARG_DATASET_NAME}")
            # Scope to this project's MLflow experiment (see note above) so a
            # re-registered dataset resolves to its NEWEST URI, not a stale one.
            [ -n "${PROJECT_NAME:-}" ] && resolve_args+=("--project-name" "${PROJECT_NAME}")
            if [ -n "${ARG_DATASET_VERSION}" ]; then
                resolve_args+=("--version" "${ARG_DATASET_VERSION}")
                echo "   Version: v${ARG_DATASET_VERSION}"
            fi
            local resolve_result
            resolve_result=$(python3 "${SCRIPT_DIR}/.register_helper.py" resolve-dataset \
                "${resolve_args[@]}" 2>/dev/null) || resolve_result=""

            if [ -n "${resolve_result}" ]; then
                local resolved_uri
                resolved_uri=$(echo "${resolve_result}" | grep -E '^\{' | tail -1 | python3 -c "import sys,json; print(json.load(sys.stdin).get('s3_uri',''))" 2>/dev/null) || resolved_uri=""
                if [ -n "${resolved_uri}" ]; then
                    echo "   Resolved to: ${resolved_uri}"
                    dataset="${resolved_uri}"
                    RESOLVED_DATASET_S3_URI="${resolved_uri}"
                    return 0
                fi
            fi
            echo "❌ Dataset '${ARG_DATASET_NAME}' not found in registry"
            echo "   Run ./do/tune --list-datasets to see available datasets."
            echo "   Register: ./do/register dataset <name> --s3-uri <uri> --technique <sft|dpo>"
            exit 1
        else
            echo "❌ --dataset is required"
            echo "   Provide an S3 URI (s3://bucket/path.jsonl), HF reference (hf://org/name), or registered name"
            echo "   Run ./do/tune --list-datasets to see available registered datasets."
            exit 1
        fi
    fi

    # Determine dataset type
    if [[ "${dataset}" == s3://* ]]; then
        # S3 dataset — verify existence
        if ! aws s3 ls "${dataset}" --region "${AWS_REGION}" >/dev/null 2>&1; then
            echo "❌ Dataset not found or not accessible: ${dataset}"
            echo "   Verify the S3 URI is correct and you have read permissions."
            echo "   Check: aws s3 ls ${dataset} --region ${AWS_REGION}"
            exit 1
        fi
        RESOLVED_DATASET_S3_URI="${dataset}"

        # Resolve a concrete data OBJECT to sample. `--dataset` may be a prefix
        # (SageMaker mounts the whole prefix as the train channel) or a single
        # object. `aws s3 cp <prefix>/ -` cannot stream a prefix, so when given a
        # prefix pick its first data object. Parquet is binary and the managed
        # RL (verl) loader reads it container-side — the jsonl line-validation
        # below does not apply, so skip it for parquet (and for a prefix whose
        # data objects are parquet). This client-side check only understands jsonl.
        local sample_object="${dataset}"
        if [[ "${dataset}" == */ ]]; then
            local first_obj
            first_obj=$(aws s3 ls "${dataset}" --region "${AWS_REGION}" 2>/dev/null \
                | awk '{print $NF}' | grep -vE '(^|/)_dataset\.json$' \
                | grep -E '\.(jsonl|parquet|json)$' | head -1) || first_obj=""
            if [ -n "${first_obj}" ]; then
                sample_object="${dataset}${first_obj}"
            fi
        fi

        # Managed RL techniques (rlvr/rlaif/mtrl) run verl's RLHFDataset, whose
        # loader is hardcoded to parquet (datasets.load_dataset("parquet", ...)).
        # A non-parquet dataset fails deep in the GPU job with an opaque
        # "ArrowInvalid: Parquet magic bytes not found". Fail LOUD here in
        # preflight instead. (sft/dpo use a different managed trainer and are not
        # subject to this constraint, so the check is scoped to RL techniques.)
        case "${ARG_TECHNIQUE}" in
            rlvr|rlaif|mtrl)
                if [[ "${sample_object}" != *.parquet ]]; then
                    echo "❌ ${ARG_TECHNIQUE} requires a PARQUET dataset."
                    echo "   The managed RL trainer (verl) reads the train channel as parquet;"
                    echo "   a non-parquet file (${sample_object##*/}) fails in-container with"
                    echo "   'ArrowInvalid: Parquet magic bytes not found'."
                    echo ""
                    echo "   Provide a parquet dataset. Keep 'prompt' as a chat message list"
                    echo "   ([{\"role\",\"content\"}]), and ensure the S3 prefix contains ONLY"
                    echo "   parquet data files (no _dataset.json sidecar in the channel)."
                    exit 1
                fi
                echo "   Dataset is parquet (${sample_object##*/}); RL format check passed."
                # BL129 — field-schema half of the Gate. The format half above only
                # checks the file is parquet; now verify the ROW SCHEMA carries the
                # verl fields the descriptor's dataset_contract requires (the SAME
                # contract the register-side Producer wrote against), so a
                # contract-violating parquet fails in sub-second preflight instead of
                # deep in the GPU job. Techniques whose contract is unverified
                # (mtrl-rollout → required_dataset_fields == []) are format-checked
                # ONLY — the reader returns [] and the check is skipped.
                _validate_rl_field_schema "${sample_object}" "${ARG_TECHNIQUE}"
                return 0
                ;;
        esac

        # Parquet → skip jsonl line-validation (format is validated by the
        # training container's parquet loader, not here).
        if [[ "${sample_object}" == *.parquet ]]; then
            echo "   Dataset is parquet (${sample_object##*/}); skipping jsonl line-check."
            return 0
        fi

        # Validate format by downloading first 10 lines
        local schema_json
        schema_json=$(_get_dataset_schema)

        local sample_data
        sample_data=$(aws s3 cp "${sample_object}" - --region "${AWS_REGION}" 2>/dev/null | head -10) || sample_data=""

        if [ -n "${sample_data}" ]; then
            local validate_result
            validate_result=$(echo "${sample_data}" | python3 "${HELPER_SCRIPT}" validate \
                --schema "${schema_json}" 2>/dev/null) || validate_result='{"valid":false,"error":"Validation failed"}'

            local is_valid
            is_valid=$(echo "${validate_result}" | python3 -c "import sys,json; print(json.load(sys.stdin).get('valid', False))" 2>/dev/null) || is_valid="False"

            if [ "${is_valid}" != "True" ]; then
                local error_msg
                error_msg=$(echo "${validate_result}" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('error','Unknown format error'))" 2>/dev/null) || error_msg="Unknown format error"
                local malformed_line
                malformed_line=$(echo "${validate_result}" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('malformed_line','') or '')" 2>/dev/null) || malformed_line=""
                local expected_format
                expected_format=$(echo "${validate_result}" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('expected_format','') or '')" 2>/dev/null) || expected_format=""

                echo "❌ Dataset format validation failed"
                echo "   ${error_msg}"
                if [ -n "${malformed_line}" ]; then
                    echo ""
                    echo "   Malformed line: ${malformed_line}"
                fi
                if [ -n "${expected_format}" ]; then
                    echo ""
                    echo "   ${expected_format}"
                fi
                exit 1
            fi
        fi

    elif [[ "${dataset}" == hf://* ]]; then
        # BL092 hard cutover: do/tune no longer stages HuggingFace datasets.
        # Dataset staging + registration is centralized under `do/register dataset`.
        local hf_ref="${dataset#hf://}"
        echo "❌ \`./do/tune --dataset hf://...\` is no longer supported."
        echo ""
        echo "   Dataset staging has moved to \`./do/register dataset\` (BL092)."
        echo "   Stage + register the HuggingFace dataset once, then tune by name:"
        echo ""
        echo "   💡 Manage datasets with: ./do/register dataset"
        echo "      1) ./do/register dataset <name> --hf-id ${hf_ref} --technique ${ARG_TECHNIQUE}"
        echo "      2) ./do/tune --technique ${ARG_TECHNIQUE} --dataset <name>"
        echo ""
        exit 1

    else
        echo "❌ Invalid dataset format: ${dataset}"
        echo "   Expected: s3://bucket/path.jsonl or a registered dataset name"
        echo "   Stage HuggingFace datasets with: ./do/register dataset <name> --hf-id <org/name>"
        exit 1
    fi
}

# ── _validate_rl_field_schema() ───────────────────────────────────────────────
# BL129 Gate field-schema half. Given a sampled PARQUET object and an RL technique,
# verify the row schema carries the verl fields the technique's tune descriptor
# requires (dataset_contract → required_dataset_fields). Fails fast (exit 1) naming
# the first missing field. A technique whose contract is unverified
# (required_dataset_fields == [], e.g. mtrl-rollout) is skipped — format-check only.
# pipefail-safe: the descriptor read and the S3 sample read each guard their pipe.
_validate_rl_field_schema() {
    local sample_object="$1"
    local technique="$2"
    local reader="${SCRIPT_DIR}/lib/python/tune_manifest.py"

    if [ ! -f "${reader}" ]; then
        # No descriptor reader (older generated project) — skip field check, keep the
        # format check that already passed. Non-fatal by design.
        return 0
    fi

    # Required fields for this technique's dataset contract (JSON array). pipefail-safe:
    # capture separately and default to [] on any error so a reader hiccup never blocks.
    local required_json
    required_json=$(python3 "${reader}" required_dataset_fields "${technique}" 2>/dev/null) || required_json="[]"
    if [ -z "${required_json}" ] || [ "${required_json}" = "[]" ]; then
        # Unverified / no field contract (e.g. mtrl) → format check only.
        return 0
    fi

    # Download the sample object to a temp file (pipefail-safe: no pipe to SIGPIPE),
    # then read its first-row column names with pyarrow and compare to the contract.
    local tmp_parquet
    tmp_parquet=$(mktemp -t mcc-rl-sample.XXXXXX.parquet) || {
        echo "   ⚠️  Could not create a temp file for the RL field-schema check; skipping it."
        return 0
    }
    # shellcheck disable=SC2064
    trap "rm -f '${tmp_parquet}'" RETURN

    if ! aws s3 cp "${sample_object}" "${tmp_parquet}" --region "${AWS_REGION}" >/dev/null 2>&1; then
        echo "   ⚠️  Could not download the sample object for the RL field-schema check; skipping it."
        return 0
    fi

    local check_result
    check_result=$(REQUIRED_JSON="${required_json}" PARQUET_PATH="${tmp_parquet}" python3 -c "
import json, os, sys
required = json.loads(os.environ['REQUIRED_JSON'])
path = os.environ['PARQUET_PATH']
try:
    import pyarrow.parquet as pq
except ImportError:
    print(json.dumps({'skip': 'pyarrow not installed'})); sys.exit(0)
try:
    cols = set(pq.ParquetFile(path).schema_arrow.names)
except Exception as e:  # noqa: BLE001 — surface as a non-fatal skip
    print(json.dumps({'skip': f'could not read parquet schema: {e}'})); sys.exit(0)
missing = [f for f in required if f not in cols]
print(json.dumps({'missing': missing, 'present': sorted(cols)}))
" 2>/dev/null) || check_result='{\"skip\":\"field check failed to run\"}'

    local skip_reason
    skip_reason=$(echo "${check_result}" | python3 -c "import sys,json; print(json.load(sys.stdin).get('skip','') or '')" 2>/dev/null) || skip_reason=""
    if [ -n "${skip_reason}" ]; then
        echo "   ⚠️  RL field-schema check skipped (${skip_reason}); the training container will still validate."
        return 0
    fi

    local missing
    missing=$(echo "${check_result}" | python3 -c "import sys,json; print(','.join(json.load(sys.stdin).get('missing',[])))" 2>/dev/null) || missing=""
    if [ -n "${missing}" ]; then
        local present
        present=$(echo "${check_result}" | python3 -c "import sys,json; print(', '.join(json.load(sys.stdin).get('present',[])))" 2>/dev/null) || present=""
        echo "❌ ${technique} dataset is missing required verl field(s): ${missing}"
        echo "   The managed RL trainer (verl RLHFDataset) requires the 5-field row schema:"
        echo "   data_source, prompt (chat message list), ability, reward_model {style, ground_truth}, extra_info."
        echo "   Found columns: ${present}"
        echo ""
        echo "   Re-register the dataset for this technique so the Producer emits the verl"
        echo "   schema:  ./do/register dataset <name> --hf-id <org/name> --technique ${technique}"
        exit 1
    fi

    echo "   RL field-schema check passed (verl 5-field contract satisfied)."
    return 0
}

# ── _get_dataset_schema() ─────────────────────────────────────────────────────
# Get the dataset schema JSON for the current model+technique from the catalog.
