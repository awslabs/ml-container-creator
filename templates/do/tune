}

# ── _validate_technique() ─────────────────────────────────────────────────────
# Check that the technique is supported for the resolved model.
_validate_technique() {
    local technique="${ARG_TECHNIQUE}"

    # Validate technique value. sft/dpo need a dataset only; rlvr/rlaif/mtrl are
    # managed RFT techniques that ALSO need an evaluator (see _preflight_rft_inputs):
    # rlvr/mtrl → a reward function (do/register evaluator), rlaif → a reward prompt
    # (do/register prompt).
    case "${technique}" in
        sft|dpo|rlaif|rlvr|mtrl) ;;
        *)
            echo "❌ Invalid technique: ${technique}"
            echo "   Valid techniques: sft, dpo, rlaif, rlvr, mtrl"
            exit 1
            ;;
    esac

    # Check catalog for model+technique support
    local result
    result=$(python3 -c "
import json, sys

with open('${CATALOG_FILE}') as f:
    catalog = json.load(f)

model_id = '${RESOLVED_MODEL_ID}'
technique = '${technique}'
entry = catalog['models'][model_id]
techniques = entry.get('techniques', {})

if technique in techniques:
    print('SUPPORTED')
else:
    supported = list(techniques.keys())
    print('UNSUPPORTED|' + '|'.join(supported))
" 2>/dev/null) || {
        echo "❌ Failed to validate technique against catalog"
        exit 1
    }

    if [ "${result}" = "SUPPORTED" ]; then
        return 0
    fi

    local supported
    supported=$(echo "${result}" | cut -d'|' -f2- | tr '|' ', ')

    echo "❌ Technique \"${technique}\" is not supported for model \"${RESOLVED_MODEL_ID}\"."
    echo "   Supported techniques: ${supported}"
    exit 1
}

