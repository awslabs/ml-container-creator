# do/validate — Target-aware pre-deploy validation (Wave 8 R5).
#
# @mlcc-script
# type: model-centric
# guard: none
# lifecycle: pre-deploy
# targets: all
# A dispatcher: sources do/config, then do/lib/python/validate_report.py runs
# every check that applies to the configured DEPLOYMENT_TARGET and prints one
# merged report. Which checks apply is derived from targets.d/<target>/manifest.json:
#   • right-sizing (always) — the same module do/deploy runs in preflight
#   • config consistency (always) — the descriptor's required vars, do/ic/*.conf
#   • cluster contract (targets whose descriptor declares cluster_contract:
#     hyperpod-eks, eks) — the existing read-only BL156 / Wave 6.1 helpers
#   • SageMaker service-model payloads (serving_config_source sagemaker-ic, and
#     only when the schema registry exists) — the Node validate-runner
#
# Usage:
#   ./do/validate [--format json|text] [--smart] [--offline] [--no-stale-warning]
#
# Exit codes:
#   0 - Validation passed (no errors)
#   1 - Validation failed (errors found, incl. a right-sizing block)
#   2 - Validation could not run (no do/config target / no descriptor)
set -e
set -u
set -o pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${SCRIPT_DIR}/lib/script-contract.sh"
_require_python_env
PROJECT_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"

_validate_usage() {
    echo "Usage: ./do/validate [--format json|text] [--smart] [--offline] [--no-stale-warning]"
    echo ""
    echo "Validate that the project configuration fits and is deployable on the configured"
    echo "DEPLOYMENT_TARGET, before do/deploy. Checks (derived from targets.d/<target>):"
    echo "  • Right-sizing (every target): KV cache + weights (+ LoRA buffer, draft) vs GPU"
    echo "    memory, context limit, TP vs GPUs/heads, dtype vs GPU architecture, LoRA rank,"
    echo "    IC packing, disk, Service Quota — the same checks do/deploy runs in preflight."
    echo "    See docs/architecture/right-sizing.md."
    echo "  • Config consistency (every target): required do/config settings, do/ic/*.conf."
    echo "  • Cluster contract (hyperpod-eks, eks): the read-only cluster checks the deploy"
    echo "    driver runs (CSI driver, pod identity, storage backing); needs kubectl access."
    echo "  • SageMaker service-model payloads (realtime, async, batch): CreateEndpointConfig /"
    echo "    CreateInferenceComponent / CreateModel / CreateTransformJob shapes against the"
    echo "    AWS service models. Skipped (not an error) until you run"
    echo "    'ml-container-creator bootstrap sync-schemas'."
    echo ""
    echo "Options:"
    echo "  --format json|text  Report format (also --format=json). JSON is for CI."
    echo "  --smart             Smart-mode payload validators that query live AWS resources"
    echo "                      (e.g. ECR image exists). Requires AWS credentials."
    echo "  --offline           Skip network-only checks (Service Quota lookup)"
    echo "  --no-stale-warning  Suppress the schema registry staleness warning"
    echo ""
    echo "Exit codes:"
    echo "  0 — Validation passed (safe to proceed to do/deploy)"
    echo "  1 — Validation failed (errors found, including a right-sizing block)"
    echo "  2 — Validation could not run (no DEPLOYMENT_TARGET / unknown target)"
    echo ""
    echo "Typical workflow:"
    echo "  ./do/validate                    # Quick check before deploying"
    echo "  ./do/validate --smart            # Full check including live AWS resources"
    echo "  ./do/validate --format json      # CI pipeline integration"
}

# Parse flags (both --format json and --format=json are accepted).
FORMAT="text"
SMART=""
OFFLINE=""
ARG_NO_STALE_WARNING=false
while [ $# -gt 0 ]; do
    case "$1" in
        --format=json|--format=JSON) FORMAT="json"; shift ;;
        --format=text|--format=TEXT) FORMAT="text"; shift ;;
        --format)
            shift
            case "${1:-}" in
                json|JSON) FORMAT="json" ;;
                text|TEXT) FORMAT="text" ;;
                *) echo "❌ --format requires json or text" >&2; exit 2 ;;
            esac
            shift
            ;;
        --smart) SMART="--smart"; shift ;;
        --offline) OFFLINE="--offline"; shift ;;
        --no-stale-warning) ARG_NO_STALE_WARNING=true; shift ;;
        --help|-h) _validate_usage; exit 0 ;;
        *) echo "❌ Unknown option: $1 (see ./do/validate --help)" >&2; exit 2 ;;
    esac
done

# do/config may reference unset vars in ${VAR:-} defaults; source it without -u.
if [ ! -f "${SCRIPT_DIR}/config" ]; then
    echo "❌ do/config not found — cannot validate" >&2
    exit 2
fi
set +u
# shellcheck disable=SC1091
source "${SCRIPT_DIR}/config" >/dev/null
set -u

# ── _check_schema_registry_staleness() ────────────────────────────────────────
# Warn (stderr, so --format json stays parseable) if the schema registry
# manifest's lastSynced timestamp is older than the threshold.
# Configurable via MCC_CATALOG_STALENESS_DAYS (default: 90).
# Suppressed by --no-stale-warning flag or MCC_NO_STALE_WARNING=true env var.
_check_schema_registry_staleness() {
    if [ "${MCC_NO_STALE_WARNING:-}" = "true" ] || [ "${ARG_NO_STALE_WARNING:-false}" = true ]; then
        return 0
    fi
    local threshold="${MCC_CATALOG_STALENESS_DAYS:-90}"
    local manifest_file="${HOME}/.ml-container-creator/schemas/manifest.json"
    if [ ! -f "${manifest_file}" ]; then
        return 0
    fi
    local last_synced
    last_synced=$(MANIFEST_FILE="${manifest_file}" THRESHOLD="${threshold}" python3 -c "
import json, os, sys
from datetime import datetime, timezone
try:
    with open(os.environ['MANIFEST_FILE']) as f:
        manifest = json.load(f)
    ls = manifest.get('lastSynced', '')
    if not ls:
        sys.exit(0)
    synced = datetime.fromisoformat(ls.replace('Z', '+00:00'))
    days = (datetime.now(timezone.utc) - synced).days
    if days > int(os.environ['THRESHOLD']):
        print(days)
except (OSError, ValueError, TypeError, AttributeError):
    pass
" 2>/dev/null) || last_synced=""
    if [ -n "${last_synced}" ]; then
        echo "⚠  Schema registry is ${last_synced} days old. Run 'ml-container-creator bootstrap sync-schemas' to update." >&2
    fi
}
_check_schema_registry_staleness

# Resolve the Node validate-runner (SageMaker payload checks) from the installed
# mcc package. Tries: (1) npm global install, (2) local node_modules (npm link),
# (3) dev repo. Absent → that section is reported as skipped, not a failure.
_find_validate_runner() {
    local npm_root
    npm_root=$(npm root -g 2>/dev/null || true)
    if [ -n "${npm_root}" ] && [ -f "${npm_root}/@aws/ml-container-creator/src/lib/validate-runner.js" ]; then
        echo "${npm_root}/@aws/ml-container-creator/src/lib/validate-runner.js"
        return 0
    fi
    if [ -f "${PROJECT_DIR}/node_modules/@aws/ml-container-creator/src/lib/validate-runner.js" ]; then
        echo "${PROJECT_DIR}/node_modules/@aws/ml-container-creator/src/lib/validate-runner.js"
        return 0
    fi
    if [ -f "${PROJECT_DIR}/src/lib/validate-runner.js" ]; then
        echo "${PROJECT_DIR}/src/lib/validate-runner.js"
        return 0
    fi
    return 1
}
RUNNER_PATH=""
if command -v node >/dev/null 2>&1; then
    RUNNER_PATH=$(_find_validate_runner || true)
fi

[ "${FORMAT}" = "text" ] && echo "🔍 Running validation..."
_RC=0
python3 "${SCRIPT_DIR}/lib/python/validate_report.py" --do-dir "${SCRIPT_DIR}" --format "${FORMAT}" \
    --runner "${RUNNER_PATH}" ${SMART} ${OFFLINE} || _RC=$?
exit "${_RC}"
