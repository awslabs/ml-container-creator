#
# Plain EKS inference deployment — standard Kubernetes Deployment (BL103).
#
# This is a vanilla Kubernetes Deployment (NOT an InferenceEndpointConfig CRD):
# it does not depend on the HyperPod inference operator and creates no SageMaker
# endpoint. The container is the MLCC BYOC image; its baked-in ENTRYPOINT
# (code/serve) starts the model server on port 8080 (SageMaker BYOC contract).
#
# Values marked with a shell ${...} placeholder are substituted at deploy time by
# do/deploy.d/eks via envsubst; EJS expressions are baked in at project-generation
# time. Placeholders keep the ${VAR} / ${VAR:-default} shape so both envsubst
# (now) and BL111's node+ejs re-render resolve them identically.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: <%= projectName %>
  namespace: <%= hyperPodNamespace %>
  labels:
    app: <%= projectName %>
    framework: <%= framework %>
    managed-by: ml-container-creator
spec:
  replicas: <%= hyperPodReplicas %>
  selector:
    matchLabels:
      app: <%= projectName %>
  template:
    metadata:
      labels:
        app: <%= projectName %>
        framework: <%= framework %>
        managed-by: ml-container-creator
    spec:
      # IRSA: the pod runs under the MLCC inference ServiceAccount, which
      # do/deploy.d/eks annotates with the bootstrap-provisioned
      # mlcc-<profile>-eks-inference-role so code/serve can `aws s3 sync` a staged
      # model. Resolved at deploy time; defaults to the fixed SA name.
      serviceAccountName: "${EKS_INFERENCE_SA:-mlcc-eks-inference-sa}"
      containers:
        - name: <%= projectName %>
          image: ${ECR_IMAGE}
          ports:
            - name: http
              containerPort: 8080
          # Serve configuration is carried by the ConfigMap (same name as the
          # Deployment) and injected as environment variables via envFrom.
          envFrom:
            - configMapRef:
                name: <%= projectName %>
          env:
            # MODEL_SOURCE steers the BYOC entrypoint (code/serve resolve_model):
            # "s3" pulls the staged model from S3; "huggingface" pulls MODEL_NAME.
            - name: MODEL_SOURCE
              value: "${HP_MODEL_SOURCE:-huggingface}"
            # MODEL_ARTIFACT_URI is the staged S3 URI the pod downloads at startup
            # (plain EKS has no model-mounting operator). code/serve's s3 branch
            # requires it; empty for the huggingface source. Emitted unconditionally
            # with an empty default so envsubst fills it only when staged.
            - name: MODEL_ARTIFACT_URI
              value: "${HP_MODEL_ARTIFACT_URI:-}"
            # HF_TOKEN injected from the hf-token-secret K8s Secret (optional=true
            # so the pod still starts for public models / staged S3 weights).
            - name: HF_TOKEN
              valueFrom:
                secretKeyRef:
                  name: hf-token-secret
                  key: token
                  optional: true
          resources:
            requests:
              cpu: "${HP_CPU_REQUEST:-<%= String(parseInt(typeof HP_GPU_COUNT !== 'undefined' && HP_GPU_COUNT ? HP_GPU_COUNT : '1') * 4) %>}"
              memory: "${HP_MEM_REQUEST:-<%= String(parseInt(typeof HP_GPU_COUNT !== 'undefined' && HP_GPU_COUNT ? HP_GPU_COUNT : '1') * 16) %>Gi}"
              nvidia.com/gpu: "${HP_GPU_COUNT:-<%= typeof HP_GPU_COUNT !== 'undefined' && HP_GPU_COUNT ? HP_GPU_COUNT : '1' %>}"
<%
   // BL155: the model-store volume is ONE of four mutually-exclusive modes, by
   // precedence: hostPath (HP_MODEL_HOSTPATH) > a CSI mount (EKS_MODEL_MOUNT =
   // s3|ebs|fsx, backed by a namespaced PVC) > emptyDir (default). The
   // ephemeral-storage request/limit is emitted ONLY on the emptyDir path — a
   // hostPath NVMe and a PVC/CSI volume do NOT draw from the node root, so a
   // large request there would make the pod unschedulable.
   var _hostPath = (typeof modelHostPath !== 'undefined' && modelHostPath) ? String(modelHostPath) : '';
   var _mount = (typeof eksModelMount !== 'undefined' && eksModelMount) ? String(eksModelMount) : '';
   var _isEmptyDir = !_hostPath && !_mount;
-%>
<% if (_isEmptyDir) { %>
              # Ephemeral storage for the model that code/serve pulls to
              # /opt/ml/model at startup — SOURCE-AGNOSTIC: an S3 `aws s3 sync` AND
              # a HuggingFace download land there identically. Without a request the
              # scheduler reserves nothing and the kubelet evicts the pod as a
              # greedy ephemeral-storage consumer once the download fills the node
              # (the "request is 0 … was using NNGi" eviction loop). Derived
              # HP_GPU_COUNT*20Gi as a catalog-free proxy for model size (bigger
              # model ⇒ more GPUs ⇒ more weight bytes); override with
              # HP_EPHEMERAL_STORAGE for models that don't fit the heuristic.
              # NOTE: only emitted on the emptyDir path. When the model lands on a
              # hostPath NVMe mount (HP_MODEL_HOSTPATH) or a PVC/CSI mount
              # (EKS_MODEL_MOUNT), it does NOT draw from node ephemeral-storage, so
              # no request is set — requesting hundreds of Gi against a small root
              # volume would make the pod unschedulable.
              ephemeral-storage: "${HP_EPHEMERAL_STORAGE:-<%= String(parseInt(typeof HP_GPU_COUNT !== 'undefined' && HP_GPU_COUNT ? HP_GPU_COUNT : '1') * 20) %>Gi}"
<% } %>
            limits:
              nvidia.com/gpu: "${HP_GPU_COUNT:-<%= typeof HP_GPU_COUNT !== 'undefined' && HP_GPU_COUNT ? HP_GPU_COUNT : '1' %>}"
<% if (_isEmptyDir) { %>
              # Limit = request so the pod is Guaranteed for ephemeral-storage and
              # cannot exceed what the scheduler reserved.
              ephemeral-storage: "${HP_EPHEMERAL_STORAGE:-<%= String(parseInt(typeof HP_GPU_COUNT !== 'undefined' && HP_GPU_COUNT ? HP_GPU_COUNT : '1') * 20) %>Gi}"
<% } %>
          volumeMounts:
            - name: model-store
              mountPath: /opt/ml/model
            # NCCL uses POSIX shared memory (/dev/shm) for intra-node, cross-GPU
            # transport when a model is tensor-parallel across multiple GPUs in one
            # pod. Kubernetes defaults /dev/shm to 64Mi, which NCCL cannot work with:
            # ncclCommInitRank fails with "unhandled system error" and the TP ranks
            # crash at startup. Back /dev/shm with a RAM-medium emptyDir so NCCL has
            # room to form the communicator. Harmless for single-GPU (TP=1) deploys.
            - name: dshm
              mountPath: /dev/shm
      volumes:
        - name: model-store
<% if (_hostPath) { %>
          # Mode 1 — hostPath NVMe (HP_MODEL_HOSTPATH). Model lands on a pre-mounted
          # node-local NVMe volume (e.g. the SageMaker DLAMI instance-store at
          # /opt/dlami/nvme), NOT the node's small EBS root. The deploy driver
          # appends the project name. For nodes whose large instance-store is
          # mounted but NOT wired into kubelet's ephemeral-storage root — common on
          # HyperPod/DLAMI GPU nodes where the EBS root is ~100 GB but TBs of NVMe
          # sit at /opt/dlami/nvme. Avoids the DiskPressure/eviction the emptyDir
          # path hits for large models (Kimi-K3, 70B+).
          hostPath:
            path: "${HP_MODEL_HOSTPATH}/<%= projectName %>"
            type: DirectoryOrCreate
<% } else if (_mount) { %>
          # Mode 2 — CSI mount (EKS_MODEL_MOUNT=<%= _mount %>). A NAMESPACED
          # PersistentVolumeClaim (ModelPvc.yaml.ejs) backs the model volume:
          #   • s3  → binds a CLUSTER-PROVIDED static mountpoint-S3 PV, read-only —
          #           the pod streams weights from S3, no local download.
          #   • ebs → a dynamically-provisioned EBS volume (download-to-a-bigger-disk).
          #   • fsx → an FSx-for-Lustre volume.
          # MLCC emits ONLY this PVC; the PV (s3) / StorageClass (ebs|fsx) are
          # cluster-provided and validated by the BL156 contract preflight (ADR-012).
          persistentVolumeClaim:
            claimName: <%= projectName %>-model-store
<% } else { %>
          # Mode 3 — default bounded emptyDir on the node root EBS. Disk is accounted
          # against the sizeLimit and the ephemeral-storage reservation above. Fine
          # for models that fit the node root; large models need the hostPath NVMe
          # path (HP_MODEL_HOSTPATH) or a CSI mount (EKS_MODEL_MOUNT=s3|ebs|fsx).
          emptyDir:
            sizeLimit: "${HP_EPHEMERAL_STORAGE:-<%= String(parseInt(typeof HP_GPU_COUNT !== 'undefined' && HP_GPU_COUNT ? HP_GPU_COUNT : '1') * 20) %>Gi}"
<% } %>
        # RAM-backed /dev/shm for NCCL (multi-GPU tensor-parallel transport). Sized
        # at HP_GPU_COUNT*8Gi by default (a catalog-free proxy: more GPUs ⇒ more
        # cross-rank shared-memory buffers), overridable via HP_SHM_SIZE. Drawn from
        # node RAM — keep it well under the instance's memory. The 64Mi K8s default
        # is far too small and makes ncclCommInitRank fail with "unhandled system
        # error" on any TP>1 model (e.g. Kimi-K3 at --tp-size 8).
        - name: dshm
          emptyDir:
            medium: Memory
            sizeLimit: "${HP_SHM_SIZE:-<%= String(parseInt(typeof HP_GPU_COUNT !== 'undefined' && HP_GPU_COUNT ? HP_GPU_COUNT : '1') * 8) %>Gi}"
