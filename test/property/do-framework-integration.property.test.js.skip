        it('should stream container logs in do/run script', () => {
            console.log('\n  🧪 Property 6 (Part 5): do/run streams container logs');
            // console.log('  📝 The do/run script should stream container logs in real-time');
            // console.log('  **Validates: Requirements 6.6**');

