    describe('Property 3: All do scripts use set -e for error handling (do/clean)', () => {
        it('should use set -e in do/clean script', () => {
            console.log('\n  🧪 Property 3: All do scripts use set -e for error handling (do/clean)');
            // console.log('  📝 The do/clean script should use set -e, set -u, and set -o pipefail');
            // console.log('  **Validates: Requirements 13.5**');

            // Read the do/clean template file
            const cleanScriptPath = path.join(__dirname, '../../generators/app/templates/do/clean');
            const cleanScript = readFileSync(cleanScriptPath, 'utf8');

            // Check for set -e
            assert.ok(
                cleanScript.includes('set -e'),
                'do/clean script should use set -e'
            );

            // Check for set -u
            assert.ok(
                cleanScript.includes('set -u'),
                'do/clean script should use set -u'
            );

            // Check for set -o pipefail
            assert.ok(
                cleanScript.includes('set -o pipefail'),
                'do/clean script should use set -o pipefail'
            );

            // Verify these are near the beginning of the script (after shebang and comments)
            const lines = cleanScript.split('\n');
            let foundSetE = false;
            let foundSetU = false;
            let foundPipefail = false;
            
            for (let i = 0; i < Math.min(10, lines.length); i++) {
                if (lines[i].includes('set -e')) foundSetE = true;
                if (lines[i].includes('set -u')) foundSetU = true;
                if (lines[i].includes('set -o pipefail')) foundPipefail = true;
            }

            assert.ok(
                foundSetE && foundSetU && foundPipefail,
                'set -e, set -u, and set -o pipefail should be near the beginning of the script'
            );

            // console.log('  ✅ Property 3 validated: do/clean uses proper error handling');
        });
    });

    describe('Property 10: Scripts that delete resources require confirmation', () => {
        it('should require confirmation before deleting resources in do/clean', () => {
            console.log('\n  🧪 Property 10: Scripts that delete resources require confirmation');
            // console.log('  📝 The do/clean script should prompt for confirmation before destructive operations');
            // console.log('  **Validates: Requirements 15.5**');

            // Read the do/clean template file
            const cleanScriptPath = path.join(__dirname, '../../generators/app/templates/do/clean');
            const cleanScript = readFileSync(cleanScriptPath, 'utf8');

            // Check for confirm_action function
            assert.ok(
                cleanScript.includes('confirm_action()'),
                'do/clean script should have confirm_action function'
            );

            // Check that confirm_action uses read -p for user input
            assert.ok(
                cleanScript.includes('read -p'),
                'do/clean script should use read -p to prompt for confirmation'
            );

            // Check for yes/no validation
            assert.ok(
                cleanScript.includes('[Yy][Ee][Ss]'),
                'do/clean script should validate yes response'
            );

            // Check that confirm_action is called before destructive operations
            // For local cleanup
            assert.ok(
                cleanScript.includes('if ! confirm_action "This will remove all local Docker images'),
                'do/clean script should confirm before removing local images'
            );

            // For ECR cleanup
            assert.ok(
                cleanScript.includes('if ! confirm_action "This will remove all images from ECR repository'),
                'do/clean script should confirm before removing ECR images'
            );

            // For endpoint cleanup
            assert.ok(
                cleanScript.includes('if ! confirm_action "This will delete SageMaker endpoint, endpoint configuration, and model'),
                'do/clean script should confirm before deleting SageMaker resources'
            );

            // Check for cancellation message
            assert.ok(
                cleanScript.includes('echo "❌ Operation cancelled"'),
                'do/clean script should display cancellation message'
            );

            // Check that confirm_action returns 1 on cancellation
            assert.ok(
                cleanScript.includes('return 1'),
                'do/clean script confirm_action should return 1 on cancellation'
            );

            // console.log('  ✅ Property 10 validated: do/clean requires confirmation before deletions');
        });

        it('should check if resources exist before attempting deletion', () => {
            console.log('\n  🧪 Property 10 (Part 2): Check resource existence before deletion');
            // console.log('  📝 The do/clean script should check if resources exist before attempting deletion');
            // console.log('  **Validates: Requirements 15.4**');

            // Read the do/clean template file
            const cleanScriptPath = path.join(__dirname, '../../generators/app/templates/do/clean');
            const cleanScript = readFileSync(cleanScriptPath, 'utf8');

            // Check for local image existence check
            assert.ok(
                cleanScript.includes('if ! docker images --format "{{.Repository}}:{{.Tag}}" | grep -q "^${PROJECT_NAME}:"'),
                'do/clean script should check if local images exist'
            );

            assert.ok(
                cleanScript.includes('echo "ℹ️  No local images found for ${PROJECT_NAME}"'),
                'do/clean script should inform user if no local images found'
            );

            // Check for ECR repository existence check
            assert.ok(
                cleanScript.includes('if ! aws ecr describe-repositories'),
                'do/clean script should check if ECR repository exists'
            );

            assert.ok(
                cleanScript.includes('echo "ℹ️  ECR repository ${ECR_REPOSITORY_NAME} does not exist"'),
                'do/clean script should inform user if ECR repository does not exist'
            );

            // Check for ECR images existence check
            assert.ok(
                cleanScript.includes('aws ecr list-images'),
                'do/clean script should check for images in ECR repository'
            );

            assert.ok(
                cleanScript.includes('echo "ℹ️  No images found in repository"'),
                'do/clean script should inform user if no ECR images found'
            );

            // Check for SageMaker endpoint existence check
            assert.ok(
                cleanScript.includes('aws sagemaker describe-endpoint'),
                'do/clean script should check if SageMaker endpoint exists'
            );

            assert.ok(
                cleanScript.includes('aws sagemaker describe-endpoint-config'),
                'do/clean script should check if endpoint configuration exists'
            );

            assert.ok(
                cleanScript.includes('aws sagemaker describe-model'),
                'do/clean script should check if model exists'
            );

            assert.ok(
                cleanScript.includes('echo "ℹ️  No SageMaker resources found for ${PROJECT_NAME}"'),
                'do/clean script should inform user if no SageMaker resources found'
            );

            // Check for existence flags
            assert.ok(
                cleanScript.includes('ENDPOINT_EXISTS=false'),
                'do/clean script should track endpoint existence'
            );

            assert.ok(
                cleanScript.includes('ENDPOINT_CONFIG_EXISTS=false'),
                'do/clean script should track endpoint config existence'
            );

            assert.ok(
                cleanScript.includes('MODEL_EXISTS=false'),
                'do/clean script should track model existence'
            );

            // console.log('  ✅ Property 10 (Part 2) validated: do/clean checks resource existence');
        });
    });

    describe('do/clean functional tests', () => {
        it('should accept cleanup target argument', () => {
            console.log('\n  🧪 do/clean functional: Accept cleanup target argument');
            // console.log('  📝 The do/clean script should accept local, ecr, endpoint, or all as argument');
            // console.log('  **Validates: Requirements 8.2, 8.3, 8.4, 8.5**');

            // Read the do/clean template file
            const cleanScriptPath = path.join(__dirname, '../../generators/app/templates/do/clean');
            const cleanScript = readFileSync(cleanScriptPath, 'utf8');

            // Check for argument parsing
            assert.ok(
                cleanScript.includes('CLEANUP_TARGET="${1:-}"'),
                'do/clean script should parse cleanup target argument'
            );

            // Check for case statement with all targets
            assert.ok(
                cleanScript.includes('case "${CLEANUP_TARGET}" in'),
                'do/clean script should have case statement for cleanup targets'
            );

            // Check for local target
            assert.ok(
                cleanScript.includes('local)'),
                'do/clean script should handle local cleanup target'
            );

            assert.ok(
                cleanScript.includes('clean_local'),
                'do/clean script should call clean_local function'
            );

            // Check for ecr target
            assert.ok(
                cleanScript.includes('ecr)'),
                'do/clean script should handle ecr cleanup target'
            );

            assert.ok(
                cleanScript.includes('clean_ecr'),
                'do/clean script should call clean_ecr function'
            );

            // Check for endpoint target
            assert.ok(
                cleanScript.includes('endpoint)'),
                'do/clean script should handle endpoint cleanup target'
            );

            assert.ok(
                cleanScript.includes('clean_endpoint'),
                'do/clean script should call clean_endpoint function'
            );

            // Check for all target
            assert.ok(
                cleanScript.includes('all)'),
                'do/clean script should handle all cleanup target'
            );

            // Check that all target calls all cleanup functions
            const allCaseMatch = cleanScript.match(/all\)([\s\S]*?);;/);
            assert.ok(allCaseMatch, 'do/clean script should have all case block');
            
            const allCaseBlock = allCaseMatch[1];
            assert.ok(
                allCaseBlock.includes('clean_local'),
                'do/clean all should call clean_local'
            );
            assert.ok(
                allCaseBlock.includes('clean_ecr'),
                'do/clean all should call clean_ecr'
            );
            assert.ok(
                allCaseBlock.includes('clean_endpoint'),
                'do/clean all should call clean_endpoint'
            );

            console.log('  ✅ do/clean accepts and handles all cleanup targets');
        });

        it('should display usage when no argument provided', () => {
            console.log('\n  🧪 do/clean functional: Display usage');
            // console.log('  📝 The do/clean script should display usage when no argument is provided');
            // console.log('  **Validates: Requirements 8.1**');

            // Read the do/clean template file
            const cleanScriptPath = path.join(__dirname, '../../generators/app/templates/do/clean');
            const cleanScript = readFileSync(cleanScriptPath, 'utf8');

            // Check for show_usage function
            assert.ok(
                cleanScript.includes('show_usage()'),
                'do/clean script should have show_usage function'
            );

            // Check for usage message
            assert.ok(
                cleanScript.includes('Usage: ./do/clean [local|ecr|endpoint|all]'),
                'do/clean script should display usage syntax'
            );

            // Check for cleanup targets description
            assert.ok(
                cleanScript.includes('Cleanup targets:'),
                'do/clean script should describe cleanup targets'
            );

            assert.ok(
                cleanScript.includes('local    - Remove local Docker images'),
                'do/clean script should describe local target'
            );

            assert.ok(
                cleanScript.includes('ecr      - Remove images from Amazon ECR'),
                'do/clean script should describe ecr target'
            );

            assert.ok(
                cleanScript.includes('endpoint - Delete SageMaker endpoint, configuration, and model'),
                'do/clean script should describe endpoint target'
            );

            assert.ok(
                cleanScript.includes('all      - Perform all cleanup operations'),
                'do/clean script should describe all target'
            );

            // Check for examples section
            assert.ok(
                cleanScript.includes('Examples:'),
                'do/clean script should include examples'
            );

            // Check that show_usage is called when no argument provided
            assert.ok(
                cleanScript.includes('if [ -z "${CLEANUP_TARGET}" ]'),
                'do/clean script should check if cleanup target is empty'
            );

            const noArgMatch = cleanScript.match(/if \[ -z "\$\{CLEANUP_TARGET\}" \];[\s\S]*?fi/);
            assert.ok(noArgMatch, 'do/clean script should have no-argument handling block');
            
            const noArgBlock = noArgMatch[0];
            assert.ok(
                noArgBlock.includes('show_usage'),
                'do/clean script should call show_usage when no argument provided'
            );

            console.log('  ✅ do/clean displays usage when no argument provided');
        });

        it('should display cleanup summary', () => {
            console.log('\n  🧪 do/clean functional: Display cleanup summary');
            // console.log('  📝 The do/clean script should display a summary of removed resources');
            // console.log('  **Validates: Requirements 8.7**');

            // Read the do/clean template file
            const cleanScriptPath = path.join(__dirname, '../../generators/app/templates/do/clean');
            const cleanScript = readFileSync(cleanScriptPath, 'utf8');

            // Check for success messages after cleanup
            assert.ok(
                cleanScript.includes('echo "✅ Local images cleaned"'),
                'do/clean script should display local cleanup success'
            );

            assert.ok(
                cleanScript.includes('echo "✅ ECR images removed"'),
                'do/clean script should display ECR cleanup success'
            );

            assert.ok(
                cleanScript.includes('echo "✅ SageMaker resources cleaned"'),
                'do/clean script should display SageMaker cleanup success'
            );

            // Check for overall completion message
            assert.ok(
                cleanScript.includes('echo "Cleanup finished!"'),
                'do/clean script should display completion message'
            );

            // Check for summary in "all" target
            const allCaseMatch = cleanScript.match(/all\)([\s\S]*?);;/);
            assert.ok(allCaseMatch, 'do/clean script should have all case block');
            
            const allCaseBlock = allCaseMatch[1];
            assert.ok(
                allCaseBlock.includes('CLEANED_ITEMS=()'),
                'do/clean all should track cleaned items'
            );

            assert.ok(
                allCaseBlock.includes('CLEANED_ITEMS+='),
                'do/clean all should add items to cleaned list'
            );

            assert.ok(
                allCaseBlock.includes('echo "Summary of cleaned resources:"'),
                'do/clean all should display summary header'
            );

            assert.ok(
                allCaseBlock.includes('for item in "${CLEANED_ITEMS[@]}"'),
                'do/clean all should iterate over cleaned items'
            );

            console.log('  ✅ do/clean displays cleanup summary');
        });

