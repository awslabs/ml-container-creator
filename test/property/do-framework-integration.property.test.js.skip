                runScript.includes('MODEL_MOUNT="-v ${MODEL_DIR}:/opt/ml/model"'),
                'do/run script should set MODEL_MOUNT with volume flag'
            );

            // Check that model mount is used in docker run command
            assert.ok(
                runScript.includes('${MODEL_MOUNT}'),
                'do/run script should use MODEL_MOUNT variable in docker run command'
            );

            // Check for mount information in output
            assert.ok(
                runScript.includes('Mounting model directory'),
                'do/run script should display model mount information'
            );

            // console.log('  ✅ Property 6 (Part 3) validated: do/run mounts model directory if specified');
