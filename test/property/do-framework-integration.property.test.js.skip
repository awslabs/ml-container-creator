    describe('Property 11: Legacy wrapper scripts contain deprecation warnings', () => {
        it('should contain deprecation warning in deploy/build_and_push.sh', () => {
            console.log('\n  🧪 Property 11: Legacy wrapper scripts contain deprecation warnings');
            // console.log('  📝 The deploy/build_and_push.sh wrapper should contain deprecation warning');
            // console.log('  **Validates: Requirements 2.5, 10.6**');

            // Read the deploy/build_and_push.sh template file
            const wrapperPath = path.join(__dirname, '../../generators/app/templates/deploy/build_and_push.sh');
            const wrapperScript = readFileSync(wrapperPath, 'utf8');

            // Check for deprecation warning header comment
            assert.ok(
                wrapperScript.includes('⚠️  DEPRECATED: This script is deprecated'),
                'deploy/build_and_push.sh should have deprecation warning in header comment'
            );

            // Check for deprecation warning output
            assert.ok(
                wrapperScript.includes('echo "⚠️  WARNING: This script is DEPRECATED"'),
                'deploy/build_and_push.sh should display deprecation warning'
            );

            // Check for migration instructions
            assert.ok(
                wrapperScript.includes('Please use the do-framework commands instead:'),
                'deploy/build_and_push.sh should provide migration instructions'
            );

            // Check for do/build reference
            assert.ok(
                wrapperScript.includes('./do/build'),
                'deploy/build_and_push.sh should reference ./do/build'
            );

            // Check for do/push reference
            assert.ok(
                wrapperScript.includes('./do/push'),
                'deploy/build_and_push.sh should reference ./do/push'
            );

            // Check for do/README.md reference
            assert.ok(
                wrapperScript.includes('do/README.md'),
                'deploy/build_and_push.sh should reference do/README.md'
            );

            // Check for MIGRATION.md reference
            assert.ok(
                wrapperScript.includes('MIGRATION.md'),
                'deploy/build_and_push.sh should reference MIGRATION.md'
            );

            // Check that it forwards to do-framework scripts
            assert.ok(
                wrapperScript.includes('./do/build && ./do/push'),
                'deploy/build_and_push.sh should forward to ./do/build && ./do/push'
            );

            // console.log('  ✅ Property 11 validated: deploy/build_and_push.sh contains deprecation warning');
        });

        it('should contain deprecation warning in deploy/deploy.sh', () => {
            console.log('\n  🧪 Property 11 (Part 2): deploy/deploy.sh contains deprecation warning');
            // console.log('  📝 The deploy/deploy.sh wrapper should contain deprecation warning');
            // console.log('  **Validates: Requirements 2.5, 10.6**');

            // Read the deploy/deploy.sh template file
            const wrapperPath = path.join(__dirname, '../../generators/app/templates/deploy/deploy.sh');
            const wrapperScript = readFileSync(wrapperPath, 'utf8');

            // Check for deprecation warning header comment
            assert.ok(
                wrapperScript.includes('⚠️  DEPRECATED: This script is deprecated'),
                'deploy/deploy.sh should have deprecation warning in header comment'
            );

            // Check for deprecation warning output
            assert.ok(
                wrapperScript.includes('echo "⚠️  WARNING: This script is DEPRECATED"'),
                'deploy/deploy.sh should display deprecation warning'
            );

            // Check for migration instructions
            assert.ok(
                wrapperScript.includes('Please use the do-framework command instead:'),
                'deploy/deploy.sh should provide migration instructions'
            );

            // Check for do/deploy reference
            assert.ok(
                wrapperScript.includes('./do/deploy'),
                'deploy/deploy.sh should reference ./do/deploy'
            );

            // Check for do/README.md reference
            assert.ok(
                wrapperScript.includes('do/README.md'),
                'deploy/deploy.sh should reference do/README.md'
            );

            // Check for MIGRATION.md reference
            assert.ok(
                wrapperScript.includes('MIGRATION.md'),
                'deploy/deploy.sh should reference MIGRATION.md'
            );

            // Check that it forwards to do-framework script
            assert.ok(
                wrapperScript.includes('./do/deploy "$@"'),
                'deploy/deploy.sh should forward to ./do/deploy with arguments'
            );

            // console.log('  ✅ Property 11 (Part 2) validated: deploy/deploy.sh contains deprecation warning');
        });

        it('should contain deprecation warning in deploy/submit_build.sh when codebuild', () => {
            console.log('\n  🧪 Property 11 (Part 3): deploy/submit_build.sh contains deprecation warning');
            // console.log('  📝 The deploy/submit_build.sh wrapper should contain deprecation warning when deployTarget is codebuild');
            // console.log('  **Validates: Requirements 2.5, 10.6**');

            // Read the deploy/submit_build.sh template file
            const wrapperPath = path.join(__dirname, '../../generators/app/templates/deploy/submit_build.sh');
            const wrapperScript = readFileSync(wrapperPath, 'utf8');

            // Check for EJS conditional
            assert.ok(
                wrapperScript.includes('<% if (deployTarget === \'codebuild\') { %>'),
                'deploy/submit_build.sh should be conditionally generated based on deployTarget'
            );

            // Check for deprecation warning header comment
            assert.ok(
                wrapperScript.includes('⚠️  DEPRECATED: This script is deprecated'),
                'deploy/submit_build.sh should have deprecation warning in header comment'
            );

            // Check for deprecation warning output
            assert.ok(
                wrapperScript.includes('echo "⚠️  WARNING: This script is DEPRECATED"'),
                'deploy/submit_build.sh should display deprecation warning'
            );

            // Check for migration instructions
            assert.ok(
                wrapperScript.includes('Please use the do-framework command instead:'),
                'deploy/submit_build.sh should provide migration instructions'
            );

            // Check for do/submit reference
            assert.ok(
                wrapperScript.includes('./do/submit'),
                'deploy/submit_build.sh should reference ./do/submit'
            );

            // Check for do/README.md reference
            assert.ok(
                wrapperScript.includes('do/README.md'),
                'deploy/submit_build.sh should reference do/README.md'
            );

            // Check for MIGRATION.md reference
            assert.ok(
                wrapperScript.includes('MIGRATION.md'),
                'deploy/submit_build.sh should reference MIGRATION.md'
            );

            // Check that it forwards to do-framework script
            assert.ok(
                wrapperScript.includes('./do/submit "$@"'),
                'deploy/submit_build.sh should forward to ./do/submit with arguments'
            );

            // console.log('  ✅ Property 11 (Part 3) validated: deploy/submit_build.sh contains deprecation warning');
        });
    });

    describe('Property 2: All do scripts source configuration (do/submit)', () => {
        it('should source do/config in do/submit script', () => {
            console.log('\n  🧪 Property 2: All do scripts source configuration (do/submit)');
            // console.log('  📝 The do/submit script should source the do/config file');
            // console.log('  **Validates: Requirements 11.1**');

            // Read the do/submit template file
            const submitScriptPath = path.join(__dirname, '../../generators/app/templates/do/submit');
            const submitScript = readFileSync(submitScriptPath, 'utf8');

            // Check that the script sources the config file
            const sourcesConfig = /source\s+['"]\$\{SCRIPT_DIR\}\/config['"]/.test(submitScript);
            
            assert.ok(
                sourcesConfig,
                'do/submit script should source ${SCRIPT_DIR}/config'
            );

            // Verify SCRIPT_DIR is set correctly
            assert.ok(
                submitScript.includes('SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"'),
                'do/submit script should set SCRIPT_DIR to script directory'
            );

            // console.log('  ✅ Property 2 validated: do/submit sources configuration');
        });
    });

    describe('Property 3: All do scripts use set -e for error handling (do/submit)', () => {
        it('should use set -e in do/submit script', () => {
            console.log('\n  🧪 Property 3: All do scripts use set -e for error handling (do/submit)');
            // console.log('  📝 The do/submit script should use set -e, set -u, and set -o pipefail');
            // console.log('  **Validates: Requirements 13.5**');

            // Read the do/submit template file
            const submitScriptPath = path.join(__dirname, '../../generators/app/templates/do/submit');
            const submitScript = readFileSync(submitScriptPath, 'utf8');

            // Check for set -e
            assert.ok(
                submitScript.includes('set -e'),
                'do/submit script should use set -e'
            );

            // Check for set -u
            assert.ok(
                submitScript.includes('set -u'),
                'do/submit script should use set -u'
            );

            // Check for set -o pipefail
            assert.ok(
                submitScript.includes('set -o pipefail'),
                'do/submit script should use set -o pipefail'
            );

            // Verify these are near the beginning of the script (after shebang and comments)
            const lines = submitScript.split('\n');
            let foundSetE = false;
            let foundSetU = false;
            let foundPipefail = false;
            
            for (let i = 0; i < Math.min(10, lines.length); i++) {
                if (lines[i].includes('set -e')) foundSetE = true;
                if (lines[i].includes('set -u')) foundSetU = true;
                if (lines[i].includes('set -o pipefail')) foundPipefail = true;
            }

            assert.ok(
                foundSetE && foundSetU && foundPipefail,
                'set -e, set -u, and set -o pipefail should be near the beginning of the script'
            );

            // console.log('  ✅ Property 3 validated: do/submit uses proper error handling');
        });
    });

    describe('Property 12: Documentation references use do-framework commands', () => {
        it('should use do-framework commands in PROJECT_README.md', () => {
            console.log('\n  🧪 Property 12: Documentation references use do-framework commands');
            // console.log('  📝 The PROJECT_README.md template should use do-framework format (./do/build) not legacy paths');
            // console.log('  **Validates: Requirements 2.4, 16.7**');

            // Read the PROJECT_README.md template file
            const readmePath = path.join(__dirname, '../../generators/app/templates/PROJECT_README.md');
            const readmeContent = readFileSync(readmePath, 'utf8');

            // Check that it uses do-framework commands
            const doCommands = [
                './do/build',
                './do/push',
                './do/deploy',
                './do/run',
                './do/test',
                './do/clean'
            ];

            for (const command of doCommands) {
                assert.ok(
                    readmeContent.includes(command),
                    `PROJECT_README.md should reference ${command}`
                );
            }

            // Check that it does NOT reference legacy deploy/ scripts in command examples
            // (It's OK to mention them in migration context, but not as primary commands)
            const legacyPatterns = [
                /```bash\s*\n\s*\.\/deploy\/build_and_push\.sh/,
                /```bash\s*\n\s*\.\/deploy\/deploy\.sh/,
                /```bash\s*\n\s*\.\/deploy\/submit_build\.sh/
            ];

            for (const pattern of legacyPatterns) {
                assert.ok(
                    !pattern.test(readmeContent),
                    `PROJECT_README.md should not use legacy commands in code examples: ${pattern}`
                );
            }

            // console.log('  ✅ Property 12 validated: PROJECT_README.md uses do-framework commands');
        });

        it('should use do-framework commands in MIGRATION.md', () => {
            console.log('\n  🧪 Property 12 (Part 2): MIGRATION.md uses do-framework commands');
            // console.log('  📝 The MIGRATION.md template should reference do-framework commands in new workflow examples');
            // console.log('  **Validates: Requirements 2.4, 10.4, 10.5**');

            // Read the MIGRATION.md template file
            const migrationPath = path.join(__dirname, '../../generators/app/templates/MIGRATION.md');
            const migrationContent = readFileSync(migrationPath, 'utf8');

            // Check that it uses do-framework commands in "New Workflow" sections
            const doCommands = [
                './do/build',
                './do/push',
                './do/deploy',
                './do/run',
                './do/test',
                './do/clean'
            ];

            for (const command of doCommands) {
                assert.ok(
                    migrationContent.includes(command),
                    `MIGRATION.md should reference ${command}`
                );
            }

            // Check that it has a command mapping table
            assert.ok(
                migrationContent.includes('| Legacy Command | do-framework Command |'),
                'MIGRATION.md should have a command mapping table'
            );

            // Check that it explains the migration from legacy to do-framework
            assert.ok(
                migrationContent.includes('deploy/build_and_push.sh'),
                'MIGRATION.md should reference legacy scripts for comparison'
            );

            // Check that it has sections for different workflows
            assert.ok(
                migrationContent.includes('## Detailed Migration Steps') ||
                migrationContent.includes('## Migration Steps'),
                'MIGRATION.md should have detailed migration steps'
            );

            // console.log('  ✅ Property 12 (Part 2) validated: MIGRATION.md uses do-framework commands');
        });

        it('should use do-framework commands in do/README.md', () => {
            console.log('\n  🧪 Property 12 (Part 3): do/README.md uses do-framework commands');
            // console.log('  📝 The do/README.md template should document do-framework commands');
            // console.log('  **Validates: Requirements 1.5, 10.1, 10.2**');

            // Read the do/README.md template file
            const doReadmePath = path.join(__dirname, '../../generators/app/templates/do/README.md');
            const doReadmeContent = readFileSync(doReadmePath, 'utf8');

            // Check that it documents all do-framework commands
            const doCommands = [
                './do/build',
                './do/push',
                './do/deploy',
                './do/run',
                './do/test',
                './do/clean'
            ];

            for (const command of doCommands) {
                assert.ok(
                    doReadmeContent.includes(command),
                    `do/README.md should document ${command}`
                );
            }

            // Check that it has usage examples
            assert.ok(
                doReadmeContent.includes('## Usage') ||
                doReadmeContent.includes('## Commands') ||
                doReadmeContent.includes('## Available Commands'),
                'do/README.md should have a usage or commands section'
            );

            // Check that it does NOT reference legacy deploy/ scripts as primary commands
            const legacyPatterns = [
                /```bash\s*\n\s*\.\/deploy\/build_and_push\.sh/,
                /```bash\s*\n\s*\.\/deploy\/deploy\.sh/
            ];

            for (const pattern of legacyPatterns) {
                assert.ok(
                    !pattern.test(doReadmeContent),
                    `do/README.md should not use legacy commands in examples: ${pattern}`
                );
            }

            // console.log('  ✅ Property 12 (Part 3) validated: do/README.md uses do-framework commands');
        });
    });

    describe('Property 13: All expected do scripts are generated', () => {
        it('should generate all standard do scripts for any deployment configuration', async function() {
            this.timeout(60000); // 1 minute should be enough for one run
            
            console.log('\n  🧪 Property 13: All expected do scripts are generated');
            // console.log('  📝 For any generated project, the do/ directory should contain all standard scripts');
            // console.log('  **Validates: Requirements 1.2, 17.1**');

            // Standard scripts that should always be present
            const standardScripts = [
                'do/build',
                'do/push',
                'do/deploy',
                'do/run',
                'do/test',
                'do/clean',
                'do/config',
                'do/README.md'
            ];

            // Test with sagemaker deployment (no do/submit)
            console.log('\n  Testing deployment config: sklearn-flask with deployTarget: sagemaker');
            
            const resultSagemaker = await helpers.run(path.join(__dirname, '../../generators/app'))
                .inTmpDir()
                .withOptions({ 'skip-install': true, offline: true })
                .withPrompts({
                    projectName: 'test-project',
                    destinationDir: '.',
                    deploymentConfig: 'sklearn-flask',
                    deployTarget: 'sagemaker',
                    awsRegion: 'us-east-1',
                    instanceType: 'ml.m5.large',
                    awsRoleArn: 'arn:aws:iam::123456789012:role/SageMakerRole',
                    modelFormat: 'pkl',
                    includeSampleModel: false,
                    includeTesting: false,
                    proceedWithIncompatible: true
                });

            // Check that all standard scripts are generated
            for (const script of standardScripts) {
                assert.ok(
                    resultSagemaker.fs.exists(script),
                    `${script} should be generated for sagemaker deployment`
                );
            }

            // Check that do/submit is NOT generated for sagemaker
            assert.ok(
                !resultSagemaker.fs.exists('do/submit'),
                'do/submit should not be generated for sagemaker deployTarget'
            );

            console.log('  ✅ All expected scripts generated for sagemaker deployment');

            // Test with codebuild deployment (includes do/submit)
            console.log('\n  Testing deployment config: xgboost-fastapi with deployTarget: codebuild');
            
            const resultCodebuild = await helpers.run(path.join(__dirname, '../../generators/app'))
                .inTmpDir()
                .withOptions({ 'skip-install': true, offline: true })
                .withPrompts({
                    projectName: 'test-project',
                    destinationDir: '.',
                    deploymentConfig: 'xgboost-fastapi',
                    deployTarget: 'codebuild',
                    awsRegion: 'us-east-1',
                    instanceType: 'ml.m5.large',
                    awsRoleArn: 'arn:aws:iam::123456789012:role/SageMakerRole',
                    modelFormat: 'json',
                    codebuildComputeType: 'BUILD_GENERAL1_MEDIUM',
                    includeSampleModel: false,
                    includeTesting: false,
                    proceedWithIncompatible: true
                });

            // Check that all standard scripts are generated
            for (const script of standardScripts) {
                assert.ok(
                    resultCodebuild.fs.exists(script),
                    `${script} should be generated for codebuild deployment`
                );
            }

            // Check that do/submit IS generated for codebuild
            assert.ok(
                resultCodebuild.fs.exists('do/submit'),
                'do/submit should be generated for codebuild deployTarget'
            );

            console.log('  ✅ All expected scripts generated for codebuild deployment');
            console.log('\n  ✅ Property 13 validated: All expected do scripts are generated');
        });
    });

    describe('Property 15: All necessary template files are generated', () => {
        it('should generate all template files regardless of deployment configuration', async function() {
            this.timeout(60000); // 1 minute should be enough for one run
            
            console.log('\n  🧪 Property 15: All necessary template files are generated');
            // console.log('  📝 For any deployment configuration, all template files should be present');
            // console.log('  **Validates: Requirements 17.4**');

            // Define all necessary template files that should always be generated
            const necessaryFiles = [
                'Dockerfile',
                'requirements.txt',
                'PROJECT_README.md',
                'MIGRATION.md',
                'code/model_handler.py',
                'code/serve.py',
                'code/serve',
                'code/flask/app.py',
                'code/flask/wsgi.py',
                'nginx.conf',
                'buildspec.yml',
                'do/config',
                'do/build',
                'do/push',
                'do/deploy',
                'do/run',
                'do/test',
                'do/clean',
                'do/README.md',
                'deploy/build_and_push.sh',
                'deploy/deploy.sh'
            ];

            // Test with sklearn-flask to verify all files are generated
            console.log('\n  Testing deployment config: sklearn-flask with deployTarget: sagemaker');
            
            const result = await helpers.run(path.join(__dirname, '../../generators/app'))
                .inTmpDir()
                .withOptions({ 'skip-install': true, offline: true })
                .withPrompts({
                    projectName: 'test-project',
                    destinationDir: '.',
                    deploymentConfig: 'sklearn-flask',
                    deployTarget: 'sagemaker',
                    awsRegion: 'us-east-1',
                    instanceType: 'ml.m5.large',
                    awsRoleArn: 'arn:aws:iam::123456789012:role/SageMakerRole',
                    modelFormat: 'pkl',
                    includeSampleModel: false,
                    includeTesting: false,
                    proceedWithIncompatible: true
                });

            // Check that all necessary files are generated
            for (const file of necessaryFiles) {
                assert.ok(
                    result.fs.exists(file),
                    `${file} should be generated regardless of configuration`
                );
            }

            console.log('  ✅ All necessary files generated for sklearn-flask');

            // Test with transformers-vllm to verify files are still generated for different framework
            console.log('\n  Testing deployment config: transformers-vllm with deployTarget: codebuild');
            
            const resultTransformers = await helpers.run(path.join(__dirname, '../../generators/app'))
                .inTmpDir()
                .withOptions({ 'skip-install': true, offline: true })
                .withPrompts({
                    projectName: 'test-project',
                    destinationDir: '.',
                    deploymentConfig: 'transformers-vllm',
                    deployTarget: 'codebuild',
                    awsRegion: 'us-east-1',
                    instanceType: 'ml.g5.xlarge',
                    awsRoleArn: 'arn:aws:iam::123456789012:role/SageMakerRole',
                    modelName: 'meta-llama/Llama-2-7b-hf',
                    modelProfile: null,
                    codebuildComputeType: 'BUILD_GENERAL1_LARGE',
                    includeSampleModel: false,
                    includeTesting: false,
                    proceedWithIncompatible: true
                });

            // Check that all necessary files are generated for transformers too
            for (const file of necessaryFiles) {
                assert.ok(
                    resultTransformers.fs.exists(file),
                    `${file} should be generated for transformers configuration too`
                );
            }

            // Check that do/submit and deploy/submit_build.sh are generated for codebuild
            assert.ok(
                resultTransformers.fs.exists('do/submit'),
                'do/submit should be generated for codebuild deployTarget'
            );
            assert.ok(
                resultTransformers.fs.exists('deploy/submit_build.sh'),
                'deploy/submit_build.sh should be generated for codebuild deployTarget'
            );

            console.log('  ✅ All necessary files generated for transformers-vllm');
            console.log('\n  ✅ Property 15 validated: All necessary template files are generated');
        });
    });

    after(() => {
        console.log('\n✅ All do-framework Integration Property Tests completed');
    });
});
