    describe('Property 3: All do scripts use set -e for error handling (do/run)', () => {
        it('should use set -e in do/run script', () => {
            console.log('\n  🧪 Property 3: All do scripts use set -e for error handling (do/run)');
            // console.log('  📝 The do/run script should use set -e, set -u, and set -o pipefail');
            // console.log('  **Validates: Requirements 13.5**');

            // Read the do/run template file
            const runScriptPath = path.join(__dirname, '../../generators/app/templates/do/run');
            const runScript = readFileSync(runScriptPath, 'utf8');

            // Check for set -e
            assert.ok(
                runScript.includes('set -e'),
                'do/run script should use set -e'
            );

            // Check for set -u
            assert.ok(
                runScript.includes('set -u'),
                'do/run script should use set -u'
            );

            // Check for set -o pipefail
            assert.ok(
                runScript.includes('set -o pipefail'),
                'do/run script should use set -o pipefail'
            );

            // Verify these are near the beginning of the script (after shebang and comments)
            const lines = runScript.split('\n');
            let foundSetE = false;
            let foundSetU = false;
            let foundPipefail = false;
            
            for (let i = 0; i < Math.min(10, lines.length); i++) {
                if (lines[i].includes('set -e')) foundSetE = true;
                if (lines[i].includes('set -u')) foundSetU = true;
                if (lines[i].includes('set -o pipefail')) foundPipefail = true;
            }

            assert.ok(
                foundSetE && foundSetU && foundPipefail,
                'set -e, set -u, and set -o pipefail should be near the beginning of the script'
            );

            // console.log('  ✅ Property 3 validated: do/run uses proper error handling');
        });
    });

    describe('Property 6: All do scripts contain conditional branching logic (do/run)', () => {
        it('should contain case statement branching on DEPLOYMENT_CONFIG in do/run', () => {
            console.log('\n  🧪 Property 6: All do scripts contain conditional branching logic (do/run)');
            // console.log('  📝 The do/run script should contain case statement branching on DEPLOYMENT_CONFIG for GPU detection');
            // console.log('  **Validates: Requirements 17.6**');

            // Read the do/run template file
            const runScriptPath = path.join(__dirname, '../../generators/app/templates/do/run');
            const runScript = readFileSync(runScriptPath, 'utf8');

            // Check for case statement on DEPLOYMENT_CONFIG
            assert.ok(
                runScript.includes('case "${DEPLOYMENT_CONFIG}" in'),
                'do/run script should have case statement on DEPLOYMENT_CONFIG'
            );

            // Check for transformers branch (GPU support)
            assert.ok(
                runScript.includes('transformers-*)'),
                'do/run script should have transformers-* case branch for GPU support'
            );

            // Check for GPU flag setting
            assert.ok(
                runScript.includes('GPU_FLAG="--gpus all"'),
                'do/run script should set GPU_FLAG for transformers deployments'
            );

            // Check for traditional ML branch (CPU only)
            assert.ok(
                runScript.includes('sklearn-*|xgboost-*|tensorflow-*)'),
                'do/run script should have traditional ML case branch for CPU-only mode'
            );

            // Check for default case
            assert.ok(
                runScript.includes('*)'),
                'do/run script should have default case branch'
            );

            // Check for esac
            assert.ok(
                runScript.includes('esac'),
                'do/run script should close case statement with esac'
            );

            // Check that GPU flag is used in docker run command
            assert.ok(
                runScript.includes('${GPU_FLAG}'),
                'do/run script should use GPU_FLAG variable in docker run command'
            );

            // console.log('  ✅ Property 6 validated: do/run contains conditional branching logic for GPU detection');
