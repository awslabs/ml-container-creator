            }

            // Check for header message at start
            assert.ok(
                deployScript.includes('echo "🚀 Deploying to AWS SageMaker"'),
                'do/deploy script should have header message with 🚀'
            );

            // Check for success summary at end
            assert.ok(
                deployScript.includes('echo "✅ Deployment complete!"'),
                'do/deploy script should have success message with ✅'
            );

            // Check for error messages
            assert.ok(
                deployScript.includes('echo "❌ Execution role ARN not provided"'),
                'do/deploy script should have error message with ❌ for missing role ARN'
            );

            assert.ok(
                deployScript.includes('echo "❌ AWS credentials not configured"'),
                'do/deploy script should have error message with ❌ for missing credentials'
            );

            // Check for endpoint details section
            assert.ok(
                deployScript.includes('echo "📋 Endpoint Details:"'),
                'do/deploy script should display endpoint details with 📋'
            );

            // Check for test command section
            assert.ok(
                deployScript.includes('echo "🧪 Test your endpoint:"'),
                'do/deploy script should display test command with 🧪'
            );

            // Check for cleanup section
            assert.ok(
                deployScript.includes('echo "🧹 Clean up when done:"'),
                'do/deploy script should display cleanup command with 🧹'
            );

            // console.log('  ✅ Property 7 validated: do/deploy uses consistent output formatting');
        });
    });

