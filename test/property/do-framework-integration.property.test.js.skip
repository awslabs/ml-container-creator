/**
 * do-framework Integration Property-Based Tests
 * 
 * Tests universal correctness properties for do-framework integration.
 * 
 * Feature: do-framework-integration
 */

import { describe, it, before, after } from 'mocha';
import assert from 'assert';
import path from 'path';
import { fileURLToPath } from 'url';
import { readFileSync } from 'fs';
import helpers from 'yeoman-test';

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);

describe('do-framework Integration Property Tests', () => {
    before(() => {
        console.log('\n🚀 Starting do-framework Integration Property Tests');
        console.log('📋 Testing: Universal correctness properties for do-framework integration');
        console.log('🔧 Configuration: 100 iterations per property');
        console.log('⏱️  Timeout: 30000ms per test');
        console.log('');
    });

    describe('Property 1: All do scripts are executable', () => {
        it('should verify _setExecutablePermissions method includes all do scripts', () => {
            console.log('\n  🧪 Property 1: All do scripts are executable');
            // console.log('  📝 The _setExecutablePermissions method should include all do scripts in its list');
            // console.log('  **Validates: Requirements 1.4**');

            // Read the generator index.js file
            const generatorPath = path.join(__dirname, '../../generators/app/index.js');
            const generatorContent = readFileSync(generatorPath, 'utf8');

            // Check that _setExecutablePermissions method exists
            assert.ok(
                generatorContent.includes('_setExecutablePermissions()'),
                'Generator should have _setExecutablePermissions() method'
            );

            // Extract the method content
            const methodMatch = generatorContent.match(/_setExecutablePermissions\(\)\s*{[\s\S]*?^\s{4}}/m);
            assert.ok(methodMatch, '_setExecutablePermissions() method should exist');
            
            const methodContent = methodMatch[0];

            // Check that all do scripts are included in the shellScripts array
            const requiredScripts = [
                'do/build',
                'do/push',
                'do/deploy',
                'do/run',
                'do/test',
                'do/clean',
                'do/submit'
            ];

            for (const script of requiredScripts) {
                assert.ok(
                    methodContent.includes(`'${script}'`),
                    `_setExecutablePermissions should include '${script}' in shellScripts array`
                );
            }

            // Verify that the method uses chmod to set permissions
            assert.ok(
                methodContent.includes('fs.chmodSync'),
                '_setExecutablePermissions should use fs.chmodSync to set permissions'
            );

            // Verify that it sets mode to 755 (rwxr-xr-x)
            assert.ok(
                methodContent.includes('parseInt(\'755\', 8)'),
                '_setExecutablePermissions should set mode to 755'
            );

            // Verify that the method is called in the end() phase
            const endMethodMatch = generatorContent.match(/async end\(\)\s*{[\s\S]*?^\s{4}}/m);
            assert.ok(endMethodMatch, 'end() method should exist');
            
            const endMethod = endMethodMatch[0];
            assert.ok(
                endMethod.includes('this._setExecutablePermissions()'),
                'end() method should call _setExecutablePermissions()'
            );

            // console.log('  ✅ Property 1 validated: _setExecutablePermissions includes all do scripts and is called in end() phase');
        });
    });

    describe('Property 14: Generator does not use template exclusion patterns', () => {
        it('should not use ignorePatterns in generator writing phase', () => {
            console.log('\n  🧪 Property 14: Generator does not use template exclusion patterns');
            // console.log('  📝 The generator writing() method should not use ignorePatterns or conditional file exclusion');
            // console.log('  **Validates: Requirements 17.3**');

            // Read the generator index.js file
            const generatorPath = path.join(__dirname, '../../generators/app/index.js');
            const generatorContent = readFileSync(generatorPath, 'utf8');

            // Check that getIgnorePatterns is not called in the writing phase
            const writingMethodMatch = generatorContent.match(/async writing\(\)\s*{[\s\S]*?^\s{4}}/m);
            
            assert.ok(writingMethodMatch, 'writing() method should exist');
            
            const writingMethod = writingMethodMatch[0];
            
            // Verify that ignorePatterns is not used
            assert.ok(
                !writingMethod.includes('getIgnorePatterns'),
                'writing() method should not call getIgnorePatterns()'
            );
            
            assert.ok(
                !writingMethod.includes('ignorePatterns'),
                'writing() method should not use ignorePatterns variable'
            );
            
            // Verify that copyTpl does not use ignore option
            const copyTplMatch = writingMethod.match(/this\.fs\.copyTpl\([^)]+\)/s);
            
            if (copyTplMatch) {
                const copyTplCall = copyTplMatch[0];
                assert.ok(
                    !copyTplCall.includes('ignore:'),
                    'copyTpl should not use ignore option'
                );
                assert.ok(
                    !copyTplCall.includes('globOptions'),
                    'copyTpl should not use globOptions with ignore patterns'
                );
            }
            
            // console.log('  ✅ Property 14 validated: Generator does not use template exclusion patterns');
            
            return true;
        });

        it('should not have getIgnorePatterns method in TemplateManager', () => {
            console.log('\n  🧪 Property 14 (Part 2): TemplateManager does not have getIgnorePatterns');
            // console.log('  📝 The TemplateManager class should not have getIgnorePatterns() method');
            // console.log('  **Validates: Requirements 17.3**');

            // Read the TemplateManager file
            const templateManagerPath = path.join(__dirname, '../../generators/app/lib/template-manager.js');
            const templateManagerContent = readFileSync(templateManagerPath, 'utf8');

            // Check that getIgnorePatterns method does not exist
            assert.ok(
                !templateManagerContent.includes('getIgnorePatterns'),
                'TemplateManager should not have getIgnorePatterns() method'
            );
            
            // Check that private exclusion methods do not exist
            assert.ok(
                !templateManagerContent.includes('_getTransformerExclusions'),
                'TemplateManager should not have _getTransformerExclusions() method'
            );
            
            assert.ok(
                !templateManagerContent.includes('_getTraditionalMLExclusions'),
                'TemplateManager should not have _getTraditionalMLExclusions() method'
            );
            
            assert.ok(
                !templateManagerContent.includes('_getSageMakerOnlyExclusions'),
                'TemplateManager should not have _getSageMakerOnlyExclusions() method'
            );
            
            assert.ok(
                !templateManagerContent.includes('_getCodeBuildOnlyExclusions'),
                'TemplateManager should not have _getCodeBuildOnlyExclusions() method'
            );
            
            // console.log('  ✅ Property 14 (Part 2) validated: TemplateManager does not have exclusion methods');
            
            return true;
        });
    });

    describe('Property 4: Config file contains all required variables', () => {
        it('should have a config template with all required variable exports', () => {
            console.log('\n  🧪 Property 4: Config file contains all required variables');
            // console.log('  📝 The do/config template should contain export statements for all required variables');
            // console.log('  **Validates: Requirements 9.2, 9.6, 16.5**');

            // Read the config template file
            const configTemplatePath = path.join(__dirname, '../../generators/app/templates/do/config');
            const configTemplate = readFileSync(configTemplatePath, 'utf8');

            // Check for required variable exports
            const requiredVariables = [
                'PROJECT_NAME',
                'DEPLOYMENT_CONFIG',
                'FRAMEWORK',
                'MODEL_SERVER',
                'AWS_REGION',
                'ECR_REPOSITORY_NAME',
                'INSTANCE_TYPE',
                'DEPLOY_TARGET'
            ];

            for (const variable of requiredVariables) {
                const regex = new RegExp(`export\\s+${variable}=`, 'm');
                assert.ok(
                    regex.test(configTemplate),
                    `Config template should export ${variable}`
                );
            }

            // Verify that DEPLOYMENT_CONFIG uses EJS variable
            assert.ok(
                configTemplate.includes('DEPLOYMENT_CONFIG="<%= deploymentConfig %>"'),
                'Config template should use deploymentConfig EJS variable'
            );

            // Verify that FRAMEWORK uses EJS variable
            assert.ok(
                configTemplate.includes('FRAMEWORK="<%= framework %>"'),
                'Config template should use framework EJS variable'
            );

            // Verify that MODEL_SERVER uses EJS variable
            assert.ok(
                configTemplate.includes('MODEL_SERVER="<%= modelServer %>"'),
                'Config template should use modelServer EJS variable'
            );

            // Verify conditional CodeBuild variables
            assert.ok(
                configTemplate.includes('<% if (deployTarget === \'codebuild\') { %>'),
                'Config template should have conditional CodeBuild section'
            );

            assert.ok(
                configTemplate.includes('CODEBUILD_COMPUTE_TYPE'),
                'Config template should include CODEBUILD_COMPUTE_TYPE in conditional section'
            );

            // Verify conditional transformers variables
            assert.ok(
                configTemplate.includes('<% if (framework === \'transformers\') { %>'),
                'Config template should have conditional transformers section'
            );

            assert.ok(
                configTemplate.includes('MODEL_NAME'),
                'Config template should include MODEL_NAME in conditional section'
            );

            // Verify environment variable overrides
            assert.ok(
                configTemplate.includes('${AWS_REGION:-<%= awsRegion %>}'),
                'Config template should support AWS_REGION environment variable override'
            );

            assert.ok(
                configTemplate.includes('${INSTANCE_TYPE:-<%= instanceType %>}'),
                'Config template should support INSTANCE_TYPE environment variable override'
            );

            // console.log('  ✅ Property 4 validated: Config template contains all required variables');
        });
    });

    describe('Property 5: Deployment configuration derivation is correct', () => {
        it('should correctly derive framework and modelServer from all valid deployment configurations', () => {
            console.log('\n  🧪 Property 5: Deployment configuration derivation is correct');
            // console.log('  📝 Splitting deploymentConfig on hyphen should correctly derive framework and modelServer');
            // console.log('  **Validates: Requirements 16.3**');

            // All valid deployment configurations
            const validDeploymentConfigs = [
                'sklearn-flask',
                'sklearn-fastapi',
                'xgboost-flask',
                'xgboost-fastapi',
                'tensorflow-flask',
                'tensorflow-fastapi',
                'transformers-vllm',
                'transformers-sglang',
                'transformers-tensorrt-llm',
                'transformers-lmi',
                'transformers-djl'
            ];

            // Expected derivations
            const expectedDerivations = {
                'sklearn-flask': { framework: 'sklearn', modelServer: 'flask' },
                'sklearn-fastapi': { framework: 'sklearn', modelServer: 'fastapi' },
                'xgboost-flask': { framework: 'xgboost', modelServer: 'flask' },
                'xgboost-fastapi': { framework: 'xgboost', modelServer: 'fastapi' },
                'tensorflow-flask': { framework: 'tensorflow', modelServer: 'flask' },
                'tensorflow-fastapi': { framework: 'tensorflow', modelServer: 'fastapi' },
                'transformers-vllm': { framework: 'transformers', modelServer: 'vllm' },
                'transformers-sglang': { framework: 'transformers', modelServer: 'sglang' },
                'transformers-tensorrt-llm': { framework: 'transformers', modelServer: 'tensorrt-llm' },
                'transformers-lmi': { framework: 'transformers', modelServer: 'lmi' },
                'transformers-djl': { framework: 'transformers', modelServer: 'djl' }
            };

            // Test each deployment configuration
            for (const deploymentConfig of validDeploymentConfigs) {
                // Use the same derivation logic as prompt-runner.js
                const parts = deploymentConfig.split('-');
                const framework = parts[0];
                // Handle multi-part model servers (e.g., tensorrt-llm)
                const modelServer = parts.slice(1).join('-');

                const expected = expectedDerivations[deploymentConfig];

                assert.strictEqual(
                    framework,
                    expected.framework,
                    `Framework should be ${expected.framework} for ${deploymentConfig}`
                );

                assert.strictEqual(
                    modelServer,
                    expected.modelServer,
                    `Model server should be ${expected.modelServer} for ${deploymentConfig}`
                );

                // Verify framework is valid
                const validFrameworks = ['sklearn', 'xgboost', 'tensorflow', 'transformers'];
                assert.ok(
                    validFrameworks.includes(framework),
                    `Derived framework ${framework} should be valid`
                );

                // Verify modelServer is valid
                const validServers = ['flask', 'fastapi', 'vllm', 'sglang', 'tensorrt-llm', 'lmi', 'djl'];
                assert.ok(
                    validServers.includes(modelServer),
                    `Derived modelServer ${modelServer} should be valid`
                );

                // Verify combination is valid
                if (framework === 'transformers') {
                    assert.ok(
                        ['vllm', 'sglang', 'tensorrt-llm', 'lmi', 'djl'].includes(modelServer),
                        `Transformers should only use LLM servers, got ${modelServer}`
                    );
                } else {
                    assert.ok(
                        ['flask', 'fastapi'].includes(modelServer),
                        `Traditional ML should only use Flask/FastAPI, got ${modelServer}`
                    );
                }
            }

            // console.log('  ✅ Property 5 validated: Deployment configuration derivation is correct for all valid configs');
        });
    });

    describe('Property 2: All do scripts source configuration', () => {
        it('should source do/config in do/build script', () => {
            console.log('\n  🧪 Property 2: All do scripts source configuration');
            // console.log('  📝 The do/build script should source the do/config file');
            // console.log('  **Validates: Requirements 3.1, 4.1, 5.1, 6.1, 7.1, 8.1, 9.4**');

            // Read the do/build template file
            const buildScriptPath = path.join(__dirname, '../../generators/app/templates/do/build');
            const buildScript = readFileSync(buildScriptPath, 'utf8');

            // Check that the script sources the config file
            const sourcesConfig = /source\s+['"]\$\{SCRIPT_DIR\}\/config['"]/.test(buildScript);
            
            assert.ok(
                sourcesConfig,
                'do/build script should source ${SCRIPT_DIR}/config'
            );

            // Verify SCRIPT_DIR is set correctly
            assert.ok(
                buildScript.includes('SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"'),
                'do/build script should set SCRIPT_DIR to script directory'
            );

            // console.log('  ✅ Property 2 validated: do/build sources configuration');
        });
    });

    describe('Property 3: All do scripts use set -e for error handling', () => {
        it('should use set -e in do/build script', () => {
            console.log('\n  🧪 Property 3: All do scripts use set -e for error handling');
            // console.log('  📝 The do/build script should use set -e, set -u, and set -o pipefail');
            // console.log('  **Validates: Requirements 3.6, 13.5**');

            // Read the do/build template file
            const buildScriptPath = path.join(__dirname, '../../generators/app/templates/do/build');
            const buildScript = readFileSync(buildScriptPath, 'utf8');

            // Check for set -e
            assert.ok(
                buildScript.includes('set -e'),
                'do/build script should use set -e'
            );

            // Check for set -u
            assert.ok(
                buildScript.includes('set -u'),
                'do/build script should use set -u'
            );

            // Check for set -o pipefail
            assert.ok(
                buildScript.includes('set -o pipefail'),
                'do/build script should use set -o pipefail'
            );

            // Verify these are near the beginning of the script (after shebang and comments)
            const lines = buildScript.split('\n');
            let foundSetE = false;
            let foundSetU = false;
            let foundPipefail = false;
            
            for (let i = 0; i < Math.min(10, lines.length); i++) {
                if (lines[i].includes('set -e')) foundSetE = true;
                if (lines[i].includes('set -u')) foundSetU = true;
                if (lines[i].includes('set -o pipefail')) foundPipefail = true;
            }

            assert.ok(
                foundSetE && foundSetU && foundPipefail,
                'set -e, set -u, and set -o pipefail should be near the beginning of the script'
            );

            // console.log('  ✅ Property 3 validated: do/build uses proper error handling');
        });
    });

    describe('Property 6: All do scripts contain conditional branching logic', () => {
        it('should contain case statement branching on DEPLOYMENT_CONFIG in do/build', () => {
            console.log('\n  🧪 Property 6: All do scripts contain conditional branching logic');
            // console.log('  📝 The do/build script should contain case statement branching on DEPLOYMENT_CONFIG');
            // console.log('  **Validates: Requirements 17.2, 17.6, 17.7, 17.8, 17.10**');

            // Read the do/build template file
            const buildScriptPath = path.join(__dirname, '../../generators/app/templates/do/build');
            const buildScript = readFileSync(buildScriptPath, 'utf8');

            // Check for case statement on DEPLOYMENT_CONFIG
            assert.ok(
                buildScript.includes('case "${DEPLOYMENT_CONFIG}" in'),
                'do/build script should have case statement on DEPLOYMENT_CONFIG'
            );

            // Check for transformers-tensorrt-llm branch
            assert.ok(
                buildScript.includes('transformers-tensorrt-llm)'),
                'do/build script should have transformers-tensorrt-llm case branch'
            );

            // Check for transformers-vllm|transformers-sglang|transformers-lmi|transformers-djl branch
            assert.ok(
                buildScript.includes('transformers-vllm|transformers-sglang|transformers-lmi|transformers-djl)'),
                'do/build script should have transformers GPU case branch'
            );

            // Check for traditional ML branch
            assert.ok(
                buildScript.includes('sklearn-*|xgboost-*|tensorflow-*)'),
                'do/build script should have traditional ML case branch'
            );

            // Check for default case
            assert.ok(
                buildScript.includes('*)'),
                'do/build script should have default case branch'
            );

            // Check for esac
            assert.ok(
                buildScript.includes('esac'),
                'do/build script should close case statement with esac'
            );

            // console.log('  ✅ Property 6 validated: do/build contains conditional branching logic');
        });
    });

    describe('Property 7: All do scripts use consistent output formatting', () => {
        it('should use emoji prefixes in do/build script', () => {
            console.log('\n  🧪 Property 7: All do scripts use consistent output formatting');
            // console.log('  📝 The do/build script should use emoji prefixes for output messages');
            // console.log('  **Validates: Requirements 14.1, 14.2, 14.3**');

            // Read the do/build template file
            const buildScriptPath = path.join(__dirname, '../../generators/app/templates/do/build');
            const buildScript = readFileSync(buildScriptPath, 'utf8');

            // Check for emoji prefixes
            const emojiPrefixes = [
                '🚀', // Action/start
                '✅', // Success
                '❌', // Error
                '🔐', // Security/authentication
                '🔑', // Key/credentials
                '🏗️'  // Build
            ];

            for (const emoji of emojiPrefixes) {
                assert.ok(
                    buildScript.includes(emoji),
                    `do/build script should use ${emoji} emoji prefix`
                );
            }

            // Check for header message at start
            assert.ok(
                buildScript.includes('echo "🚀 Building Docker image for ${PROJECT_NAME}"'),
                'do/build script should have header message with 🚀'
            );

            // Check for success summary at end
            assert.ok(
                buildScript.includes('echo "✅ Build complete!"'),
                'do/build script should have success message with ✅'
            );

            // Check for error messages
            assert.ok(
                buildScript.includes('echo "❌ Docker is not installed"'),
                'do/build script should have error message with ❌ for missing Docker'
            );

            // Check for next steps section
            assert.ok(
                buildScript.includes('echo "Next steps:"'),
                'do/build script should have next steps section'
            );

            // console.log('  ✅ Property 7 validated: do/build uses consistent output formatting');
        });
    });

    describe('Property 9: Tool-dependent scripts validate prerequisites', () => {
        it('should validate Docker is installed in do/build script', () => {
            console.log('\n  🧪 Property 9: Tool-dependent scripts validate prerequisites');
            // console.log('  📝 The do/build script should validate that Docker is installed');
            // console.log('  **Validates: Requirements 13.1**');

            // Read the do/build template file
            const buildScriptPath = path.join(__dirname, '../../generators/app/templates/do/build');
            const buildScript = readFileSync(buildScriptPath, 'utf8');

            // Check for Docker validation
            assert.ok(
                buildScript.includes('if ! command -v docker &> /dev/null'),
                'do/build script should check if Docker is installed'
            );

            // Check for error message
            assert.ok(
                buildScript.includes('echo "❌ Docker is not installed"'),
                'do/build script should display error if Docker is not installed'
            );

            // Check for installation instructions
            assert.ok(
                buildScript.includes('Install from: https://docs.docker.com/get-docker/'),
                'do/build script should provide Docker installation instructions'
            );

            // Check for exit with error code
            assert.ok(
                buildScript.includes('exit 2'),
                'do/build script should exit with code 2 for missing prerequisite'
            );

            // Check for NGC_API_KEY validation for tensorrt-llm
            assert.ok(
                buildScript.includes('if [ -z "${NGC_API_KEY:-}" ]'),
                'do/build script should check for NGC_API_KEY when needed'
            );

            // console.log('  ✅ Property 9 validated: do/build validates prerequisites');
        });
    });

