                runScript.includes('Port: 8080'),
                'do/run script should display port information'
            );

            // console.log('  ✅ Property 6 (Part 2) validated: do/run exposes port 8080');
        });

        it('should mount model directory if specified in do/run script', () => {
            console.log('\n  🧪 Property 6 (Part 3): do/run mounts model directory if specified');
            // console.log('  📝 The do/run script should mount model directory if MODEL_DIR is set');
            // console.log('  **Validates: Requirements 6.4**');

