                pushScript.includes('aws ecr create-repository'),
                'do/push script should create ECR repository if it does not exist'
            );

            // Check for repository name parameter
            assert.ok(
                pushScript.includes('--repository-name "${ECR_REPOSITORY_NAME}"'),
