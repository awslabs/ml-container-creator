    describe('do/test script functional requirements', () => {
        it('should accept optional endpoint name argument', () => {
            console.log('\n  🧪 do/test functional: Accept optional endpoint name argument');
            // console.log('  📝 The do/test script should accept an optional endpoint name argument');
            // console.log('  **Validates: Requirements 7.2, 7.3**');

            // Read the do/test template file
            const testScriptPath = path.join(__dirname, '../../generators/app/templates/do/test');
            const testScript = readFileSync(testScriptPath, 'utf8');

            // Check for argument parsing
            assert.ok(
                testScript.includes('ENDPOINT_NAME="${1:-}"'),
                'do/test script should parse endpoint name from first argument'
            );

            // Check for conditional logic based on endpoint name
            assert.ok(
                testScript.includes('if [ -z "${ENDPOINT_NAME}" ]'),
                'do/test script should check if endpoint name is provided'
            );

            // Check for local testing mode
            assert.ok(
                testScript.includes('TEST_MODE="local"'),
                'do/test script should set TEST_MODE to local when no endpoint provided'
            );

            // Check for SageMaker testing mode
            assert.ok(
                testScript.includes('TEST_MODE="sagemaker"'),
                'do/test script should set TEST_MODE to sagemaker when endpoint provided'
            );

            console.log('  ✅ do/test accepts optional endpoint name argument');
        });

        it('should test local container at localhost:8080', () => {
            console.log('\n  🧪 do/test functional: Test local container');
            // console.log('  📝 The do/test script should test local container at localhost:8080');
            // console.log('  **Validates: Requirements 7.2**');

            // Read the do/test template file
            const testScriptPath = path.join(__dirname, '../../generators/app/templates/do/test');
            const testScript = readFileSync(testScriptPath, 'utf8');

            // Check for local URL
            assert.ok(
                testScript.includes('TARGET_URL="http://localhost:8080"'),
                'do/test script should set TARGET_URL to localhost:8080 for local testing'
            );

            // Check for local container message
            assert.ok(
                testScript.includes('echo "🧪 Testing local container at localhost:8080"'),
                'do/test script should display local container testing message'
            );

            console.log('  ✅ do/test tests local container at localhost:8080');
        });

        it('should send health check request to /ping endpoint', () => {
            console.log('\n  🧪 do/test functional: Send health check to /ping');
            // console.log('  📝 The do/test script should send health check request to /ping endpoint');
            // console.log('  **Validates: Requirements 7.4**');

            // Read the do/test template file
            const testScriptPath = path.join(__dirname, '../../generators/app/templates/do/test');
            const testScript = readFileSync(testScriptPath, 'utf8');

            // Check for /ping endpoint test
            assert.ok(
                testScript.includes('echo "🔍 Test 1: Health check"'),
                'do/test script should have health check test section'
            );

            // Check for curl to /ping for local testing
            assert.ok(
                testScript.includes('curl -s -w "\\n%{http_code}" -X GET "${TARGET_URL}/ping"'),
                'do/test script should send GET request to /ping endpoint'
            );

            // Check for HTTP 200 validation
            assert.ok(
                testScript.includes('if [ "${HTTP_CODE}" = "200" ]'),
                'do/test script should check for HTTP 200 response'
            );

            // Check for success message
            assert.ok(
                testScript.includes('echo "✅ Health check passed (HTTP ${HTTP_CODE})"'),
                'do/test script should display success message for health check'
            );

            console.log('  ✅ do/test sends health check to /ping endpoint');
        });

        it('should send inference request to /invocations endpoint', () => {
            console.log('\n  🧪 do/test functional: Send inference request to /invocations');
            // console.log('  📝 The do/test script should send inference request to /invocations endpoint');
            // console.log('  **Validates: Requirements 7.5**');

            // Read the do/test template file
            const testScriptPath = path.join(__dirname, '../../generators/app/templates/do/test');
            const testScript = readFileSync(testScriptPath, 'utf8');

            // Check for /invocations endpoint test
            assert.ok(
                testScript.includes('echo "🔍 Test 2: Inference request"'),
                'do/test script should have inference request test section'
            );

            // Check for curl to /invocations for local testing
            assert.ok(
                testScript.includes('curl -s -w "\\n%{http_code}" -X POST "${TARGET_URL}/invocations"'),
                'do/test script should send POST request to /invocations endpoint'
            );

            // Check for Content-Type header
            assert.ok(
