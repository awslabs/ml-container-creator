    describe('Property 3: All do scripts use set -e for error handling (do/deploy)', () => {
        it('should use set -e in do/deploy script', () => {
            console.log('\n  🧪 Property 3: All do scripts use set -e for error handling (do/deploy)');
            // console.log('  📝 The do/deploy script should use set -e, set -u, and set -o pipefail');
            // console.log('  **Validates: Requirements 13.5**');

            // Read the do/deploy template file
            const deployScriptPath = path.join(__dirname, '../../generators/app/templates/do/deploy');
            const deployScript = readFileSync(deployScriptPath, 'utf8');

            // Check for set -e
            assert.ok(
                deployScript.includes('set -e'),
                'do/deploy script should use set -e'
            );

            // Check for set -u
            assert.ok(
                deployScript.includes('set -u'),
                'do/deploy script should use set -u'
            );

            // Check for set -o pipefail
            assert.ok(
                deployScript.includes('set -o pipefail'),
                'do/deploy script should use set -o pipefail'
            );

            // Verify these are near the beginning of the script (after shebang and comments)
            const lines = deployScript.split('\n');
            let foundSetE = false;
            let foundSetU = false;
            let foundPipefail = false;
            
            for (let i = 0; i < Math.min(10, lines.length); i++) {
                if (lines[i].includes('set -e')) foundSetE = true;
                if (lines[i].includes('set -u')) foundSetU = true;
                if (lines[i].includes('set -o pipefail')) foundPipefail = true;
            }

            assert.ok(
                foundSetE && foundSetU && foundPipefail,
                'set -e, set -u, and set -o pipefail should be near the beginning of the script'
            );

            // console.log('  ✅ Property 3 validated: do/deploy uses proper error handling');
        });
    });

    describe('Property 6: All do scripts contain conditional branching logic (do/deploy)', () => {
        it('should contain case statement branching on DEPLOY_TARGET in do/deploy', () => {
            console.log('\n  🧪 Property 6: All do scripts contain conditional branching logic (do/deploy)');
            // console.log('  📝 The do/deploy script should contain case statement branching on DEPLOY_TARGET');
            // console.log('  **Validates: Requirements 17.8**');

            // Read the do/deploy template file
            const deployScriptPath = path.join(__dirname, '../../generators/app/templates/do/deploy');
            const deployScript = readFileSync(deployScriptPath, 'utf8');

            // Check for case statement on DEPLOY_TARGET
            assert.ok(
                deployScript.includes('case "${DEPLOY_TARGET}" in'),
                'do/deploy script should have case statement on DEPLOY_TARGET'
            );

            // Check for codebuild branch
            assert.ok(
                deployScript.includes('codebuild)'),
                'do/deploy script should have codebuild case branch'
            );

            // Check for sagemaker branch
            assert.ok(
                deployScript.includes('sagemaker)'),
                'do/deploy script should have sagemaker case branch'
            );

            // Check for default case
            assert.ok(
                deployScript.includes('*)'),
                'do/deploy script should have default case branch'
            );

            // Check for esac
            assert.ok(
                deployScript.includes('esac'),
                'do/deploy script should close case statement with esac'
            );

            // Check for ECR image verification in codebuild branch
            assert.ok(
                deployScript.includes('CodeBuild deployment - verifying ECR image exists'),
                'do/deploy script should verify ECR image for CodeBuild deployment'
            );

            // Check for ECR image verification command
            assert.ok(
                deployScript.includes('aws ecr describe-images'),
                'do/deploy script should use aws ecr describe-images to verify image'
            );

            // console.log('  ✅ Property 6 validated: do/deploy contains conditional branching logic');
        });
    });

    describe('Property 7: All do scripts use consistent output formatting (do/deploy)', () => {
        it('should use emoji prefixes in do/deploy script', () => {
            console.log('\n  🧪 Property 7: All do scripts use consistent output formatting (do/deploy)');
            // console.log('  📝 The do/deploy script should use emoji prefixes for output messages');
            // console.log('  **Validates: Requirements 14.1**');

            // Read the do/deploy template file
            const deployScriptPath = path.join(__dirname, '../../generators/app/templates/do/deploy');
            const deployScript = readFileSync(deployScriptPath, 'utf8');

            // Check for emoji prefixes
            const emojiPrefixes = [
                '🚀', // Action/start
                '✅', // Success
                '❌', // Error
                '🔍', // Check/validation
                '📦', // Package/model
                '⚙️',  // Configuration
                '⏳', // Waiting
                '📋', // Details/info
                '🧪', // Test
                '🧹'  // Clean
            ];

            for (const emoji of emojiPrefixes) {
                assert.ok(
                    deployScript.includes(emoji),
                    `do/deploy script should use ${emoji} emoji prefix`
