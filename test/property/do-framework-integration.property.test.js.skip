        it('should push all tags to ECR in do/push script', () => {
            console.log('\n  🧪 Property 8 (Part 4): AWS-dependent scripts push all tags');
            // console.log('  📝 The do/push script should push all image tags to ECR');
            // console.log('  **Validates: Requirements 4.4, 4.5**');

            // Read the do/push template file
            const pushScriptPath = path.join(__dirname, '../../generators/app/templates/do/push');
            const pushScript = readFileSync(pushScriptPath, 'utf8');

            // Check for image tagging
            assert.ok(
                pushScript.includes('docker tag "${PROJECT_NAME}:latest" "${ECR_REPOSITORY}:latest"'),
                'do/push script should tag image with latest'
            );

            assert.ok(
                pushScript.includes('docker tag "${PROJECT_NAME}:latest" "${ECR_REPOSITORY}:${PROJECT_NAME}-latest"'),
                'do/push script should tag image with project-name-latest'
            );

            assert.ok(
                pushScript.includes('docker tag "${PROJECT_NAME}:latest" "${ECR_REPOSITORY}:${PROJECT_NAME}-${TIMESTAMP}"'),
                'do/push script should tag image with timestamp'
            );

            // Check for image pushing
            assert.ok(
                pushScript.includes('docker push "${ECR_REPOSITORY}:latest"'),
                'do/push script should push latest tag'
            );

            assert.ok(
                pushScript.includes('docker push "${ECR_REPOSITORY}:${PROJECT_NAME}-latest"'),
                'do/push script should push project-name-latest tag'
            );

            assert.ok(
                pushScript.includes('docker push "${ECR_REPOSITORY}:${PROJECT_NAME}-${TIMESTAMP}"'),
                'do/push script should push timestamp tag'
            );

            // Check for pushed image URIs display
            assert.ok(
                pushScript.includes('echo "📦 Pushed image URIs:"'),
                'do/push script should display pushed image URIs'
            );

            assert.ok(
                pushScript.includes('echo "   ${ECR_REPOSITORY}:latest"'),
                'do/push script should display latest URI'
            );

            assert.ok(
                pushScript.includes('echo "   ${ECR_REPOSITORY}:${PROJECT_NAME}-latest"'),
                'do/push script should display project-name-latest URI'
            );

            assert.ok(
                pushScript.includes('echo "   ${ECR_REPOSITORY}:${PROJECT_NAME}-${TIMESTAMP}"'),
                'do/push script should display timestamp URI'
            );

            // console.log('  ✅ Property 8 (Part 4) validated: do/push pushes all tags and displays URIs');
        });
    });

