    describe('Property 7: All do scripts use consistent output formatting (do/run)', () => {
        it('should use emoji prefixes in do/run script', () => {
            console.log('\n  🧪 Property 7: All do scripts use consistent output formatting (do/run)');
            // console.log('  📝 The do/run script should use emoji prefixes for output messages');
            // console.log('  **Validates: Requirements 14.1**');

            // Read the do/run template file
            const runScriptPath = path.join(__dirname, '../../generators/app/templates/do/run');
            const runScript = readFileSync(runScriptPath, 'utf8');

            // Check for emoji prefixes
            const emojiPrefixes = [
                '🚀', // Action/start
                '✅', // Success
                '❌', // Error
                '⚠️',  // Warning
                '🎮', // GPU
                '💻', // CPU
                '📁', // Directory/folder
                '🔑', // Key/credentials
                '🏃', // Running
                '📝'  // Logs/notes
            ];

            for (const emoji of emojiPrefixes) {
                assert.ok(
                    runScript.includes(emoji),
                    `do/run script should use ${emoji} emoji prefix`
                );
            }

            // Check for header message at start
            assert.ok(
                runScript.includes('echo "🚀 Running Docker container locally for ${PROJECT_NAME}"'),
                'do/run script should have header message with 🚀'
            );

            // Check for success message at end
            assert.ok(
                runScript.includes('echo "✅ Container stopped and cleaned up"'),
                'do/run script should have success message with ✅'
            );

            // Check for error messages
            assert.ok(
                runScript.includes('echo "❌ Docker is not installed"'),
                'do/run script should have error message with ❌ for missing Docker'
            );

            assert.ok(
                runScript.includes('echo "❌ Docker image not found:'),
                'do/run script should have error message with ❌ for missing image'
            );

            // Check for next steps section
            assert.ok(
                runScript.includes('echo "Next steps:"'),
                'do/run script should have next steps section'
            );

            // console.log('  ✅ Property 7 validated: do/run uses consistent output formatting');
        });
    });

    describe('Property 9: Tool-dependent scripts validate prerequisites (do/run)', () => {
        it('should validate Docker is installed in do/run script', () => {
            console.log('\n  🧪 Property 9: Tool-dependent scripts validate prerequisites (do/run)');
            // console.log('  📝 The do/run script should validate that Docker is installed');
            // console.log('  **Validates: Requirements 13.1**');

            // Read the do/run template file
            const runScriptPath = path.join(__dirname, '../../generators/app/templates/do/run');
            const runScript = readFileSync(runScriptPath, 'utf8');

            // Check for Docker validation
            assert.ok(
                runScript.includes('if ! command -v docker &> /dev/null'),
                'do/run script should check if Docker is installed'
            );

            // Check for error message
            assert.ok(
                runScript.includes('echo "❌ Docker is not installed"'),
                'do/run script should display error if Docker is not installed'
            );

            // Check for installation instructions
            assert.ok(
                runScript.includes('Install from: https://docs.docker.com/get-docker/'),
                'do/run script should provide Docker installation instructions'
            );

            // Check for exit with error code
            assert.ok(
                runScript.includes('exit 2'),
                'do/run script should exit with code 2 for missing prerequisite'
            );

            // console.log('  ✅ Property 9 validated: do/run validates Docker is installed');
        });

        it('should validate Docker image exists in do/run script', () => {
            console.log('\n  🧪 Property 9 (Part 2): Tool-dependent scripts validate Docker image exists');
            // console.log('  📝 The do/run script should validate that Docker image exists before running');
            // console.log('  **Validates: Requirements 6.2**');

            // Read the do/run template file
            const runScriptPath = path.join(__dirname, '../../generators/app/templates/do/run');
            const runScript = readFileSync(runScriptPath, 'utf8');

            // Check for image existence validation
            assert.ok(
                runScript.includes('if ! docker image inspect "${PROJECT_NAME}:latest" &> /dev/null'),
                'do/run script should check if Docker image exists'
            );

            // Check for error message
            assert.ok(
                runScript.includes('echo "❌ Docker image not found:'),
                'do/run script should display error if image not found'
            );

            // Check for build instructions
            assert.ok(
                runScript.includes('Build the image first: ./do/build'),
                'do/run script should provide build instructions'
            );

            // Check for exit with error code
            assert.ok(
                runScript.includes('exit 5'),
                'do/run script should exit with code 5 for Docker errors'
            );

            // console.log('  ✅ Property 9 (Part 2) validated: do/run validates Docker image exists');
        });

        it('should check nvidia-docker availability for GPU deployments in do/run script', () => {
            console.log('\n  🧪 Property 9 (Part 3): Tool-dependent scripts check nvidia-docker for GPU');
            // console.log('  📝 The do/run script should check nvidia-docker availability for transformers deployments');
            // console.log('  **Validates: Requirements 6.5**');

            // Read the do/run template file
            const runScriptPath = path.join(__dirname, '../../generators/app/templates/do/run');
            const runScript = readFileSync(runScriptPath, 'utf8');

            // Check for nvidia-docker validation
            assert.ok(
                runScript.includes('if ! docker run --rm --gpus all nvidia/cuda:11.0-base nvidia-smi &> /dev/null'),
                'do/run script should check if nvidia-docker is available'
            );

            // Check for warning message (not error, since it's a warning)
            assert.ok(
                runScript.includes('echo "⚠️  Warning: GPU support requested but nvidia-docker may not be available"'),
                'do/run script should display warning if nvidia-docker may not be available'
            );

            // Check for installation instructions
            assert.ok(
                runScript.includes('Install nvidia-docker: https://github.com/NVIDIA/nvidia-docker'),
                'do/run script should provide nvidia-docker installation instructions'
            );

            // Note: This is a warning, not an error, so the script continues
            // console.log('  ✅ Property 9 (Part 3) validated: do/run checks nvidia-docker availability');
        });
    });

