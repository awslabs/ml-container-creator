        it('should display success messages with exit code 0', () => {
            console.log('\n  🧪 do/test functional: Display success messages');
            // console.log('  📝 The do/test script should display success messages and exit with code 0');
            // console.log('  **Validates: Requirements 7.6**');

            // Read the do/test template file
            const testScriptPath = path.join(__dirname, '../../generators/app/templates/do/test');
            const testScript = readFileSync(testScriptPath, 'utf8');

            // Check for success messages
            assert.ok(
                testScript.includes('echo "✅ Health check passed (HTTP ${HTTP_CODE})"'),
                'do/test script should display health check success message'
            );

            assert.ok(
                testScript.includes('echo "✅ Inference request successful'),
                'do/test script should display inference request success message'
            );

            assert.ok(
                testScript.includes('echo "✅ All tests passed!"'),
                'do/test script should display overall success message'
            );

            // Verify no explicit exit 0 (implicit success)
            // The script should naturally exit with 0 if all tests pass
            const explicitExitZero = testScript.match(/exit 0/g);
            assert.ok(
                !explicitExitZero || explicitExitZero.length === 0,
                'do/test script should not need explicit exit 0 (implicit success)'
            );

            console.log('  ✅ do/test displays success messages with implicit exit code 0');
        });

        it('should display error details with non-zero exit codes', () => {
            console.log('\n  🧪 do/test functional: Display error details');
            // console.log('  📝 The do/test script should display error details and exit with non-zero codes');
            // console.log('  **Validates: Requirements 7.7**');

