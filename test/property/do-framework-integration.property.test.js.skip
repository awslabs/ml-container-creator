            const testScriptPath = path.join(__dirname, '../../generators/app/templates/do/test');
            const testScript = readFileSync(testScriptPath, 'utf8');

            // Check for error messages
            assert.ok(
                testScript.includes('echo "❌ Health check failed:'),
                'do/test script should display health check failure message'
            );

            assert.ok(
                testScript.includes('echo "❌ Inference request failed'),
                'do/test script should display inference request failure message'
            );

            // Check for exit with non-zero codes
            const exitCodes = testScript.match(/exit [1-9]/g);
            assert.ok(
                exitCodes && exitCodes.length > 0,
                'do/test script should exit with non-zero codes on failure'
            );

            // Check for specific error codes
            assert.ok(
                testScript.includes('exit 1'),
                'do/test script should use exit 1 for general errors'
            );

            assert.ok(
                testScript.includes('exit 3'),
                'do/test script should use exit 3 for configuration errors'
            );

            // Check for error context
            assert.ok(
                testScript.includes('echo "   Make sure the container is running: ./do/run"'),
                'do/test script should provide remediation instructions'
            );

            console.log('  ✅ do/test displays error details with non-zero exit codes');
        });
